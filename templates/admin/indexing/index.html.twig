{% extends 'admin/base.html.twig' %}

{% block title %}Painel de Indexação & Normatização de Currículos | Admin CECH{% endblock %}

{% block body %}
<div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-3">
                <span class="p-2.5 rounded-2xl bg-sky-500/10 text-sky-600 dark:text-sky-400">
                    <sl-icon name="cpu"></sl-icon>
                </span>
                Indexação & Normatização de Dados
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                Gera o índice manual de alta performance (vinculação de coautores CECH, estratos Qualis e instituições) sem alterar nenhum dado original do Lattes.
            </p>
        </div>

        <div class="flex items-center gap-2">
            <a href="{{ path('app_admin_curriculum_index') }}" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-900 transition-colors">
                <sl-icon name="people"></sl-icon> Ver Docentes
            </a>
        </div>
    </div>

    <!-- Regra de Ouro / Info Banner -->
    <div class="rounded-2xl p-4 sm:p-5 bg-gradient-to-r from-sky-500/10 via-indigo-500/10 to-transparent border border-sky-500/20 text-xs sm:text-sm space-y-1.5">
        <div class="flex items-center gap-2 font-bold text-sky-800 dark:text-sky-300">
            <sl-icon name="shield-check" class="text-base"></sl-icon>
            <span>Regra Fixa do Projeto: Preservação Total dos Dados Originais</span>
        </div>
        <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">
            Os dados brutos importados da plataforma CNPq Lattes (nomes de autores, citações, títulos e instituições) nunca são adulterados. A indexação é gravada exclusivamente em colunas dedicadas de relacionamento (<code class="bg-sky-100 dark:bg-sky-950 px-1 py-0.5 rounded text-[11px] font-mono">matched_researcher_id</code>, <code class="bg-sky-100 dark:bg-sky-950 px-1 py-0.5 rounded text-[11px] font-mono">author_identity_id</code>, <code class="bg-sky-100 dark:bg-sky-950 px-1 py-0.5 rounded text-[11px] font-mono">qualis_journal_id</code>, etc.).
        </p>
    </div>

    <!-- Metrics Cards Grid -->
    <!-- Metrics Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
        <!-- Total Pesquisadores -->
        <div class="glass-card rounded-3xl p-4 sm:p-5 shadow-sm space-y-1.5">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider">Total</span>
                <sl-icon name="people" class="text-base text-sky-500"></sl-icon>
            </div>
            <div class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white" id="stat-total-researchers">
                {{ overview.totalResearchers|number_format }}
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400">Docentes na base</p>
        </div>

        <!-- Docentes Ativos -->
        <div class="glass-card rounded-3xl p-4 sm:p-5 shadow-sm space-y-1.5 border-l-4 border-l-emerald-500">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Ativos</span>
                <sl-icon name="person-check" class="text-base text-emerald-500"></sl-icon>
            </div>
            <div class="text-xl sm:text-2xl font-extrabold text-emerald-600 dark:text-emerald-400" id="stat-active-researchers">
                {{ overview.activeResearchers|number_format }}
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400">Em exercício no CECH</p>
        </div>

        <!-- Aposentados / Históricos -->
        <div class="glass-card rounded-3xl p-4 sm:p-5 shadow-sm space-y-1.5 border-l-4 border-l-amber-500">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Históricos</span>
                <sl-icon name="person-dash" class="text-base text-amber-500"></sl-icon>
            </div>
            <div class="text-xl sm:text-2xl font-extrabold text-amber-600 dark:text-amber-400" id="stat-retired-researchers">
                {{ overview.retiredResearchers|number_format }}
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400">Aposentados / Saída</p>
        </div>

        <!-- Já Indexados -->
        <div class="glass-card rounded-3xl p-4 sm:p-5 shadow-sm space-y-1.5">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider">Indexados</span>
                <sl-icon name="check-circle" class="text-base text-sky-500"></sl-icon>
            </div>
            <div class="text-xl sm:text-2xl font-extrabold text-sky-600 dark:text-sky-400 flex items-baseline gap-1.5">
                <span id="stat-indexed-researchers">{{ overview.indexedResearchers|number_format }}</span>
                <span class="text-[10px] font-semibold text-slate-400" id="stat-indexed-percent">({{ overview.percentage }}%)</span>
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400">Índice calculado</p>
        </div>

        <!-- Pendentes -->
        <div class="glass-card rounded-3xl p-4 sm:p-5 shadow-sm space-y-1.5">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider">Pendentes</span>
                <sl-icon name="hourglass-split" class="text-base text-amber-500"></sl-icon>
            </div>
            <div class="text-xl sm:text-2xl font-extrabold text-slate-700 dark:text-slate-300" id="stat-pending-researchers">
                {{ overview.pendingResearchers|number_format }}
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400">Aguardando fila</p>
        </div>

        <!-- Coautores Vinculados -->
        <div class="glass-card rounded-3xl p-4 sm:p-5 shadow-sm space-y-1.5">
            <div class="flex items-center justify-between text-slate-400">
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider">Coautores</span>
                <sl-icon name="link-45deg" class="text-base text-purple-500"></sl-icon>
            </div>
            <div class="text-xl sm:text-2xl font-extrabold text-purple-600 dark:text-purple-400" id="stat-cech-matched">
                {{ overview.cechMatchedAuthors|number_format }}
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400">Docentes cruzados</p>
        </div>
    </div>

    <!-- Main Execution Card -->
    <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-slate-200/80 dark:border-white/10">
            <div>
                <h2 class="font-heading text-lg font-bold text-slate-900 dark:text-white">Executar Indexação em Lote</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">Inicia o processamento sequencial com barra de progresso e estimativa de tempo em tempo real.</p>
            </div>

            <!-- Department Filter & Options -->
            <div class="flex flex-wrap items-center gap-3">
                <select id="filter-dept" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700 shadow-sm focus:border-sky-500 focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                    <option value="all">Todos os Departamentos</option>
                    {% for d in departments %}
                        <option value="{{ d.code }}" {% if selectedDept == d.code %}selected{% endif %}>
                            {{ d.code }} - {{ d.name }} ({{ d.facultyCount }})
                        </option>
                    {% endfor %}
                </select>

                <label class="inline-flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400 cursor-pointer select-none">
                    <input type="checkbox" id="filter-only-pending" class="rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-700 dark:bg-slate-900">
                    Apenas Pendentes
                </label>
            </div>
        </div>

        <!-- Action Controls -->
        <div class="flex flex-wrap items-center gap-3">
            <button type="button" id="btn-start" class="inline-flex items-center gap-2 rounded-2xl bg-sky-600 px-6 py-3 text-xs sm:text-sm font-bold text-white shadow-md hover:bg-sky-500 transition-all hover:scale-[1.02] active:scale-[0.98]">
                <sl-icon name="play-fill" class="text-base"></sl-icon>
                <span>Iniciar Indexação</span>
            </button>

            <button type="button" id="btn-pause" disabled class="hidden items-center gap-2 rounded-2xl border border-slate-300 bg-white px-5 py-3 text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 transition-colors">
                <sl-icon name="pause-fill" class="text-base text-amber-500"></sl-icon>
                <span>Pausar</span>
            </button>

            <button type="button" id="btn-resume" disabled class="hidden items-center gap-2 rounded-2xl bg-emerald-600 px-5 py-3 text-xs sm:text-sm font-bold text-white hover:bg-emerald-500 transition-colors shadow-md">
                <sl-icon name="play-fill" class="text-base"></sl-icon>
                <span>Continuar</span>
            </button>

            <button type="button" id="btn-cancel" disabled class="hidden items-center gap-2 rounded-2xl border border-rose-300 bg-white px-5 py-3 text-xs sm:text-sm font-bold text-rose-600 hover:bg-rose-50 dark:border-rose-900/60 dark:bg-slate-900 dark:text-rose-400 transition-colors">
                <sl-icon name="stop-fill" class="text-base"></sl-icon>
                <span>Cancelar</span>
            </button>

            <button type="button" id="btn-index-journals" class="inline-flex items-center gap-2 rounded-2xl border border-indigo-300 bg-indigo-50/50 hover:bg-indigo-100 text-indigo-700 dark:border-indigo-900/60 dark:bg-indigo-950/40 dark:text-indigo-300 px-5 py-3 text-xs sm:text-sm font-bold transition-all shadow-xs cursor-pointer ml-auto" title="Indexa todos os periódicos e bases internacionais (Scopus, WoS, etc.) diretamente na tabela de produções">
                <sl-icon name="database-check" class="text-base"></sl-icon>
                <span>Indexar Periódicos & Bases ({{ overview.totalArticles|default(13469)|number_format }} artigos)</span>
            </button>
        </div>

        <!-- Real-Time Progress Box (Hidden until started) -->
        <div id="progress-container" class="hidden space-y-5 rounded-2xl bg-slate-50 dark:bg-slate-900/80 p-5 sm:p-6 border border-slate-200/80 dark:border-white/10">
            <!-- Progress Bar with Percentage -->
            <div class="space-y-2">
                <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-300">
                    <span id="progress-status-text">Preparando fila de docentes...</span>
                    <span id="progress-percent-text" class="text-sm font-extrabold text-sky-600 dark:text-sky-400">0%</span>
                </div>
                <div class="h-3.5 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800 shadow-inner">
                    <div id="progress-bar-fill" class="h-full rounded-full bg-gradient-to-r from-sky-500 via-indigo-500 to-emerald-500 transition-all duration-300 ease-out shadow-sm" style="width: 0%"></div>
                </div>
            </div>

            <!-- Time Stats Badges Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                <!-- Tempo Decorrido -->
                <div class="rounded-xl bg-white dark:bg-slate-950 p-3.5 border border-slate-200/80 dark:border-white/10 flex items-center gap-3">
                    <div class="h-10 w-10 rounded-lg bg-sky-100 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 flex items-center justify-center text-lg shrink-0">
                        <sl-icon name="stopwatch"></sl-icon>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Tempo Decorrido</span>
                        <span class="font-mono text-base font-extrabold text-slate-800 dark:text-slate-100" id="time-elapsed">00:00:00</span>
                    </div>
                </div>

                <!-- Tempo Estimado Restante -->
                <div class="rounded-xl bg-white dark:bg-slate-950 p-3.5 border border-slate-200/80 dark:border-white/10 flex items-center gap-3">
                    <div class="h-10 w-10 rounded-lg bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg shrink-0">
                        <sl-icon name="hourglass-split"></sl-icon>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Tempo Restante (ETA)</span>
                        <span class="font-mono text-base font-extrabold text-amber-600 dark:text-amber-400" id="time-remaining">Calculando...</span>
                    </div>
                </div>

                <!-- Velocidade & Contagem -->
                <div class="rounded-xl bg-white dark:bg-slate-950 p-3.5 border border-slate-200/80 dark:border-white/10 flex items-center gap-3">
                    <div class="h-10 w-10 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg shrink-0">
                        <sl-icon name="lightning-charge"></sl-icon>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Progresso & Velocidade</span>
                        <span class="font-mono text-xs font-bold text-slate-800 dark:text-slate-100 block" id="progress-count-speed">0 / 0 (0.0 doc/s)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Live Terminal Execution Log -->
        <div class="space-y-2">
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                <span class="font-bold flex items-center gap-1.5">
                    <sl-icon name="terminal"></sl-icon> Log de Processamento ao Vivo
                </span>
                <button type="button" id="btn-clear-log" class="hover:underline text-[11px]">Limpar Log</button>
            </div>
            <div id="terminal-log" class="h-64 overflow-y-auto rounded-2xl bg-slate-950 p-4 font-mono text-[11px] leading-relaxed text-slate-300 border border-slate-800 shadow-inner space-y-1 select-text">
                <p class="text-slate-500">// Pronto. Clique em "Iniciar Indexação" para processar a base de docentes.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnStart = document.getElementById('btn-start');
    const btnPause = document.getElementById('btn-pause');
    const btnResume = document.getElementById('btn-resume');
    const btnCancel = document.getElementById('btn-cancel');
    const btnClearLog = document.getElementById('btn-clear-log');
    
    const filterDept = document.getElementById('filter-dept');
    const filterOnlyPending = document.getElementById('filter-only-pending');
    
    const progressContainer = document.getElementById('progress-container');
    const progressStatusText = document.getElementById('progress-status-text');
    const progressPercentText = document.getElementById('progress-percent-text');
    const progressBarFill = document.getElementById('progress-bar-fill');
    
    const timeElapsedEl = document.getElementById('time-elapsed');
    const timeRemainingEl = document.getElementById('time-remaining');
    const progressCountSpeedEl = document.getElementById('progress-count-speed');
    const terminalLog = document.getElementById('terminal-log');

    let queue = [];
    let currentIndex = 0;
    let isRunning = false;
    let isPaused = false;
    let isCancelled = false;
    
    let startTime = null;
    let timerInterval = null;
    let processedTimes = [];

    function formatTime(seconds) {
        if (isNaN(seconds) || seconds < 0 || !isFinite(seconds)) return '00:00:00';
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = Math.floor(seconds % 60);
        return [h, m, s].map(v => String(v).padStart(2, '0')).join(':');
    }

    function log(msg, type = 'info') {
        const time = new Date().toLocaleTimeString();
        const p = document.createElement('p');
        p.className = type === 'error' ? 'text-rose-400 font-semibold' :
                      type === 'success' ? 'text-emerald-400 font-semibold' :
                      type === 'warn' ? 'text-amber-400' : 'text-slate-300';
        p.innerHTML = `<span class="text-slate-500">[${time}]</span> ${msg}`;
        terminalLog.appendChild(p);
        terminalLog.scrollTop = terminalLog.scrollHeight;
    }

    btnClearLog.addEventListener('click', () => {
        terminalLog.innerHTML = '<p class="text-slate-500">// Log limpo.</p>';
    });

    function updateTimer() {
        if (!isRunning || isPaused || !startTime) return;
        const now = Date.now();
        const elapsedSec = (now - startTime) / 1000;
        timeElapsedEl.textContent = formatTime(elapsedSec);

        // Calculate ETA based on processed items
        if (currentIndex > 0 && queue.length > currentIndex) {
            const avgTimePerItem = elapsedSec / currentIndex;
            const remainingItems = queue.length - currentIndex;
            const etaSeconds = avgTimePerItem * remainingItems;
            timeRemainingEl.textContent = formatTime(etaSeconds);
            
            const speed = (currentIndex / elapsedSec).toFixed(1);
            progressCountSpeedEl.textContent = `${currentIndex} / ${queue.length} (${speed} doc/s)`;
        }
    }

    btnStart.addEventListener('click', async function() {
        btnStart.disabled = true;
        btnStart.classList.add('opacity-50');
        filterDept.disabled = true;
        filterOnlyPending.disabled = true;

        log(`Buscando fila de docentes (Departamento: ${filterDept.value}, Apenas Pendentes: ${filterOnlyPending.checked ? 'Sim' : 'Não'})...`);
        
        try {
            const resp = await fetch(`{{ path('app_admin_indexing_queue') }}?dept=${encodeURIComponent(filterDept.value)}&only_pending=${filterOnlyPending.checked ? 1 : 0}`);
            const data = await resp.json();
            
            if (!data.success || data.items.length === 0) {
                log('Nenhum docente encontrado para processar na fila informada.', 'warn');
                btnStart.disabled = false;
                btnStart.classList.remove('opacity-50');
                filterDept.disabled = false;
                filterOnlyPending.disabled = false;
                return;
            }

            queue = data.items;
            currentIndex = 0;
            processedTimes = [];
            isRunning = true;
            isPaused = false;
            isCancelled = false;

            progressContainer.classList.remove('hidden');
            btnStart.classList.add('hidden');
            btnPause.classList.remove('hidden');
            btnPause.disabled = false;
            btnCancel.classList.remove('hidden');
            btnCancel.disabled = false;

            startTime = Date.now();
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(updateTimer, 1000);

            log(`Fila inicializada com ${queue.length} docente(s). Iniciando indexação sequencial...`, 'success');
            processNextItem();

        } catch (err) {
            log(`Erro ao carregar fila: ${err.message}`, 'error');
            btnStart.disabled = false;
            btnStart.classList.remove('opacity-50');
            filterDept.disabled = false;
            filterOnlyPending.disabled = false;
        }
    });

    btnPause.addEventListener('click', function() {
        isPaused = true;
        btnPause.classList.add('hidden');
        btnResume.classList.remove('hidden');
        btnResume.disabled = false;
        log('Indexação pausada pelo usuário.', 'warn');
        progressStatusText.textContent = 'Pausado.';
    });

    btnResume.addEventListener('click', function() {
        isPaused = false;
        btnResume.classList.add('hidden');
        btnPause.classList.remove('hidden');
        log('Indexação retomada...', 'info');
        processNextItem();
    });

    btnCancel.addEventListener('click', function() {
        if (!confirm('Deseja realmente cancelar a execução da indexação?')) return;
        isCancelled = true;
        isRunning = false;
        if (timerInterval) clearInterval(timerInterval);
        log('Indexação cancelada pelo usuário.', 'error');
        finishExecution(false);
    });

    async function processNextItem() {
        if (isCancelled || !isRunning) return;

        if (isPaused) {
            return;
        }

        if (currentIndex >= queue.length) {
            finishExecution(true);
            return;
        }

        const item = queue[currentIndex];
        const percent = Math.round((currentIndex / queue.length) * 100);
        
        progressBarFill.style.width = `${percent}%`;
        progressPercentText.textContent = `${percent}%`;
        progressStatusText.textContent = `Processando (${currentIndex + 1}/${queue.length}): ${item.fullName}`;

        try {
            const resp = await fetch(`/admin/indexing/step/${item.id}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!resp.ok) {
                throw new Error(`HTTP ${resp.status}`);
            }

            const res = await resp.json();
            
            if (res.success) {
                const s = res.stats;
                const statusBadge = s.isActiveInCech
                    ? `<span class="inline-flex items-center gap-0.5 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] bg-emerald-50 dark:bg-emerald-950/60 px-1.5 py-0.2 rounded">● Ativo (${s.admissionYear ? 'desde ' + s.admissionYear : 'CECH'})</span>`
                    : `<span class="inline-flex items-center gap-0.5 text-amber-600 dark:text-amber-400 font-bold text-[10px] bg-amber-50 dark:bg-amber-950/60 px-1.5 py-0.2 rounded">○ Histórico (${s.admissionYear || '?'}&ndash;${s.leaveYear || '?'})</span>`;

                log(`[${currentIndex + 1}/${queue.length}] ✓ <strong>${item.fullName}</strong> ${statusBadge} — ${s.productionsProcessed} prods, ${s.authorsIndexed} autores (${s.authorsCechMatched} CECH), ${s.qualisResolved} qualis, ${s.institutionsResolved} inst. (${res.elapsedMs}ms)`, 'success');
            } else {
                log(`[${currentIndex + 1}/${queue.length}] ⚠ Falha ao indexar ${item.fullName}: ${res.message || 'Erro desconhecido'}`, 'warn');
            }
        } catch (err) {
            log(`[${currentIndex + 1}/${queue.length}] ✗ Erro ao processar ${item.fullName}: ${err.message}`, 'error');
        }

        currentIndex++;
        updateTimer();

        // Continue next item immediately
        setTimeout(processNextItem, 10);
    }

    function finishExecution(completedAll) {
        isRunning = false;
        if (timerInterval) clearInterval(timerInterval);

        btnPause.classList.add('hidden');
        btnResume.classList.add('hidden');
        btnCancel.classList.add('hidden');
        btnStart.classList.remove('hidden');
        btnStart.disabled = false;
        btnStart.classList.remove('opacity-50');
        filterDept.disabled = false;
        filterOnlyPending.disabled = false;

        if (completedAll) {
            progressBarFill.style.width = '100%';
            progressPercentText.textContent = '100%';
            progressStatusText.textContent = 'Indexação concluída com sucesso!';
            timeRemainingEl.textContent = '00:00:00';
            log('🎉 Processamento de todos os docentes finalizado com sucesso!', 'success');
        } else {
            progressStatusText.textContent = 'Execução interrompida.';
        }
    }

    // Indexação direta de periódicos e bases em lote
    const btnIndexJournals = document.getElementById('btn-index-journals');
    btnIndexJournals?.addEventListener('click', async () => {
        if (!confirm('Deseja iniciar a indexação rápida de periódicos e bases científicas para todos os 13.469 artigos?')) {
            return;
        }

        btnIndexJournals.disabled = true;
        btnIndexJournals.classList.add('opacity-50', 'cursor-not-allowed');

        progressContainer.classList.remove('hidden');
        progressBarFill.style.width = '50%';
        progressPercentText.textContent = '...';
        progressStatusText.textContent = 'Indexando periódicos e bases científicas...';
        log('🚀 Iniciando indexação em lote de periódicos e bases científicas internacionais...', 'info');

        try {
            const resp = await fetch('{{ path("app_admin_indexing_journals_batch") }}', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const res = await resp.json();
            if (res.success) {
                const s = res.stats;
                progressBarFill.style.width = '100%';
                progressPercentText.textContent = '100%';
                progressStatusText.textContent = 'Periódicos e bases indexados!';
                log(`✓ Concluído em ${s.durationSec}s! ${s.totalProcessed} artigos processados, ${s.journalsMatched} periódicos vinculados, ${s.qualisResolved} Qualis atribuídos, ${s.databasesLinked} com bases científicas.`, 'success');
            } else {
                log('✗ Erro ao indexar periódicos: ' + (res.message || 'Erro'), 'error');
            }
        } catch (err) {
            log('✗ Falha na requisição: ' + err.message, 'error');
        } finally {
            btnIndexJournals.disabled = false;
            btnIndexJournals.classList.remove('opacity-50', 'cursor-not-allowed');
        }
    });
});
</script>
{% endblock %}
