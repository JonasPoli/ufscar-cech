{% extends 'admin/base.html.twig' %}

{% block title %}{{ isNew ? 'Novo Usuário' : 'Editar Usuário: ' ~ user.username }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-2xl space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                {{ isNew ? 'Novo Usuário' : 'Editar Usuário' }}
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                Controle de credenciais de acesso administrativo.
            </p>
        </div>

        <a href="{{ path('app_admin_user_index') }}" class="text-xs text-sky-600 font-semibold hover:underline flex items-center gap-1">
            <sl-icon name="arrow-left"></sl-icon> Voltar à lista
        </a>
    </div>

    <div class="glass-card rounded-3xl p-8 shadow-sm">
        <form method="POST" action="" class="space-y-6">
            <div class="space-y-1">
                <label class="text-xs font-semibold text-slate-700 dark:text-slate-300">Nome de Usuário (Login) *</label>
                <input type="text" name="username" value="{{ user.username }}" required class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                    Senha {% if not isNew %}<span class="text-slate-400 font-normal">(deixe em branco para manter a atual)</span>{% else %}*{% endif %}
                </label>
                <input type="password" name="password" {% if isNew %}required{% endif %} class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500">
            </div>

            <div class="space-y-1">
                <label class="text-xs font-semibold text-slate-700 dark:text-slate-300">Nível de Permissão (Role) *</label>
                <select name="role" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500">
                    <option value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in user.roles %}selected{% endif %}>Administrador Completo (ROLE_ADMIN)</option>
                    <option value="ROLE_USER" {% if 'ROLE_USER' in user.roles and 'ROLE_ADMIN' not in user.roles %}selected{% endif %}>Usuário Padrão (ROLE_USER)</option>
                </select>
            </div>

            <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-200/60 dark:border-white/10">
                <a href="{{ path('app_admin_user_index') }}" class="px-5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-900 transition-colors">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-sky-600 text-xs font-semibold text-white hover:bg-sky-500 shadow-sm transition-colors">
                    Salvar Usuário
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
