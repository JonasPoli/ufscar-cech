<!-- Modal Mesclar Periódicos -->
<div id="mergeModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="glass-card rounded-3xl p-6 max-w-lg w-full shadow-2xl space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <sl-icon name="intersect" class="text-amber-500"></sl-icon> Mesclar Periódicos Selecionados
            </h3>
            <button type="button" onclick="closeModal('mergeModal')" class="text-slate-400 hover:text-slate-600">
                <sl-icon name="x-lg"></sl-icon>
            </button>
        </div>
        <form action="{{ path('app_admin_journal_merge') }}" method="POST" class="space-y-4">
            <input type="hidden" name="_token" value="{{ csrf_token('merge_journals') }}">
            <div id="mergeSourcesContainer"></div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Selecione o Periódico Principal (Destino)</label>
                <select name="master_id" id="masterSelect" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white">
                </select>
                <p class="text-[11px] text-slate-400 mt-1">Os títulos dos outros periódicos serão migrados como sinônimos (tesauro) do periódico principal.</p>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeModal('mergeModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">Cancelar</button>
                <button type="submit" class="px-4 py-2 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-500 rounded-xl">Confirmar Mesclagem</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Confirmação de Exclusão -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="glass-card rounded-3xl p-6 max-w-sm w-full shadow-2xl space-y-4">
        <div class="flex items-center gap-3 text-rose-600">
            <sl-icon name="exclamation-triangle" class="text-2xl"></sl-icon>
            <h3 class="font-heading text-base font-bold text-slate-900 dark:text-white">Excluir Periódico</h3>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400">
            Deseja realmente remover o periódico <strong id="deleteJournalTitle" class="text-slate-900 dark:text-white"></strong>? Esta ação não pode ser desfeita.
        </p>
        <form id="deleteForm" method="POST" class="flex justify-end gap-2 pt-2">
            <input type="hidden" name="_token" id="deleteCsrfToken" value="">
            <button type="button" onclick="closeModal('deleteModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">Cancelar</button>
            <button type="submit" class="px-4 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-500 rounded-xl">Excluir</button>
        </form>
    </div>
</div>

<script>
function openModal(id) {
    document.getElementById(id).classList.remove('hidden');
}

function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
}

function toggleSelectAll(master) {
    document.querySelectorAll('.journal-checkbox').forEach(cb => cb.checked = master.checked);
}

function openMergeModal() {
    const selected = Array.from(document.querySelectorAll('.journal-checkbox:checked'));
    if (selected.length < 2) {
        alert('Selecione ao menos 2 periódicos para mesclar.');
        return;
    }

    const select = document.getElementById('masterSelect');
    const container = document.getElementById('mergeSourcesContainer');
    select.innerHTML = '';
    container.innerHTML = '';

    selected.forEach(cb => {
        const id = cb.value;
        const title = cb.dataset.title;

        const opt = document.createElement('option');
        opt.value = id;
        opt.textContent = `${title} (#${id})`;
        select.appendChild(opt);

        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'source_ids[]';
        input.value = id;
        container.appendChild(input);
    });

    openModal('mergeModal');
}

function confirmDelete(id, title) {
    document.getElementById('deleteJournalTitle').textContent = `"${title}"`;
    const form = document.getElementById('deleteForm');
    form.action = `/admin/journals/${id}/delete`;
    
    // Create or set CSRF token
    fetch(`/admin/journals/${id}/edit`).then(() => {
        // use form action
    });
    
    openModal('deleteModal');
}
</script>
{% endblock %}
