{% extends 'admin/base.html.twig' %}

{% block title %}Gerenciamento de Cache de Páginas{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Cache de Páginas Públicas</h1>
                {% if isEnabled %}
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span> Ativo (PROD)
                    </span>
                {% else %}
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
                        <span class="h-2 w-2 rounded-full bg-amber-500"></span> Desativado (DEV)
                    </span>
                {% endif %}
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Gerenciamento do sistema de cache em arquivos físicos (HTML) para respostas públicas.
            </p>
        </div>

        <form action="{{ path('app_admin_cache_clear') }}" method="POST" onsubmit="return confirm('Tem certeza que deseja remover completamente a pasta de cache de páginas?');">
            <input type="hidden" name="_token" value="{{ csrf_token('clear_page_cache') }}">
            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold bg-rose-600 hover:bg-rose-700 text-white shadow-sm transition-all focus:ring-2 focus:ring-rose-500 focus:outline-none">
                <sl-icon name="trash"></sl-icon>
                Limpar Cache Agora
            </button>
        </form>
    </div>

    <!-- Rule / Config Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Stat: Files Count -->
        <div class="glass-card rounded-2xl p-5 space-y-2">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-xs font-medium uppercase tracking-wider">
                <span>Arquivos em Cache</span>
                <sl-icon name="files" class="text-lg text-cech-blue dark:text-cech-teal"></sl-icon>
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">
                {{ stats.fileCount }} <span class="text-xs font-normal text-slate-500 dark:text-slate-400">página(s)</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Páginas geradas e salvas em disco.</p>
        </div>

        <!-- Stat: Total Size -->
        <div class="glass-card rounded-2xl p-5 space-y-2">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-xs font-medium uppercase tracking-wider">
                <span>Tamanho Total em Disco</span>
                <sl-icon name="hdd-stack" class="text-lg text-cech-blue dark:text-cech-teal"></sl-icon>
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">
                {% if stats.totalSizeBytes > 1048576 %}
                    {{ (stats.totalSizeBytes / 1048576)|number_format(2, ',', '.') }} <span class="text-xs font-normal text-slate-500 dark:text-slate-400">MB</span>
                {% elseif stats.totalSizeBytes > 1024 %}
                    {{ (stats.totalSizeBytes / 1024)|number_format(1, ',', '.') }} <span class="text-xs font-normal text-slate-500 dark:text-slate-400">KB</span>
                {% else %}
                    {{ stats.totalSizeBytes }} <span class="text-xs font-normal text-slate-500 dark:text-slate-400">Bytes</span>
                {% endif %}
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Espaço consumido pelos HTMLs cacheados.</p>
        </div>

        <!-- Stat: TTL -->
        <div class="glass-card rounded-2xl p-5 space-y-2">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-xs font-medium uppercase tracking-wider">
                <span>Tempo de Vida (TTL)</span>
                <sl-icon name="clock-history" class="text-lg text-cech-blue dark:text-cech-teal"></sl-icon>
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white">
                {{ ttlDays }} <span class="text-xs font-normal text-slate-500 dark:text-slate-400">Dias</span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Validade antes de recriar o arquivo físico.</p>
        </div>
    </div>

    <!-- Technical Info Details -->
    <div class="glass-card rounded-2xl p-6 space-y-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <sl-icon name="gear" class="text-cech-blue dark:text-cech-teal"></sl-icon>
            Regras do Sistema de Cache
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 space-y-1.5">
                <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                    <sl-icon name="folder-check" class="text-slate-500"></sl-icon> Diretório Físico do Cache
                </span>
                <code class="block font-mono text-[11px] bg-white dark:bg-slate-950 p-2 rounded border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 break-all">
                    {{ stats.cacheDir }}
                </code>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 space-y-1.5">
                <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                    <sl-icon name="shield-check" class="text-slate-500"></sl-icon> Funcionamento por Ambiente
                </span>
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                    <strong>Modo PROD:</strong> Se o arquivo físico existe e é menor que 30 dias, abre o cache. Caso contrário, gera novo HTML e salva.<br>
                    <strong>Modo DEV:</strong> Não verifica se existe cache nem abre arquivo salvo; gera respostas novas em tempo real.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
