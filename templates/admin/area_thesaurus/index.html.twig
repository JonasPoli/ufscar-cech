{% extends 'admin/base.html.twig' %}

{% block title %}Tesauro de categorias de revistas | Admin CECH{% endblock %}

{% block body %}
{% set vocabularyNames = {
    'capes': 'CAPES',
    'cnpq': 'CNPq (Lattes)',
    'wos': 'Web of Science',
    'latindex': 'Latindex',
    'doaj': 'DOAJ',
    'scielo_desc': 'SciELO (descritor)',
    'scielo_area': 'SciELO (área)',
    'asjc': 'ASJC (Scopus e OpenAlex)',
    'livre': 'Texto livre'
} %}
{% set statusNames = {'active': 'ativo', 'pending': 'pendente', 'ignored': 'ignorado'} %}
{% set filterParams = {'status': status, 'q': q ?: null, 'vocabulary': vocabulary, 'area': areaSlug} %}
{# As áreas, agrupadas por grande área, montadas uma vez só: cada linha da tabela reaproveita o mesmo texto #}
{% set areaOptions %}
{%- for group in groups -%}
<optgroup label="{{ group.area.name }}"><option value="{{ group.area.slug }}">{{ group.area.name }} (grande área)</option>
{%- for child in group.children -%}
<option value="{{ child.slug }}">{{ child.name }}</option>
{%- endfor -%}
</optgroup>
{%- endfor -%}
{% endset %}
<div class="space-y-6">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="font-heading text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <sl-icon name="tags" class="text-sky-600 dark:text-sky-400"></sl-icon>
                Tesauro de categorias de revistas
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-3xl">
                Cada categoria que as bases dão a uma revista (ASJC, Web of Science, DOAJ, Latindex, SciELO) e cada texto de área do Qualis ou do Lattes vira uma área CAPES por esta tabela.
                Defina a área de um rótulo, ignore o que não diz nada sobre o assunto ou cadastre um sinônimo: a correção vale sobre a semente dos arquivos.
                Nada muda nas revistas até a próxima execução de <code>app:journals:classify</code> (ou do pipeline).
            </p>
            <p class="mt-2 text-xs font-semibold text-slate-700 dark:text-slate-300">
                {{ counts.active|number_format(0, ',', '.') }} ativos,
                {{ counts.pending|number_format(0, ',', '.') }} pendentes,
                {{ counts.ignored|number_format(0, ',', '.') }} ignorados;
                {{ manualCount|number_format(0, ',', '.') }} correç{{ manualCount == 1 ? 'ão manual' : 'ões manuais' }}.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <a href="{{ path('app_admin_area_thesaurus_export') }}" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 dark:border-slate-700 px-3.5 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Baixa o tesauro inteiro, de todos os status e vocabulários">
                <sl-icon name="filetype-csv"></sl-icon> Exportar CSV
            </a>
            <a href="{{ path('app_admin_journal_index') }}" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 dark:border-slate-700 px-3.5 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <sl-icon name="journal-bookmark"></sl-icon> Periódicos & Qualis
            </a>
        </div>
    </div>

    <!-- Abas por status -->
    <div class="flex flex-wrap gap-2 pt-1">
        {% for key, label in tabs %}
            <a href="{{ path('app_admin_area_thesaurus_index', filterParams|merge({'status': key})) }}" class="px-3 py-1 rounded-xl text-xs font-bold transition-all {% if status == key %}bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm{% else %}bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300{% endif %}">
                {{ label }} ({{ counts[key]|number_format(0, ',', '.') }})
            </a>
        {% endfor %}
    </div>
    {% if status == 'pending' %}
        <p class="text-xs text-amber-700 dark:text-amber-300">
            Rótulos usados por revistas ou currículos que o tesauro ainda não reconhece. Defina a área ou ignore o rótulo para tirá-lo desta lista.
        </p>
    {% elseif status == 'ignored' %}
        <p class="text-xs text-slate-500 dark:text-slate-400">
            Rótulos que não dizem nada sobre o assunto (como «Outros»): não dão área a nenhuma revista. Defina uma área para devolvê-los à classificação.
        </p>
    {% endif %}

    <!-- Busca e filtros -->
    <div class="glass-card rounded-2xl p-4 shadow-sm">
        <form method="GET" action="{{ path('app_admin_area_thesaurus_index') }}" class="flex flex-col lg:flex-row gap-3">
            <input type="hidden" name="status" value="{{ status }}">
            <div class="flex-1 relative">
                <sl-icon name="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></sl-icon>
                <input type="text" name="q" value="{{ q }}" placeholder="Buscar pelo rótulo..." class="w-full pl-10 pr-4 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500">
            </div>
            <label for="filter-vocabulary" class="sr-only">Vocabulário</label>
            <select id="filter-vocabulary" name="vocabulary" class="px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500">
                <option value="">Todos os vocabulários</option>
                {% for key in vocabularies %}
                    <option value="{{ key }}" {{ vocabulary == key ? 'selected' }}>{{ vocabularyNames[key] }}</option>
                {% endfor %}
            </select>
            <label for="filter-area" class="sr-only">Área CAPES</label>
            <select id="filter-area" name="area" class="px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500">
                <option value="">Todas as áreas</option>
                {% for group in groups %}
                    <optgroup label="{{ group.area.name }}">
                        <option value="{{ group.area.slug }}" {{ areaSlug == group.area.slug ? 'selected' }}>{{ group.area.name }} (grande área)</option>
                        {% for child in group.children %}
                            <option value="{{ child.slug }}" {{ areaSlug == child.slug ? 'selected' }}>{{ child.name }}</option>
                        {% endfor %}
                    </optgroup>
                {% endfor %}
            </select>
            <button type="submit" class="rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-4 py-2 text-xs font-semibold hover:opacity-90 transition-opacity">
                Filtrar
            </button>

            {% if q != '' or vocabulary or areaSlug %}
                <a href="{{ path('app_admin_area_thesaurus_index', {'status': status}) }}" class="rounded-xl border border-slate-300 dark:border-slate-700 px-3 py-2 text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center justify-center">
                    Limpar
                </a>
            {% endif %}
        </form>
    </div>

    <!-- Novo sinônimo -->
    <div class="glass-card rounded-2xl p-4 shadow-sm">
        <form method="POST" action="{{ path('app_admin_area_thesaurus_synonym') }}" class="flex flex-col lg:flex-row lg:items-end gap-3">
            <input type="hidden" name="_token" value="{{ csrf_token('area_thesaurus_synonym') }}">
            <input type="hidden" name="status" value="{{ status }}">
            <input type="hidden" name="q" value="{{ q }}">
            <input type="hidden" name="vocabulary" value="{{ vocabulary }}">
            <input type="hidden" name="filter_area" value="{{ areaSlug }}">
            <div class="flex-1">
                <label for="synonym-label" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Novo sinônimo (texto livre)</label>
                <input id="synonym-label" type="text" name="label" required maxlength="255" placeholder="Como o rótulo aparece no Qualis, no Lattes ou nas bases..." class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500">
            </div>
            <div>
                <label for="synonym-area" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Área CAPES</label>
                <select id="synonym-area" name="area" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500">
                    <option value="">Escolha a área...</option>
                    {{ areaOptions }}
                </select>
            </div>
            <button type="submit" class="rounded-xl bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-500 transition-colors">
                Adicionar sinônimo
            </button>
        </form>
    </div>

    <!-- Data Table -->
    <div class="glass-card rounded-2xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700 dark:text-slate-300">
                <thead class="bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-800 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                    <tr>
                        <th class="py-3 px-4">Rótulo</th>
                        <th class="py-3 px-4 w-40">Vocabulário</th>
                        <th class="py-3 px-4">Área CAPES</th>
                        <th class="py-3 px-4 w-24 text-center" title="Revistas que usam o rótulo (no CNPq, registros de área dos currículos)">Revistas</th>
                        <th class="py-3 px-4 w-24">Origem</th>
                        <th class="py-3 px-4">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-normal">
                    {% for v in items %}
                        <tr class="align-top hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white break-words" title="Forma do tesauro: {{ v.normalizedName }}">
                                {{ v.variationName }}
                            </td>
                            <td class="py-3 px-4" title="{{ v.vocabulary }}">
                                {{ vocabularyNames[v.vocabulary] ?? v.vocabulary }}
                            </td>
                            <td class="py-3 px-4">
                                {% if v.area %}
                                    <span class="font-semibold text-slate-900 dark:text-white">{{ v.area.name }}</span>
                                    <span class="block text-[11px] text-slate-400">{{ v.area.parent ? v.area.parent.name : 'Grande área' }}</span>
                                {% elseif v.status == 'ignored' %}
                                    <span class="italic text-slate-400">Sem área (ignorado)</span>
                                {% else %}
                                    <span class="italic text-slate-400">Sem decisão</span>
                                {% endif %}
                            </td>
                            <td class="py-3 px-4 text-center font-semibold text-slate-900 dark:text-white">
                                {{ v.occurrences|number_format(0, ',', '.') }}
                            </td>
                            <td class="py-3 px-4">
                                {% if v.manual %}
                                    <span class="inline-block rounded-lg bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">Manual</span>
                                {% else %}
                                    <span class="inline-block rounded-lg bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">Semente</span>
                                {% endif %}
                            </td>
                            <td class="py-3 px-4">
                                <form method="POST" action="{{ path('app_admin_area_thesaurus_define', {'id': v.id}) }}" class="flex flex-wrap items-center gap-1.5">
                                    <input type="hidden" name="_token" value="{{ csrf_token('area_thesaurus_define_' ~ v.id) }}">
                                    <input type="hidden" name="status" value="{{ status }}">
                                    <input type="hidden" name="q" value="{{ q }}">
                                    <input type="hidden" name="vocabulary" value="{{ vocabulary }}">
                                    <input type="hidden" name="filter_area" value="{{ areaSlug }}">
                                    <input type="hidden" name="page" value="{{ currentPage }}">
                                    <label for="area-{{ v.id }}" class="sr-only">Área CAPES de {{ v.variationName }}</label>
                                    <select id="area-{{ v.id }}" name="area" required data-current="{{ v.area ? v.area.slug : '' }}" class="max-w-[16rem] px-2 py-1.5 text-xs rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-hidden focus:ring-2 focus:ring-sky-500">
                                        <option value="">Escolha a área...</option>
                                        {{ areaOptions }}
                                    </select>
                                    <button type="submit" class="rounded-lg bg-emerald-600 px-2.5 py-1.5 text-[11px] font-semibold text-white hover:bg-emerald-500 transition-colors">Definir área</button>
                                </form>
                                <div class="mt-2 flex flex-wrap items-center gap-3 text-[11px]">
                                    {% if v.status != 'ignored' %}
                                        <form method="POST" action="{{ path('app_admin_area_thesaurus_ignore', {'id': v.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('area_thesaurus_ignore_' ~ v.id) }}">
                                            <input type="hidden" name="status" value="{{ status }}">
                                            <input type="hidden" name="q" value="{{ q }}">
                                            <input type="hidden" name="vocabulary" value="{{ vocabulary }}">
                                            <input type="hidden" name="filter_area" value="{{ areaSlug }}">
                                            <input type="hidden" name="page" value="{{ currentPage }}">
                                            <button type="submit" class="font-semibold text-slate-600 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400" title="O rótulo não diz nada sobre o assunto">Ignorar</button>
                                        </form>
                                    {% endif %}
                                    {% if v.manual %}
                                        <form method="POST" action="{{ path('app_admin_area_thesaurus_delete', {'id': v.id}) }}" onsubmit="return confirm('Excluir esta correção manual? A semente dos arquivos, se houver, volta na próxima execução do comando.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('area_thesaurus_delete_' ~ v.id) }}">
                                            <input type="hidden" name="status" value="{{ status }}">
                                            <input type="hidden" name="q" value="{{ q }}">
                                            <input type="hidden" name="vocabulary" value="{{ vocabulary }}">
                                            <input type="hidden" name="filter_area" value="{{ areaSlug }}">
                                            <input type="hidden" name="page" value="{{ currentPage }}">
                                            <button type="submit" class="font-semibold text-rose-600 hover:text-rose-500 dark:text-rose-400">Excluir correção</button>
                                        </form>
                                    {% endif %}
                                    <span class="text-slate-400">{{ statusNames[v.status] ?? v.status }}</span>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400">
                                Nenhum rótulo nesta aba{% if q != '' %} com a busca «{{ q }}»{% endif %}{% if vocabulary or areaSlug %} e os filtros escolhidos{% endif %}.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        {% if totalPages > 1 %}
            <div class="px-4 py-3 bg-slate-50 dark:bg-slate-900/60 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs text-slate-500">
                    Página {{ currentPage }} de {{ totalPages }} ({{ total|number_format(0, ',', '.') }} rótulos)
                </span>
                <div class="flex items-center gap-1">
                    {% if currentPage > 1 %}
                        <a href="{{ path('app_admin_area_thesaurus_index', filterParams|merge({'page': 1})) }}" class="px-2.5 py-1 text-xs rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">« Primeira</a>
                        <a href="{{ path('app_admin_area_thesaurus_index', filterParams|merge({'page': currentPage - 1})) }}" class="px-2.5 py-1 text-xs rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">‹ Anterior</a>
                    {% endif %}

                    {% set startPage = max(1, currentPage - 2) %}
                    {% set endPage = min(totalPages, currentPage + 2) %}
                    {% for p in startPage..endPage %}
                        <a href="{{ path('app_admin_area_thesaurus_index', filterParams|merge({'page': p})) }}" class="px-2.5 py-1 text-xs rounded-lg border {% if p == currentPage %}bg-sky-600 text-white border-sky-600 font-bold{% else %}border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800{% endif %}">
                            {{ p }}
                        </a>
                    {% endfor %}

                    {% if currentPage < totalPages %}
                        <a href="{{ path('app_admin_area_thesaurus_index', filterParams|merge({'page': currentPage + 1})) }}" class="px-2.5 py-1 text-xs rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Próxima ›</a>
                        <a href="{{ path('app_admin_area_thesaurus_index', filterParams|merge({'page': totalPages})) }}" class="px-2.5 py-1 text-xs rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Última »</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script>
    // Pré-seleciona a área atual de cada linha (sem o script, o select começa em "Escolha a área...")
    document.querySelectorAll('select[data-current]').forEach(function (select) {
        if (select.dataset.current) {
            select.value = select.dataset.current;
        }
    });
</script>
{% endblock %}
