<script>
function copyCrawlerScript() {
    const rawCode = document.getElementById('rawScriptContent').value;
    navigator.clipboard.writeText(rawCode).then(() => {
        const btn = document.getElementById('btnCopyScript');
        const icon = document.getElementById('copyIcon');
        const text = document.getElementById('copyText');
        
        icon.setAttribute('name', 'check-lg');
        text.innerText = 'Copiado com Sucesso!';
        btn.classList.remove('bg-sky-600', 'hover:bg-sky-500');
        btn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');

        setTimeout(() => {
            icon.setAttribute('name', 'clipboard');
            text.innerText = 'Copiar Script do Console';
            btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500');
            btn.classList.add('bg-sky-600', 'hover:bg-sky-500');
        }, 3000);
    }).catch(err => {
        alert('Não foi possível copiar automaticamente. Selecione o código e copie manualmente.');
    });
}
</script>
