{% extends 'admin/base.html.twig' %}

{% block title %}Adicionar Docente por ID Lattes | CECH{% endblock %}

{% block body %}
<div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-sky-600 dark:text-sky-400 uppercase tracking-wider mb-1">
                <a href="{{ path('app_admin_curriculum_index') }}" class="hover:underline">Currículos</a>
                <span>/</span>
                <span>Adicionar Docente</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <sl-icon name="person-plus" class="text-sky-500"></sl-icon> Adicionar / Sincronizar Docente
            </h1>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
                Cadastre docentes via formulário manual, importe XML ou utilize a <b>sincronização instantânea via navegador</b> com foto em alta resolução.
            </p>
        </div>

        <a href="{{ path('app_admin_curriculum_index') }}" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-medium text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
            <sl-icon name="arrow-left"></sl-icon> Voltar à Listagem
        </a>
    </div>

    <!-- Main Grid: Form & Info -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Form Card -->
        <div class="lg:col-span-2">
            <sl-card class="w-full">
                <div slot="header" class="flex items-center justify-between font-semibold text-slate-900 dark:text-white text-sm">
                    <span class="flex items-center gap-2">
                        <sl-icon name="cloud-arrow-down" class="text-sky-500"></sl-icon> Importação Manual / Upload de XML
                    </span>
                    <span class="text-xs font-normal text-slate-500">Cadastro Direto</span>
                </div>

                <form method="POST" action="{{ path('app_admin_curriculum_new') }}" enctype="multipart/form-data" class="space-y-5">
                    <!-- ID Lattes / URL -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="lattesInput">
                            ID Lattes (16 dígitos) ou Link do Currículo <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" id="lattesInput" name="lattes_id" required placeholder="Ex: 3389666977978800 ou http://lattes.cnpq.br/3389666977978800" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 font-mono" />
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                            Você pode colar a URL completa do Lattes ou apenas os 16 dígitos numéricos.
                        </p>
                    </div>

                    <!-- Departamento -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5" for="deptSelect">
                            Departamento do CECH / UFSCar <span class="text-rose-500">*</span>
                        </label>
                        <select id="deptSelect" name="department" required class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20">
                            <option value="">Selecione o departamento...</option>
                            <option value="DCI|Departamento de Ciência da Informação">DCI - Departamento de Ciência da Informação</option>
                            <option value="DEn|Departamento de Educação">DEn - Departamento de Educação</option>
                            <option value="DFil|Departamento de Filosofia">DFil - Departamento de Filosofia</option>
                            <option value="DCSo|Departamento de Ciências Sociais">DCSo - Departamento de Ciências Sociais</option>
                            <option value="DPsi|Departamento de Psicologia">DPsi - Departamento de Psicologia</option>
                            <option value="DL|Departamento de Letras">DL - Departamento de Letras</option>
                            <option value="DFis|Departamento de Educação Física e Motricidade Humana">DFis - Depto. de Educação Física e Motricidade Humana</option>
                            <option value="DGeo|Departamento de Metodologia de Ensino">DGeo / DMTE - Depto. de Metodologia de Ensino</option>
                        </select>
                    </div>

                    <!-- XML File or HTML Content (Optional Import Sources) -->
                    <div class="space-y-4">
                        <div class="rounded-xl border border-dashed border-slate-300 dark:border-slate-700 p-4 bg-slate-50/50 dark:bg-slate-900/50">
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1" for="xmlFileInput">
                                Opção 1: Arquivo XML do Currículo Lattes
                            </label>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-2">
                                Se possuir o arquivo <code>.xml</code> exportado da Plataforma Lattes, anexe-o aqui para importar todas as produções e orientações instantaneamente.
                            </p>
                            <input type="file" id="xmlFileInput" name="xml_file" accept=".xml" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100 dark:file:bg-slate-800 dark:file:text-sky-400 cursor-pointer" />
                        </div>

                        <div class="rounded-xl border border-slate-200 dark:border-slate-800 p-4 bg-white dark:bg-slate-900/30">
                            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1" for="htmlContentInput">
                                Opção 2: Colar Código-Fonte / HTML do Lattes
                            </label>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-2">
                                Abra a página do currículo no Lattes, pressione <b>Ctrl+U</b> (ou <b>Cmd+Option+U</b>), copie todo o código e cole aqui:
                            </p>
                            <textarea id="htmlContentInput" name="html_content" rows="3" placeholder="Cole o código HTML da página do Lattes aqui..." class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 font-mono"></textarea>
                        </div>
                    </div>

                    <!-- Fetch Photo Checkbox -->
                    <div class="flex items-center gap-3 pt-2">
                        <input type="checkbox" id="fetchPhotoCheck" name="fetch_photo" value="1" checked class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500 dark:border-slate-700 dark:bg-slate-900" />
                        <label for="fetchPhotoCheck" class="text-xs font-medium text-slate-700 dark:text-slate-300 cursor-pointer">
                            Buscar e vincular a <b>foto oficial em alta resolução</b> do CNPq automaticamente
                        </label>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
                        <a href="{{ path('app_admin_curriculum_index') }}" class="rounded-xl px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
                            Cancelar
                        </a>
                        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-5 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-sky-500 transition-colors">
                            <sl-icon name="cloud-arrow-down"></sl-icon> Importar e Salvar Docente
                        </button>
                    </div>
                </form>
            </sl-card>
        </div>

        <!-- Help / Info Card -->
        <div class="space-y-6">
            <sl-card class="w-full">
                <div slot="header" class="font-semibold text-slate-900 dark:text-white text-sm flex items-center gap-2">
                    <sl-icon name="info-circle" class="text-sky-500"></sl-icon> Como funciona a importação?
                </div>
                <div class="text-xs text-slate-600 dark:text-slate-400 space-y-3 leading-relaxed">
                    <p>
                        <b>1. Resolução do K-ID do CNPq:</b><br />
                        O sistema consulta o endereço do Lattes e resolve o identificador curricular do docente de forma instantânea.
                    </p>
                    <p>
                        <b>2. Captura da Foto Oficial:</b><br />
                        A foto é baixada diretamente do servidor de imagens do CNPq (<code>servicosweb.cnpq.br/wspessoa</code>) e salva em <code>public/uploads/photos/{idLattes}.jpg</code>.
                    </p>
                    <p>
                        <b>3. Produções e Orientações:</b><br />
                        Se você anexar o XML ou usar o script sincronizador do navegador, todos os artigos, livros, capítulos, eventos, patentes e orientações serão calculados e indexados automaticamente!
                    </p>
                </div>
            </sl-card>

            <sl-card class="w-full">
                <div slot="header" class="font-semibold text-slate-900 dark:text-white text-sm flex items-center gap-2">
                    <sl-icon name="bookmark-star" class="text-amber-500"></sl-icon> Bookmarklet Rápido (1-Clique)
                </div>
                <div class="space-y-3 text-xs text-slate-600 dark:text-slate-400">
                    <p class="leading-relaxed">
                        Arraste o botão abaixo para a sua <b>Barra de Favoritos</b> do navegador:
                    </p>
                    <div class="p-3 bg-amber-50 dark:bg-amber-950/40 rounded-xl border border-amber-200 dark:border-amber-800 text-center">
                        <a href="javascript:(async function(){const m=document.documentElement.innerHTML.match(/lattes\.cnpq\.br\/(\d{16})/i),p=new URLSearchParams(location.search),i=document.querySelector('input[name=&quot;id&quot;]'),id=(m?m[1]:null)||p.get('id')||(i?i.value:'')||location.pathname.split('/').pop()||'';const old=document.getElementById('cech-sync-toast');if(old)old.remove();const t=document.createElement('div');t.id='cech-sync-toast';t.style.position='fixed';t.style.top='20px';t.style.right='20px';t.style.zIndex='9999999';t.style.background='#0284c7';t.style.color='#fff';t.style.padding='16px 20px';t.style.borderRadius='14px';t.style.boxShadow='0 12px 30px rgba(0,0,0,0.4)';t.style.fontFamily='system-ui,sans-serif';t.style.fontSize='13px';t.style.maxWidth='480px';t.style.maxHeight='80vh';t.style.overflowY='auto';t.style.lineHeight='1.5';t.style.cursor='pointer';t.textContent='⏳ Sincronizando com CECH...';document.body.appendChild(t);const eps=Array.from(new Set([location.origin+'/api/curriculum/import-html','https://127.0.0.1:8002/api/curriculum/import-html','https://localhost:8002/api/curriculum/import-html','http://127.0.0.1:8002/api/curriculum/import-html','http://localhost:8002/api/curriculum/import-html','https://127.0.0.1:8000/api/curriculum/import-html','https://localhost:8000/api/curriculum/import-html','http://127.0.0.1:8000/api/curriculum/import-html','http://localhost:8000/api/curriculum/import-html']));let ok=false;for(const ep of eps){try{const r=await fetch(ep,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idLattes:id,html:document.documentElement.outerHTML})});if(!r.ok&&r.status>=500)throw new Error('HTTP '+r.status);const d=await r.json();if(d.success){console.group('%c📊 [CECH] RELATÓRIO DETALHADO DE ALTERAÇÕES','color:#0284c7;font-size:14px;font-weight:bold;');console.log('👤 Docente:',d.researcher.fullName);console.log('📝 Resumo:',d.report?d.report.summaryMessage:d.message);let dh='';if(d.report&&d.report.addedItems){const it=d.report.addedItems,li=[];if(it.articles&&it.articles.length){console.log('%c📰 Novos Artigos ('+it.articles.length+'):','color:#16a34a;font-weight:bold;');console.table(it.articles);it.articles.forEach(a=>li.push(`<li><b>📰 Artigo:</b> "${a.title}" (${a.year||'s/d'})</li>`));}if(it.books&&it.books.length){console.log('%c📚 Novos Livros ('+it.books.length+'):','color:#16a34a;font-weight:bold;');console.table(it.books);it.books.forEach(b=>li.push(`<li><b>📚 Livro:</b> "${b.title}" (${b.year||'s/d'})</li>`));}if(it.chapters&&it.chapters.length){console.log('%c📖 Novos Capítulos ('+it.chapters.length+'):','color:#16a34a;font-weight:bold;');console.table(it.chapters);it.chapters.forEach(c=>li.push(`<li><b>📖 Capítulo:</b> "${c.title}" (${c.year||'s/d'})</li>`));}if(it.events&&it.events.length){console.log('%c🎤 Novos Trabalhos em Eventos ('+it.events.length+'):','color:#16a34a;font-weight:bold;');console.table(it.events);it.events.forEach(e=>li.push(`<li><b>🎤 Evento:</b> "${e.title}" (${e.year||'s/d'})</li>`));}if(it.orientations&&it.orientations.length){console.log('%c🎓 Novas Orientações ('+it.orientations.length+'):','color:#16a34a;font-weight:bold;');console.table(it.orientations);it.orientations.forEach(o=>li.push(`<li><b>🎓 Orientação (${o.type}):</b> ${o.student} (${o.year||'s/d'})</li>`));}if(li.length){dh=`<div style="margin-top:10px;background:rgba(255,255,255,0.08);padding:10px 12px;border-radius:8px;font-size:12px;"><b style="color:#38bdf8;">Novos itens adicionados (${li.length}):</b><ul style="margin:6px 0 0 16px;padding:0;line-height:1.4;">${li.slice(0,8).join('')}${li.length>8?`<li><i>... e mais ${li.length-8} itens</i></li>`:''}</ul></div>`;}else{dh='<div style="margin-top:8px;opacity:0.85;font-size:12px;">ℹ️ Nenhuma nova produção ou orientação adicionada.</div>';}}console.groupEnd();t.style.background='#0f172a';t.innerHTML='<b>🎉 Sincronizado com Sucesso!</b><br><br><b>Docente:</b> '+(d.researcher.fullName||'')+'<br><b>ID Lattes:</b> '+(d.researcher.idLattes||'')+'<br><b>Total Produções:</b> '+(d.researcher.productionsCount??0)+'<br><b>Total Orientações:</b> '+(d.researcher.orientationsCount??0)+'<br>'+dh+'<br><small style="opacity:0.7">Clique para fechar | F12 para ver no console</small>';t.onclick=()=>t.remove();setTimeout(()=>t.remove(),12000);ok=true;break;}}catch(e){}}if(!ok){t.style.background='#b91c1c';t.innerHTML='<b>❌ Erro ao conectar ao servidor local.</b>';t.onclick=()=>t.remove();}})();" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs shadow-md transition-transform active:scale-95 cursor-grab">
                            <sl-icon name="cloud-arrow-down"></sl-icon> 📥 Sincronizar com CECH
                        </a>
                        <p class="text-[10px] text-amber-700 dark:text-amber-300 mt-2">
                            Basta abrir qualquer página do Lattes e clicar no favorito!
                        </p>
                    </div>
                </div>
            </sl-card>
        </div>
    </div>

    <!-- In-Browser Synchronizer Documentation & Interactive Toolkit -->
    <div class="rounded-2xl border border-sky-200 dark:border-sky-900/60 bg-gradient-to-br from-sky-50/50 via-white to-sky-50/20 dark:from-sky-950/20 dark:via-slate-900 dark:to-slate-900 p-6 sm:p-8 shadow-sm">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pb-6 border-b border-sky-100 dark:border-slate-800">
            <div>
                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg bg-sky-100 text-sky-700 dark:bg-sky-900/50 dark:text-sky-300 text-xs font-semibold uppercase tracking-wider mb-2">
                    <sl-icon name="lightning-charge"></sl-icon> Ferramenta Oficial de Sincronização
                </div>
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    Sincronizador In-Browser Lattes (Versão Atualizada 2.2)
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-3xl">
                    Importa instantaneamente todo o currículo aberto no navegador com relatório de alterações detalhado no console F12 e notificação flutuante.
                </p>
            </div>

            <div class="flex items-center gap-2">
                <button type="button" id="btnCopyScript" onclick="copyCrawlerScript()" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-sky-500 active:scale-95 transition-all">
                    <sl-icon name="clipboard" id="copyIcon"></sl-icon>
                    <span id="copyText">Copiar Script do Console</span>
                </button>
            </div>
        </div>

        <!-- Methods & Steps -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-6">
            <div class="rounded-xl bg-white dark:bg-slate-800/80 p-5 border border-slate-200 dark:border-slate-700 shadow-sm space-y-2">
                <div class="flex items-center gap-2 text-xs font-bold text-sky-600 dark:text-sky-400">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-sky-100 dark:bg-sky-900/60 text-sky-600 dark:text-sky-300 text-xs">1</span>
                    Abra o Currículo
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    Acesse qualquer currículo na Plataforma Lattes pelo link direto (ex: <code>http://lattes.cnpq.br/3389666977978800</code>).
                </p>
            </div>

            <div class="rounded-xl bg-white dark:bg-slate-800/80 p-5 border border-slate-200 dark:border-slate-700 shadow-sm space-y-2">
                <div class="flex items-center gap-2 text-xs font-bold text-sky-600 dark:text-sky-400">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-sky-100 dark:bg-sky-900/60 text-sky-600 dark:text-sky-300 text-xs">2</span>
                    Execute o Script
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    Pressione <b>F12</b> &rarr; aba <b>Console</b>, cole o código abaixo e aperte <b>Enter</b> (ou use o Bookmarklet nos favoritos).
                </p>
            </div>

            <div class="rounded-xl bg-white dark:bg-slate-800/80 p-5 border border-slate-200 dark:border-slate-700 shadow-sm space-y-2">
                <div class="flex items-center gap-2 text-xs font-bold text-emerald-600 dark:text-emerald-400">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-600 dark:text-emerald-300 text-xs">3</span>
                    Pronto! Ingestão Completa
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400">
                    Um toast flutuante exibirá o relatório detalhado com os novos artigos e orientações importados.
                </p>
            </div>
        </div>

        <!-- Hidden Textarea with raw script for perfect clipboard copying -->
        <textarea id="rawScriptContent" class="hidden">/**
 * CECH - In-Browser Full Lattes Data & Photo Importer (Versão 2.2)
 * Sincroniza qualquer currículo Lattes aberto no navegador diretamente com o CECH.
 */
(async function importFullLattesToCech() {
    console.log('%c🚀 [CECH] INICIANDO SINCRONIZAÇÃO DO CURRÍCULO LATTES...', 'color: #0284c7; font-size: 14px; font-weight: bold;');

    const textMatch = document.documentElement.innerHTML.match(/lattes\.cnpq\.br\/(\d{16})/i);
    const urlParams = new URLSearchParams(window.location.search);
    const idInput = document.querySelector('input[name="id"]');
    const idVal = idInput ? idInput.value : '';
    const idLattes = (textMatch ? textMatch[1] : null) || urlParams.get('id') || idVal || window.location.pathname.split('/').pop() || '';

    const toastId = 'cech-sync-toast';
    const oldToast = document.getElementById(toastId);
    if (oldToast) oldToast.remove();

    const toast = document.createElement('div');
    toast.id = toastId;
    toast.style.position = 'fixed';
    toast.style.top = '20px';
    toast.style.right = '20px';
    toast.style.zIndex = '9999999';
    toast.style.background = '#0284c7';
    toast.style.color = '#ffffff';
    toast.style.padding = '16px 22px';
    toast.style.borderRadius = '14px';
    toast.style.boxShadow = '0 12px 30px rgba(0,0,0,0.4)';
    toast.style.fontFamily = 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    toast.style.fontSize = '13px';
    toast.style.maxWidth = '480px';
    toast.style.maxHeight = '80vh';
    toast.style.overflowY = 'auto';
    toast.style.lineHeight = '1.5';
    toast.style.cursor = 'pointer';
    toast.style.border = '1px solid rgba(255,255,255,0.2)';
    toast.textContent = '⏳ Sincronizando com CECH... Tentando conectar ao servidor local...';
    document.body.appendChild(toast);

    const endpoints = Array.from(new Set([
        window.location.origin + '/api/curriculum/import-html',
        'https://127.0.0.1:8002/api/curriculum/import-html',
        'https://localhost:8002/api/curriculum/import-html',
        'http://127.0.0.1:8002/api/curriculum/import-html',
        'http://localhost:8002/api/curriculum/import-html',
        'https://127.0.0.1:8000/api/curriculum/import-html',
        'https://localhost:8000/api/curriculum/import-html',
        'http://127.0.0.1:8000/api/curriculum/import-html',
        'http://localhost:8000/api/curriculum/import-html'
    ]));

    let success = false;
    let lastError = null;

    for (const endpoint of endpoints) {
        try {
            console.log(`📡 [CECH] Tentando envio para: ${endpoint}...`);
            const resp = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    idLattes: idLattes,
                    html: document.documentElement.outerHTML
                })
            });

            if (!resp.ok && resp.status >= 500) {
                const errData = await resp.json().catch(() => ({ message: `HTTP ${resp.status}` }));
                throw new Error(errData.message || `HTTP ${resp.status}`);
            }

            const data = await resp.json();

            if (data.success) {
                console.group('%c📊 [CECH] RELATÓRIO DETALHADO DE ALTERAÇÕES', 'color: #0284c7; font-size: 14px; font-weight: bold;');
                console.log('👤 Docente:', data.researcher.fullName, `(Lattes: ${data.researcher.idLattes})`);
                console.log('📝 Resumo:', data.report ? data.report.summaryMessage : data.message);

                let detailsHtml = '';
                if (data.report && data.report.addedItems) {
                    const items = data.report.addedItems;
                    let list = [];

                    if (items.articles && items.articles.length > 0) {
