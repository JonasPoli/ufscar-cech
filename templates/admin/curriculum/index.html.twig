{% extends 'admin/base.html.twig' %}

{% block title %}Currículos Docentes{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                Currículos & Docentes do CECH
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                Gerencie o corpo docente, visualize produções e exporte dados em múltiplos formatos.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <!-- Export Dropdown -->
            <div class="relative inline-block text-left">
                <sl-dropdown>
                    <sl-button slot="trigger" caret variant="default">
                        <sl-icon slot="prefix" name="download"></sl-icon> Exportar Dados
                    </sl-button>
                    <sl-menu>
                        <sl-menu-item value="csv">
                            <a href="{{ path('app_admin_curriculum_export', {'format': 'csv', 'dept': selectedDept}) }}" class="flex items-center gap-2 text-xs">
                                <sl-icon name="filetype-csv"></sl-icon> Exportar para CSV
                            </a>
                        </sl-menu-item>
                        <sl-menu-item value="json">
                            <a href="{{ path('app_admin_curriculum_export', {'format': 'json', 'dept': selectedDept}) }}" class="flex items-center gap-2 text-xs">
                                <sl-icon name="filetype-json"></sl-icon> Exportar para JSON
                            </a>
                        </sl-menu-item>
                        <sl-menu-item value="xml">
                            <a href="{{ path('app_admin_curriculum_export', {'format': 'xml', 'dept': selectedDept}) }}" class="flex items-center gap-2 text-xs">
                                <sl-icon name="filetype-xml"></sl-icon> Exportar para XML
                            </a>
                        </sl-menu-item>
                    </sl-menu>
                </sl-dropdown>
            </div>

            <a href="{{ path('app_admin_curriculum_new') }}" class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-sky-500 transition-colors">
                <sl-icon name="person-plus"></sl-icon> Adicionar Docente (Lattes)
            </a>

            <a href="{{ path('app_admin_curriculum_import') }}" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition-colors">
                <sl-icon name="cloud-arrow-up"></sl-icon> Importar XMLs em Lote
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="glass-card rounded-2xl p-4 shadow-sm">
        <form method="GET" action="{{ path('app_admin_curriculum_index') }}" class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                <div class="relative flex-1 sm:w-80">
                    <input type="text" name="q" value="{{ search }}" placeholder="Buscar por nome, Lattes ID ou ORCID..." class="w-full rounded-xl border border-slate-300 bg-white pl-9 pr-4 py-2 text-xs text-slate-900 placeholder-slate-400 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500 shadow-sm" />
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <sl-icon name="search"></sl-icon>
                    </div>
                </div>

                <select name="dept" onchange="this.form.submit()" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500 shadow-sm">
                    <option value="">Todos os Departamentos</option>
                    {% for d in departments %}
                        <option value="{{ d.code }}" {% if selectedDept == d.code or selectedDept == d.name %}selected{% endif %}>
                            {{ d.name }} ({{ d.code }})
                        </option>
                    {% endfor %}
                </select>

                <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-slate-800 px-3.5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-slate-700 dark:bg-slate-700 dark:hover:bg-slate-600 transition-colors">
                    <sl-icon name="funnel"></sl-icon> Filtrar
                </button>

                {% if selectedDept or search %}
                    <a href="{{ path('app_admin_curriculum_index') }}" class="text-xs text-rose-600 dark:text-rose-400 hover:underline flex items-center gap-1">
                        <sl-icon name="x-circle"></sl-icon> Limpar Filtros
                    </a>
                {% endif %}
            </div>

            <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                Exibindo <span class="font-bold text-slate-700 dark:text-slate-200">{{ researchers|length }}</span> de <span class="font-bold text-slate-700 dark:text-slate-200">{{ totalResearchers }}</span> docentes
            </div>
        </form>
    </div>

    <!-- Table Card -->
    <div class="glass-card rounded-2xl p-6 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs divide-y divide-slate-200 dark:divide-white/10">
                <thead>
                    <tr class="text-slate-500 dark:text-slate-400 font-semibold bg-slate-50/50 dark:bg-slate-900/40">
                        <th class="py-3 px-4">Docente</th>
                        <th class="py-3 px-4">Departamento</th>
                        <th class="py-3 px-4">ID Lattes</th>
                        <th class="py-3 px-4">Produções</th>
                        <th class="py-3 px-4">Orientações</th>
                        <th class="py-3 px-4 text-right">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                    {% for r in researchers %}
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-900/50 transition-colors">
                            <td class="py-3 px-4 text-slate-900 dark:text-white">
                                <div class="flex items-center gap-3">
                                    {% if r.photoUrl %}
                                        <img src="{{ asset(r.photoUrl) }}" alt="{{ r.fullName }}" class="h-9 w-9 rounded-full object-cover ring-2 ring-sky-500/20 shadow-sm shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="h-9 w-9 rounded-full bg-gradient-to-tr from-sky-500 to-indigo-600 text-white font-bold text-xs hidden items-center justify-center shadow-sm shrink-0">
                                            {{ r.fullName|slice(0, 2)|upper }}
                                        </div>
                                    {% else %}
                                        <div class="h-9 w-9 rounded-full bg-gradient-to-tr from-sky-500 to-indigo-600 text-white font-bold text-xs flex items-center justify-center shadow-sm shrink-0">
                                            {{ r.fullName|slice(0, 2)|upper }}
                                        </div>
                                    {% endif %}
                                    <div>
                                        <a href="{{ path('app_admin_curriculum_show', {'id': r.id}) }}" class="hover:text-sky-600 dark:hover:text-sky-400 font-semibold text-slate-900 dark:text-white block">
                                            {{ r.fullName }}
                                        </a>
                                        <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
                                            {% if r.orcid %}
                                                <span class="inline-flex items-center rounded bg-emerald-50 px-1.5 py-0.2 text-[9px] font-bold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
                                                    ORCID: {{ r.orcid }}
                                                </span>
                                            {% endif %}
                                            {% set isActive = (r.status ?? true) and (r.leaveYear is not defined or r.leaveYear is null or r.leaveYear >= date()|date('Y')) %}
                                            {% if isActive %}
                                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-500/20 px-2 py-0.2 text-[9px] font-bold text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300" title="Docente em atividade no CECH">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> {{ r.admissionYear ? 'Desde ' ~ r.admissionYear : 'Ativo no CECH' }}
                                                </span>
                                            {% else %}
                                                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-500/20 px-2 py-0.2 text-[9px] font-bold text-amber-700 dark:bg-amber-950/60 dark:text-amber-300" title="Vínculo encerrado / Docente aposentado">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span> {{ r.admissionYear ? r.admissionYear ~ '–' ~ (r.leaveYear ?: 'Saída') : 'Histórico/Aposentado' }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-4 text-slate-600 dark:text-slate-300">
                                {% if r.departmentCode %}
                                    <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                        {{ r.departmentCode }}
                                    </span>
                                {% else %}
                                    {{ r.department ?: '-' }}
                                {% endif %}
                            </td>
                            <td class="py-3 px-4 font-mono text-slate-500 dark:text-slate-400">
                                <a href="http://lattes.cnpq.br/{{ r.idLattes }}" target="_blank" rel="noopener noreferrer" class="hover:underline text-sky-600">
                                    {{ r.idLattes }}
                                </a>
                            </td>
                            <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-200">
                                {{ r.totalProductions }}
                            </td>
                            <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-200">
                                {{ r.totalOrientations }}
                            </td>
                            <td class="py-3 px-4 text-right space-x-1">
                                <a href="{{ path('app_admin_curriculum_show', {'id': r.id}) }}" class="inline-flex items-center p-1.5 text-slate-600 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400" title="Ver Detalhes">
                                    <sl-icon name="eye"></sl-icon>
                                </a>
                                <a href="{{ path('app_admin_curriculum_pdf', {'id': r.id}) }}" class="inline-flex items-center p-1.5 text-slate-600 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400" title="Gerar PDF">
                                    <sl-icon name="file-earmark-pdf"></sl-icon>
                                </a>
                                <button type="button" onclick="confirmDelete('{{ path('app_admin_curriculum_delete', {'id': r.id}) }}', '{{ csrf_token('delete' ~ r.id) }}', 'Deseja realmente remover o currículo de {{ r.fullName|e('js') }}?')" class="inline-flex items-center p-1.5 text-slate-400 hover:text-rose-600" title="Excluir">
                                    <sl-icon name="trash"></sl-icon>
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-500 dark:text-slate-400">
                                <sl-icon name="search" class="text-3xl text-slate-300 mb-2"></sl-icon>
                                <p class="text-sm font-semibold">Nenhum docente encontrado</p>
                                <p class="text-xs text-slate-400 mt-1">Tente ajustar seus termos de busca ou filtros.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if totalPages > 1 %}
            <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200 dark:border-white/10 pt-4">
                <div class="text-xs text-slate-500 dark:text-slate-400">
                    Página <span class="font-bold text-slate-700 dark:text-slate-200">{{ currentPage }}</span> de <span class="font-bold text-slate-700 dark:text-slate-200">{{ totalPages }}</span>
                </div>
                <div class="flex items-center gap-1.5">
                    {% if currentPage > 1 %}
                        <a href="{{ path('app_admin_curriculum_index', {'page': currentPage - 1, 'dept': selectedDept, 'q': search}) }}" class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                            &laquo; Anterior
                        </a>
                    {% endif %}

                    {% for p in max(1, currentPage - 2)..min(totalPages, currentPage + 2) %}
                        <a href="{{ path('app_admin_curriculum_index', {'page': p, 'dept': selectedDept, 'q': search}) }}" class="rounded-xl px-3 py-1.5 text-xs font-semibold shadow-sm transition-colors {% if p == currentPage %}bg-sky-600 text-white{% else %}border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200{% endif %}">
                            {{ p }}
                        </a>
                    {% endfor %}

                    {% if currentPage < totalPages %}
                        <a href="{{ path('app_admin_curriculum_index', {'page': currentPage + 1, 'dept': selectedDept, 'q': search}) }}" class="rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                            Próxima &raquo;
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
