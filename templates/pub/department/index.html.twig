{% extends 'pub/base.html.twig' %}

{% block title %}Departamentos Acadêmicos | Portal CECH UFSCar{% endblock %}
{% block meta_description %}Conheça a estrutura acadêmica, departamentos e corpo docente do Centro de Educação e Ciências Humanas da Universidade Federal de São Carlos (UFSCar).{% endblock %}
{% block og_title %}Departamentos Acadêmicos do CECH UFSCar{% endblock %}
{% block og_description %}Conheça os departamentos, cursos e corpos docentes que compõem o Centro de Educação e Ciências Humanas da UFSCar.{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="border-b border-slate-200/60 pb-6 dark:border-white/10">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 px-3 py-0.5 text-xs font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300 mb-2">
            <sl-icon name="diagram-3-fill"></sl-icon> Estrutura Acadêmica
        </span>
        <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">
            Departamentos do CECH
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Conheça os departamentos, cursos e corpos docentes que compõem o Centro de Educação e Ciências Humanas.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {% for dept in departments %}
            <a href="{{ path('app_pub_department_show', {'codeOrSlug': dept.departmentCode ?: dept.department}) }}" class="glass-card rounded-3xl p-6 hover:border-sky-500/50 hover:shadow-xl transition-all group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="rounded-xl bg-gradient-to-tr from-sky-600 to-indigo-600 px-3 py-1 text-xs font-extrabold text-white shadow-sm">
                            {{ dept.departmentCode }}
                        </span>
                        <span class="text-xs text-slate-400 font-medium">{{ dept.totalFaculty }} docentes</span>
                    </div>

                    <h2 class="font-heading text-lg font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors leading-snug">
                        {{ dept.department }}
                    </h2>
                </div>

                <div class="mt-6 pt-4 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                    <span class="font-semibold text-slate-700 dark:text-slate-300">{{ dept.totalProductions|number_format(0, ',', '.') }} produções</span>
                    <div class="flex items-center gap-1 font-semibold text-sky-600 dark:text-sky-400 group-hover:translate-x-1 transition-transform">
                        Ver detalhes <sl-icon name="arrow-right"></sl-icon>
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>
</div>
{% endblock %}
