{#
    Rede de coautoria interativa (assets/js/graph.js).

    Variáveis:
      graphId    identificador único na página
      src        URL do JSON do grafo (/api/v1/grafo?…)
      pairSrc    URL das publicações de um par (/api/v1/grafo/par?…), sem a e b
      pairs      pares mais fortes (CoauthorshipGraphService::topPairs), opcional
      morePairs  URL para ver mais pares, opcional
      totalPairs total de pares do recorte, opcional
      heading    título da seção
      limits     opções de quantidade de ligações (rota atual + parâmetro `ligacoes`), opcional: {label: url}
      currentLimit rótulo da opção atual
#}
{% set btn = 'inline-flex h-9 min-w-9 items-center justify-center rounded-lg border border-slate-300 bg-white px-2 text-sm text-slate-700 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800' %}
<section id="{{ graphId }}" class="glass-card rounded-3xl p-4 sm:p-6 space-y-4" aria-labelledby="{{ graphId }}-title"
         data-cech-graph data-src="{{ src }}" data-pair-src="{{ pairSrc }}">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <h2 id="{{ graphId }}-title" class="flex items-center gap-2.5 font-heading text-xl font-bold text-slate-900 dark:text-white">
                <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-cech-blue to-cech-teal text-white shadow-sm" aria-hidden="true"><sl-icon name="diagram-3"></sl-icon></span>
                {{ heading|default('Rede de coautoria') }}
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Clique numa pessoa para ver sua vizinhança e numa ligação para ver as publicações em comum.</p>
        </div>
        {% if limits is defined and limits %}
            <div class="flex items-center gap-2 text-xs">
                <span class="font-semibold text-slate-600 dark:text-slate-300">Ligações exibidas:</span>
                {% for label, url in limits %}
                    <a href="{{ url }}" class="rounded-lg px-2 py-1 {{ label == currentLimit ? 'bg-sky-700 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800' }}" {% if label == currentLimit %}aria-current="true"{% endif %}>{{ label }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div data-graph-frame class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-950 overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-white/10 p-3">
            <div class="flex items-center gap-2 min-w-0">
                <label for="{{ graphId }}-focus" class="text-xs font-semibold text-slate-600 dark:text-slate-300 whitespace-nowrap">Destacar docente</label>
                <select id="{{ graphId }}-focus" data-graph-focus class="max-w-[16rem] rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-white">
                    <option value="">Toda a rede visível</option>
                </select>
            </div>
            <div class="flex items-center gap-1.5" role="toolbar" aria-label="Controles da rede">
                <button type="button" class="{{ btn }}" data-graph-zoom-in aria-label="Ampliar"><sl-icon name="zoom-in"></sl-icon></button>
                <button type="button" class="{{ btn }}" data-graph-zoom-out aria-label="Reduzir"><sl-icon name="zoom-out"></sl-icon></button>
                <button type="button" class="{{ btn }}" data-graph-reset aria-label="Centralizar e limpar a seleção"><sl-icon name="arrow-counterclockwise"></sl-icon></button>
                <button type="button" class="{{ btn }}" data-graph-fullscreen aria-label="Tela cheia"><sl-icon name="arrows-fullscreen"></sl-icon></button>
                <button type="button" class="{{ btn }} text-xs font-semibold" data-graph-names aria-pressed="true">Nomes</button>
            </div>
        </div>
        <div data-graph-info hidden class="border-b border-slate-200 dark:border-white/10 bg-sky-50/70 dark:bg-sky-950/30 px-3 py-2 text-slate-700 dark:text-slate-200"></div>
        <div data-graph-canvas class="h-[480px] sm:h-[560px] w-full" role="img" aria-label="Grafo de coautoria entre docentes do CECH. A lista de pares abaixo traz as mesmas informações em texto."></div>
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 dark:border-white/10 p-3 text-xs text-slate-600 dark:text-slate-300">
            <ul data-graph-legend class="flex flex-wrap gap-x-3 gap-y-1" aria-label="Legenda: departamentos"></ul>
            <p data-graph-status aria-live="polite"></p>
        </div>
    </div>

    {% if pairs is defined and pairs %}
        {% import 'pub/research/_macros.html.twig' as rs %}
        <div class="space-y-3" data-graph-pairs>
            <div class="flex flex-wrap items-end justify-between gap-2">
                <h3 class="font-heading text-base font-bold text-slate-900 dark:text-white" data-graph-pairs-title>
                    Pares que mais publicam juntos{% if totalPairs is defined and totalPairs %} <span class="text-sm font-normal text-slate-500 dark:text-slate-400">({{ totalPairs|number_format(0, ',', '.') }} pares no total)</span>{% endif %}
                </h3>
                <button type="button" data-graph-pairs-reset hidden class="inline-flex items-center gap-1 text-xs font-semibold text-cech-blue hover:underline dark:text-cech-teal">
                    <sl-icon name="x-circle" aria-hidden="true"></sl-icon> Mostrar todos os pares
                </button>
            </div>
            <ol class="grid grid-cols-1 gap-3 md:grid-cols-2" data-graph-pairs-list>
                {% for pair in pairs %}
                    <li>{{ rs.pair_card(pair, loop.index) }}</li>
                {% endfor %}
            </ol>
            <ol class="grid grid-cols-1 gap-3 md:grid-cols-2" data-graph-pairs-focus hidden aria-live="polite"></ol>
            {% if morePairs is defined and morePairs %}
                <a href="{{ morePairs }}" data-graph-pairs-more class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-cech-teal hover:text-cech-blue dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Ver mais pares <sl-icon name="chevron-down" aria-hidden="true"></sl-icon></a>
            {% endif %}
        </div>
    {% endif %}

    <dialog data-graph-dialog aria-labelledby="{{ graphId }}-dialog-title" class="w-[min(48rem,calc(100vw-2rem))] max-h-[85vh] rounded-2xl p-0 shadow-2xl backdrop:bg-slate-950/60 bg-white text-slate-800 dark:bg-slate-900 dark:text-slate-100">
        <div class="sticky top-0 flex items-start justify-between gap-3 border-b border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 px-5 py-4">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-sky-700 dark:text-sky-400">Pesquisa compartilhada</p>
                <h3 id="{{ graphId }}-dialog-title" data-graph-dialog-title class="font-heading text-base font-bold text-slate-900 dark:text-white"></h3>
            </div>
            <button type="button" data-graph-dialog-close class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Fechar"><sl-icon name="x-lg"></sl-icon></button>
        </div>
        <div data-graph-dialog-body class="px-5 pb-5 overflow-y-auto max-h-[70vh]"></div>
    </dialog>
</section>
