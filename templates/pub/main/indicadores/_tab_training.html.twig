{# ══════════════════════════════════════════════════════════════════
   BLOCO 2: FORMAÇÃO DE RECURSOS HUMANOS E ORIENTAÇÕES
   ══════════════════════════════════════════════════════════════════ #}
<div class="indicator-group space-y-6" data-group="training">
    <div class="flex items-center gap-3">
        <div class="h-8 w-1.5 rounded-full bg-emerald-600"></div>
        <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white font-heading">
                2. Formação de Recursos Humanos & Orientações
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Titulações concluídas de mestres e doutores, perfis de estudantes e pirâmide de formação acadêmica.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# Fig 9: Evolução de Titulações (Span 2 cols) #}
        <div class="glass-card rounded-2xl p-6 border border-slate-200/60 dark:border-white/10 shadow-sm lg:col-span-2 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wide">Figura 9</span>
                    <span class="text-xs text-slate-400">Série Histórica 2010–{{ fig7Graduations.years|last }}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white font-heading">
                    Evolução Anual de Orientações Concluídas
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
                    Orientações concluídas por ano discriminadas por nível de titulação acadêmica: Mestrado, Doutorado, Pós-Doutorado e Iniciação Científica (IC).
                </p>
            </div>
            <div class="h-80">
                <canvas id="chartFig7"></canvas>
            </div>
        </div>

        {# Fig 10: Pirâmide de Formação #}
        <div class="glass-card rounded-2xl p-6 border border-slate-200/60 dark:border-white/10 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wide">Figura 10</span>
                    <span class="text-xs text-slate-400">Fluxo</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white font-heading">
                    Pirâmide de Níveis Acadêmicos
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
                    Volume total acumulado de orientações por estágio de formação.
                </p>
            </div>
            <div class="h-80">
                <canvas id="chartFig9"></canvas>
            </div>
        </div>

        {# Fig 11: Formação dos Estudantes Orientados (Span 3 cols) #}
        <div class="glass-card rounded-2xl p-6 border border-slate-200/60 dark:border-white/10 shadow-sm lg:col-span-3 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wide">Figura 11</span>
                    <span class="text-xs text-slate-400">Cursos dos Orientandos</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white font-heading">
                    Principais Cursos e Programas dos Estudantes Orientados
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
                    Distribuição dos estudantes titulados de acordo com o curso ou programa de graduação/pós-graduação.
                </p>
            </div>
            <div class="h-72">
                <canvas id="chartFig5"></canvas>
            </div>
        </div>

    </div>
</div>

<script>
(function() {
    const isDark = document.documentElement.classList.contains('dark');
    const textColor = isDark ? '#cbd5e1' : '#475569';
    const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.05)';

    // ── Fig 9: Evolução Anual de Formação (Stacked Bar) ──
    const fig7Data = {{ fig7Graduations|json_encode|raw }};
    const fig7Colors = {
        'MESTRADO': '#0284c7',
        'DOUTORADO': '#10b981',
        'POS_DOUTORADO': '#f59e0b',
        'INICIACAO_CIENTIFICA': '#6366f1'
    };
    const fig7Datasets = Object.keys(fig7Data.labels).map(k => ({
        label: fig7Data.labels[k],
        data: Object.values(fig7Data.series[k]),
        backgroundColor: fig7Colors[k] || '#64748b',
        borderRadius: 4
    }));

    const elFig7 = document.getElementById('chartFig7');
    if (elFig7) {
        new Chart(elFig7, {
            type: 'bar',
            data: {
                labels: fig7Data.years,
                datasets: fig7Datasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top', labels: { color: textColor, font: { size: 11 }, boxWidth: 12 } }
                },
                scales: {
                    x: { stacked: true, grid: { display: false }, ticks: { color: textColor } },
                    y: { stacked: true, grid: { color: gridColor }, ticks: { color: textColor } }
                }
            }
        });
    }

    // ── Fig 10: Pirâmide de Formação Acadêmica ──
    const fig9Data = {{ fig9Pyramid|json_encode|raw }};
    const elFig9 = document.getElementById('chartFig9');
    if (elFig9) {
        new Chart(elFig9, {
            type: 'bar',
            data: {
                labels: Object.keys(fig9Data),
                datasets: [{
                    label: 'Orientações / Titulações',
                    data: Object.values(fig9Data),
                    backgroundColor: ['#6366f1', '#0284c7', '#14b8a6', '#10b981', '#f59e0b', '#ec4899'],
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: gridColor }, ticks: { color: textColor } },
                    y: { grid: { display: false }, ticks: { color: textColor, font: { size: 11 } } }
                }
            }
        });
    }

    // ── Fig 11: Cursos dos Estudantes Orientados ──
    const fig5Data = {{ fig5StudentsGrad|json_encode|raw }};
    const elFig5 = document.getElementById('chartFig5');
    if (elFig5) {
        new Chart(elFig5, {
            type: 'bar',
            data: {
                labels: fig5Data.map(d => d.courseName),
                datasets: [{
                    label: 'Estudantes Orientados',
                    data: fig5Data.map(d => parseInt(d.total)),
                    backgroundColor: '#10b981',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: textColor, font: { size: 10 }, maxRotation: 45, minRotation: 20 } },
                    y: { grid: { color: gridColor }, ticks: { color: textColor } }
                }
            }
        });
    }
})();
</script>
