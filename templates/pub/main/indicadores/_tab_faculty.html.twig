            nodeElements.append('text')
                .attr('x', d => d.x0 < width / 2 ? d.x1 + 6 : d.x0 - 6)
                .attr('y', d => (d.y1 + d.y0) / 2)
                .attr('dy', '0.35em')
                .attr('text-anchor', d => d.x0 < width / 2 ? 'start' : 'end')
                .attr('fill', isDark ? '#e2e8f0' : '#1e293b')
                .attr('font-size', d => d.value > 10 ? '11px' : '10px')
                .attr('font-weight', d => d.value > 10 ? 'bold' : '500')
                .text(d => {
                    const label = d.name.length > 24 ? d.name.slice(0, 22) + '…' : d.name;
                    return `${label} (${d.value})`;
                });

            nodeElements.on('mouseenter', (event, d) => {
                if (!tooltip) return;
                const totalM = records.length;
                const pct = totalM > 0 ? Math.round((d.value / totalM) * 100) : 0;
                const stageLabels = ['Origem no CECH', 'Esfera Institucional', 'Instituição de Destino'];

                tooltip.innerHTML = `
                    <div class="font-bold text-sm text-white mb-1 flex items-center justify-between gap-2">
                        <span>${d.name}</span>
                        <span class="text-[10px] px-2 py-0.5 rounded bg-indigo-500/30 text-indigo-200 border border-indigo-400/40">${stageLabels[d.stage]}</span>
                    </div>
                    <div class="border-t border-slate-700/80 pt-2 text-slate-300 space-y-1 font-mono text-xs">
                        <div class="flex justify-between gap-4">
                            <span>Pesquisadores:</span>
                            <strong class="text-emerald-400 font-bold">${d.value} (${pct}%)</strong>
                        </div>
                    </div>
                `;
                tooltip.classList.remove('hidden');
                linkElements.attr('stroke-opacity', l => (l.source === d || l.target === d) ? 0.85 : 0.08);
            })
            .on('mousemove', (event) => {
                if (!tooltip) return;
                const [mouseX, mouseY] = d3.pointer(event, container);
                tooltip.style.left = `${Math.min(width - 240, mouseX + 16)}px`;
                tooltip.style.top = `${Math.max(10, mouseY - 30)}px`;
            })
            .on('mouseleave', () => {
                if (tooltip) tooltip.classList.add('hidden');
                linkElements.attr('stroke-opacity', 0.45);
            });
        }

        function applyFilters() {
            const selDept = deptFilter ? deptFilter.value : 'all';
            const selCat = catFilter ? catFilter.value : 'all';

            currentFilteredRecords = allRecords.filter(r => {
                const matchDept = selDept === 'all' || r.department === selDept;
                const matchCat = selCat === 'all' || r.institutionCategory === selCat;
                return matchDept && matchCat;
            });

            updateKpis(currentFilteredRecords);
            filterRanking(currentFilteredRecords);
            filterTable();
            renderSankey();
        }

        // View Mode Switcher
        viewBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                viewBtns.forEach(b => {
                    b.classList.remove('bg-white', 'dark:bg-slate-800', 'text-indigo-600', 'dark:text-indigo-400', 'shadow-xs');
                    b.classList.add('text-slate-600', 'dark:text-slate-400');
                });
                btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-indigo-600', 'dark:text-indigo-400', 'shadow-xs');
                btn.classList.remove('text-slate-600', 'dark:text-slate-400');

                const view = btn.dataset.view;
                const containers = document.querySelectorAll('.fig17-view-container');
                containers.forEach(c => c.classList.add('hidden'));

                if (view === 'sankey') {
                    const c = document.getElementById('fig17ViewSankeyContainer');
                    if (c) c.classList.remove('hidden');
                    renderSankey();
                } else if (view === 'ranking') {
                    const c = document.getElementById('fig17ViewRankingContainer');
                    if (c) c.classList.remove('hidden');
                } else if (view === 'table') {
                    const c = document.getElementById('fig17ViewTableContainer');
                    if (c) c.classList.remove('hidden');
                }
            });
        });

        if (deptFilter) deptFilter.addEventListener('change', applyFilters);
        if (catFilter) catFilter.addEventListener('change', applyFilters);
        if (resetBtn) {
            resetBtn.addEventListener('click', () => {
                if (deptFilter) deptFilter.value = 'all';
                if (catFilter) catFilter.value = 'all';
                if (tableSearch) tableSearch.value = '';
                applyFilters();
            });
        }

        function filterTable() {
            const query = tableSearch ? tableSearch.value.trim().toLowerCase() : '';
            const selectedDept = deptFilter ? deptFilter.value.toLowerCase() : 'all';
            const selectedCat = catFilter ? catFilter.value.toLowerCase() : 'all';

            let visibleCount = 0;

            tableRows.forEach(row => {
                const name = row.dataset.name || '';
                const dept = row.dataset.dept || '';
                const inst = row.dataset.inst || '';
                const cat = row.dataset.cat || '';
                const role = row.dataset.role || '';

                const matchQuery = query === '' || name.includes(query) || dept.includes(query) || inst.includes(query) || cat.includes(query) || role.includes(query);
                const matchDept = selectedDept === 'all' || dept === selectedDept;
                const matchCat = selectedCat === 'all' || cat === selectedCat;

                if (matchQuery && matchDept && matchCat) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (tableCountBadge) {
                tableCountBadge.textContent = `Exibindo ${visibleCount} de ${allRecords.length} pesquisadores`;
            }
        }

        if (tableSearch) {
            tableSearch.addEventListener('input', filterTable);
        }

        renderSankey();

        if (window.ResizeObserver) {
            let resizeTimer;
            new ResizeObserver(() => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(renderSankey, 150);
            }).observe(container);
        }
    })();
    }

    window.initTabFaculty = initTabFaculty;

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTabFaculty);
    } else {
        initTabFaculty();
    }
})();
</script>
