                                    <th scope="col" class="py-3 px-4">Ano Saída</th>
                                    <th scope="col" class="py-3 px-4">Instituição de Destino</th>
                                    <th scope="col" class="py-3 px-4">Esfera / Tipo</th>
                                    <th scope="col" class="py-3 px-4">Cargo / Função</th>
                                    <th scope="col" class="py-3 px-4">Período</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 bg-white/40 dark:bg-slate-900/40 text-slate-700 dark:text-slate-300">
                                {% for r in fig17Exits.records %}
                                    <tr class="fig17-table-row hover:bg-slate-50 dark:hover:bg-slate-800/40 transition" 
                                        data-name="{{ r.name|lower }}" 
                                        data-dept="{{ r.department|lower }}" 
                                        data-inst="{{ r.destinationInstitution|lower }}" 
                                        data-cat="{{ r.institutionCategory|lower }}"
                                        data-role="{{ r.role|lower }}">
                                        <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">
                                            <a href="{{ path('app_pub_professor_show', {'slugOrId': r.slug}) }}" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition inline-flex items-center gap-1.5">
                                                <sl-icon name="person" class="text-indigo-500"></sl-icon>
                                                {{ r.name }}
                                            </a>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                                {{ r.department }}
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 font-mono font-medium">
                                            {{ r.leaveYear ?: '–' }}
                                        </td>
                                        <td class="py-3 px-4 font-bold text-indigo-700 dark:text-indigo-300">
                                            {{ r.destinationInstitution }}
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-medium
                                                {% if 'Paulista' in r.institutionCategory %}bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300
                                                {% elseif 'Federal' in r.institutionCategory %}bg-cyan-50 text-cyan-700 dark:bg-cyan-950/60 dark:text-cyan-300
                                                {% elseif 'Internacional' in r.institutionCategory %}bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300
                                                {% elseif 'Órgão' in r.institutionCategory %}bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300
                                                {% else %}bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300{% endif %}">
                                                {{ r.institutionCategory }}
