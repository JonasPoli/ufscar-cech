            const filteredRecords = allRecords.filter(r => {
                if (r.destinationInstitution === 'Não mapeado / Aposentado') return false;
                const matchDept = selectedDept === 'all' || r.department === selectedDept;
                const matchCat = selectedCat === 'all' || r.institutionCategory === selectedCat;
                return matchDept && matchCat;
            });

            const totalFiltered = filteredRecords.length;

            // Atualizar KPIs no cabeçalho dinamicamente
            if (kpiTotal) {
                kpiTotal.innerHTML = `${totalFiltered} <span class="text-xs font-normal text-slate-400">/ ${initialTotalExits}</span>`;
            }
            if (totalFiltered > 0) {
                const publicCount = filteredRecords.filter(r => ['Estadual Paulista (USP/UNESP/UNICAMP)', 'Universidade Federal (IFES)', 'Universidade Estadual (Outros Estados)'].includes(r.institutionCategory)).length;
                const outStateCount = filteredRecords.filter(r => r.institutionCategory === 'Universidade Estadual (Outros Estados)' || r.institutionCategory === 'Instituição Internacional / Exterior' || ['UFMS', 'UFRGS', 'UFSC', 'UFF', 'UnB', 'UFPR', 'UFPE', 'UFAL', 'UFPB', 'UNILAB', 'UEM', 'UDESC', 'UNIOESTE', 'UERN'].includes(r.destinationInstitution)).length;
                if (kpiPublic) kpiPublic.textContent = Math.round((publicCount / totalFiltered) * 100) + '%';
                if (kpiOutState) kpiOutState.innerHTML = `${outStateCount} <span class="text-xs font-normal">(${Math.round((outStateCount / totalFiltered) * 100)}%)</span>`;
            }

            if (totalFiltered === 0) {
                container.innerHTML = `
                    <div class="flex flex-col items-center justify-center h-80 text-center text-slate-400">
                        <sl-icon name="info-circle" class="text-4xl mb-3 text-slate-300 dark:text-slate-600"></sl-icon>
                        <div class="font-bold text-sm text-slate-600 dark:text-slate-300">Nenhum docente encontrado para os filtros selecionados.</div>
                        <div class="text-xs mt-1">Tente selecionar outro departamento ou categoria institucional.</div>
                    </div>
                `;
                return;
            }

            // Construir nós e links para as 3 camadas
            const layer1To2 = new Map(); // Dept -> Cat
            const layer2To3 = new Map(); // Cat -> Inst

            filteredRecords.forEach(r => {
                const d = r.department;
                const c = r.institutionCategory;
                const i = r.destinationInstitution;

                const k1 = `${d}|||${c}`;
                if (!layer1To2.has(k1)) {
                    layer1To2.set(k1, { source: d, target: c, value: 0, researchers: [] });
                }
                const l1 = layer1To2.get(k1);
                l1.value++;
                l1.researchers.push(`${r.name} (${r.leaveYear || '–'})`);

                const k2 = `${c}|||${i}`;
                if (!layer2To3.has(k2)) {
                    layer2To3.set(k2, { source: c, target: i, value: 0, researchers: [] });
                }
                const l2 = layer2To3.get(k2);
                l2.value++;
                l2.researchers.push(`${r.name} (${r.leaveYear || '–'}, ${d})`);
            });

            const nodesMap = new Map();
            const nodeIndex = new Map();
            let idx = 0;

            function registerNode(name, type) {
                if (!nodesMap.has(name)) {
                    nodesMap.set(name, { id: name, name: name, type: type });
                    nodeIndex.set(name, idx++);
                }
            }

            layer1To2.forEach(l => {
                registerNode(l.source, 'department');
                registerNode(l.target, 'category');
            });
            layer2To3.forEach(l => {
                registerNode(l.source, 'category');
                registerNode(l.target, 'institution');
            });

            const nodes = Array.from(nodesMap.values());
            const links = [];

            layer1To2.forEach(l => {
                links.push({
                    source: nodeIndex.get(l.source),
                    target: nodeIndex.get(l.target),
                    value: l.value,
                    sourceName: l.source,
                    targetName: l.target,
                    researchers: l.researchers
                });
            });

            layer2To3.forEach(l => {
                links.push({
                    source: nodeIndex.get(l.source),
                    target: nodeIndex.get(l.target),
                    value: l.value,
                    sourceName: l.source,
                    targetName: l.target,
                    researchers: l.researchers
                });
            });

            // Layout D3 Sankey
            const sankeyLayout = d3.sankey()
                .nodeId(d => d.index)
                .nodeWidth(isMobile ? 14 : 20)
                .nodePadding(isMobile ? 10 : 12)
                .extent([[10, 15], [width - (isMobile ? 10 : 25), height - 15]]);

            const graph = sankeyLayout({
                nodes: nodes.map(d => Object.assign({}, d)),
                links: links.map(d => Object.assign({}, d))
            });

            // Criar SVG
            const svg = d3.select(container)
                .append('svg')
                .attr('viewBox', `0 0 ${width} ${height}`)
                .attr('width', '100%')
                .attr('height', height)
                .attr('class', 'overflow-visible font-sans select-none');

            // Definição de gradientes para os links
            const defs = svg.append('defs');
            graph.links.forEach((link, i) => {
                const gradId = `fig17-link-grad-${i}`;
                const grad = defs.append('linearGradient')
                    .attr('id', gradId)
                    .attr('gradientUnits', 'userSpaceOnUse')
                    .attr('x1', link.source.x1)
                    .attr('x2', link.target.x0);

                const c1 = getNodeColor(link.source.name, link.source.type);
                const c2 = getNodeColor(link.target.name, link.target.type);

                grad.append('stop').attr('offset', '0%').attr('stop-color', c1).attr('stop-opacity', 0.55);
                grad.append('stop').attr('offset', '100%').attr('stop-color', c2).attr('stop-opacity', 0.55);
                link.gradientId = gradId;
            });

            // Camada de Links
            const linkGroup = svg.append('g')
                .attr('fill', 'none')
                .selectAll('path')
                .data(graph.links)
                .join('path')
                .attr('d', d3.sankeyLinkHorizontal())
                .attr('stroke', d => `url(#${d.gradientId})`)
                .attr('stroke-width', d => Math.max(2, d.width))
                .attr('stroke-opacity', isDark ? 0.65 : 0.5)
                .attr('class', 'transition-all duration-200 cursor-pointer')
                .style('mix-blend-mode', isDark ? 'screen' : 'multiply');

            // Camada de Nós
            const nodeGroup = svg.append('g')
                .selectAll('g')
                .data(graph.nodes)
                .join('g')
                .attr('class', 'cursor-pointer group');

            // Retângulos dos nós
            nodeGroup.append('rect')
                .attr('x', d => d.x0)
                .attr('y', d => d.y0)
                .attr('height', d => Math.max(3, d.y1 - d.y0))
                .attr('width', d => d.x1 - d.x0)
                .attr('rx', 4)
                .attr('fill', d => getNodeColor(d.name, d.type))
                .attr('stroke', isDark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.1)')
                .attr('stroke-width', 1)
                .attr('class', 'transition-all duration-200 shadow-sm');

            // Rótulos de texto dos nós
            nodeGroup.append('text')
                .attr('x', d => d.x0 < width / 2 ? d.x1 + 8 : d.x0 - 8)
                .attr('y', d => (d.y1 + d.y0) / 2)
                .attr('dy', '0.35em')
                .attr('text-anchor', d => d.x0 < width / 2 ? 'start' : 'end')
                .attr('fill', isDark ? '#f1f5f9' : '#0f172a')
                .attr('font-size', isMobile ? '10px' : '11px')
                .attr('font-weight', '600')
                .text(d => `${d.name} (${d.value})`)
                .attr('class', 'pointer-events-none');

            // ── Eventos de Hover & Tooltip ──
            linkGroup
                .on('mouseenter', (event, d) => {
                    linkGroup.attr('stroke-opacity', 0.15);
                    d3.select(event.currentTarget)
                        .attr('stroke-opacity', 0.95)
                        .attr('stroke-width', Math.max(3, d.width + 2));

                    if (tooltip) {
                        const resListHtml = d.researchers.slice(0, 10).map(r => `<li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>${r}</li>`).join('');
                        const extraCount = d.researchers.length > 10 ? `<li class="text-[10px] text-slate-400 italic font-normal mt-1">+${d.researchers.length - 10} outros docentes</li>` : '';

                        tooltip.innerHTML = `
                            <div class="flex items-center justify-between border-b border-slate-700/60 pb-1.5 mb-2">
                                <span class="font-bold text-indigo-400 uppercase text-[10px] tracking-wide">Fluxo de Mobilidade</span>
                                <span class="font-extrabold text-white text-xs bg-indigo-600/80 px-2 py-0.5 rounded-full">${d.value} ${d.value === 1 ? 'docente' : 'docentes'}</span>
                            </div>
                            <div class="text-xs mb-2 font-medium text-slate-200">
                                <strong>${d.source.name}</strong> ➔ <strong>${d.target.name}</strong>
                            </div>
                            <div class="text-[11px] font-semibold text-slate-400 mb-1">Pesquisadores vinculados:</div>
                            <ul class="space-y-1 text-slate-300 text-[11px]">
                                ${resListHtml}
                                ${extraCount}
                            </ul>
                        `;
                        tooltip.classList.remove('hidden');
                    }
                })
                .on('mousemove', (event) => {
                    if (tooltip) {
                        const wrapperRect = container.getBoundingClientRect();
                        const x = event.clientX - wrapperRect.left + 15;
                        const y = event.clientY - wrapperRect.top - 10;
                        tooltip.style.left = `${Math.min(x, wrapperRect.width - 290)}px`;
                        tooltip.style.top = `${Math.max(10, y)}px`;
                    }
                })
                .on('mouseleave', () => {
                    linkGroup.attr('stroke-opacity', isDark ? 0.65 : 0.5)
                        .attr('stroke-width', d => Math.max(2, d.width));
                    if (tooltip) tooltip.classList.add('hidden');
                });

            nodeGroup
                .on('mouseenter', (event, d) => {
                    const connectedLinks = linkGroup.filter(l => l.source.index === d.index || l.target.index === d.index);
                    linkGroup.attr('stroke-opacity', 0.12);
                    connectedLinks.attr('stroke-opacity', 0.95);

                    if (tooltip) {
                        const typeLabel = d.type === 'department' ? 'Departamento de Origem' : (d.type === 'category' ? 'Esfera Institucional' : 'Instituição de Destino');
                        
                        // Coletar nomes dos pesquisadores vinculados a este nó
                        const connectedResearchers = new Set();
                        d.sourceLinks.forEach(l => l.researchers.forEach(r => connectedResearchers.add(r)));
                        d.targetLinks.forEach(l => l.researchers.forEach(r => connectedResearchers.add(r)));
                        const resArray = Array.from(connectedResearchers);

                        const resListHtml = resArray.slice(0, 10).map(r => `<li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>${r}</li>`).join('');
                        const extraCount = resArray.length > 10 ? `<li class="text-[10px] text-slate-400 italic font-normal mt-1">+${resArray.length - 10} outros docentes</li>` : '';

                        tooltip.innerHTML = `
                            <div class="flex items-center justify-between border-b border-slate-700/60 pb-1.5 mb-2">
                                <span class="font-bold text-indigo-400 uppercase text-[10px] tracking-wide">${typeLabel}</span>
                                <span class="font-extrabold text-white text-xs bg-indigo-600/80 px-2 py-0.5 rounded-full">${d.value} ${d.value === 1 ? 'docente' : 'docentes'}</span>
                            </div>
                            <div class="text-sm font-bold text-white mb-2">${d.name}</div>
                            <div class="text-[11px] font-semibold text-slate-400 mb-1">Docentes participantes:</div>
                            <ul class="space-y-1 text-slate-300 text-[11px]">
                                ${resListHtml}
                                ${extraCount}
                            </ul>
                        `;
                        tooltip.classList.remove('hidden');
                    }
                })
                .on('mousemove', (event) => {
                    if (tooltip) {
                        const wrapperRect = container.getBoundingClientRect();
                        const x = event.clientX - wrapperRect.left + 15;
                        const y = event.clientY - wrapperRect.top - 10;
                        tooltip.style.left = `${Math.min(x, wrapperRect.width - 290)}px`;
                        tooltip.style.top = `${Math.max(10, y)}px`;
                    }
                })
                .on('mouseleave', () => {
                    linkGroup.attr('stroke-opacity', isDark ? 0.65 : 0.5);
                    if (tooltip) tooltip.classList.add('hidden');
                });
        }

        // ── 3. Filtros Interativos (Departamento & Categoria) ──
        function applyFilters() {
            const selectedDept = deptFilter ? deptFilter.value : 'all';
            const selectedCat = catFilter ? catFilter.value : 'all';

            // Filtrar ranking cards
            rankingCards.forEach(card => {
                const cardCat = card.dataset.category || '';
                const matchCat = selectedCat === 'all' || cardCat === selectedCat;
                card.style.display = matchCat ? 'block' : 'none';
            });

            // Filtrar linhas da tabela
            filterTable();

            // Re-renderizar Sankey
            renderSankey();
        }

        if (deptFilter) deptFilter.addEventListener('change', applyFilters);
        if (catFilter) catFilter.addEventListener('change', applyFilters);

        if (resetBtn) {
            resetBtn.addEventListener('click', () => {
                if (deptFilter) deptFilter.value = 'all';
                if (catFilter) catFilter.value = 'all';
                if (tableSearch) tableSearch.value = '';
                applyFilters();
            });
        }

        // ── 4. Busca Instantânea na Tabela ──
        function filterTable() {
            const query = tableSearch ? tableSearch.value.trim().toLowerCase() : '';
            const selectedDept = deptFilter ? deptFilter.value.toLowerCase() : 'all';
            const selectedCat = catFilter ? catFilter.value.toLowerCase() : 'all';

            let visibleCount = 0;

            tableRows.forEach(row => {
                const name = row.dataset.name || '';
                const dept = row.dataset.dept || '';
                const inst = row.dataset.inst || '';
                const cat = row.dataset.cat || '';
                const role = row.dataset.role || '';

                const matchQuery = query === '' || name.includes(query) || dept.includes(query) || inst.includes(query) || cat.includes(query) || role.includes(query);
                const matchDept = selectedDept === 'all' || dept === selectedDept;
                const matchCat = selectedCat === 'all' || cat === selectedCat;

                if (matchQuery && matchDept && matchCat) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (tableCountBadge) {
                tableCountBadge.textContent = `Exibindo ${visibleCount} de ${allRecords.length} pesquisadores`;
            }
        }

        if (tableSearch) {
            tableSearch.addEventListener('input', filterTable);
        }

        // Renderização inicial
        renderSankey();

        // Observer para redimensionamento responsivo
        if (window.ResizeObserver) {
            let resizeTimer;
            new ResizeObserver(() => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(renderSankey, 150);
            }).observe(container);
        } else {
            window.addEventListener('resize', renderSankey);
        }
    })();
});
</script>
{% endblock %}
