{# ── D3.js v7 & D3-Sankey Libraries ── #}
<script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-sankey@0.12.3/dist/d3-sankey.min.js"></script>

{# ── Chart Configurations and Interactive Scripts ── #}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const textColor = isDark ? '#cbd5e1' : '#475569';
    const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.05)';
    const palette = ['#0284c7', '#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#14b8a6', '#f97316', '#06b6d4', '#64748b', '#84cc16', '#a855f7'];

    // ── Tab filter handling ──
    const tabBtns = document.querySelectorAll('.tab-btn');
    const groups = document.querySelectorAll('.indicator-group');

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(b => {
                b.classList.remove('bg-primary-600', 'text-white', 'shadow-sm');
                b.classList.add('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');
            });
            btn.classList.add('bg-primary-600', 'text-white', 'shadow-sm');
            btn.classList.remove('bg-slate-100', 'text-slate-700', 'dark:bg-slate-800', 'dark:text-slate-300');

            const target = btn.dataset.tab;
            groups.forEach(g => {
                if (target === 'all' || g.dataset.group === target) {
                    g.style.display = 'block';
                } else {
                    g.style.display = 'none';
                }
            });
        });
    });

    // ── Fig 1: Vínculos Departamentais ──
    const fig1Data = {{ fig1Dept|json_encode|raw }};
    const fig1DeptColors = ['#0284c7', '#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#14b8a6', '#f97316', '#06b6d4', '#84cc16', '#e11d48', '#64748b'];

    new Chart(document.getElementById('chartFig1'), {
        type: 'bar',
        data: {
            labels: fig1Data.map(d => d.deptCode),
            datasets: [{
                label: 'Docentes',
                data: fig1Data.map(d => parseInt(d.total)),
                backgroundColor: fig1Data.map((d, i) => fig1DeptColors[i % fig1DeptColors.length]),
                borderRadius: 6
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        title: (items) => {
                            const item = fig1Data[items[0].dataIndex];
                            return item.deptName ? `${item.deptName} (${item.deptCode})` : items[0].label;
                        },
                        label: (item) => `${item.raw} docentes vinculados`
                    }
                }
            },
            scales: {
                x: { grid: { color: gridColor }, ticks: { color: textColor } },
                y: { grid: { display: false }, ticks: { color: textColor, font: { weight: 'bold', size: 11 } } }
            }
        }
    });

    // ── Fig 2: Formação de Graduação do Corpo Docente ──
    (function initFig2ObservableChart() {
        const container = document.getElementById('chartFig2');
        const tooltip = document.getElementById('chartFig2Tooltip');
        const pillsContainer = document.getElementById('fig2PillsContainer');
        if (!container || typeof d3 === 'undefined') return;

        // Dados brutos e paleta oficial por Grande Área do Conhecimento
        const dados = {{ fig2Grad|json_encode|raw }};
        const cores = {
            "Ciências Sociais Aplicadas": "#72B544",
            "Ciências Humanas": "#E86F8A",
            "Engenharias": "#F2C94C",
            "Ciências Exatas e da Terra": "#6C63B5",
            "Linguística, Letras e Artes": "#52B8A6",
            "Ciências da Saúde": "#5AA9E6",
            "Ciências Agrárias": "#9ACD32",
            "Ciências Biológicas": "#38BDF8",
            "Outras": "#9E9E9E"
        };

        // Ordem canônica de apresentação das Grandes Áreas
        const areaOrder = [
            "Ciências Humanas",
            "Ciências Sociais Aplicadas",
            "Linguística, Letras e Artes",
            "Engenharias",
            "Ciências Exatas e da Terra",
            "Ciências da Saúde",
            "Ciências Biológicas",
            "Ciências Agrárias",
            "Outras"
        ];

        // Agrupamento por área
        const groupedMap = new Map();
        dados.forEach(d => {
            const area = d.area || "Outras";
            if (!groupedMap.has(area)) groupedMap.set(area, []);
            groupedMap.get(area).push({
                area: area,
                formacao: d.formacao,
                quantidade: parseInt(d.quantidade, 10) || 0
            });
        });

        const groups = [];
        areaOrder.forEach(areaName => {
            if (groupedMap.has(areaName)) {
                const items = groupedMap.get(areaName);
                // Ordenação dentro da área: 1) quantidade decrescente, 2) alfabética
                items.sort((a, b) => b.quantidade - a.quantidade || a.formacao.localeCompare(b.formacao, 'pt-BR'));
                groups.push({
                    area: areaName,
                    color: cores[areaName] || "#9E9E9E",
                    total: items.reduce((acc, c) => acc + c.quantidade, 0),
                    items: items
                });
                groupedMap.delete(areaName);
            }
        });
        // Áreas restantes
        groupedMap.forEach((items, areaName) => {
            items.sort((a, b) => b.quantidade - a.quantidade || a.formacao.localeCompare(b.formacao, 'pt-BR'));
            groups.push({
                area: areaName,
                color: cores[areaName] || "#9E9E9E",
                total: items.reduce((acc, c) => acc + c.quantidade, 0),
                items: items
            });
        });

        // Preenchimento dos badges de resumo por Grande Área no cabeçalho
        if (pillsContainer && pillsContainer.children.length === 0) {
            groups.forEach(g => {
                const pill = document.createElement('span');
                pill.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border transition shadow-xs';
                pill.style.borderColor = g.color + '66';
                pill.style.backgroundColor = g.color + '15';
                pill.style.color = isDark ? '#f8fafc' : '#1e293b';
                pill.innerHTML = `<span class="w-2 h-2 rounded-full inline-block" style="background-color: ${g.color}"></span> ${g.area} <span class="opacity-75 text-[10px]">(${g.total})</span>`;
                pillsContainer.appendChild(pill);
            });
        }

        function render() {
            container.innerHTML = '';
            const width = container.clientWidth || 900;
            const isMobile = width < 640;
            const isTablet = width >= 640 && width < 1024;

            const marginLeft = isMobile ? 140 : (isTablet ? 220 : 250);
            const marginRight = isMobile ? 36 : 50;
            const marginTop = 42;
            const marginBottom = 20;

            const barHeight = isMobile ? 18 : 22;
            const barGap = isMobile ? 6 : 7;
            const groupHeaderHeight = isMobile ? 32 : 36;
            const groupGap = isMobile ? 18 : 24;

            // Escala Compartilhada Global Unificada (0 até max de toda a base)
            const globalMax = d3.max(dados, d => parseInt(d.quantidade, 10)) || 10;
            const xScale = d3.scaleLinear()
                .domain([0, globalMax])
                .nice()
                .range([marginLeft, width - marginRight]);

            // Montagem do layout linear com cálculo de coordenadas Y
            let currentY = marginTop;
            const layoutItems = [];

            groups.forEach((group, gIdx) => {
                layoutItems.push({
                    type: 'header',
                    area: group.area,
                    color: group.color,
                    total: group.total,
                    count: group.items.length,
                    y: currentY,
                    gIdx: gIdx
                });
                currentY += groupHeaderHeight;

                group.items.forEach((item, iIdx) => {
                    layoutItems.push({
                        type: 'bar',
                        area: item.area,
                        formacao: item.formacao,
                        quantidade: item.quantidade,
                        color: group.color,
                        y: currentY,
                        height: barHeight,
                        iIdx: iIdx
                    });
                    currentY += barHeight + barGap;
                });

                currentY += groupGap;
            });

            const totalHeight = currentY + marginBottom;

            const svg = d3.select(container)
                .append('svg')
                .attr('viewBox', `0 0 ${width} ${totalHeight}`)
                .attr('width', '100%')
                .attr('height', totalHeight)
                .style('display', 'block')
                .style('font-family', "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif");

            const isDarkMode = document.documentElement.classList.contains('dark');
            const axisColor = isDarkMode ? 'rgba(255,255,255,0.12)' : '#e2e8f0';
            const gridLineColor = isDarkMode ? 'rgba(255,255,255,0.06)' : '#f1f5f9';
            const labelTextColor = isDarkMode ? '#cbd5e1' : '#334155';
            const subTextColor = isDarkMode ? '#94a3b8' : '#64748b';
            const headerTextColor = isDarkMode ? '#f8fafc' : '#0f172a';

            // 1. Grade Vertical Discreta e Eixo X Superior
            const tickCount = isMobile ? 4 : 8;
            const ticks = xScale.ticks(tickCount);

            const gridGroup = svg.append('g').attr('class', 'grid-lines');
            ticks.forEach(t => {
                const tx = xScale(t);

                // Linha vertical estendendo-se por todos os grupos
                gridGroup.append('line')
                    .attr('x1', tx)
                    .attr('x2', tx)
                    .attr('y1', marginTop - 15)
                    .attr('y2', currentY - groupGap)
                    .attr('stroke', gridLineColor)
                    .attr('stroke-width', 1);

                // Rótulo numérico no eixo superior
                gridGroup.append('text')
                    .attr('x', tx)
                    .attr('y', marginTop - 20)
                    .attr('text-anchor', 'middle')
                    .attr('font-size', isMobile ? '10px' : '11px')
                    .attr('font-weight', '600')
                    .attr('fill', subTextColor)
                    .text(t);
            });

            // Linha base do eixo superior
            gridGroup.append('line')
                .attr('x1', marginLeft)
                .attr('x2', width - marginRight)
                .attr('y1', marginTop - 12)
                .attr('y2', marginTop - 12)
                .attr('stroke', axisColor)
                .attr('stroke-width', 1);

            // 2. Renderização de Grupos, Rótulos e Barras
            layoutItems.forEach(item => {
                if (item.type === 'header') {
                    const headerG = svg.append('g').attr('class', 'group-header');

                    // Linha divisória sutil entre grupos
                    if (item.gIdx > 0) {
                        headerG.append('line')
                            .attr('x1', isMobile ? 10 : 20)
                            .attr('x2', width - marginRight + 20)
                            .attr('y1', item.y - (groupGap / 2))
                            .attr('y2', item.y - (groupGap / 2))
                            .attr('stroke', isDarkMode ? 'rgba(255,255,255,0.06)' : '#e2e8f0')
                            .attr('stroke-dasharray', '3,3');
                    }

                    // Marcador Circular Colorido (●)
                    headerG.append('circle')
                        .attr('cx', isMobile ? 12 : marginLeft - 16)
                        .attr('cy', item.y + 14)
                        .attr('r', isMobile ? 4 : 5)
                        .attr('fill', item.color);

                    // Título da Grande Área
                    const titleText = headerG.append('text')
                        .attr('x', isMobile ? 22 : marginLeft)
                        .attr('y', item.y + 18)
                        .attr('font-size', isMobile ? '11px' : '12.5px')
                        .attr('font-weight', '800')
                        .attr('letter-spacing', '0.05em')
                        .attr('fill', headerTextColor)
                        .text(item.area.toUpperCase());

                    // Subtítulo descritivo com contagem
                    titleText.append('tspan')
                        .attr('font-size', isMobile ? '10px' : '11px')
                        .attr('font-weight', '500')
                        .attr('fill', subTextColor)
                        .text(`  (${item.total} docente${item.total > 1 ? 's' : ''} · ${item.count} formaç${item.count > 1 ? 'ões' : 'ão'})`);

                } else if (item.type === 'bar') {
                    const barG = svg.append('g')
                        .attr('class', 'bar-row')
                        .style('cursor', 'pointer');

                    const barWidth = Math.max(3, xScale(item.quantidade) - marginLeft);
                    const labelX = marginLeft - 12;
                    const labelY = item.y + (item.height / 2);

                    // Rótulo da formação à esquerda
                    const textElem = barG.append('text')
                        .attr('x', labelX)
                        .attr('y', labelY)
                        .attr('text-anchor', 'end')
                        .attr('dominant-baseline', 'central')
                        .attr('font-size', isMobile ? '10px' : '11.5px')
                        .attr('font-weight', '500')
                        .attr('fill', labelTextColor);

                    // Quebra de linha inteligente para formações com nomes longos no mobile/desktop
                    const maxChars = isMobile ? 20 : (isTablet ? 28 : 34);
                    if (item.formacao.length > maxChars && item.formacao.includes(' ')) {
                        const words = item.formacao.split(' ');
                        const half = Math.ceil(words.length / 2);
                        const line1 = words.slice(0, half).join(' ');
                        const line2 = words.slice(half).join(' ');

                        textElem.attr('dominant-baseline', 'auto');
                        textElem.append('tspan')
                            .attr('x', labelX)
                            .attr('dy', isMobile ? '-0.4em' : '-0.3em')
                            .text(line1);
                        textElem.append('tspan')
                            .attr('x', labelX)
                            .attr('dy', isMobile ? '1.1em' : '1.1em')
                            .text(line2);
                    } else {
                        textElem.text(item.formacao);
                    }

                    // Barra Horizontal Sólida com cantos arredondados
                    const barRect = barG.append('rect')
                        .attr('x', marginLeft)
                        .attr('y', item.y)
                        .attr('width', barWidth)
                        .attr('height', item.height)
                        .attr('rx', 4)
                        .attr('ry', 4)
                        .attr('fill', item.color)
                        .attr('opacity', 0.95)
                        .style('transition', 'opacity 0.15s ease, filter 0.15s ease');

                    // Valor numérico inteiro ao final da barra
                    barG.append('text')
                        .attr('x', marginLeft + barWidth + 8)
                        .attr('y', labelY)
                        .attr('text-anchor', 'start')
                        .attr('dominant-baseline', 'central')
                        .attr('font-size', isMobile ? '10.5px' : '11.5px')
                        .attr('font-weight', '700')
                        .attr('fill', labelTextColor)
                        .text(item.quantidade);

                    // Interatividade: Destaque e Tooltip no Hover
                    barG.on('mouseenter', (event) => {
                        barRect.attr('opacity', 1).style('filter', 'brightness(1.1)');

                        if (tooltip) {
                            tooltip.innerHTML = `
                                <div class="font-bold text-sm text-white">${item.formacao}</div>
                                <div class="mt-1 flex items-center gap-1.5 text-xs text-slate-300">
                                    <span class="inline-block w-2.5 h-2.5 rounded-full" style="background-color: ${item.color}"></span>
                                    <span>Grande área: <strong class="text-white">${item.area}</strong></span>
                                </div>
                                <div class="mt-1.5 pt-1.5 border-t border-slate-700/80 text-xs font-semibold text-emerald-400">
                                    Quantidade: <span class="text-sm font-extrabold text-white">${item.quantidade}</span> docente${item.quantidade > 1 ? 's' : ''}
                                </div>
                            `;
                            tooltip.classList.remove('hidden');
                        }
                    })
                    .on('mousemove', (event) => {
                        if (tooltip) {
                            const wrapperRect = container.getBoundingClientRect();
                            const mouseX = event.clientX - wrapperRect.left;
                            const mouseY = event.clientY - wrapperRect.top;

                            const tooltipWidth = tooltip.offsetWidth || 200;
                            const leftPos = (mouseX + tooltipWidth + 20 > width)
                                ? (mouseX - tooltipWidth - 10)
                                : (mouseX + 15);
                            const topPos = mouseY - 25;

                            tooltip.style.left = `${Math.max(10, leftPos)}px`;
                            tooltip.style.top = `${Math.max(10, topPos)}px`;
                        }
                    })
                    .on('mouseleave', () => {
                        barRect.attr('opacity', 0.95).style('filter', 'none');
                        if (tooltip) tooltip.classList.add('hidden');
                    });
                }
            });
        }

        render();

        // Redesenho responsivo fluido
        if (window.ResizeObserver) {
            let resizeTimer;
            const resizeObserver = new ResizeObserver(() => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(render, 100);
            });
            resizeObserver.observe(container);
        } else {
            window.addEventListener('resize', render);
        }
    })();

    // ── Fig 3: Trajetória Acadêmica e Origem dos Docentes (Sankey) ──
    (function initFig16SankeyChart() {
        const container = document.getElementById('chartFig16');
        const tooltip = document.getElementById('chartFig16Tooltip');
        const deptFilter = document.getElementById('sankeyDeptFilter');
        const groupingFilter = document.getElementById('sankeyGroupingFilter');
        const colorFilter = document.getElementById('sankeyColorFilter');
        const resetBtn = document.getElementById('sankeyResetBtn');

        const kpiTotal = document.getElementById('sankeyKpiTotal');
        const kpiDocSP = document.getElementById('sankeyKpiDocSP');
        const kpiDocExt = document.getElementById('sankeyKpiDocExt');
        const kpiDocUFSCar = document.getElementById('sankeyKpiDocUFSCar');

        if (!container || typeof d3 === 'undefined' || typeof d3.sankey === 'undefined') return;

        const rawData = {{ fig16Sankey|json_encode|raw }};
        const allTrajectories = rawData.trajectories || [];

        // Paleta oficial de cores para instituições
        const instColors = {
            'UFSCar': '#10b981',       // Verde Esmeralda (Destino / Formação na casa)
            'USP': '#0284c7',          // Azul Royal
            'UNICAMP': '#f59e0b',      // Âmbar / Dourado
            'UNESP': '#6366f1',        // Índigo
            'PUC-SP': '#ec4899',       // Rosa
            'PUC-Campinas': '#8b5cf6', // Roxo
            'PUC-Rio': '#a855f7',
            'PUC-RS': '#d946ef',
            'PUC-Minas': '#c026d3',
            'UFMG': '#06b6d4',         // Ciano
            'UFRJ': '#0ea5e9',         // Azul Céu
            'UFSC': '#14b8a6',         // Verde Água
            'UFRGS': '#3b82f6',        // Azul Cobalto
            'UnB': '#84cc16',          // Verde Lima
            'UFPR': '#22c55e',         // Verde
            'UFU': '#059669',          // Verde Floresta
            'UFF': '#2dd4bf',
            'UFPE': '#38bdf8',
            'UFBA': '#60a5fa',
            'UFPA': '#818cf8',
            'UFPB': '#a78bfa',
            'UFC': '#c084fc',
            'UFSM': '#e879f9',
            'UFMS': '#f472b6',
            'UFMT': '#fb7185',
            'UFG': '#4ade80',
            'UFAL': '#34d399',
            'UNIFESP': '#2dd4bf',
            'UNIMEP': '#f97316',       // Laranja
            'Mackenzie': '#ef4444',    // Vermelho
            'UEL': '#f43f5e',
            'UEM': '#fb923c',
            'UERJ': '#38bdf8',
            'UNISO': '#a3e635',
            'UNIFRAN': '#fbbf24',
            'USF': '#f87171',
            'FADISC': '#cbd5e1',
            'FESPSP': '#94a3b8',
            'UNIVESP': '#64748b',
            'Doutorado Direto': '#64748b',
            'CECH (UFSCar)': isDark ? '#38bdf8' : '#1e293b',
            'Outras Instituições': '#94a3b8',
            'Não informado': '#64748b',
            'Graduação Não Inf.': '#64748b',
            'Mestrado Não Inf.': '#64748b',
            'Doutorado Não Inf.': '#64748b'
        };

        const spUniversities = ['USP', 'UFSCar', 'UNICAMP', 'UNESP', 'PUC-SP', 'PUC-Campinas', 'UNIFESP', 'Mackenzie', 'UNIMEP', 'UEL', 'UEM', 'USF', 'UNISO', 'FADISC', 'FESPSP', 'UNIVESP'];

        function getInstColor(name) {
            if (instColors[name]) return instColors[name];
            if (name.startsWith('Exterior')) return '#ea580c';
            const charSum = name.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
            return d3.interpolateTurbo((charSum % 20) / 20);
        }

        function getCategoryColor(name) {
            if (name === 'UFSCar' || name === 'CECH (UFSCar)') return '#10b981';
            if (['USP', 'UNICAMP', 'UNESP', 'PUC-SP', 'PUC-Campinas', 'UNIFESP', 'Mackenzie', 'UNIMEP', 'UNISO', 'USF'].includes(name)) return '#0284c7';
            if (name.startsWith('UF') || name === 'UnB' || name === 'UFF') return '#06b6d4';
            if (name.startsWith('Exterior')) return '#ea580c';
            if (name === 'Doutorado Direto') return '#64748b';
            return '#94a3b8';
        }

        let pinnedNodeId = null;

        function render() {
            container.innerHTML = '';
            const width = container.clientWidth || 980;
            const isMobile = width < 640;
            const height = isMobile ? 560 : 640;

            const selectedDept = deptFilter ? deptFilter.value : 'all';
            const groupingMode = groupingFilter ? groupingFilter.value : 'top';
            const colorMode = colorFilter ? colorFilter.value : 'source';

            // 1. Filtrar trajetórias
            const filteredTrajectories = allTrajectories.filter(t => selectedDept === 'all' || t.deptCode === selectedDept);
            const totalCount = filteredTrajectories.length;

            if (kpiTotal) kpiTotal.textContent = totalCount;

            if (totalCount > 0) {
                const docSPCount = filteredTrajectories.filter(t => spUniversities.includes(t.doc)).length;
                const docExtCount = filteredTrajectories.filter(t => t.doc.startsWith('Exterior')).length;
                const docUFSCarCount = filteredTrajectories.filter(t => t.doc === 'UFSCar').length;

                if (kpiDocSP) kpiDocSP.textContent = Math.round((docSPCount / totalCount) * 100) + '%';
                if (kpiDocExt) kpiDocExt.innerHTML = `${docExtCount} <span class="text-xs font-normal">(${Math.round((docExtCount / totalCount) * 100)}%)</span>`;
                if (kpiDocUFSCar) kpiDocUFSCar.textContent = Math.round((docUFSCarCount / totalCount) * 100) + '%';
            }

            if (totalCount === 0) {
                container.innerHTML = `<div class="flex items-center justify-center h-80 text-sm text-slate-400">Nenhum pesquisador encontrado para este filtro.</div>`;
                return;
            }

            // 2. Frequências locais
            const localFrequencies = {};
            filteredTrajectories.forEach(t => {
                localFrequencies[t.grad] = (localFrequencies[t.grad] || 0) + 1;
                localFrequencies[t.mest] = (localFrequencies[t.mest] || 0) + 1;
                localFrequencies[t.doc] = (localFrequencies[t.doc] || 0) + 1;
            });

            const threshold = (groupingMode === 'top' && totalCount > 15) ? 2 : 1;

            // 3. Montar nós e links
            const nodesMap = new Map();
            const linksMap = new Map();

            function getOrAddNode(id, name, stage, stageLabel) {
                if (!nodesMap.has(id)) {
                    nodesMap.set(id, {
                        id: id,
                        name: name,
                        stage: stage,
                        stageLabel: stageLabel,
                        color: getInstColor(name),
                        categoryColor: getCategoryColor(name),
                        total: 0
                    });
                }
                const n = nodesMap.get(id);
                n.total++;
                return n;
            }

            filteredTrajectories.forEach(t => {
                const gName = (groupingMode === 'top' && localFrequencies[t.grad] < threshold && !t.grad.startsWith('Exterior') && t.grad !== 'Graduação Não Inf.') ? 'Outras Instituições' : t.grad;
                const mName = (t.mest === 'Doutorado Direto' || (groupingMode === 'top' && localFrequencies[t.mest] < threshold && !t.mest.startsWith('Exterior') && t.mest !== 'Mestrado Não Inf.')) ? (t.mest === 'Doutorado Direto' ? 'Doutorado Direto' : 'Outras Instituições') : t.mest;
                const dName = (groupingMode === 'top' && localFrequencies[t.doc] < threshold && !t.doc.startsWith('Exterior') && t.doc !== 'Doutorado Não Inf.') ? 'Outras Instituições' : t.doc;
                const cName = 'CECH (UFSCar)';

                const gNode = getOrAddNode('grad:' + gName, gName, 0, 'Graduação');
                const mNode = getOrAddNode('mest:' + mName, mName, 1, 'Mestrado');
                const dNode = getOrAddNode('doc:' + dName, dName, 2, 'Doutorado');
                const cNode = getOrAddNode('cech:CECH', cName, 3, 'CECH UFSCar');

                function recordLink(sourceId, targetId, stageFrom, stageTo) {
                    const linkKey = `${sourceId} -> ${targetId}`;
                    if (!linksMap.has(linkKey)) {
                        linksMap.set(linkKey, {
                            source: sourceId,
                            target: targetId,
                            stageFrom: stageFrom,
                            stageTo: stageTo,
                            value: 0,
                            researchers: [],
                            deptDistribution: {}
                        });
                    }
                    const l = linksMap.get(linkKey);
                    l.value++;
                    if (l.researchers.length < 20) {
                        l.researchers.push({
                            name: t.name,
                            slug: t.slug,
                            dept: t.deptName || t.deptCode
                        });
                    }
                    l.deptDistribution[t.deptCode] = (l.deptDistribution[t.deptCode] || 0) + 1;
                }

                recordLink(gNode.id, mNode.id, 'Graduação', 'Mestrado');
                recordLink(mNode.id, dNode.id, 'Mestrado', 'Doutorado');
                recordLink(dNode.id, cNode.id, 'Doutorado', 'CECH UFSCar');
            });

            const nodesArray = Array.from(nodesMap.values());
            const linksArray = Array.from(linksMap.values());

            // 4. Configurar D3 Sankey Layout
            const marginLeft = isMobile ? 85 : 130;
            const marginRight = isMobile ? 85 : 130;
            const marginTop = 15;
            const marginBottom = 15;

            const sankeyLayout = d3.sankey()
                .nodeId(d => d.id)
                .nodeWidth(isMobile ? 12 : 16)
                .nodePadding(isMobile ? 8 : 12)
                .nodeAlign(d3.sankeyJustify)
                .extent([[marginLeft, marginTop], [width - marginRight, height - marginBottom]]);

            let graph;
            try {
                graph = sankeyLayout({
                    nodes: nodesArray.map(d => Object.assign({}, d)),
                    links: linksArray.map(d => Object.assign({}, d))
                });
            } catch (err) {
                console.error("Sankey layout calculation error:", err);
                return;
            }

            // 5. Criar SVG
            const svg = d3.select(container)
                .append('svg')
                .attr('viewBox', `0 0 ${width} ${height}`)
                .attr('width', '100%')
                .attr('height', height)
                .style('overflow', 'visible')
                .style('font-family', 'Inter, system-ui, -apple-system, sans-serif');

            // Definições de gradientes para links
            const defs = svg.append('defs');
            graph.links.forEach((link, i) => {
                const gradId = `sankey-link-grad-${i}`;
                const sourceColor = colorMode === 'category' ? link.source.categoryColor : link.source.color;
                const targetColor = colorMode === 'category' ? link.target.categoryColor : link.target.color;

                const grad = defs.append('linearGradient')
                    .attr('id', gradId)
                    .attr('gradientUnits', 'userSpaceOnUse')
                    .attr('x1', link.source.x1)
                    .attr('x2', link.target.x0);

                grad.append('stop').attr('offset', '0%').attr('stop-color', sourceColor).attr('stop-opacity', 0.8);
                grad.append('stop').attr('offset', '100%').attr('stop-color', targetColor).attr('stop-opacity', 0.8);
            });

            // 6. Desenhar Links (Fitas de fluxo)
            const linkG = svg.append('g')
                .attr('class', 'sankey-links')
                .attr('fill', 'none');

            const linkPaths = linkG.selectAll('path')
                .data(graph.links)
                .join('path')
                .attr('d', d3.sankeyLinkHorizontal())
                .attr('stroke', (d, i) => {
                    if (colorMode === 'gradient') return `url(#sankey-link-grad-${i})`;
                    if (colorMode === 'category') return d.source.categoryColor;
                    return d.source.color;
                })
                .attr('stroke-width', d => Math.max(1.5, d.width))
                .attr('stroke-opacity', isDark ? 0.45 : 0.35)
                .style('mix-blend-mode', isDark ? 'screen' : 'multiply')
                .style('transition', 'stroke-opacity 0.2s ease, stroke-width 0.2s ease')
                .attr('cursor', 'pointer');

            // 7. Desenhar Nós (Barras verticais)
            const nodeG = svg.append('g')
                .attr('class', 'sankey-nodes');

            const nodeGroups = nodeG.selectAll('g')
                .data(graph.nodes)
                .join('g')
                .attr('class', 'sankey-node-group')
                .attr('cursor', 'pointer');

            const nodeRects = nodeGroups.append('rect')
                .attr('x', d => d.x0)
                .attr('y', d => d.y0)
                .attr('height', d => Math.max(2, d.y1 - d.y0))
                .attr('width', d => d.x1 - d.x0)
                .attr('fill', d => colorMode === 'category' ? d.categoryColor : d.color)
                .attr('rx', 3)
                .attr('ry', 3)
                .attr('stroke', isDark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.15)')
                .attr('stroke-width', 0.75)
                .style('transition', 'opacity 0.2s ease, filter 0.2s ease');

            // 8. Rótulos dos Nós
            const nodeTextFill = isDark ? '#e2e8f0' : '#1e293b';
            const nodeSubTextFill = isDark ? '#94a3b8' : '#64748b';

            nodeGroups.append('text')
                .attr('x', d => {
                    if (d.stage === 0) return d.x0 - 8;
                    if (d.stage === 3) return d.x1 + 8;
                    return d.x0 < width / 2 ? d.x1 + 6 : d.x0 - 6;
                })
                .attr('y', d => (d.y0 + d.y1) / 2)
                .attr('dy', '0.35em')
                .attr('text-anchor', d => {
                    if (d.stage === 0) return 'end';
                    if (d.stage === 3) return 'start';
                    return d.x0 < width / 2 ? 'start' : 'end';
                })
                .attr('font-size', isMobile ? '9.5px' : '11px')
                .attr('font-weight', '600')
                .attr('fill', nodeTextFill)
                .text(d => {
                    const nodeH = d.y1 - d.y0;
                    if (nodeH < 9 && d.stage > 0 && d.stage < 3 && !isMobile) return '';
                    return d.name;
                })
                .append('tspan')
                .attr('font-weight', '700')
                .attr('fill', nodeSubTextFill)
                .attr('dx', '4px')
                .text(d => {
                    const nodeH = d.y1 - d.y0;
                    if (nodeH < 9 && d.stage > 0 && d.stage < 3 && !isMobile) return '';
                    return `(${d.value})`;
                });

            // 9. Lógica de Interatividade (Hover / Highlight / Pin)
            function getConnectedElements(node) {
                const connectedNodeIds = new Set([node.id]);
                const connectedLinkIndices = new Set();

                // BFS para frente (descendentes)
                const queueForward = [node];
                while (queueForward.length > 0) {
                    const curr = queueForward.shift();
                    graph.links.forEach((l, idx) => {
                        if (l.source.id === curr.id) {
                            connectedLinkIndices.add(idx);
                            if (!connectedNodeIds.has(l.target.id)) {
                                connectedNodeIds.add(l.target.id);
                                queueForward.push(l.target);
                            }
                        }
                    });
                }

                // BFS para trás (ancestrais)
                const queueBackward = [node];
                while (queueBackward.length > 0) {
                    const curr = queueBackward.shift();
                    graph.links.forEach((l, idx) => {
                        if (l.target.id === curr.id) {
                            connectedLinkIndices.add(idx);
                            if (!connectedNodeIds.has(l.source.id)) {
                                connectedNodeIds.add(l.source.id);
                                queueBackward.push(l.source);
                            }
                        }
                    });
                }

                return { connectedNodeIds, connectedLinkIndices };
            }

            function highlightNode(node) {
                const { connectedNodeIds, connectedLinkIndices } = getConnectedElements(node);

                linkPaths
                    .attr('stroke-opacity', (d, idx) => connectedLinkIndices.has(idx) ? 0.85 : 0.04)
                    .attr('stroke-width', (d, idx) => connectedLinkIndices.has(idx) ? Math.max(2.5, d.width + 1) : Math.max(1, d.width));

                nodeRects
                    .attr('opacity', d => connectedNodeIds.has(d.id) ? 1 : 0.25)
                    .style('filter', d => d.id === node.id ? 'brightness(1.2) drop-shadow(0 0 6px rgba(56, 189, 248, 0.5))' : 'none');
            }

            function highlightLink(link, linkIndex) {
                linkPaths
                    .attr('stroke-opacity', (d, idx) => idx === linkIndex ? 0.95 : 0.06)
                    .attr('stroke-width', (d, idx) => idx === linkIndex ? Math.max(3, d.width + 1.5) : Math.max(1, d.width));

                nodeRects
                    .attr('opacity', d => (d.id === link.source.id || d.id === link.target.id) ? 1 : 0.25)
                    .style('filter', d => (d.id === link.source.id || d.id === link.target.id) ? 'brightness(1.15)' : 'none');
            }

            function clearHighlight() {
                if (pinnedNodeId) return;
                linkPaths
                    .attr('stroke-opacity', isDark ? 0.45 : 0.35)
                    .attr('stroke-width', d => Math.max(1.5, d.width));
                nodeRects
                    .attr('opacity', 1)
                    .style('filter', 'none');
            }

            // Tooltip helper
            function updateTooltipPos(event) {
                if (!tooltip) return;
                const wrapperRect = container.getBoundingClientRect();
                const mouseX = event.clientX - wrapperRect.left;
                const mouseY = event.clientY - wrapperRect.top;
                const tooltipW = tooltip.offsetWidth || 240;
                const leftPos = (mouseX + tooltipW + 25 > width) ? (mouseX - tooltipW - 15) : (mouseX + 15);
                const topPos = Math.max(10, mouseY - 30);
                tooltip.style.left = `${Math.max(10, leftPos)}px`;
                tooltip.style.top = `${topPos}px`;
            }

            // Eventos em Nós
            nodeGroups
                .on('mouseenter', (event, d) => {
                    if (!pinnedNodeId) {
                        highlightNode(d);
                    }
                    if (tooltip) {
                        const pct = Math.round((d.value / totalCount) * 100);
                        tooltip.innerHTML = `
                            <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-blue-400 mb-1">
                                <span class="w-2 h-2 rounded-full" style="background-color: ${d.color}"></span>
                                <span>Etapa: ${d.stageLabel}</span>
                            </div>
                            <div class="text-sm font-extrabold text-white">${d.name}</div>
                            <div class="mt-2 pt-2 border-t border-slate-700/80 flex items-center justify-between text-xs">
                                <span class="text-slate-300">Docentes nesta fase:</span>
                                <span class="font-bold text-emerald-400">${d.value} (${pct}%)</span>
                            </div>
                            <div class="mt-1 text-[10px] text-slate-400">Clique para fixar o destaque deste fluxo.</div>
                        `;
                        tooltip.classList.remove('hidden');
                        updateTooltipPos(event);
                    }
                })
                .on('mousemove', updateTooltipPos)
                .on('mouseleave', () => {
                    if (tooltip && !pinnedNodeId) tooltip.classList.add('hidden');
                    clearHighlight();
                })
                .on('click', (event, d) => {
                    event.stopPropagation();
                    if (pinnedNodeId === d.id) {
                        pinnedNodeId = null;
                        if (resetBtn) resetBtn.classList.add('hidden');
                        clearHighlight();
                        if (tooltip) tooltip.classList.add('hidden');
                    } else {
                        pinnedNodeId = d.id;
                        if (resetBtn) resetBtn.classList.remove('hidden');
                        highlightNode(d);
                    }
                });

            // Eventos em Links
            linkPaths
                .on('mouseenter', (event, d) => {
                    const linkIdx = graph.links.indexOf(d);
                    if (!pinnedNodeId) {
                        highlightLink(d, linkIdx);
                    }
                    if (tooltip) {
                        const pct = Math.round((d.value / totalCount) * 100);
                        const researchersHtml = (d.researchers || []).slice(0, 8).map(r => `
                            <li class="py-0.5 flex items-center justify-between gap-2 text-slate-200">
                                <a href="/professor/${r.slug}" class="truncate font-medium text-sky-400 hover:underline" target="_blank">${r.name}</a>
                                <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-800 text-slate-400 font-mono">${r.dept}</span>
                            </li>
                        `).join('');
                        const extraCount = (d.value > 8) ? `<div class="text-[10px] text-slate-400 mt-1 italic">+ ${d.value - 8} outro(s) docente(s)</div>` : '';

                        tooltip.innerHTML = `
                            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1 flex items-center gap-1.5">
                                <span>${d.stageFrom}</span>
                                <sl-icon name="arrow-right" class="text-[10px]"></sl-icon>
                                <span>${d.stageTo}</span>
                            </div>
                            <div class="text-sm font-extrabold text-white flex items-center gap-2">
                                <span style="color: ${d.source.color}">${d.source.name}</span>
                                <sl-icon name="arrow-right" class="text-slate-500 text-xs"></sl-icon>
                                <span style="color: ${d.target.color}">${d.target.name}</span>
                            </div>
                            <div class="mt-2 pt-2 border-t border-slate-700/80 flex items-center justify-between text-xs">
                                <span class="text-slate-300">Fluxo de Formação:</span>
                                <span class="font-bold text-emerald-400">${d.value} docente${d.value > 1 ? 's' : ''} (${pct}%)</span>
                            </div>
                            ${researchersHtml ? `
                                <div class="mt-2.5 pt-2 border-t border-slate-700/80">
                                    <div class="text-[10px] uppercase font-bold text-slate-400 mb-1">Docentes neste percurso:</div>
                                    <ul class="text-[11px] max-h-32 overflow-y-auto space-y-0.5 pr-1 scrollbar-thin">
                                        ${researchersHtml}
                                    </ul>
                                    ${extraCount}
                                </div>
                            ` : ''}
                        `;
                        tooltip.classList.remove('hidden');
                        updateTooltipPos(event);
                    }
                })
                .on('mousemove', updateTooltipPos)
                .on('mouseleave', () => {
                    if (tooltip && !pinnedNodeId) tooltip.classList.add('hidden');
                    clearHighlight();
                });

            // Clique fora para resetar
            svg.on('click', () => {
                pinnedNodeId = null;
                if (resetBtn) resetBtn.classList.add('hidden');
                clearHighlight();
                if (tooltip) tooltip.classList.add('hidden');
            });
        }

        if (resetBtn) {
            resetBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                pinnedNodeId = null;
                resetBtn.classList.add('hidden');
                if (tooltip) tooltip.classList.add('hidden');
                render();
            });
        }

        if (deptFilter) deptFilter.addEventListener('change', () => { pinnedNodeId = null; if (resetBtn) resetBtn.classList.add('hidden'); render(); });
        if (groupingFilter) groupingFilter.addEventListener('change', () => { pinnedNodeId = null; if (resetBtn) resetBtn.classList.add('hidden'); render(); });
        if (colorFilter) colorFilter.addEventListener('change', render);

        render();

        // Redesenho responsivo com ResizeObserver
        if (window.ResizeObserver) {
            let resizeTimer;
            const resizeObserver = new ResizeObserver(() => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(render, 100);
            });
            resizeObserver.observe(container);
        } else {
            window.addEventListener('resize', render);
        }
    })();

