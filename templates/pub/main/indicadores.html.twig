{% extends 'pub/base.html.twig' %}

{% block title %}Indicadores e Métricas de Auto-Avaliação | Portal CECH UFSCar{% endblock %}
{% block meta_description %}Panorama estatístico e indicadores de auto-avaliação do CECH UFSCar: corpo docente, formações, orientações concluídas, produção científica, estratos Qualis e parcerias nacionais e internacionais.{% endblock %}
{% block og_title %}Indicadores e Métricas de Auto-Avaliação — CECH UFSCar{% endblock %}
{% block og_description %}{{ block('meta_description') }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">

    {# ── Top Header ── #}
    <div class="border-b border-slate-200/60 pb-8 dark:border-white/10 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 px-3 py-1 text-xs font-bold text-emerald-800 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/40">
                    <sl-icon name="graph-up-arrow"></sl-icon> Auto-Avaliação & Desempenho
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400">
                    Atualizado com a base Lattes & Repositório UFSCar
                </span>
            </div>
            <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                Indicadores e Métricas Acadêmicas
            </h1>
            <p class="text-base text-slate-600 dark:text-slate-300 mt-2 max-w-3xl leading-relaxed">
                Relatório consolidado de métricas e indicadores de auto-avaliação do Centro de Educação e Ciências Humanas (CECH/UFSCar), abrangendo corpo docente, formação de pós-graduação, produção bibliográfica qualificada e redes de cooperação.
            </p>
        </div>

        {# Action Buttons #}
        <div class="flex items-center gap-3">
            <button id="printFullReportBtn" type="button" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-white hover:bg-slate-50 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition shadow-sm cursor-pointer">
                <sl-icon name="printer"></sl-icon> Imprimir Relatório
            </button>
        </div>
    </div>

    {# ── Global Summary KPIs ── #}
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="glass-card rounded-2xl p-5 border border-slate-200/60 dark:border-white/10 shadow-sm relative overflow-hidden group">
            <div class="absolute -right-3 -bottom-3 w-16 h-16 bg-blue-500/10 rounded-full blur-xl group-hover:scale-150 transition"></div>
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider">Docentes Ativos</span>
                <sl-icon name="people" class="text-blue-500 text-lg"></sl-icon>
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white font-heading">
                {{ summary.totalResearchers|number_format(0, ',', '.') }}
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Cadastrados no CECH
            </div>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-slate-200/60 dark:border-white/10 shadow-sm relative overflow-hidden group">
            <div class="absolute -right-3 -bottom-3 w-16 h-16 bg-emerald-500/10 rounded-full blur-xl group-hover:scale-150 transition"></div>
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider">Produções Totais</span>
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300">Únicas</span>
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white font-heading">
                {{ summary.uniqueProductions|number_format(0, ',', '.') }}
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1" title="Soma direta de todas as produções cadastradas nos currículos Lattes individuais">
                {{ summary.totalProductions|number_format(0, ',', '.') }} registros nos Lattes
            </div>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-slate-200/60 dark:border-white/10 shadow-sm relative overflow-hidden group">
            <div class="absolute -right-3 -bottom-3 w-16 h-16 bg-indigo-500/10 rounded-full blur-xl group-hover:scale-150 transition"></div>
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider">Artigos Qualis</span>
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300">Únicos</span>
            </div>
            <div class="text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 font-heading">
                {{ summary.uniqueArticlesQualis|number_format(0, ',', '.') }}
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1" title="Soma direta dos artigos com Qualis nos currículos Lattes">
                {{ summary.totalArticlesQualis|number_format(0, ',', '.') }} registros nos Lattes
            </div>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-slate-200/60 dark:border-white/10 shadow-sm relative overflow-hidden group">
            <div class="absolute -right-3 -bottom-3 w-16 h-16 bg-amber-500/10 rounded-full blur-xl group-hover:scale-150 transition"></div>
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider">Orientações</span>
                <sl-icon name="mortarboard" class="text-amber-500 text-lg"></sl-icon>
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white font-heading">
                {{ summary.totalOrientations|number_format(0, ',', '.') }}
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Titulações e defesas concluídas
            </div>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-slate-200/60 dark:border-white/10 shadow-sm relative overflow-hidden group col-span-2 lg:col-span-1">
            <div class="absolute -right-3 -bottom-3 w-16 h-16 bg-purple-500/10 rounded-full blur-xl group-hover:scale-150 transition"></div>
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                <span class="text-xs font-semibold uppercase tracking-wider">Livros & Capítulos</span>
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300">Únicos</span>
            </div>
            <div class="text-3xl font-extrabold text-slate-900 dark:text-white font-heading">
                {{ summary.uniqueBooksAndChapters|number_format(0, ',', '.') }}
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1" title="Soma direta de livros e capítulos nos currículos Lattes">
                {{ summary.totalBooksAndChapters|number_format(0, ',', '.') }} registros nos Lattes
            </div>
        </div>
    </div>

    {# ── Interactive Mobile-Responsive Navigation Pill Tabs ── #}
    <div class="sticky top-16 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md py-3 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 border-y border-slate-200/80 dark:border-slate-800/80 shadow-xs">
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none scroll-smooth" id="indicatorsTabList" role="tablist">
            <button type="button" class="indicator-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 cursor-pointer shrink-0 {% if initialTab == 'faculty' %}bg-sky-600 hover:bg-sky-700 text-white shadow-md border border-sky-500{% else %}bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 border border-transparent{% endif %}" data-tab="faculty" role="tab" aria-selected="{% if initialTab == 'faculty' %}true{% else %}false{% endif %}">
                <sl-icon name="person-badge" class="text-base"></sl-icon>
                <span>1. Corpo Docente & Vínculos</span>
                <span class="text-[10px] px-1.5 py-0.2 rounded-full {% if initialTab == 'faculty' %}bg-white/20 text-white{% else %}bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400{% endif %}">8 figs</span>
            </button>

            <button type="button" class="indicator-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 cursor-pointer shrink-0 {% if initialTab == 'training' %}bg-sky-600 hover:bg-sky-700 text-white shadow-md border border-sky-500{% else %}bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 border border-transparent{% endif %}" data-tab="training" role="tab" aria-selected="{% if initialTab == 'training' %}true{% else %}false{% endif %}">
                <sl-icon name="mortarboard" class="text-base"></sl-icon>
                <span>2. Formação & Orientações</span>
                <span class="text-[10px] px-1.5 py-0.2 rounded-full {% if initialTab == 'training' %}bg-white/20 text-white{% else %}bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400{% endif %}">3 figs</span>
            </button>

            <button type="button" class="indicator-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 cursor-pointer shrink-0 {% if initialTab == 'production' %}bg-sky-600 hover:bg-sky-700 text-white shadow-md border border-sky-500{% else %}bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 border border-transparent{% endif %}" data-tab="production" role="tab" aria-selected="{% if initialTab == 'production' %}true{% else %}false{% endif %}">
                <sl-icon name="journal-text" class="text-base"></sl-icon>
                <span>3. Produção, Qualis & Bases</span>
                <span class="text-[10px] px-1.5 py-0.2 rounded-full {% if initialTab == 'production' %}bg-white/20 text-white{% else %}bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400{% endif %}">5 figs</span>
            </button>

            <button type="button" class="indicator-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 cursor-pointer shrink-0 {% if initialTab == 'network' %}bg-sky-600 hover:bg-sky-700 text-white shadow-md border border-sky-500{% else %}bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 border border-transparent{% endif %}" data-tab="network" role="tab" aria-selected="{% if initialTab == 'network' %}true{% else %}false{% endif %}">
                <sl-icon name="diagram-3" class="text-base"></sl-icon>
                <span>4. Redes & Parcerias</span>
                <span class="text-[10px] px-1.5 py-0.2 rounded-full {% if initialTab == 'network' %}bg-white/20 text-white{% else %}bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400{% endif %}">3 figs</span>
            </button>

            <button type="button" class="indicator-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 cursor-pointer shrink-0 {% if initialTab == 'all' %}bg-sky-600 hover:bg-sky-700 text-white shadow-md border border-sky-500{% else %}bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 border border-transparent{% endif %}" data-tab="all" role="tab" aria-selected="{% if initialTab == 'all' %}true{% else %}false{% endif %}">
                <sl-icon name="grid-fill" class="text-base"></sl-icon>
                <span>Todos os 19 Indicadores</span>
            </button>
        </div>
    </div>

    {# ── Async Tab Loading Skeleton ── #}
    <div id="tabLoadingSkeleton" class="hidden py-16 text-center space-y-4">
        <div class="inline-flex items-center justify-center p-4 rounded-2xl bg-slate-100 dark:bg-slate-800 text-sky-600 dark:text-sky-400 animate-pulse">
            <sl-spinner style="font-size: 2.5rem; --track-width: 4px;"></sl-spinner>
        </div>
        <div class="space-y-1">
            <div class="text-sm font-bold text-slate-700 dark:text-slate-200">
                Carregando indicadores...
            </div>
            <div class="text-xs text-slate-400">
                Processando dados cienciométricos
            </div>
        </div>
    </div>

    {# ── Dynamic Tab Panes Container ── #}
    <div id="indicatorsTabContent" class="space-y-10 min-h-[400px]">

        {# Tab Pane: Faculty (Corpo Docente) #}
        <div id="tabPane-faculty" class="tab-pane {% if initialTab != 'faculty' and initialTab != 'all' %}hidden{% endif %}" data-tab-name="faculty">
            {% if fig1Dept is defined %}
                {% include 'pub/main/indicadores/_tab_faculty.html.twig' %}
            {% endif %}
        </div>

        {# Tab Pane: Training (Formação & Orientações) #}
        <div id="tabPane-training" class="tab-pane {% if initialTab != 'training' and initialTab != 'all' %}hidden{% endif %}" data-tab-name="training">
            {% if fig7Graduations is defined %}
                {% include 'pub/main/indicadores/_tab_training.html.twig' %}
            {% endif %}
        </div>

        {# Tab Pane: Production (Produção, Qualis & Bases) #}
        <div id="tabPane-production" class="tab-pane {% if initialTab != 'production' and initialTab != 'all' %}hidden{% endif %}" data-tab-name="production">
            {% if fig10Heatmap is defined %}
                {% include 'pub/main/indicadores/_tab_production.html.twig' %}
            {% endif %}
        </div>

        {# Tab Pane: Network (Redes & Parcerias) #}
        <div id="tabPane-network" class="tab-pane {% if initialTab != 'network' and initialTab != 'all' %}hidden{% endif %}" data-tab-name="network">
            {% if fig13Coauthors is defined %}
                {% include 'pub/main/indicadores/_tab_network.html.twig' %}
            {% endif %}
        </div>

    </div>

</div>

{# ── Dynamic Async Tab Loader & Cache Manager ── #}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.indicator-tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');
    const skeleton = document.getElementById('tabLoadingSkeleton');
    const printBtn = document.getElementById('printFullReportBtn');

    // Cache local de fragmentos carregados em memória
    const loadedTabs = new Set();

    // Registrar abas pré-renderizadas no HTML inicial
    tabPanes.forEach(pane => {
        if (pane.children.length > 0 && pane.innerHTML.trim() !== '') {
            loadedTabs.add(pane.dataset.tabName);
        }
    });

    /**
     * Executa com segurança os scripts embutidos dentro de um elemento inserido dinamicamente
     */
    function executeScripts(container) {
        const scripts = container.querySelectorAll('script');
        scripts.forEach(oldScript => {
            const newScript = document.createElement('script');
            Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
            newScript.text = oldScript.textContent;
            document.body.appendChild(newScript);
            newScript.parentNode.removeChild(newScript);
        });
    }

    /**
     * Executa a inicialização dos gráficos da aba correspondente
     */
    function triggerTabInit(tabName) {
        if (tabName === 'faculty') {
            if (typeof window.initTabFaculty === 'function') window.initTabFaculty();
        } else if (tabName === 'training') {
            if (typeof window.initTabTraining === 'function') window.initTabTraining();
        } else if (tabName === 'production') {
            if (typeof window.initTabProduction === 'function') window.initTabProduction();
        } else if (tabName === 'network') {
            if (typeof window.initTabNetwork === 'function') window.initTabNetwork();
        } else if (tabName === 'all') {
            if (typeof window.initTabFaculty === 'function') window.initTabFaculty();
            if (typeof window.initTabTraining === 'function') window.initTabTraining();
            if (typeof window.initTabProduction === 'function') window.initTabProduction();
            if (typeof window.initTabNetwork === 'function') window.initTabNetwork();
        }
    }

    /**
     * Alterna para a aba desejada com carregamento sob demanda e cache
     */
    async function switchTab(tabName, updateUrl = true) {
        if (!tabName) tabName = 'faculty';

        // Atualizar estado visual dos botões de abas
        tabBtns.forEach(btn => {
            const isCurrent = btn.dataset.tab === tabName;
            btn.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
            
            if (isCurrent) {
                btn.className = 'indicator-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 cursor-pointer shrink-0 bg-sky-600 hover:bg-sky-700 text-white shadow-md border border-sky-500';
                const badge = btn.querySelector('span:last-child');
                if (badge) badge.className = 'text-[10px] px-1.5 py-0.2 rounded-full bg-white/20 text-white';
            } else {
                btn.className = 'indicator-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 cursor-pointer shrink-0 bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 border border-transparent';
                const badge = btn.querySelector('span:last-child');
                if (badge) badge.className = 'text-[10px] px-1.5 py-0.2 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400';
            }
        });

        // Atualizar hash da URL sem scroll
        if (updateUrl && history.replaceState) {
            history.replaceState(null, '', '#' + tabName);
        }

        // Modo "Todos os Indicadores"
        if (tabName === 'all') {
            skeleton.classList.remove('hidden');
            const allTabs = ['faculty', 'training', 'production', 'network'];
            
            for (const t of allTabs) {
                const pane = document.getElementById('tabPane-' + t);
                if (pane && !loadedTabs.has(t)) {
                    try {
                        const res = await fetch('/indicadores/fragment/' + t);
                        if (res.ok) {
                            pane.innerHTML = await res.text();
                            loadedTabs.add(t);
                            executeScripts(pane);
                        }
                    } catch (e) {
                        console.error('Erro ao carregar aba:', t, e);
                    }
                }
                if (pane) pane.classList.remove('hidden');
            }
            skeleton.classList.add('hidden');
            setTimeout(() => triggerTabInit('all'), 60);
            return;
        }

        // Modo de Aba Individual
        tabPanes.forEach(p => p.classList.add('hidden'));
        const targetPane = document.getElementById('tabPane-' + tabName);
        if (!targetPane) return;

        // Se já está em cache no DOM, exibe instantaneamente em 0ms
        if (loadedTabs.has(tabName) && targetPane.innerHTML.trim() !== '') {
            targetPane.classList.remove('hidden');
            setTimeout(() => triggerTabInit(tabName), 40);
            return;
        }

        // Se não está carregado, busca o fragmento HTML
        skeleton.classList.remove('hidden');
        try {
            const response = await fetch('/indicadores/fragment/' + encodeURIComponent(tabName));
            if (!response.ok) throw new Error('Falha ao carregar fragmento da aba.');

            const html = await response.text();
            targetPane.innerHTML = html;
            loadedTabs.add(tabName);
            
            skeleton.classList.add('hidden');
            targetPane.classList.remove('hidden');

            // Inicializar scripts e gráficos do fragmento
            executeScripts(targetPane);
            setTimeout(() => triggerTabInit(tabName), 50);
        } catch (err) {
            skeleton.classList.add('hidden');
            targetPane.innerHTML = `
                <div class="glass-card rounded-2xl p-8 text-center space-y-3 border border-red-200/60 dark:border-red-900/40">
                    <sl-icon name="exclamation-triangle" class="text-red-500 text-3xl"></sl-icon>
                    <div class="text-sm font-bold text-slate-800 dark:text-slate-200">Não foi possível carregar esta seção.</div>
                    <button type="button" onclick="location.reload()" class="px-3 py-1.5 rounded-lg bg-sky-600 text-white text-xs font-semibold cursor-pointer">
                        Tentar Novamente
                    </button>
                </div>
            `;
            targetPane.classList.remove('hidden');
        }
    }

    // Escuta de clique nas abas
    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const tab = btn.dataset.tab;
            switchTab(tab);
        });
    });

    // Suporte ao botão Imprimir
    if (printBtn) {
        printBtn.addEventListener('click', async () => {
            await switchTab('all', false);
            setTimeout(() => {
                window.print();
            }, 600);
        });
    }

    // Inicialização baseada no Hash da URL ou default
    const hash = window.location.hash.replace('#', '');
    if (['faculty', 'training', 'production', 'network', 'all'].includes(hash)) {
        switchTab(hash, false);
    } else {
        setTimeout(() => triggerTabInit('faculty'), 50);
    }
});
</script>
{% endblock %}
