                        <button type="button" id="fig17ResetBtn" class="px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center gap-1">
                            <sl-icon name="arrow-counterclockwise"></sl-icon> Limpar
                        </button>
                    </div>
                </div>

                {# ── VIEW 1: SANKEY FLOW ── #}
                <div id="fig17ViewSankeyContainer" class="fig17-view-container">
