{#
    Template: templates/pub/main/home.html.twig
    Finalidade: Página inicial do Portal CECH com busca rápida, destaques de departamentos e contadores globais.
    
    Variáveis Recebidas do Controller (MainController::home):
    @var stats array{totalResearchers: int, totalArticles: int, totalBooks: int, totalOrientations: int} Métricas gerais do centro
    @var departments array<int, array{name: string, code: string, count: int}> Relação de departamentos acadêmicos e contagem de docentes
    @var recentResearchers \App\Entity\Researcher[] Últimos pesquisadores atualizados
#}
{% extends 'pub/base.html.twig' %}

{% block title %}Portal CECH | Produção Científica e Acadêmica UFSCar{% endblock %}
{% block meta_description %}Portal oficial de produção científica, intelectual e acadêmica do Centro de Educação e Ciências Humanas (CECH) da Universidade Federal de São Carlos (UFSCar). Conheça docentes, artigos, livros e pesquisas.{% endblock %}
{% block og_title %}Portal CECH — Produção Científica e Acadêmica UFSCar{% endblock %}
{% block og_description %}Mapeamento e catálogo da produção científica, intelectual, projetos de pesquisa e corpo docente do Centro de Educação e Ciências Humanas da UFSCar.{% endblock %}

{% block body %}
<div class="space-y-16 pb-20">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-sky-50 via-white to-slate-50 dark:from-slate-900/80 dark:via-slate-950 dark:to-slate-950 pt-16 pb-20">
        <div class="absolute inset-0 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:24px_24px] opacity-20 pointer-events-none"></div>
        <div class="relative mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100/90 px-3.5 py-1 text-xs font-semibold text-slate-800 dark:bg-slate-900/90 dark:text-slate-200 border border-slate-200 dark:border-white/10 mb-6 shadow-sm">
                <img src="{{ asset('images/logo-colorido.svg') }}" alt="CECH" class="h-4 w-auto inline-block dark:hidden">
                <img src="{{ asset('images/logo-colorido-dark.svg') }}" alt="CECH" class="h-4 w-auto hidden dark:inline-block"> Centro de Educação e Ciências Humanas — UFSCar
            </span>

            <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
                Mapeamento da Produção Científica & Acadêmica
            </h1>

            <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
                Explore a produção intelectual, projetos de pesquisa, artigos, livros, orientações e trajetórias dos docentes e pesquisadores do CECH.
            </p>

            <!-- Main Search Box -->
            <div class="mt-8 max-w-2xl mx-auto">
                <form action="{{ path('app_pub_search') }}" method="GET" class="relative flex items-center shadow-xl rounded-2xl overflow-hidden glass-card p-1.5 focus-within:ring-2 focus-within:ring-cech-blue">
                    <div class="pl-4 text-slate-400">
                        <sl-icon name="search" class="text-xl"></sl-icon>
                    </div>
                    <input type="text" name="q" placeholder="Buscar por pesquisador, palavra-chave, título de artigo ou DOI..." class="w-full bg-transparent px-4 py-3.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none dark:text-white dark:placeholder:text-slate-500">
                    <button type="submit" class="rounded-xl bg-cech-blue hover:bg-cech-blue-dark px-6 py-3 text-sm font-semibold text-white shadow-md transition-all">
                        Pesquisar
                    </button>
                </form>
                <div class="mt-3 flex items-center justify-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                    <span>Sugestões:</span>
                    <a href="{{ path('app_pub_search', {'q': 'Educação'}) }}" class="hover:text-cech-blue dark:hover:text-cech-teal underline">Educação</a>
                    <span>•</span>
                    <a href="{{ path('app_pub_search', {'q': 'Filosofia'}) }}" class="hover:text-cech-blue dark:hover:text-cech-teal underline">Filosofia</a>
                    <span>•</span>
                    <a href="{{ path('app_pub_search', {'q': 'Ciências Sociais'}) }}" class="hover:text-cech-blue dark:hover:text-cech-teal underline">Ciências Sociais</a>
                    <span>•</span>
                    <a href="{{ path('app_pub_search', {'q': 'Psicologia'}) }}" class="hover:text-cech-blue dark:hover:text-cech-teal underline">Psicologia</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Key Metrics Grid -->
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <!-- Metric 1: Docentes Ativos -->
            <div class="glass-card rounded-2xl p-5 text-center shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-400 mb-2">
                    <sl-icon name="people" class="text-xl"></sl-icon>
                </div>
                <div class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                    {{ stats.researchers|number_format(0, ',', '.') }}
                </div>
                <p class="text-xs text-slate-700 dark:text-slate-200 mt-1 font-semibold">Docentes Ativos</p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5" title="Docentes ativos vinculados ao CECH">Cadastrados no CECH</p>
            </div>

            <!-- Metric 2: Total Produções -->
            <div class="glass-card rounded-2xl p-5 text-center shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400 mb-2">
                    <sl-icon name="journal-bookmark" class="text-xl"></sl-icon>
                </div>
                <div class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                    {{ stats.uniqueProductions|number_format(0, ',', '.') }}
                </div>
                <p class="text-xs text-slate-700 dark:text-slate-200 mt-1 font-semibold">Produções Únicas</p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5" title="Soma direta nos Lattes individuais">{{ stats.productions|number_format(0, ',', '.') }} nos Lattes</p>
            </div>

            <!-- Metric 3: Artigos Qualis -->
            <div class="glass-card rounded-2xl p-5 text-center shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-400 mb-2">
                    <sl-icon name="file-earmark-text" class="text-xl"></sl-icon>
                </div>
                <div class="font-heading text-2xl sm:text-3xl font-extrabold text-indigo-600 dark:text-indigo-400">
                    {{ stats.uniqueArticlesQualis|number_format(0, ',', '.') }}
                </div>
                <p class="text-xs text-slate-700 dark:text-slate-200 mt-1 font-semibold">Artigos Qualis</p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5" title="Total de artigos em periódicos cadastrados">{{ stats.articles|number_format(0, ',', '.') }} artigos totais</p>
            </div>

            <!-- Metric 4: Livros & Capítulos -->
            <div class="glass-card rounded-2xl p-5 text-center shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-400 mb-2">
                    <sl-icon name="book" class="text-xl"></sl-icon>
                </div>
                <div class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                    {{ stats.uniqueBooksAndChapters|number_format(0, ',', '.') }}
                </div>
                <p class="text-xs text-slate-700 dark:text-slate-200 mt-1 font-semibold">Livros & Capítulos</p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">{{ stats.books|number_format(0, ',', '.') }} livros • {{ stats.chapters|number_format(0, ',', '.') }} caps</p>
            </div>

            <!-- Metric 5: Orientações Concluídas -->
            <div class="glass-card rounded-2xl p-5 text-center shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-400 mb-2">
                    <sl-icon name="mortarboard" class="text-xl"></sl-icon>
                </div>
                <div class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                    {{ stats.orientations|number_format(0, ',', '.') }}
                </div>
                <p class="text-xs text-slate-700 dark:text-slate-200 mt-1 font-semibold">Orientações</p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Titulações concluídas</p>
            </div>

            <!-- Metric 6: Trabalhos em Eventos -->
            <div class="glass-card rounded-2xl p-5 text-center shadow-sm hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-400 mb-2">
                    <sl-icon name="calendar-event" class="text-xl"></sl-icon>
                </div>
                <div class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                    {{ stats.events|number_format(0, ',', '.') }}
                </div>
                <p class="text-xs text-slate-700 dark:text-slate-200 mt-1 font-semibold">Trabalhos em Eventos</p>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Anais e congressos</p>
            </div>
        </div>
    </section>

    <!-- Departments Section -->
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Departamentos Acadêmicos</h2>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Unidades de ensino e pesquisa vinculadas ao CECH</p>
            </div>
            <a href="{{ path('app_pub_department_list') }}" class="text-xs sm:text-sm font-semibold text-sky-600 hover:text-sky-500 dark:text-sky-400 flex items-center gap-1">
                Ver todos <sl-icon name="arrow-right"></sl-icon>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
            {% for dept in topDepartments %}
                <a href="{{ path('app_pub_department_show', {'codeOrSlug': dept.departmentCode ?: dept.department}) }}" class="glass-card rounded-2xl p-5 hover:border-sky-500/50 hover:shadow-lg transition-all group flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="rounded-lg bg-sky-100 px-2.5 py-1 text-xs font-bold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                                {{ dept.departmentCode }}
                            </span>
                            <span class="text-xs text-slate-400 font-medium">{{ dept.totalFaculty }} docentes</span>
                        </div>
                        <h3 class="font-heading text-base font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                            {{ dept.department }}
                        </h3>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                        <span>{{ dept.totalProductions|number_format(0, ',', '.') }} produções</span>
                        <sl-icon name="chevron-right" class="text-slate-400 group-hover:translate-x-1 transition-transform"></sl-icon>
                    </div>
                </a>
            {% endfor %}
        </div>
    </section>

    <!-- Recent Publications and Featured Researchers -->
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Recent Publications (2 cols) -->
            <div class="lg:col-span-2 space-y-4">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <h2 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Publicações Recentes</h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Trabalhos científicos mais recentes do corpo docente</p>
                    </div>
                    <a href="{{ path('app_pub_search', {'type': 'productions'}) }}" class="text-xs sm:text-sm font-semibold text-sky-600 hover:text-sky-500 dark:text-sky-400 flex items-center gap-1">
                        Ver todas <sl-icon name="arrow-right"></sl-icon>
                    </a>
                </div>

                <div class="space-y-3">
                    {% for prod in recentProductions %}
                        <div class="glass-card rounded-2xl p-5 hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col justify-between">
                            <div>
                                <div class="flex flex-wrap items-center gap-2 mb-2">
                                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                        {{ prod.itemType }}
                                    </span>
                                    {% if prod.year %}
                                        <span class="rounded-md bg-sky-100 px-2 py-0.5 text-[11px] font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                                            {{ prod.year }}
                                        </span>
                                    {% endif %}
                                    {% set jBadges = prod.journalName ? journal_badges(prod, prod.issn, prod.qualis) : '' %}
                                    {% if jBadges %}
                                        {{ jBadges|raw }}
                                    {% elseif prod.qualis %}
                                        <span class="rounded-md px-2 py-0.5 text-[11px] font-bold badge-qualis-{{ prod.qualis|lower }}">
                                            Qualis {{ prod.qualis }}
                                        </span>
                                    {% endif %}
                                </div>

                                <h3 class="font-heading text-base font-semibold text-slate-900 dark:text-white leading-snug">
                                    {{ prod.title }}
                                </h3>

                                <div class="mt-2 text-xs text-slate-600 dark:text-slate-400">
                                    {% if prod.journalName %}
                                        <span class="font-medium text-slate-700 dark:text-slate-300 italic">{{ prod.journalName }}</span>
                                    {% elseif prod.publisher %}
                                        <span>Editora: {{ prod.publisher }}</span>
                                    {% elseif prod.eventName %}
                                        <span>Evento: {{ prod.eventName }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs">
                                <div class="flex items-center gap-1.5 text-slate-600 dark:text-slate-400">
                                    <sl-icon name="person" class="text-slate-400"></sl-icon>
                                    <a href="{{ path('app_pub_professor_show', {'slugOrId': prod.researcher.slug ?: prod.researcher.idLattes}) }}" class="font-medium hover:text-sky-600 dark:hover:text-sky-400 underline">
                                        {{ prod.researcher.fullName }}
                                    </a>
                                    {% if prod.researcher.departmentCode %}
                                        <span class="text-[11px] text-slate-400">({{ prod.researcher.departmentCode }})</span>
                                    {% endif %}
                                </div>

                                {% if prod.doi %}
                                    <a href="{{ prod.doiUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold text-sky-600 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300 hover:underline">
                                        <sl-icon name="box-arrow-up-right" class="text-[11px]"></sl-icon> DOI: {{ prod.doi }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Featured Researchers (1 col) -->
            <div class="space-y-4">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <h2 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Pesquisadores</h2>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Docentes com Maior Volume de Publicações em Estratos Qualis A1</p>
                    </div>
                </div>

                <div class="space-y-3">
                    {% for r in featuredResearchers %}
                        <a href="{{ path('app_pub_professor_show', {'slugOrId': r.slug ?: r.idLattes}) }}" class="glass-card rounded-2xl p-4 hover:border-sky-500/50 hover:shadow-md transition-all flex items-center gap-3.5 group">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl overflow-hidden shadow-sm group-hover:scale-105 transition-transform {% if not r.photoUrl %}bg-gradient-to-tr from-sky-500 to-indigo-600 text-white font-bold text-sm{% endif %}">
                                {% if r.photoUrl %}
                                    <img src="{{ r.photoUrl }}" alt="{{ r.fullName }}" class="h-full w-full object-cover">
                                {% else %}
                                    {{ r.fullName|slice(0, 2)|upper }}
                                {% endif %}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-2">
                                    <h4 class="font-heading text-sm font-bold text-slate-900 dark:text-white truncate group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                                        {{ r.fullName }}
                                    </h4>
                                    {% if r.a1Count > 0 %}
                                        <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-500/10 px-2 py-0.5 text-[11px] font-extrabold text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shrink-0" title="{{ r.a1Count }} artigo(s) Qualis A1 publicado(s)">
                                            <sl-icon name="award" class="text-xs"></sl-icon> {{ r.a1Count }} A1
                                        </span>
                                    {% endif %}
                                </div>
                                <p class="text-xs text-slate-500 dark:text-slate-400 truncate mt-0.5">
                                    {{ r.department ?: 'CECH / UFSCar' }}
                                    {% if r.admissionYear or r.leaveYear %}
                                        • {{ r.isActiveInCech ? ('Desde ' ~ r.admissionYear) : (r.admissionYear ? r.admissionYear ~ '–' ~ (r.leaveYear ?: 'Saída') : 'Histórico') }}
                                    {% endif %}
                                </p>
                            </div>
                            <sl-icon name="chevron-right" class="text-slate-400 group-hover:translate-x-1 transition-transform"></sl-icon>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
</div>
{% endblock %}
