{% extends 'pub/base.html.twig' %}
{% import 'pub/research/_macros.html.twig' as rs %}

{% set q = filter.q %}
{% set modeLabels = {
    especialistas: 'Especialistas',
    publicacoes: 'Publicações',
    pesquisador: 'Pesquisador',
    orientacoes: 'Teses e orientações',
} %}
{% set modeHints = {
    especialistas: 'Quem pesquisa o assunto, com as publicações que comprovam',
    publicacoes: 'Trabalhos sobre o assunto, sem repetição entre currículos',
    pesquisador: 'Docentes pelo nome, nome de citação, ID Lattes ou ORCID',
    orientacoes: 'Teses, dissertações e orientações dos docentes',
} %}
{% set placeholders = {
    especialistas: 'O que você quer pesquisar? Ex.: formação de professores',
    publicacoes: 'Título, palavra-chave, periódico ou DOI',
    pesquisador: 'Nome do docente',
    orientacoes: 'Título, orientando(a) ou palavra-chave',
} %}
{% set searchParams = filter.toQuery|merge({modo: mode}) %}
{% set sortParams = sort is defined and sort ? searchParams|merge({ordem: sort}) : searchParams %}
{% set inputClass = 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white' %}
{% set labelClass = 'block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1' %}

{% block title %}{% if q %}{{ q }} — {{ modeLabels[mode] }} | Portal CECH UFSCar{% else %}Encontre especialistas | Portal CECH UFSCar{% endif %}{% endblock %}
{% block meta_description %}{% if q %}Resultados da busca por "{{ q }}" na produção científica do CECH UFSCar.{% else %}Encontre especialistas do CECH UFSCar por assunto, publicação ou nome, com filtros por departamento, área, vínculo, tipo de publicação e período.{% endif %}{% endblock %}
{% block meta_robots %}{% if hasSearch %}noindex, follow{% else %}index, follow{% endif %}{% endblock %}

{% block body %}
{% set modeIcons = {especialistas: 'person-badge', publicacoes: 'journal-text', pesquisador: 'person-vcard', orientacoes: 'mortarboard'} %}
{% set formHtml %}
    <form id="searchForm" action="{{ path('app_pub_search') }}" method="GET" class="mt-8 rounded-3xl bg-white/95 shadow-2xl shadow-cech-blue/10 ring-1 ring-slate-200/80 backdrop-blur dark:bg-slate-900/90 dark:ring-white/10" role="search" aria-label="Busca de especialistas">
        <fieldset class="px-4 pt-4 sm:px-6 sm:pt-5">
            <legend class="sr-only">Tipo de busca</legend>
            <div class="inline-flex flex-wrap gap-1 rounded-2xl bg-slate-100 p-1 dark:bg-white/5" role="radiogroup">
                {% for key, label in modeLabels %}
                    <label class="cursor-pointer">
                        <input type="radio" name="modo" value="{{ key }}" class="peer sr-only" {% if mode == key %}checked{% endif %} data-placeholder="{{ placeholders[key] }}">
                        <span class="inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-sm font-semibold text-slate-600 transition peer-checked:bg-white peer-checked:text-cech-blue peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-cech-teal hover:text-slate-900 dark:text-slate-300 dark:hover:text-white dark:peer-checked:bg-slate-800 dark:peer-checked:text-cech-teal"><sl-icon name="{{ modeIcons[key] }}" aria-hidden="true"></sl-icon>{{ label }}</span>
                    </label>
                {% endfor %}
            </div>
        </fieldset>

        <div class="p-4 sm:p-6 space-y-4">
            <div class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-1">
                    <label for="search-q" class="sr-only">Termos da busca</label>
                    <input id="search-q" type="search" name="q" value="{{ q }}" maxlength="200" placeholder="{{ placeholders[mode] }}" class="{{ inputClass }} pl-10 py-3 text-base">
                    <sl-icon name="search" class="absolute left-3.5 top-4 text-slate-400"></sl-icon>
                </div>
                <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cech-blue to-cech-teal px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-cech-blue/25 transition hover:brightness-110 cursor-pointer">
                    Buscar <sl-icon name="arrow-right"></sl-icon>
                </button>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400" id="mode-hint">{{ modeHints[mode] }}</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
                <div class="lg:col-span-2">
                    <label for="f-departamento" class="{{ labelClass }}">Departamento</label>
                    <select id="f-departamento" name="departamento" class="{{ inputClass }}">
                        <option value="">Todos os departamentos</option>
                        {% for d in allDepartments %}
                            <option value="{{ d.code }}" {% if filter.department == d.code or filter.department == d.name %}selected{% endif %}>{{ d.name }} ({{ d.code }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="f-grande-area" class="{{ labelClass }}">Grande área</label>
                    <select id="f-grande-area" name="grande_area" class="{{ inputClass }}">
                        <option value="">Todas</option>
                        {% for m in majorAreas %}
                            <option value="{{ m.code }}" {% if filter.majorArea == m.code %}selected{% endif %}>{{ m.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="lg:col-span-2">
                    <label for="f-area" class="{{ labelClass }}">Área de atuação</label>
                    <select id="f-area" name="area" class="{{ inputClass }}">
                        <option value="">Todas as áreas</option>
                        {% for group, items in areas|filter(a => a.researchers > 0)|reduce((carry, a) => carry|merge({(a.majorLabel): (carry[a.majorLabel] ?? [])|merge([a])}), {}) %}
                            <optgroup label="{{ group }}">
                                {% for a in items %}
                                    <option value="{{ a.area }}" {% if filter.area == a.area %}selected{% endif %}>{{ a.area }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="f-vinculo" class="{{ labelClass }}">Vínculo</label>
                    <select id="f-vinculo" name="vinculo" class="{{ inputClass }}">
                        <option value="">Todos</option>
                        <option value="vigente" {% if filter.affiliation == 'vigente' %}selected{% endif %}>Vínculo vigente</option>
                        <option value="encerrado" {% if filter.affiliation == 'encerrado' %}selected{% endif %}>Vínculo encerrado</option>
                    </select>
                </div>
                <div class="lg:col-span-2">
                    <label for="f-tipo" class="{{ labelClass }}">Tipo de publicação</label>
                    {# Tipo de publicação não se aplica a teses e orientações: o campo fica desativado nesse modo #}
                    <select id="f-tipo" name="tipo" class="{{ inputClass }} disabled:opacity-50" {% if mode == 'orientacoes' %}disabled title="Não se aplica a teses e orientações"{% endif %}>
                        <option value="">Todos os tipos</option>
                        {% for key, label in constant('App\\Service\\Research\\ResearchFilter::TYPE_LABELS') %}
                            <option value="{{ key }}" {% if filter.type == key %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <fieldset class="lg:col-span-2">
                    <legend class="{{ labelClass }}">Período de publicação</legend>
                    <div class="flex items-center gap-2">
                        <label for="f-de" class="sr-only">Ano inicial</label>
                        <input id="f-de" type="number" name="de" value="{{ filter.from }}" min="1950" max="{{ currentYear }}" placeholder="De" inputmode="numeric" class="{{ inputClass }}">
                        <span class="text-slate-400" aria-hidden="true">–</span>
                        <label for="f-ate" class="sr-only">Ano final</label>
                        <input id="f-ate" type="number" name="ate" value="{{ filter.to }}" min="1950" max="{{ currentYear }}" placeholder="Até" inputmode="numeric" class="{{ inputClass }}">
                    </div>
                </fieldset>
                <div class="lg:col-span-2 flex flex-col justify-end gap-2">
                    <label class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200 cursor-pointer">
                        <input type="checkbox" name="exata" value="1" {% if filter.exact %}checked{% endif %} class="h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500">
                        Buscar a expressão exata
                    </label>
                </div>
            </div>

            {% if filter.topicSlug %}
                <input type="hidden" name="tema" value="{{ filter.topicSlug }}">
            {% endif %}

            <div class="flex flex-wrap items-center gap-2 text-xs">
                {% if filter.topicText %}
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200 px-3 py-1 font-semibold">
                        Tema: {{ filter.topicText }}
                        <a href="{{ path('app_pub_search', searchParams|filter((v, k) => k != 'tema')) }}" class="hover:underline" aria-label="Remover o tema {{ filter.topicText }}"><sl-icon name="x-lg"></sl-icon></a>
                    </span>
                {% endif %}
                {% if hasSearch %}
                    <a href="{{ path('app_pub_search', {modo: mode}) }}" class="inline-flex items-center gap-1 font-semibold text-rose-700 hover:underline dark:text-rose-400">
                        <sl-icon name="x-circle"></sl-icon> Limpar filtros
                    </a>
                {% endif %}
            </div>
        </div>
    </form>
{% endset %}
{% embed 'pub/research/_hero.html.twig' with {
    eyebrow: 'Pesquisa institucional',
    icon: 'compass',
    title: 'Encontre',
    highlight: 'especialistas',
    subtitle: 'Descubra quem pesquisa cada assunto no CECH, com as publicações que comprovam, ou procure por publicação e por nome.',
    stats: [
        {value: heroStats.researchers, label: 'Docentes', icon: 'people'},
        {value: heroStats.publications, label: 'Publicações', icon: 'journal-text'},
        {value: heroStats.topics, label: 'Assuntos', icon: 'tags'},
    ],
    formHtml: formHtml,
} only %}
    {% block hero_after %}{{ formHtml|raw }}{% endblock %}
{% endembed %}

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    {% if not hasSearch %}
        <section class="space-y-4" aria-labelledby="comecar">
            <div class="flex items-end justify-between gap-4">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-cech-teal-dark dark:text-cech-teal">Caminhos da pesquisa</p>
                    <h2 id="comecar" class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Por onde você quer começar?</h2>
                </div>
                <a href="{{ path('app_pub_explore') }}" class="text-sm font-semibold text-sky-700 hover:underline dark:text-sky-400">Todos os assuntos <sl-icon name="arrow-right"></sl-icon></a>
            </div>
            {% set tones = [
                'bg-sky-50 text-sky-900 ring-sky-200 hover:bg-sky-100 dark:bg-sky-950/50 dark:text-sky-200 dark:ring-sky-800/60',
                'bg-teal-50 text-teal-900 ring-teal-200 hover:bg-teal-100 dark:bg-teal-950/50 dark:text-teal-200 dark:ring-teal-800/60',
                'bg-amber-50 text-amber-900 ring-amber-200 hover:bg-amber-100 dark:bg-amber-950/50 dark:text-amber-200 dark:ring-amber-800/60',
                'bg-violet-50 text-violet-900 ring-violet-200 hover:bg-violet-100 dark:bg-violet-950/50 dark:text-violet-200 dark:ring-violet-800/60',
                'bg-rose-50 text-rose-900 ring-rose-200 hover:bg-rose-100 dark:bg-rose-950/50 dark:text-rose-200 dark:ring-rose-800/60',
                'bg-emerald-50 text-emerald-900 ring-emerald-200 hover:bg-emerald-100 dark:bg-emerald-950/50 dark:text-emerald-200 dark:ring-emerald-800/60',
            ] %}
            <ul class="flex flex-wrap gap-2.5">
                {% for t in topTopics %}
                    <li>
                        <a href="{{ path('app_pub_search', {tema: t.slug}) }}" class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold ring-1 ring-inset transition hover:-translate-y-0.5 hover:shadow-md {{ tones[loop.index0 % tones|length] }}">
                            {{ t.term }} <span class="rounded-full bg-white/70 px-1.5 text-[11px] font-bold dark:bg-black/20">{{ t.occurrences|number_format(0, ',', '.') }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>

            <ul class="grid grid-cols-1 gap-4 pt-4 md:grid-cols-3">
                {% for card in [
                    {route: 'app_pub_coauthorship', icon: 'diagram-3', title: 'A ciência acontece em rede', text: 'Veja quem publica junto e as publicações de cada parceria.', tone: 'from-cech-blue to-cech-teal'},
                    {route: 'app_pub_explore', icon: 'stars', title: 'Explore por assunto e área', text: 'Panorama de cada assunto, área de atuação e grande área.', tone: 'from-cech-teal to-emerald-500'},
                    {route: 'app_pub_projects', icon: 'kanban', title: 'Projetos de pesquisa', text: 'Projetos e equipes declarados nos currículos.', tone: 'from-cech-red to-amber-500'},
                ] %}
                    <li>
                        <a href="{{ path(card.route) }}" class="group glass-card relative flex h-full flex-col gap-3 overflow-hidden rounded-3xl p-6 transition hover:-translate-y-1 hover:shadow-xl">
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br {{ card.tone }} text-xl text-white shadow-md" aria-hidden="true"><sl-icon name="{{ card.icon }}"></sl-icon></span>
                            <span class="font-heading text-lg font-bold text-slate-900 dark:text-white">{{ card.title }}</span>
                            <span class="text-sm text-slate-600 dark:text-slate-300">{{ card.text }}</span>
                            <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-cech-blue transition group-hover:gap-2 dark:text-cech-teal">Abrir <sl-icon name="arrow-right" aria-hidden="true"></sl-icon></span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <section class="space-y-4" aria-labelledby="resultados" aria-live="polite">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
                <div>
                    <h2 id="resultados" class="font-heading text-xl font-bold text-slate-900 dark:text-white">
                        {% if mode == 'especialistas' %}
                            {{ result.count|number_format(0, ',', '.') }} {{ result.count == 1 ? 'docente' : 'docentes' }}
                        {% elseif mode == 'publicacoes' %}
                            {{ result.count|number_format(0, ',', '.') }} {{ result.count == 1 ? 'publicação' : 'publicações' }}
                        {% elseif mode == 'pesquisador' %}
                            {{ result.count|number_format(0, ',', '.') }} {{ result.count == 1 ? 'docente' : 'docentes' }}
                        {% else %}
                            {{ result.count|number_format(0, ',', '.') }} {{ result.count == 1 ? 'tese ou orientação' : 'teses e orientações' }}
                        {% endif %}
                    </h2>
                    {% if mode == 'especialistas' %}
                        <p class="text-xs text-slate-500 dark:text-slate-400">{{ result.publications|number_format(0, ',', '.') }} publicações relacionadas{% if q %} a “{{ q }}”{% endif %}{% if filter.topicText %} no tema “{{ filter.topicText }}”{% endif %}.</p>
                    {% elseif mode == 'publicacoes' %}
                        <p class="text-xs text-slate-500 dark:text-slate-400">A mesma publicação declarada em vários currículos aparece uma vez.</p>
                    {% endif %}
                </div>
                {% if mode in ['especialistas', 'publicacoes'] and result.count > 1 %}
                    <div class="flex items-center gap-2">
                        <label for="f-ordem" class="text-xs font-semibold text-slate-600 dark:text-slate-300">Ordenar por</label>
                        <select id="f-ordem" name="ordem" form="searchForm" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-white">
                            {% for key, label in sorts %}
                                <option value="{{ key }}" {% if sort == key %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>

            {% if nameMatches and nameMatches.count > 0 %}
                <div class="glass-card rounded-2xl p-4">
                    <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 mb-2">Docentes com “{{ q }}” no nome</p>
                    <ul class="flex flex-wrap gap-2">
                        {% for p in nameMatches.results %}
                            <li>
                                <a href="{{ path('app_pub_professor_show', {slugOrId: p.slug}) }}" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-sm hover:border-sky-500 dark:border-slate-700 dark:bg-slate-900">
                                    {{ rs.avatar(p, 'h-7 w-7 text-[10px]', true) }} <span class="font-semibold text-slate-800 dark:text-slate-100">{{ p.name }}</span>
                                </a>
                            </li>
                        {% endfor %}
                        {% if nameMatches.count > nameMatches.results|length %}
                            <li><a href="{{ path('app_pub_search', searchParams|merge({modo: 'pesquisador'})) }}" class="inline-flex px-3 py-1.5 text-sm font-semibold text-sky-700 hover:underline dark:text-sky-400">Ver todos ({{ nameMatches.count }})</a></li>
                        {% endif %}
                    </ul>
                </div>
            {% endif %}

            {% if result.count == 0 %}
                <div class="glass-card rounded-2xl p-10 text-center text-slate-600 dark:text-slate-300">
                    <sl-icon name="search" class="text-4xl text-slate-400 mb-3"></sl-icon>
                    <p class="text-base font-medium">Nenhum resultado para esta busca.</p>
                    <p class="text-sm mt-1">Experimente variações em português ou inglês, desmarque “expressão exata” ou remova algum filtro.</p>
                </div>
            {% elseif mode == 'especialistas' %}
                <ol class="space-y-4">
                    {% for item in result.results %}
                        {% set person = item.researcher %}
                        <li class="glass-card group relative overflow-hidden rounded-3xl p-5 transition hover:border-cech-teal/40 hover:shadow-xl sm:p-6">
                            <span class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-cech-blue via-cech-teal to-cech-red opacity-0 transition group-hover:opacity-100" aria-hidden="true"></span>
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/70 dark:border-white/10 pb-4">
                                <div class="flex items-center gap-4 min-w-0">
                                    {{ rs.avatar(person, 'h-14 w-14 text-base', true) }}
                                    <div class="min-w-0 space-y-1">
                                        <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white truncate">
                                            <a href="{{ path('app_pub_professor_show', {slugOrId: person.slug}|merge(searchParams)|merge({aba: 'busca'})) }}" class="hover:text-sky-700 dark:hover:text-sky-400">{{ person.name }}</a>
                                        </h3>
                                        {{ rs.person_meta(person) }}
                                    </div>
                                </div>
                                <a href="{{ path('app_pub_professor_show', {slugOrId: person.slug}|merge(searchParams)|merge({aba: 'busca'})) }}#busca" class="shrink-0 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-cech-blue to-cech-teal px-4 py-2 text-sm font-semibold text-white shadow-md shadow-cech-blue/20 transition hover:brightness-110">
                                    Ver {{ item.count }} {{ item.count == 1 ? 'publicação' : 'publicações' }} <sl-icon name="arrow-up-right" aria-hidden="true"></sl-icon>
                                </a>
                            </div>
                            <div class="divide-y divide-slate-200/70 dark:divide-white/10">
                                {% for w in item.publications %}
                                    {{ rs.work(w, false) }}
                                {% endfor %}
                            </div>
                        </li>
                    {% endfor %}
                </ol>
            {% elseif mode == 'publicacoes' %}
                <ol class="glass-card rounded-3xl px-4 sm:px-6 divide-y divide-slate-200/70 dark:divide-white/10">
                    {% for w in result.results %}
                        <li>{{ rs.work(w) }}</li>
                    {% endfor %}
                </ol>
            {% elseif mode == 'pesquisador' %}
                <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {% for p in result.results %}
                        <li>
                            <a href="{{ path('app_pub_professor_show', {slugOrId: p.slug}) }}" class="glass-card flex h-full items-center gap-4 rounded-3xl p-5 transition hover:-translate-y-0.5 hover:border-cech-teal/40 hover:shadow-xl">
                                {{ rs.avatar(p, 'h-14 w-14 text-base', true) }}
                                <span class="min-w-0">
                                    <span class="block font-heading text-sm font-bold text-slate-900 dark:text-white truncate">{{ p.name }}</span>
                                    {{ rs.person_meta(p) }}
                                    <span class="block text-xs text-slate-500 dark:text-slate-400">{{ p.productions|number_format(0, ',', '.') }} produções{% if p.latestYear %} · mais recente {{ p.latestYear }}{% endif %}</span>
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="space-y-3">
                    {% for o in orientations %}
                        <article class="glass-card rounded-2xl p-4 sm:p-5">
                            <div class="flex flex-wrap items-center gap-2 text-xs">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-md font-bold uppercase tracking-wider bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">{{ o.orientationType|replace({'_': ' '}) }}</span>
                                {% if o.year %}<span class="font-mono font-semibold text-slate-500 dark:text-slate-400">{{ o.year }}</span>{% endif %}
                                {% if o.nature == 'CONCLUIDA' %}<span class="font-semibold text-emerald-700 dark:text-emerald-400">Concluída</span>{% else %}<span class="font-semibold text-amber-700 dark:text-amber-400">Em andamento</span>{% endif %}
                            </div>
                            <h3 class="mt-1.5 font-heading text-sm sm:text-base font-bold text-slate-900 dark:text-white">{{ o.title }}</h3>
                            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
                                Orientando(a): <strong>{{ o.studentName }}</strong>{% if o.displayCourseName %} · <span class="italic">{{ o.displayCourseName }}</span>{% endif %}
                            </p>
                            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
                                Orientador(a):
                                <a href="{{ path('app_pub_professor_show', {'slugOrId': o.researcher.slug ?: o.researcher.idLattes}) }}" class="font-semibold underline hover:text-sky-700 dark:hover:text-sky-400">{{ o.researcher.fullName }}</a>
                                {% if o.researcher.departmentCode %}({{ o.researcher.departmentCode }}){% endif %}
                                {% if o.handleUrl %}
                                    · <a href="{{ o.handleUrl }}" target="_blank" rel="noopener noreferrer" class="font-semibold text-teal-700 hover:underline dark:text-teal-400">Repositório Institucional (TeD-UFSCar)<span class="sr-only"> (abre em nova aba)</span></a>
                                {% endif %}
                            </p>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}

            {{ rs.pagination('app_pub_search', sortParams, result.page, result.pages) }}
        </section>
    {% endif %}
</div>

<script>
    // Troca o texto de ajuda e o exemplo do campo ao escolher outro tipo de busca
    document.querySelectorAll('#searchForm input[name="modo"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
            var input = document.getElementById('search-q');
            var hint = document.getElementById('mode-hint');
            var hints = {{ modeHints|json_encode|raw }};
            if (input) input.placeholder = radio.dataset.placeholder;
            if (hint) hint.textContent = hints[radio.value] || '';
            var type = document.getElementById('f-tipo');
            if (type) {
                type.disabled = radio.value === 'orientacoes';
                type.title = type.disabled ? 'Não se aplica a teses e orientações' : '';
            }
        });
    });
</script>
{% endblock %}
