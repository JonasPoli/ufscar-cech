{#
    Dica de novidade no topo da página (NovidadesService::tipFor): o que mudou e como era antes.
    Some quando a pessoa clica em "Entendi" (guardado no navegador, por dica).
#}
{% set dica = novidade_dica(app.request.attributes.get('_route')) %}
{% if dica %}
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-6 no-print">
        <aside id="{{ dica.id }}" class="rounded-2xl border border-amber-300/70 bg-amber-50 px-4 py-3 sm:px-5 text-sm text-slate-800 shadow-sm dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-slate-100" aria-labelledby="{{ dica.id }}-titulo">
            <div class="flex items-start gap-3">
                <sl-icon name="stars" class="mt-0.5 shrink-0 text-lg text-amber-600 dark:text-amber-400"></sl-icon>
                <div class="min-w-0 flex-1 space-y-1">
                    <p class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">Novidade de {{ dica.desde|date('d/m/Y') }}</p>
                    <h2 id="{{ dica.id }}-titulo" class="font-heading text-base font-bold text-slate-900 dark:text-white">{{ dica.titulo }}</h2>
                    {% if dica.antes %}<p><strong>Antes:</strong> {{ dica.antes }}</p>{% endif %}
                    <p><strong>Agora:</strong> {{ dica.agora }}</p>
                    <p class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-1">
                        <a href="{{ path('app_pub_news') }}#d-{{ dica.desde }}" class="font-semibold text-sky-800 hover:underline dark:text-sky-300">Ver todas as novidades</a>
                        <button type="button" data-dica-fechar class="font-semibold text-slate-700 hover:underline dark:text-slate-200">Entendi</button>
                    </p>
                </div>
                <button type="button" data-dica-fechar class="shrink-0 rounded-lg p-1.5 text-slate-500 hover:bg-amber-100 dark:hover:bg-amber-900/40" aria-label="Fechar a dica">
                    <sl-icon name="x-lg"></sl-icon>
                </button>
            </div>
        </aside>
    </div>
    <script>
        // Roda logo depois da caixa, antes de a página aparecer: quem já clicou em "Entendi" não a vê piscar
        (function () {
            var box = document.getElementById({{ dica.id|json_encode|raw }});
            if (!box) return;
            var key = 'cech-' + box.id;
            var wrapper = box.parentNode;
            try { if (localStorage.getItem(key) === '1') { wrapper.hidden = true; return; } } catch (e) {}
            box.querySelectorAll('[data-dica-fechar]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    try { localStorage.setItem(key, '1'); } catch (e) {}
                    wrapper.hidden = true;
                    var main = document.getElementById('conteudo');
                    if (main) main.focus();
                });
            });
        })();
    </script>
{% endif %}
