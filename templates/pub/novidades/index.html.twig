{% extends 'pub/base.html.twig' %}

{% block title %}Novidades e histórico de manutenções | Portal CECH UFSCar{% endblock %}
{% block meta_description %}O que mudou no Portal de Produção do CECH/UFSCar: cada atualização explicada em linguagem simples, com os ajustes feitos no código.{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <header class="space-y-2 border-b border-slate-200/60 pb-6 dark:border-white/10">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-950 dark:text-amber-200">
            <sl-icon name="stars"></sl-icon> Novidades
        </span>
        <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">O que mudou no portal</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300">
            O histórico das manutenções, da mais recente para a mais antiga. Cada atualização traz o que mudou em palavras simples e,
            no fim, os ajustes feitos no código, com o código de cada alteração no git.
        </p>
    </header>

    {% if entries|length > 1 %}
        <nav aria-label="Atualizações" class="flex flex-wrap gap-2 text-xs">
            {% for e in entries %}
                <a href="#d-{{ e.data }}" class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-semibold text-slate-700 hover:border-sky-500 hover:text-sky-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:text-sky-400">{{ e.data|date('d/m/Y') }}</a>
            {% endfor %}
        </nav>
    {% endif %}

    <ol class="relative space-y-8 border-l-2 border-slate-200 pl-6 dark:border-white/10">
        {% for e in entries %}
            <li id="d-{{ e.data }}" class="relative scroll-mt-24">
                <span class="absolute -left-[33px] top-1.5 h-4 w-4 rounded-full border-2 border-white dark:border-slate-950 {{ loop.first ? 'bg-amber-500' : 'bg-sky-700' }}" aria-hidden="true"></span>
                <article class="glass-card rounded-2xl p-5 sm:p-6 space-y-3" aria-labelledby="t-{{ e.data }}">
                    <p class="flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
                        <time datetime="{{ e.data }}">{{ e.data|date('d/m/Y') }}</time>
                        {% if loop.first %}<span class="rounded-full bg-amber-100 px-2 py-0.5 text-amber-900 dark:bg-amber-950 dark:text-amber-200">Mais recente</span>{% endif %}
                    </p>
                    <h2 id="t-{{ e.data }}" class="font-heading text-xl font-bold text-slate-900 dark:text-white">{{ e.titulo }}</h2>
                    {% if e.resumo %}<p class="text-sm text-slate-700 dark:text-slate-200">{{ e.resumo }}</p>{% endif %}
                    <ul class="list-disc space-y-1.5 pl-5 text-sm text-slate-700 dark:text-slate-200">
                        {% for m in e.mudancas %}<li>{{ m }}</li>{% endfor %}
                    </ul>
                    {% if e.commits|length > 0 %}
                        <details class="rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-2 text-sm dark:border-white/10 dark:bg-white/5">
                            <summary class="cursor-pointer font-semibold text-slate-700 dark:text-slate-200">
                                Ajustes no git ({{ e.commits|length }})
                            </summary>
                            <ul class="mt-2 space-y-1.5 pb-1">
                                {% for c in e.commits %}
                                    <li class="flex gap-3">
                                        <code class="shrink-0 rounded bg-slate-200/70 px-1.5 py-0.5 font-mono text-xs text-slate-800 dark:bg-slate-800 dark:text-slate-200">{{ c.hash }}</code>
                                        <span class="text-slate-700 dark:text-slate-300">{{ c.texto }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </details>
                    {% endif %}
                </article>
            </li>
        {% endfor %}
    </ol>
</div>
{% endblock %}
