        {# ── Painel "Preferências de leitura" (comportamento em assets/js/a11y.js; estilos em assets/styles/app.css) ── #}
        {# O atributo hidden fica num elemento sem classe de display (uma classe .flex/.block o anularia) #}
        <div id="a11y-panel" role="dialog" aria-modal="false" aria-labelledby="a11y-panel-title" aria-describedby="a11y-panel-desc" tabindex="-1" hidden
             class="a11y-panel fixed z-[60] left-3 right-3 top-[4.5rem] sm:left-auto sm:right-4 lg:right-8 sm:w-[24rem] overflow-y-auto overscroll-contain rounded-3xl border border-slate-200 bg-white p-5 text-slate-800 shadow-2xl focus:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <h2 id="a11y-panel-title" class="font-heading flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white">
                        <sl-icon name="universal-access-circle" class="text-cech-blue dark:text-cech-teal" aria-hidden="true"></sl-icon> Preferências de leitura
                    </h2>
                    <p id="a11y-panel-desc" class="mt-0.5 text-xs text-slate-600 dark:text-slate-400">Valem para todas as páginas e ficam salvas neste navegador.</p>
                </div>
                <button type="button" data-a11y-close title="Fechar (Esc)" aria-label="Fechar as preferências de leitura" class="shrink-0 min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">
                    <sl-icon name="x-lg" aria-hidden="true"></sl-icon>
                </button>
            </div>

            {# Tamanho do texto #}
            <div class="mt-5" role="group" aria-labelledby="a11y-font-label">
                <div class="flex items-center justify-between gap-3">
                    <span id="a11y-font-label" class="text-sm font-semibold">Tamanho do texto</span>
                    <output id="a11y-font-value" for="a11y-font-down a11y-font-up" aria-live="polite" class="rounded-lg bg-slate-100 px-2 py-0.5 text-sm font-bold tabular-nums dark:bg-slate-800">100%</output>
                </div>
                <div class="mt-2 flex items-center gap-3">
                    <button type="button" id="a11y-font-down" data-a11y-font="-1" title="Diminuir o texto" class="a11y-step-btn min-w-[44px] min-h-[44px] rounded-xl border border-slate-300 bg-white px-3 text-sm font-bold text-slate-800 hover:border-cech-blue hover:text-cech-blue focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:border-cech-teal dark:hover:text-cech-teal">
                        <span aria-hidden="true">A−</span><span class="sr-only">Diminuir o texto</span>
                    </button>
                    <div class="flex-1 h-2 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden" aria-hidden="true">
                        <div data-a11y-font-bar class="h-full w-0 rounded-full bg-cech-blue dark:bg-cech-teal transition-[width] duration-200"></div>
                    </div>
                    <button type="button" id="a11y-font-up" data-a11y-font="1" title="Aumentar o texto" class="a11y-step-btn min-w-[44px] min-h-[44px] rounded-xl border border-slate-300 bg-white px-3 text-base font-bold text-slate-800 hover:border-cech-blue hover:text-cech-blue focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-100 dark:hover:border-cech-teal dark:hover:text-cech-teal">
                        <span aria-hidden="true">A+</span><span class="sr-only">Aumentar o texto</span>
                    </button>
                </div>
                <p class="mt-1.5 text-xs text-slate-600 dark:text-slate-400">De 100% a 200%. O zoom do navegador também funciona.</p>
            </div>

            {# Tema #}
            <fieldset class="mt-5">
                <legend class="text-sm font-semibold">Tema</legend>
                <div class="mt-2 grid grid-cols-3 gap-1 rounded-2xl bg-slate-100 p-1 dark:bg-slate-800">
                    {% for themeOption in [
                        {value: 'auto', label: 'Automático', icon: 'circle-half'},
                        {value: 'light', label: 'Claro', icon: 'sun-fill'},
                        {value: 'dark', label: 'Escuro', icon: 'moon-stars-fill'},
                    ] %}
                        <label class="a11y-seg block">
                            <input type="radio" name="a11y-theme" value="{{ themeOption.value }}" class="peer sr-only" aria-describedby="a11y-theme-hint" {% if themeOption.value == 'auto' %}checked{% endif %}>
                            <span class="flex min-h-[44px] cursor-pointer flex-col items-center justify-center gap-0.5 rounded-xl px-1 py-1.5 text-center text-xs font-semibold text-slate-600 transition-colors hover:text-slate-900 peer-checked:bg-white peer-checked:text-cech-blue peer-checked:shadow peer-focus-visible:ring-2 peer-focus-visible:ring-sky-500 dark:text-slate-300 dark:hover:text-white dark:peer-checked:bg-slate-950 dark:peer-checked:text-cech-teal">
                                <sl-icon name="{{ themeOption.icon }}" class="text-base" aria-hidden="true"></sl-icon>
                                {{ themeOption.label }}
                            </span>
                        </label>
                    {% endfor %}
                </div>
                <p id="a11y-theme-hint" class="mt-1.5 text-xs text-slate-600 dark:text-slate-400">No automático, o portal segue o tema claro ou escuro do seu aparelho.</p>
            </fieldset>

            {# Alto contraste, espaçamento e animações #}
            <div class="mt-5 space-y-4">
                {% for toggle in [
                    {key: 'contrast', label: 'Alto contraste', hint: 'Textos mais fortes, bordas mais visíveis e links sublinhados.'},
                    {key: 'spacing', label: 'Espaçamento ampliado', hint: 'Mais espaço entre linhas, parágrafos, letras e palavras.'},
                    {key: 'reduceMotion', label: 'Reduzir animações', hint: 'Desliga transições e movimentos. Já vem ligado se o seu aparelho pede menos movimento.'},
                ] %}
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <label for="a11y-{{ toggle.key }}" class="block cursor-pointer text-sm font-semibold">{{ toggle.label }}</label>
                            <p id="a11y-{{ toggle.key }}-hint" class="text-xs text-slate-600 dark:text-slate-400">{{ toggle.hint }}</p>
                        </div>
                        <input type="checkbox" role="switch" id="a11y-{{ toggle.key }}" data-a11y-toggle="{{ toggle.key }}" aria-describedby="a11y-{{ toggle.key }}-hint" class="a11y-switch mt-0.5">
                    </div>
                {% endfor %}
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-4 dark:border-slate-700">
                <button type="button" data-a11y-reset class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800">
