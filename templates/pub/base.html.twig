{#
    Template: templates/pub/base.html.twig
    Finalidade: Layout mestre do portal público do CECH/UFSCar.
    
    Variáveis Globais Disponíveis:
    @var site_settings \App\Entity\SiteSetting|null Configurações globais de metadados, títulos SEO e URLs base
    @var app.user \App\Entity\User|null Usuário logado na sessão atual
    @var app.request \Symfony\Component\HttpFoundation\Request Objeto da requisição HTTP atual
    
    Blocos Principais:
    - title: Título da página exibido na aba do navegador e no Google
    - meta_description: Descrição resumida para mecanismos de busca
    - academic_meta: Metatags específicas para indexação no Google Scholar
    - schema_json_ld: Dados estruturados Schema.org em formato JSON-LD
    - content: Conteúdo principal da página
    - stylesheets / javascripts: Inclusão de assets adicionais
#}
<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        {# ── Dynamic SEO Titles & Meta Descriptions ── #}
        <title>{% block title %}{{ site_settings ? site_settings.seoTitle : 'Portal CECH | Produção Científica e Acadêmica UFSCar' }}{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ site_settings ? site_settings.seoDescription : 'Mapeamento da produção científica, intelectual e acadêmica do Centro de Educação e Ciências Humanas da UFSCar.' }}{% endblock %}">
        <meta name="keywords" content="{% block meta_keywords %}{{ site_settings ? site_settings.seoKeywords : 'UFSCar, CECH, produção científica, currículos lattes, artigos, livros, pós-graduação' }}{% endblock %}">
        <meta name="author" content="CECH — Universidade Federal de São Carlos (UFSCar)">
        <meta name="robots" content="{% block meta_robots %}index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1{% endblock %}">
        
        {# ── Canonical URL & Favicon ── #}
        <link rel="canonical" href="{% block canonical_url %}{{ site_settings ? site_settings.baseUrl ~ app.request.pathInfo : app.request.uri }}{% endblock %}">
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo-colorido.svg') }}">
        <link rel="alternate icon" href="{{ asset('images/logo-colorido.svg') }}">

        {# ── Google Search Console Verification ── #}
        {% if site_settings and site_settings.googleSearchConsoleVerification %}
            <meta name="google-site-verification" content="{{ site_settings.googleSearchConsoleVerification }}">
        {% endif %}

        {# ── Open Graph / Facebook Meta Tags ── #}
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:locale" content="pt_BR">
        <meta property="og:site_name" content="Portal de Produção Científica CECH — UFSCar">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{{ block('canonical_url') }}">
        <meta property="og:image" content="{% block og_image %}{{ (site_settings and site_settings.ogImage) ? site_settings.baseUrl ~ site_settings.ogImage : asset('images/logo-colorido.svg') }}{% endblock %}">

        {# ── Twitter Cards Meta Tags ── #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('og_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">

        {# ── Google Scholar / Academic Citation Meta Tags Block ── #}
        {% block academic_meta %}{% endblock %}

        {# ── PageSpeed Font Optimization: Preconnect & Font-Display Swap ── #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

        {# ── Shoelace Web Components ── #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/themes/light.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/themes/dark.css" />
        <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/shoelace-autoloader.js"></script>

        {# ── Data Visualization Libraries (Chart.js & D3.js) ── #}
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/d3-sankey@0.12.3/dist/d3-sankey.min.js"></script>

        {% block javascripts %}{% endblock %}

        {# ── Google Analytics 4 (GA4) ── #}
        {% if site_settings and site_settings.googleAnalyticsId %}
            <script async src="https://www.googletagmanager.com/gtag/js?id={{ site_settings.googleAnalyticsId }}"></script>
            <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                gtag('config', '{{ site_settings.googleAnalyticsId }}', {
                    page_path: window.location.pathname,
                    anonymize_ip: true
                });
            </script>
        {% endif %}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <style>
                body { font-family: 'Inter', sans-serif; }
                h1, h2, h3, h4, .font-heading { font-family: 'Outfit', sans-serif; }
                .glass-card {
                    background: rgba(255, 255, 255, 0.85);
                    backdrop-filter: blur(12px);
                    border: 1px solid rgba(226, 232, 240, 0.8);
                }
                .dark .glass-card {
                    background: rgba(15, 23, 42, 0.85);
                    backdrop-filter: blur(12px);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                }
                .badge-qualis-a1 { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
                .badge-qualis-a2 { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
                .badge-qualis-a3 { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
                .badge-qualis-a4 { background: #fefce8; color: #854d0e; border: 1px solid #fef08a; }
                .badge-qualis-b1 { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
                .badge-qualis-b2 { background: #f5f3ff; color: #5b21b6; border: 1px solid #ddd6fe; }
                .badge-qualis-b3 { background: #faf5ff; color: #6b21a8; border: 1px solid #e9d5ff; }
                .badge-qualis-b4 { background: #fff1f2; color: #9f1239; border: 1px solid #fecdd3; }
                .badge-qualis-c  { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
            </style>
        {% endblock %}

        {# ── Schema.org Structured Data (JSON-LD) Block ── #}
        {% block schema_json_ld %}
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "CollegeOrUniversity",
                        "@id": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}#organization",
                        "name": "Centro de Educação e Ciências Humanas — UFSCar",
                        "alternateName": "CECH UFSCar",
                        "url": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}",
                        "logo": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}/images/logo-colorido.svg",
                        "parentOrganization": {
                            "@type": "CollegeOrUniversity",
                            "name": "Universidade Federal de São Carlos",
                            "alternateName": "UFSCar",
                            "url": "https://www.ufscar.br"
                        },
                        "address": {
                            "@type": "PostalAddress",
                            "addressLocality": "São Carlos",
                            "addressRegion": "SP",
                            "addressCountry": "BR"
                        }
                    },
                    {
                        "@type": "WebSite",
                        "@id": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}#website",
                        "url": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}",
                        "name": "Portal de Produção Científica CECH UFSCar",
                        "publisher": {
                            "@id": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}#organization"
                        },
                        "potentialAction": {
                            "@type": "SearchAction",
                            "target": {
                                "@type": "EntryPoint",
                                "urlTemplate": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}/busca?q={search_term_string}"
                            },
                            "query-input": "required name=search_term_string"
                        }
                    }
                ]
            }
            </script>
        {% endblock %}

        <script>
            if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                document.documentElement.classList.add('sl-theme-dark');
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.remove('sl-theme-dark');
            }

            function setDarkMode(isDark) {
                if (isDark) {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.add('sl-theme-dark');
                    localStorage.theme = 'dark';
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.classList.remove('sl-theme-dark');
                    localStorage.theme = 'light';
                }
            }
        </script>
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100 flex flex-col justify-between">
        {# ── Navbar ── #}
        <header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/80">
            <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
                <!-- Brand / Logo -->
                <a href="{{ path('app_pub_home') }}" class="flex items-center gap-3 group">
                    <div class="h-10 px-2 py-1 flex items-center justify-center rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-white/10 shadow-sm group-hover:scale-105 transition-transform">
                        <img src="{{ asset('images/logo-colorido.svg') }}" alt="Logo CECH UFSCar" class="h-7 w-auto dark:hidden">
                        <img src="{{ asset('images/logo-colorido-dark.svg') }}" alt="Logo CECH UFSCar" class="h-7 w-auto hidden dark:block">
                    </div>
                    <div class="flex flex-col">
                        <span class="font-heading text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-cech-blue dark:group-hover:text-cech-teal transition-colors">
                            Portal de Produção
                        </span>
                        <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
                            CECH — UFSCar
                        </span>
                    </div>
                </a>

                <!-- Navigation Links -->
                <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
                    <a href="{{ path('app_pub_home') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Início
                    </a>
                    <a href="{{ path('app_pub_indicators') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Indicadores
                    </a>
                    <a href="{{ path('app_pub_department_list') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Departamentos
                    </a>
                    <a href="{{ path('app_pub_search') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Busca
                    </a>
                </nav>

                <!-- Actions: Theme Toggle & Quick Search & Admin Link -->
                <div class="flex items-center gap-3">
                    <form action="{{ path('app_pub_search') }}" method="GET" class="relative hidden sm:block">
                        <input type="text" name="q" placeholder="Buscar docente, artigo, DOI..." class="w-48 lg:w-64 rounded-full border border-slate-300 bg-slate-100/80 px-4 py-1.5 pl-9 text-xs text-slate-900 placeholder:text-slate-400 focus:border-cech-blue focus:bg-white focus:outline-none focus:ring-2 focus:ring-cech-blue/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500">
                        <sl-icon name="search" class="absolute left-3 top-2 text-slate-400 text-xs"></sl-icon>
                    </form>

                    <!-- Dark/Light Mode Switch -->
                    <div class="flex items-center rounded-full border border-slate-200 p-1 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
                        <button type="button" onclick="setDarkMode(false)" title="Modo Claro" class="rounded-full p-1 text-slate-500 hover:text-amber-500 dark:text-slate-400 dark:hover:text-amber-400 transition-colors">
                            <sl-icon name="sun-fill" class="text-sm"></sl-icon>
                        </button>
                        <button type="button" onclick="setDarkMode(true)" title="Modo Escuro" class="rounded-full p-1 text-slate-500 hover:text-cech-teal dark:text-slate-400 dark:hover:text-cech-teal transition-colors">
                            <sl-icon name="moon-stars-fill" class="text-sm"></sl-icon>
                        </button>
                    </div>

                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="rounded-xl bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-slate-800 dark:bg-cech-blue dark:hover:bg-cech-blue-dark transition-colors">
                            Painel Admin
                        </a>
                    {% endif %}
                </div>
            </div>
        </header>

        {# ── Main Content ── #}
        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>

        {# ── Footer ── #}
        <footer class="border-t border-slate-200/80 bg-white/70 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/70 py-10">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-slate-500 dark:text-slate-400">
                <div class="flex items-center gap-3">
                    <img src="{{ asset('images/logo-colorido.svg') }}" alt="Logo CECH UFSCar" class="h-8 w-auto dark:hidden">
                    <img src="{{ asset('images/logo-colorido-dark.svg') }}" alt="Logo CECH UFSCar" class="h-8 w-auto hidden dark:block">
                    <div class="flex flex-col">
                        <span class="font-bold text-slate-800 dark:text-slate-200 text-sm">Centro de Educação e Ciências Humanas</span>
                        <span class="text-slate-500 dark:text-slate-400">Universidade Federal de São Carlos (UFSCar)</span>
                    </div>
                </div>
                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="{{ path('app_pub_home') }}" class="hover:text-cech-blue dark:hover:text-cech-teal transition-colors">Início</a>
                    <a href="{{ path('app_pub_indicators') }}" class="hover:text-cech-blue dark:hover:text-cech-teal transition-colors">Indicadores</a>
                    <a href="{{ path('app_pub_department_list') }}" class="hover:text-cech-blue dark:hover:text-cech-teal transition-colors">Departamentos</a>
                    <a href="{{ path('app_pub_sitemap') }}" class="hover:text-cech-blue dark:hover:text-cech-teal transition-colors">Sitemap XML</a>
                    <a href="{{ path('app_admin_dashboard') }}" class="hover:text-cech-blue dark:hover:text-cech-teal transition-colors">Acesso Restrito</a>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-200/60 dark:border-white/5 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex items-center justify-center gap-2 text-xs text-slate-400 dark:text-slate-500">
                <span>Desenvolvido por</span>
                <a href="https://www.nit.ufscar.br/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:opacity-80 transition-opacity" title="NIT Materiais - Núcleo de Informação Tecnológica em Materiais">
                    <picture class="inline-flex items-center">
                        <source srcset="{{ asset('images/logo-nit.webp') }}" type="image/webp">
                        <img src="{{ asset('images/logo-nit.png') }}" alt="NIT Materiais" width="57" height="20" loading="lazy" decoding="async" class="h-5 w-auto object-contain">
                    </picture>
                    <span class="font-medium text-slate-600 dark:text-slate-300">NIT Materiais</span>
                </a>
            </div>
        </footer>
    </body>
</html>
