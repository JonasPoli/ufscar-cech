{#
    Template: templates/pub/base.html.twig
    Finalidade: Layout mestre do portal público do CECH/UFSCar.
    
    Variáveis Globais Disponíveis:
    @var site_settings \App\Entity\SiteSetting|null Configurações globais de metadados, títulos SEO e URLs base
    @var app.user \App\Entity\User|null Usuário logado na sessão atual
    @var app.request \Symfony\Component\HttpFoundation\Request Objeto da requisição HTTP atual
    
    Blocos Principais:
    - title: Título da página exibido na aba do navegador e no Google
    - meta_description: Descrição resumida para mecanismos de busca
    - academic_meta: Metatags específicas para indexação no Google Scholar
    - schema_json_ld: Dados estruturados Schema.org em formato JSON-LD
    - content: Conteúdo principal da página
    - stylesheets / javascripts: Inclusão de assets adicionais
#}
<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        {# ── Dynamic SEO Titles & Meta Descriptions ── #}
        <title>{% block title %}{{ site_settings ? site_settings.seoTitle : 'Portal CECH | Produção Científica e Acadêmica UFSCar' }}{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ site_settings ? site_settings.seoDescription : 'Mapeamento da produção científica, intelectual e acadêmica do Centro de Educação e Ciências Humanas da UFSCar.' }}{% endblock %}">
        <meta name="keywords" content="{% block meta_keywords %}{{ site_settings ? site_settings.seoKeywords : 'UFSCar, CECH, produção científica, currículos lattes, artigos, livros, pós-graduação' }}{% endblock %}">
        <meta name="author" content="CECH — Universidade Federal de São Carlos (UFSCar)">
        <meta name="robots" content="{% block meta_robots %}index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1{% endblock %}">
        
        {# ── Canonical URL & Favicon ── #}
        <link rel="canonical" href="{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}">
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo-colorido.svg') }}">
        <link rel="alternate icon" href="{{ asset('images/logo-colorido.svg') }}">
        <link rel="image_src" href="{{ block('og_image') }}">

        {# ── Google Search Console Verification ── #}
        {% if site_settings and site_settings.googleSearchConsoleVerification %}
            <meta name="google-site-verification" content="{{ site_settings.googleSearchConsoleVerification }}">
        {% endif %}

        {# ── Open Graph / Facebook / WhatsApp Meta Tags ── #}
        <meta property="og:site_name" content="Portal de Produção Científica CECH — UFSCar">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:locale" content="pt_BR">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{{ block('canonical_url') }}">
        <meta property="og:image" content="{% block og_image %}{{ (site_settings and site_settings.ogImage) ? ((site_settings.ogImage starts with 'http') ? site_settings.ogImage : (app.request.schemeAndHttpHost ~ site_settings.ogImage)) : (app.request.schemeAndHttpHost ~ asset('images/og-cech.png')) }}{% endblock %}">
        <meta property="og:image:secure_url" content="{{ block('og_image') }}">
        <meta property="og:image:type" content="{% block og_image_type %}image/png{% endblock %}">
        <meta property="og:image:width" content="{% block og_image_width %}1200{% endblock %}">
        <meta property="og:image:height" content="{% block og_image_height %}630{% endblock %}">
        <meta property="og:image:alt" content="{% block og_image_alt %}Portal de Produção Científica CECH — UFSCar{% endblock %}">
        {% block extra_og_tags %}{% endblock %}

        {# ── Twitter Cards Meta Tags ── #}
        <meta name="twitter:card" content="{% block twitter_card %}summary_large_image{% endblock %}">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('og_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">
        <meta name="twitter:image:alt" content="{{ block('og_image_alt') }}">

        {# ── Google Scholar / Academic Citation Meta Tags Block ── #}
        {% block academic_meta %}{% endblock %}

        {# ── PageSpeed Optimization: Preconnect to CDNs ── #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

        {# ── Asynchronous Google Fonts (Non-Render-Blocking) ── #}
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" media="print" onload="this.media='all'">
        <noscript>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap">
        </noscript>

        {# ── Shoelace Web Components ── #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/themes/light.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/themes/dark.css" media="(prefers-color-scheme: dark)" id="shoelace-dark-theme" />
        <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/shoelace-autoloader.js"></script>

        {# ── Optional Vendor Scripts (Chart.js / D3.js) - loaded only on pages that require them ── #}
        {% block vendor_scripts %}{% endblock %}

        {% block javascripts %}{% endblock %}

        {# ── Google Analytics 4 (GA4) ── #}
        {% if site_settings and site_settings.googleAnalyticsId %}
            <script async src="https://www.googletagmanager.com/gtag/js?id={{ site_settings.googleAnalyticsId }}"></script>
            <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                gtag('config', '{{ site_settings.googleAnalyticsId }}', {
                    page_path: window.location.pathname,
                    anonymize_ip: true
                });
            </script>
        {% endif %}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <style>
                body { font-family: 'Inter', sans-serif; }
                h1, h2, h3, h4, .font-heading { font-family: 'Outfit', sans-serif; }
                .glass-card {
                    background: rgba(255, 255, 255, 0.85);
                    backdrop-filter: blur(12px);
                    border: 1px solid rgba(226, 232, 240, 0.8);
                }
                .dark .glass-card {
                    background: rgba(15, 23, 42, 0.85);
                    backdrop-filter: blur(12px);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                }
                .badge-qualis-a1 { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
                .badge-qualis-a2 { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
                .badge-qualis-a3 { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
                .badge-qualis-a4 { background: #fefce8; color: #854d0e; border: 1px solid #fef08a; }
                .badge-qualis-b1 { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
                .badge-qualis-b2 { background: #f5f3ff; color: #5b21b6; border: 1px solid #ddd6fe; }
                .badge-qualis-b3 { background: #faf5ff; color: #6b21a8; border: 1px solid #e9d5ff; }
                .badge-qualis-b4 { background: #fff1f2; color: #9f1239; border: 1px solid #fecdd3; }
                .badge-qualis-c  { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
            </style>
        {% endblock %}

        {# Componente de grafo de coautoria (carrega o ECharts sob demanda) #}
        <script src="{{ asset('js/graph.js') }}" defer></script>

        {# Painel "Preferências de leitura" e fórmulas em títulos (KaTeX só é baixado se houver \(…\) ou $$…$$ no <main>) #}
        <script src="{{ asset('js/a11y.js') }}" defer></script>
        <script src="{{ asset('js/math.js') }}" defer></script>

        {# ── Schema.org Structured Data (JSON-LD) Block ── #}
        {% block schema_json_ld %}
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "CollegeOrUniversity",
                        "@id": "{{ app.request.schemeAndHttpHost }}#organization",
                        "name": "Centro de Educação e Ciências Humanas — UFSCar",
                        "alternateName": "CECH UFSCar",
                        "url": "{{ app.request.schemeAndHttpHost }}",
                        "logo": "{{ app.request.schemeAndHttpHost }}/images/og-cech.png",
                        "parentOrganization": {
                            "@type": "CollegeOrUniversity",
                            "name": "Universidade Federal de São Carlos",
                            "alternateName": "UFSCar",
                            "url": "https://www.ufscar.br"
                        },
                        "address": {
                            "@type": "PostalAddress",
                            "addressLocality": "São Carlos",
                            "addressRegion": "SP",
                            "addressCountry": "BR"
                        }
                    },
                    {
                        "@type": "WebSite",
                        "@id": "{{ app.request.schemeAndHttpHost }}#website",
                        "url": "{{ app.request.schemeAndHttpHost }}",
                        "name": "Portal de Produção Científica CECH UFSCar",
                        "publisher": {
                            "@id": "{{ app.request.schemeAndHttpHost }}#organization"
                        },
                        "potentialAction": {
                            "@type": "SearchAction",
                            "target": {
                                "@type": "EntryPoint",
                                "urlTemplate": "{{ app.request.schemeAndHttpHost }}/busca?q={search_term_string}"
                            },
                            "query-input": "required name=search_term_string"
                        }
                    }
                ]
            }
            </script>
        {% endblock %}

        {#
            Preferências de leitura (tema e acessibilidade), aplicadas aqui, antes da pintura da página.
            - Tema: localStorage.theme = 'light' | 'dark'; sem a chave, o tema é automático e acompanha
              prefers-color-scheme ao vivo. Classes 'dark' (Tailwind) e 'sl-theme-dark' (Shoelace) no <html>.
            - Demais preferências: localStorage['cech-a11y'] = {"fontScale":100-200,"contrast":bool,"spacing":bool,
              "reduceMotion":bool|null} (só as diferentes do padrão; null = segue prefers-reduced-motion).
              Classes no <html>: a11y-text-scaled, a11y-contrast, a11y-spacing, a11y-reduce-motion, a11y-motion-full
              e a11y-compact-nav (menu recolhido quando o texto ampliado não cabe no cabeçalho); CSS em assets/styles/app.css.
            - API: window.CechA11y (state, set, setTheme, reset, fitHeader) e window.setDarkMode(isDark).
              O painel "Preferências de leitura" é ligado por assets/js/a11y.js.
        #}
        <script>
            (function (w, d) {
                var KEY = 'cech-a11y';
                var root = d.documentElement;
                var DEFAULTS = { fontScale: 100, contrast: false, spacing: false, reduceMotion: null };
                var mqDark = w.matchMedia ? w.matchMedia('(prefers-color-scheme: dark)') : null;
                var mqMotion = w.matchMedia ? w.matchMedia('(prefers-reduced-motion: reduce)') : null;

                // O armazenamento pode falhar (modo privado, bloqueio de cookies): tudo passa por try/catch
                function read(key) { try { return w.localStorage.getItem(key); } catch (e) { return null; } }
                function write(key, value) {
                    try {
                        if (value === null) { w.localStorage.removeItem(key); } else { w.localStorage.setItem(key, value); }
                    } catch (e) {}
                }

                function has(obj, key) { return Object.prototype.hasOwnProperty.call(obj, key); }

                // Valida valores vindos do armazenamento ou da API (qualquer valor estranho volta ao padrão)
                function normalize(saved) {
                    var out = {}, key;
                    for (key in DEFAULTS) { out[key] = has(saved, key) ? saved[key] : DEFAULTS[key]; }
                    var scale = parseInt(out.fontScale, 10);
                    out.fontScale = (scale >= 100 && scale <= 200) ? scale : 100;
                    out.contrast = out.contrast === true;
                    out.spacing = out.spacing === true;
                    out.reduceMotion = (out.reduceMotion === true || out.reduceMotion === false) ? out.reduceMotion : null;
                    return out;
                }

                function loadPrefs() {
                    var saved;
                    try { saved = JSON.parse(read(KEY) || '{}'); } catch (e) { saved = null; }
                    return normalize(saved && typeof saved === 'object' ? saved : {});
                }

                function savePrefs() {
                    var out = {}, any = false, key;
                    for (key in DEFAULTS) { if (prefs[key] !== DEFAULTS[key]) { out[key] = prefs[key]; any = true; } }
                    write(KEY, any ? JSON.stringify(out) : null);
                }

                var prefs = loadPrefs();

                function getTheme() { var t = read('theme'); return (t === 'dark' || t === 'light') ? t : 'auto'; }

                function applyTheme() {
                    var theme = getTheme();
                    var dark = theme === 'dark' || (theme === 'auto' && !!(mqDark && mqDark.matches));
                    var darkLink = d.getElementById('shoelace-dark-theme');
                    root.classList.toggle('dark', dark);
                    root.classList.toggle('sl-theme-dark', dark);
                    root.style.colorScheme = dark ? 'dark' : 'light';
                    root.setAttribute('data-theme', theme);
                    if (darkLink) { darkLink.media = dark ? 'all' : '(prefers-color-scheme: dark)'; }
                }

                function applyPrefs() {
                    var scale = prefs.fontScale;
                    if (scale !== 100) {
                        root.style.fontSize = scale + '%';
                        root.style.setProperty('--a11y-scale', String(scale / 100));
                    } else {
                        root.style.fontSize = '';
                        root.style.removeProperty('--a11y-scale');
                    }
                    root.classList.toggle('a11y-text-scaled', scale !== 100);
                    root.classList.toggle('a11y-contrast', prefs.contrast);
                    root.classList.toggle('a11y-spacing', prefs.spacing);
                    var reduce = prefs.reduceMotion === null ? !!(mqMotion && mqMotion.matches) : prefs.reduceMotion;
                    root.classList.toggle('a11y-reduce-motion', reduce);
                    root.classList.toggle('a11y-motion-full', prefs.reduceMotion === false);
                }

                function notify() {
                    api.fitHeader();
                    try { d.dispatchEvent(new CustomEvent('cech:a11y-change', { detail: api.state() })); } catch (e) {}
                }

                var api = w.CechA11y = {
                    steps: [100, 110, 125, 150, 175, 200],
                    state: function () {
                        return {
                            theme: getTheme(),
                            dark: root.classList.contains('dark'),
                            fontScale: prefs.fontScale,
                            contrast: prefs.contrast,
                            spacing: prefs.spacing,
                            reduceMotion: root.classList.contains('a11y-reduce-motion')
                        };
                    },
                    set: function (key, value) {
                        if (!has(DEFAULTS, key)) return;
                        prefs[key] = value;
                        prefs = normalize(prefs);
                        savePrefs();
                        applyPrefs();
                        notify();
                    },
                    setTheme: function (theme) {
                        write('theme', (theme === 'dark' || theme === 'light') ? theme : null);
                        applyTheme();
                        notify();
                    },
                    reset: function () {
                        write(KEY, null);
                        write('theme', null);
                        prefs = loadPrefs();
                        applyTheme();
                        applyPrefs();
                        notify();
                    },
                    // Com texto ampliado ou espaçamento maior, recolhe a navegação no botão de menu se o cabeçalho não couber
                    fitHeader: function () {
                        var row = d.getElementById('site-header-row');
                        root.classList.remove('a11y-compact-nav');
                        if (!row || !(root.classList.contains('a11y-text-scaled') || root.classList.contains('a11y-spacing'))) return;
                        root.classList.add('a11y-measuring');
                        var overflows = row.scrollWidth > row.clientWidth + 1;
                        root.classList.remove('a11y-measuring');
                        root.classList.toggle('a11y-compact-nav', overflows);
                    }
                };

                // Mantida por compatibilidade: escolher claro ou escuro grava localStorage.theme
                w.setDarkMode = function (isDark) { api.setTheme(isDark ? 'dark' : 'light'); };

                applyTheme();
                applyPrefs();

                function onChange(mq, fn) {
                    if (!mq) return;
                    if (mq.addEventListener) { mq.addEventListener('change', fn); } else if (mq.addListener) { mq.addListener(fn); }
                }
                onChange(mqDark, function () { if (getTheme() === 'auto') { applyTheme(); notify(); } });
                onChange(mqMotion, function () { if (prefs.reduceMotion === null) { applyPrefs(); notify(); } });

                // Outra aba mudou as preferências
                w.addEventListener('storage', function (e) {
                    if (e.key === KEY || e.key === 'theme' || e.key === null) {
                        prefs = loadPrefs();
                        applyTheme();
                        applyPrefs();
                        notify();
                    }
                });
            })(window, document);
        </script>
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100 flex flex-col justify-between">
        {# Primeiro elemento focável da página: aparece ao receber foco pelo teclado #}
        <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[100] focus:rounded-xl focus:bg-slate-900 focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg focus:outline-none focus:ring-4 focus:ring-sky-400 dark:focus:bg-white dark:focus:text-slate-900">Pular para o conteúdo</a>

        {# ── Navbar ── #}
        <header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/80">
            <div id="site-header-row" class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
                <!-- Brand / Logo -->
                <a href="{{ path('app_pub_home') }}" class="flex items-center gap-3 group">
                    <div class="h-10 px-2 py-1 flex items-center justify-center rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-white/10 shadow-sm group-hover:scale-105 transition-transform">
                        <img src="{{ asset('images/logo-colorido.svg') }}" alt="Logo CECH UFSCar" width="74" height="28" class="h-7 w-auto dark:hidden">
                        <img src="{{ asset('images/logo-colorido-dark.svg') }}" alt="Logo CECH UFSCar" width="74" height="28" class="h-7 w-auto hidden dark:block">
                    </div>
                    {# Com os sete links do menu na barra (lg e xl), o nome por extenso não cabe: fica o logo #}
                    <div class="flex flex-col lg:hidden 2xl:flex">
                        <span class="font-heading text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-cech-blue dark:group-hover:text-cech-teal transition-colors">
                            Portal de Produção
                        </span>
                        <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
                            CECH — UFSCar
                        </span>
                    </div>
                </a>

                <!-- Navigation Links -->
                {% set currentRoute = app.request.attributes.get('_route') ?? '' %}
                {% set navItems = [
                    {route: 'app_pub_search', label: 'Especialistas', match: 'app_pub_search'},
                    {route: 'app_pub_explore', label: 'Explorar', match: 'app_pub_explore'},
                    {route: 'app_pub_coauthorship', label: 'Coautorias', match: 'app_pub_coauthorship'},
                    {route: 'app_pub_projects', label: 'Projetos', match: 'app_pub_project'},
                    {route: 'app_pub_indicators', label: 'Indicadores', match: 'app_pub_indicators'},
                    {route: 'app_pub_journals_index', label: 'Periódicos', match: 'app_pub_journals'},
                    {route: 'app_pub_department_list', label: 'Departamentos', match: 'app_pub_department'},
                ] %}
                <nav class="hidden lg:flex items-center gap-4 xl:gap-5 text-sm font-medium" aria-label="Navegação principal">
                    {% for item in navItems %}
                        {% set isActive = currentRoute starts with item.match %}
                        <a href="{{ path(item.route) }}" {% if isActive %}aria-current="page"{% endif %} class="{{ isActive ? 'text-cech-blue dark:text-cech-teal font-semibold' : 'text-slate-600 dark:text-slate-300' }} hover:text-cech-blue dark:hover:text-cech-teal transition-colors">
                            {{ item.label }}
                        </a>
                    {% endfor %}
                </nav>

                <!-- Actions: Theme Toggle & Quick Search & Admin Link & Hamburger -->
                <div class="flex items-center gap-2 sm:gap-3">
                    {# Com sete links na barra, o campo de busca rápida só cabe a partir de xl; abaixo disso o link "Especialistas" leva à busca #}
                    <form id="header-search" action="{{ path('app_pub_search') }}" method="GET" role="search" class="relative hidden sm:block lg:hidden xl:block">
                        <input type="text" name="q" placeholder="Buscar docente, artigo, DOI..." class="w-48 lg:w-64 rounded-full border border-slate-300 bg-slate-100/80 px-4 py-1.5 pl-9 text-xs text-slate-900 placeholder:text-slate-400 focus:border-cech-blue focus:bg-white focus:outline-none focus:ring-2 focus:ring-cech-blue/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500">
                        <sl-icon name="search" class="absolute left-3 top-2 text-slate-400 text-xs"></sl-icon>
                    </form>

                    <!-- Acessibilidade: abre o painel "Preferências de leitura" (tamanho do texto, tema, contraste, espaçamento, animações) -->
                    <button type="button" id="a11y-toggle" data-a11y-open aria-controls="a11y-panel" aria-expanded="false" aria-haspopup="dialog" title="Acessibilidade: tamanho do texto, tema e contraste" class="hidden sm:inline-flex min-w-[40px] min-h-[40px] items-center justify-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 px-2.5 text-slate-700 hover:text-cech-blue focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:text-cech-teal dark:focus-visible:ring-offset-slate-950 transition-colors">
                        <sl-icon name="universal-access-circle" class="text-lg" aria-hidden="true"></sl-icon>
                        <span class="sr-only md:not-sr-only lg:sr-only 2xl:not-sr-only text-xs font-semibold">Acessibilidade</span>
                    </button>

                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="hidden sm:inline-flex rounded-xl bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-slate-800 dark:bg-cech-blue dark:hover:bg-cech-blue-dark transition-colors">
                            Painel Admin
                        </a>
                    {% endif %}

                    <!-- Mobile Hamburger Button -->
                    <button 
                        type="button" 
                        id="mobile-menu-btn" 
                        onclick="toggleMobileMenu()" 
                        class="lg:hidden flex items-center justify-center p-2 rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shadow-2xs" 
                        aria-label="Abrir Menu" 
                        aria-expanded="false"
                    >
                        <sl-icon name="list" id="mobile-menu-icon" class="text-xl"></sl-icon>
                    </button>
                </div>
            </div>
        </header>
        {# Com texto ampliado, decide já aqui (antes da pintura) se a navegação precisa ir para o botão de menu #}
