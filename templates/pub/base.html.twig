{#
    Template: templates/pub/base.html.twig
    Finalidade: Layout mestre do portal público do CECH/UFSCar.
    
    Variáveis Globais Disponíveis:
    @var site_settings \App\Entity\SiteSetting|null Configurações globais de metadados, títulos SEO e URLs base
    @var app.user \App\Entity\User|null Usuário logado na sessão atual
    @var app.request \Symfony\Component\HttpFoundation\Request Objeto da requisição HTTP atual
    
    Blocos Principais:
    - title: Título da página exibido na aba do navegador e no Google
    - meta_description: Descrição resumida para mecanismos de busca
    - academic_meta: Metatags específicas para indexação no Google Scholar
    - schema_json_ld: Dados estruturados Schema.org em formato JSON-LD
    - content: Conteúdo principal da página
    - stylesheets / javascripts: Inclusão de assets adicionais
#}
<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        {# ── Dynamic SEO Titles & Meta Descriptions ── #}
        <title>{% block title %}{{ site_settings ? site_settings.seoTitle : 'Portal CECH | Produção Científica e Acadêmica UFSCar' }}{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ site_settings ? site_settings.seoDescription : 'Mapeamento da produção científica, intelectual e acadêmica do Centro de Educação e Ciências Humanas da UFSCar.' }}{% endblock %}">
        <meta name="keywords" content="{% block meta_keywords %}{{ site_settings ? site_settings.seoKeywords : 'UFSCar, CECH, produção científica, currículos lattes, artigos, livros, pós-graduação' }}{% endblock %}">
        <meta name="author" content="CECH — Universidade Federal de São Carlos (UFSCar)">
        <meta name="robots" content="{% block meta_robots %}index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1{% endblock %}">
        
        {# ── Canonical URL & Favicon ── #}
        <link rel="canonical" href="{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}">
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo-colorido.svg') }}">
        <link rel="alternate icon" href="{{ asset('images/logo-colorido.svg') }}">
        <link rel="image_src" href="{{ block('og_image') }}">

        {# ── Google Search Console Verification ── #}
        {% if site_settings and site_settings.googleSearchConsoleVerification %}
            <meta name="google-site-verification" content="{{ site_settings.googleSearchConsoleVerification }}">
        {% endif %}

        {# ── Open Graph / Facebook / WhatsApp Meta Tags ── #}
        <meta property="og:site_name" content="Portal de Produção Científica CECH — UFSCar">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:locale" content="pt_BR">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{{ block('canonical_url') }}">
        <meta property="og:image" content="{% block og_image %}{{ (site_settings and site_settings.ogImage) ? ((site_settings.ogImage starts with 'http') ? site_settings.ogImage : (app.request.schemeAndHttpHost ~ site_settings.ogImage)) : (app.request.schemeAndHttpHost ~ asset('images/og-cech.png')) }}{% endblock %}">
        <meta property="og:image:secure_url" content="{{ block('og_image') }}">
        <meta property="og:image:type" content="{% block og_image_type %}image/png{% endblock %}">
        <meta property="og:image:width" content="{% block og_image_width %}1200{% endblock %}">
        <meta property="og:image:height" content="{% block og_image_height %}630{% endblock %}">
        <meta property="og:image:alt" content="{% block og_image_alt %}Portal de Produção Científica CECH — UFSCar{% endblock %}">
        {% block extra_og_tags %}{% endblock %}

        {# ── Twitter Cards Meta Tags ── #}
        <meta name="twitter:card" content="{% block twitter_card %}summary_large_image{% endblock %}">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('og_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">
        <meta name="twitter:image:alt" content="{{ block('og_image_alt') }}">

        {# ── Google Scholar / Academic Citation Meta Tags Block ── #}
        {% block academic_meta %}{% endblock %}

        {# ── PageSpeed Optimization: Preconnect to CDNs ── #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

        {# ── Asynchronous Google Fonts (Non-Render-Blocking) ── #}
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" media="print" onload="this.media='all'">
        <noscript>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap">
        </noscript>

        {# ── Shoelace Web Components ── #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/themes/light.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/themes/dark.css" media="(prefers-color-scheme: dark)" id="shoelace-dark-theme" />
        <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/shoelace-autoloader.js"></script>

        {# ── Optional Vendor Scripts (Chart.js / D3.js) - loaded only on pages that require them ── #}
        {% block vendor_scripts %}{% endblock %}

        {% block javascripts %}{% endblock %}

        {# ── Google Analytics 4 (GA4) ── #}
        {% if site_settings and site_settings.googleAnalyticsId %}
            <script async src="https://www.googletagmanager.com/gtag/js?id={{ site_settings.googleAnalyticsId }}"></script>
            <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                gtag('config', '{{ site_settings.googleAnalyticsId }}', {
                    page_path: window.location.pathname,
                    anonymize_ip: true
                });
            </script>
        {% endif %}

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <style>
                body { font-family: 'Inter', sans-serif; }
                h1, h2, h3, h4, .font-heading { font-family: 'Outfit', sans-serif; }
                .glass-card {
                    background: rgba(255, 255, 255, 0.85);
                    backdrop-filter: blur(12px);
                    border: 1px solid rgba(226, 232, 240, 0.8);
                }
                .dark .glass-card {
                    background: rgba(15, 23, 42, 0.85);
                    backdrop-filter: blur(12px);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                }
                .badge-qualis-a1 { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
                .badge-qualis-a2 { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
                .badge-qualis-a3 { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
                .badge-qualis-a4 { background: #fefce8; color: #854d0e; border: 1px solid #fef08a; }
                .badge-qualis-b1 { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
                .badge-qualis-b2 { background: #f5f3ff; color: #5b21b6; border: 1px solid #ddd6fe; }
                .badge-qualis-b3 { background: #faf5ff; color: #6b21a8; border: 1px solid #e9d5ff; }
                .badge-qualis-b4 { background: #fff1f2; color: #9f1239; border: 1px solid #fecdd3; }
                .badge-qualis-c  { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
            </style>
        {% endblock %}

        {# ── Schema.org Structured Data (JSON-LD) Block ── #}
        {% block schema_json_ld %}
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "CollegeOrUniversity",
                        "@id": "{{ app.request.schemeAndHttpHost }}#organization",
                        "name": "Centro de Educação e Ciências Humanas — UFSCar",
                        "alternateName": "CECH UFSCar",
                        "url": "{{ app.request.schemeAndHttpHost }}",
                        "logo": "{{ app.request.schemeAndHttpHost }}/images/og-cech.png",
                        "parentOrganization": {
                            "@type": "CollegeOrUniversity",
                            "name": "Universidade Federal de São Carlos",
                            "alternateName": "UFSCar",
                            "url": "https://www.ufscar.br"
                        },
                        "address": {
                            "@type": "PostalAddress",
                            "addressLocality": "São Carlos",
                            "addressRegion": "SP",
                            "addressCountry": "BR"
                        }
                    },
                    {
                        "@type": "WebSite",
                        "@id": "{{ app.request.schemeAndHttpHost }}#website",
                        "url": "{{ app.request.schemeAndHttpHost }}",
                        "name": "Portal de Produção Científica CECH UFSCar",
                        "publisher": {
                            "@id": "{{ app.request.schemeAndHttpHost }}#organization"
                        },
                        "potentialAction": {
                            "@type": "SearchAction",
                            "target": {
                                "@type": "EntryPoint",
                                "urlTemplate": "{{ app.request.schemeAndHttpHost }}/busca?q={search_term_string}"
                            },
                            "query-input": "required name=search_term_string"
                        }
                    }
                ]
            }
            </script>
        {% endblock %}

        <script>
            (function() {
                var darkLink = document.getElementById('shoelace-dark-theme');
                var isDark = localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (isDark) {
                    document.documentElement.classList.add('dark', 'sl-theme-dark');
                    if (darkLink) darkLink.media = 'all';
                } else {
                    document.documentElement.classList.remove('dark', 'sl-theme-dark');
                }
            })();

            function setDarkMode(isDark) {
                var darkLink = document.getElementById('shoelace-dark-theme');
                if (isDark) {
                    document.documentElement.classList.add('dark', 'sl-theme-dark');
                    localStorage.theme = 'dark';
                    if (darkLink) darkLink.media = 'all';
                } else {
                    document.documentElement.classList.remove('dark', 'sl-theme-dark');
                    localStorage.theme = 'light';
                }
            }
        </script>
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100 flex flex-col justify-between">
        {# ── Navbar ── #}
        <header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/80">
            <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
                <!-- Brand / Logo -->
                <a href="{{ path('app_pub_home') }}" class="flex items-center gap-3 group">
                    <div class="h-10 px-2 py-1 flex items-center justify-center rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-white/10 shadow-sm group-hover:scale-105 transition-transform">
                        <img src="{{ asset('images/logo-colorido.svg') }}" alt="Logo CECH UFSCar" width="74" height="28" class="h-7 w-auto dark:hidden">
                        <img src="{{ asset('images/logo-colorido-dark.svg') }}" alt="Logo CECH UFSCar" width="74" height="28" class="h-7 w-auto hidden dark:block">
                    </div>
                    <div class="flex flex-col">
                        <span class="font-heading text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-cech-blue dark:group-hover:text-cech-teal transition-colors">
                            Portal de Produção
                        </span>
                        <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
                            CECH — UFSCar
                        </span>
                    </div>
                </a>

                <!-- Navigation Links -->
                <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
                    <a href="{{ path('app_pub_home') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Início
                    </a>
                    <a href="{{ path('app_pub_indicators') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Indicadores
                    </a>
                    <a href="{{ path('app_pub_department_list') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Departamentos
                    </a>
                    <a href="{{ path('app_pub_thematic_search') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Temas
                    </a>
                    <a href="{{ path('app_pub_search') }}" class="text-slate-600 hover:text-cech-blue dark:text-slate-300 dark:hover:text-cech-teal transition-colors">
                        Busca
                    </a>
                </nav>

                <!-- Actions: Theme Toggle & Quick Search & Admin Link & Hamburger -->
                <div class="flex items-center gap-2 sm:gap-3">
                    <form action="{{ path('app_pub_search') }}" method="GET" class="relative hidden sm:block">
                        <input type="text" name="q" placeholder="Buscar docente, artigo, DOI..." class="w-48 lg:w-64 rounded-full border border-slate-300 bg-slate-100/80 px-4 py-1.5 pl-9 text-xs text-slate-900 placeholder:text-slate-400 focus:border-cech-blue focus:bg-white focus:outline-none focus:ring-2 focus:ring-cech-blue/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500">
                        <sl-icon name="search" class="absolute left-3 top-2 text-slate-400 text-xs"></sl-icon>
                    </form>

                    <!-- Dark/Light Mode Switch -->
                    <div class="flex items-center rounded-full border border-slate-200 p-0.5 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
                        <button type="button" onclick="setDarkMode(false)" title="Modo Claro" aria-label="Ativar modo claro" class="min-w-[40px] min-h-[40px] rounded-full p-2 flex items-center justify-center text-slate-600 hover:text-amber-500 dark:text-slate-400 dark:hover:text-amber-400 transition-colors">
                            <sl-icon name="sun-fill" class="text-base"></sl-icon>
                        </button>
                        <button type="button" onclick="setDarkMode(true)" title="Modo Escuro" aria-label="Ativar modo escuro" class="min-w-[40px] min-h-[40px] rounded-full p-2 flex items-center justify-center text-slate-600 hover:text-cech-teal dark:text-slate-400 dark:hover:text-cech-teal transition-colors">
                            <sl-icon name="moon-stars-fill" class="text-base"></sl-icon>
                        </button>
                    </div>

                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="hidden sm:inline-flex rounded-xl bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-slate-800 dark:bg-cech-blue dark:hover:bg-cech-blue-dark transition-colors">
                            Painel Admin
                        </a>
                    {% endif %}

                    <!-- Mobile Hamburger Button -->
                    <button 
                        type="button" 
                        id="mobile-menu-btn" 
                        onclick="toggleMobileMenu()" 
                        class="md:hidden flex items-center justify-center p-2 rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer shadow-2xs" 
                        aria-label="Abrir Menu" 
                        aria-expanded="false"
                    >
                        <sl-icon name="list" id="mobile-menu-icon" class="text-xl"></sl-icon>
                    </button>
                </div>
            </div>
        </header>

        {# ── Mobile Slide-Over Drawer & Backdrop ── #}
        <div id="mobile-menu-backdrop" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden" onclick="closeMobileMenu()" aria-hidden="true"></div>

        <div id="mobile-menu-drawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-xs sm:max-w-sm bg-white/95 dark:bg-slate-950/95 backdrop-blur-xl shadow-2xl border-l border-slate-200 dark:border-slate-800 translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col justify-between overflow-y-auto" role="dialog" aria-modal="true" aria-label="Menu Principal">
            <!-- Header do Menu -->
            <div class="p-5 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="h-9 px-2 py-1 flex items-center justify-center rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-white/10 shadow-2xs">
                        <img src="{{ asset('images/logo-colorido.svg') }}" alt="Logo CECH" width="64" height="24" class="h-6 w-auto dark:hidden">
                        <img src="{{ asset('images/logo-colorido-dark.svg') }}" alt="Logo CECH" width="64" height="24" class="h-6 w-auto hidden dark:block">
                    </div>
                    <div>
                        <span class="font-heading text-sm font-bold tracking-tight text-slate-900 dark:text-white block">
                            Portal de Produção
                        </span>
                        <span class="text-[10px] text-slate-500 dark:text-slate-400 block">
                            CECH • UFSCar
                        </span>
                    </div>
                </div>
                <button type="button" onclick="closeMobileMenu()" class="p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer" aria-label="Fechar Menu">
                    <sl-icon name="x-lg" class="text-base"></sl-icon>
                </button>
            </div>

            <!-- Corpo do Menu: Busca + Navegação Principal + Atalhos -->
            <div class="p-5 space-y-6 flex-1">
                <!-- Busca Rápida Mobile -->
                <form action="{{ path('app_pub_search') }}" method="GET" class="relative">
                    <input 
                        type="text" 
                        name="q" 
                        placeholder="Buscar docente, artigo, DOI..." 
                        class="w-full rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 px-4 py-2.5 pl-10 text-sm text-slate-900 placeholder:text-slate-400 focus:border-sky-500 focus:bg-white dark:focus:bg-slate-900 focus:outline-none dark:text-white"
                    >
                    <sl-icon name="search" class="absolute left-3.5 top-3 text-slate-400 text-sm"></sl-icon>
                </form>

                <!-- Links Principais -->
                <div class="space-y-1">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-2">Navegação</span>
                    
                    {# Início #}
                    <a href="{{ path('app_pub_home') }}" class="flex items-center gap-3.5 px-3 py-2.5 rounded-2xl text-slate-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-sky-950/50 hover:text-sky-600 dark:hover:text-sky-400 transition-colors group {% if app.request.attributes.get('_route') == 'app_pub_home' %}bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 font-semibold{% endif %}">
                        <div class="h-8 w-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-hover:bg-sky-500 group-hover:text-white transition-colors">
                            <sl-icon name="house-fill" class="text-sm"></sl-icon>
                        </div>
                        <div class="flex-1">
                            <div class="text-sm font-semibold">Início</div>
                            <div class="text-[11px] text-slate-400">Página inicial do portal</div>
                        </div>
                    </a>

                    {# Indicadores #}
                    <a href="{{ path('app_pub_indicators') }}" class="flex items-center gap-3.5 px-3 py-2.5 rounded-2xl text-slate-700 dark:text-slate-200 hover:bg-emerald-50 dark:hover:bg-emerald-950/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors group {% if 'indicators' in app.request.attributes.get('_route') %}bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 font-semibold{% endif %}">
                        <div class="h-8 w-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-hover:bg-emerald-500 group-hover:text-white transition-colors">
                            <sl-icon name="graph-up-arrow" class="text-sm"></sl-icon>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-semibold">Indicadores</span>
                                <span class="text-[9px] uppercase font-bold px-1.5 py-0.2 rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Auto-Avaliação</span>
                            </div>
                            <div class="text-[11px] text-slate-400">18 figuras e métricas do CECH</div>
                        </div>
                    </a>

                    {# Departamentos #}
                    <a href="{{ path('app_pub_department_list') }}" class="flex items-center gap-3.5 px-3 py-2.5 rounded-2xl text-slate-700 dark:text-slate-200 hover:bg-indigo-50 dark:hover:bg-indigo-950/50 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors group {% if 'department' in app.request.attributes.get('_route') %}bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-semibold{% endif %}">
                        <div class="h-8 w-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-hover:bg-indigo-500 group-hover:text-white transition-colors">
                            <sl-icon name="building" class="text-sm"></sl-icon>
                        </div>
                        <div class="flex-1">
                            <div class="text-sm font-semibold">Departamentos</div>
                            <div class="text-[11px] text-slate-400">Departamentos e docentes vinculados</div>
                        </div>
                    </a>

                    {# Temas #}
                    <a href="{{ path('app_pub_thematic_search') }}" class="flex items-center gap-3.5 px-3 py-2.5 rounded-2xl text-slate-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-sky-950/50 hover:text-sky-600 dark:hover:text-sky-400 transition-colors group {% if 'thematic' in app.request.attributes.get('_route') %}bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 font-semibold{% endif %}">
                        <div class="h-8 w-8 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-hover:bg-sky-500 group-hover:text-white transition-colors">
                            <sl-icon name="stars" class="text-sm"></sl-icon>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-semibold">Temas</span>
                                <span class="text-[9px] uppercase font-bold px-1.5 py-0.2 rounded-md bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300">Descoberta</span>
                            </div>
                            <div class="text-[11px] text-slate-400">Palavras-chave e conceitos</div>
                        </div>
                    </a>

                    {# Busca #}
