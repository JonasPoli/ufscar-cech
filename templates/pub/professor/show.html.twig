{#
    Template: templates/pub/professor/show.html.twig
    Finalidade: Exibição pública moderna e modular do perfil do docente/pesquisador do CECH UFSCar (4 abas com lazy loading).
#}
{% extends 'pub/base.html.twig' %}

{% block title %}{{ researcher.fullName }} | Currículo Lattes & Produção Científica — CECH UFSCar{% endblock %}
{% block meta_description %}{{ researcher.abstractResume ? researcher.abstractResume|slice(0, 155) ~ '...' : 'Perfil acadêmico, produções científicas, orientações e trajetória de ' ~ researcher.fullName ~ ' no CECH - UFSCar.' }}{% endblock %}
{% block meta_keywords %}{{ researcher.fullName }}, {{ researcher.department }}, UFSCar, CECH, currículo lattes, produção científica, {{ researcher.citationNames }}{% endblock %}

{% block og_type %}profile{% endblock %}
{% block og_title %}{{ researcher.fullName }} — Docente e Pesquisador(a) do CECH UFSCar{% endblock %}
{% block og_description %}{{ researcher.abstractResume ? researcher.abstractResume|slice(0, 155) ~ '...' : 'Currículo e produção científica de ' ~ researcher.fullName ~ ' no CECH - UFSCar.' }}{% endblock %}

{# ── Academic Google Scholar Meta Tags ── #}
{% block academic_meta %}
    {% for a in articles|slice(0, 8) %}
        <meta name="citation_title" content="{{ a.title|e('html_attr') }}">
        <meta name="citation_author" content="{{ researcher.fullName|e('html_attr') }}">
        {% if a.year %}<meta name="citation_publication_date" content="{{ a.year }}">{% endif %}
        {% if a.journalName %}<meta name="citation_journal_title" content="{{ a.journalName|e('html_attr') }}">{% endif %}
        {% if a.doi %}<meta name="citation_doi" content="{{ a.doi|e('html_attr') }}">{% endif %}
        {% if a.issn %}<meta name="citation_issn" content="{{ a.issn|e('html_attr') }}">{% endif %}
    {% endfor %}
{% endblock %}

{# ── Schema.org Structured Data (JSON-LD) for Person ── #}
{% block schema_json_ld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}{{ path('app_pub_professor_show', {'slugOrId': researcher.slug ?: researcher.idLattes}) }}#person",
    "name": "{{ researcher.fullName|e('js') }}",
    {% if researcher.citationNames %}"alternateName": {{ researcher.citationNames|split(';')|map(n => n|trim)|json_encode|raw }},{% endif %}
    "jobTitle": "Docente e Pesquisador(a)",
    "worksFor": {
        "@type": "CollegeOrUniversity",
        "name": "Centro de Educação e Ciências Humanas — UFSCar",
        "parentOrganization": {
            "@type": "CollegeOrUniversity",
            "name": "Universidade Federal de São Carlos",
            "url": "https://www.ufscar.br"
        }
    },
    {% if researcher.department %}"department": "{{ researcher.department|e('js') }}",{% endif %}
    {% if researcher.email %}"email": "mailto:{{ researcher.email }}",{% endif %}
    "sameAs": [
        "{{ researcher.lattesUrl }}"{% if researcher.orcid %},
        "{{ researcher.orcidUrl }}"{% endif %}
    ],
    {% if researcher.abstractResume %}"description": "{{ researcher.abstractResume|slice(0, 300)|e('js') }}",{% endif %}
    "alumniOf": [
        {% for e in researcher.educations %}
            {
                "@type": "EducationalOrganization",
                "name": "{{ e.institutionName|e('js') }}"
            }{% if not loop.last %},{% endif %}
        {% endfor %}
    ],
    "knowsAbout": [
        {% for ka in researcher.knowledgeAreas %}
            "{{ ka.area|e('js') }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: #fff !important; color: #000 !important; font-size: 11pt; }
            .glass-card { background: #fff !important; border: 1px solid #ccc !important; box-shadow: none !important; }
            .prof-tab-pane { display: block !important; opacity: 1 !important; visibility: visible !important; }
            a { text-decoration: none !important; color: #000 !important; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 no-print" aria-label="Breadcrumb">
        <a href="{{ path('app_pub_home') }}" class="hover:text-sky-600 dark:hover:text-sky-400">Início</a>
        <span>/</span>
        {% if researcher.departmentCode %}
            <a href="{{ path('app_pub_department_show', {'codeOrSlug': researcher.departmentCode}) }}" class="hover:text-sky-600 dark:hover:text-sky-400">
                {{ researcher.department }}
            </a>
            <span>/</span>
        {% endif %}
        <span class="text-slate-900 dark:text-white font-medium truncate" aria-current="page">{{ researcher.fullName }}</span>
    </nav>

    <!-- Researcher Profile Header Card -->
    <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-sm relative overflow-hidden">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 flex-1 min-w-0">
                <!-- Avatar / Photo -->
                <div class="flex h-28 w-28 sm:h-32 sm:w-32 shrink-0 items-center justify-center rounded-2xl overflow-hidden shadow-lg shadow-sky-500/20 {% if not researcher.photoUrl %}bg-gradient-to-tr from-sky-600 via-indigo-600 to-purple-600 text-white font-bold text-3xl sm:text-4xl{% endif %}">
                    {% if researcher.photoUrl %}
                        <img src="{{ researcher.photoUrl }}" alt="{{ researcher.fullName }}" class="h-full w-full object-cover" onerror="this.onerror=null;this.parentElement.innerHTML='{{ researcher.fullName|slice(0, 2)|upper }}';this.parentElement.className='flex h-28 w-28 sm:h-32 sm:w-32 shrink-0 items-center justify-center rounded-2xl overflow-hidden shadow-lg bg-gradient-to-tr from-sky-600 via-indigo-600 to-purple-600 text-white font-bold text-3xl sm:text-4xl';">
                    {% else %}
                        {{ researcher.fullName|slice(0, 2)|upper }}
                    {% endif %}
                </div>

                <!-- Profile Info -->
                <div class="flex-1 min-w-0 space-y-2">
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                            {{ researcher.fullName }}
                        </h1>
                        {% if researcher.departmentCode %}
                            <span class="rounded-full bg-sky-100 px-3 py-0.5 text-xs font-bold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                                {{ researcher.departmentCode }}
                            </span>
                        {% endif %}
                    </div>

                    {% set citationVariants = author_thesaurus_variants(researcher) %}
                    {% if citationVariants|length > 0 %}
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                            <strong class="font-medium text-slate-700 dark:text-slate-300">Nomes em Citação:</strong> {{ citationVariants|join('; ') }}
                        </p>
                    {% elseif researcher.citationNames %}
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                            <strong class="font-medium text-slate-700 dark:text-slate-300">Nomes em Citação:</strong> {{ researcher.citationNames }}
                        </p>
                    {% endif %}

                    <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400 pt-1">
                        {% if researcher.department %}
                            <span class="flex items-center gap-1 font-medium text-slate-700 dark:text-slate-200">
                                <sl-icon name="building" class="text-sky-500"></sl-icon> {{ researcher.department }}
                            </span>
                        {% endif %}
                        {% if researcher.lastLattesUpdate %}
                            <span class="flex items-center gap-1 font-medium text-slate-600 dark:text-slate-300">
                                <sl-icon name="clock-history"></sl-icon> Atualização Lattes: {{ researcher.lastLattesUpdate|date('d/m/Y') }}
                            </span>
                        {% endif %}
                    </div>

                    {% if researcher.languageProficiencies|length > 0 %}
                        <div class="flex flex-wrap items-center gap-1.5 pt-1 text-xs">
                            <span class="text-slate-400 font-medium mr-1 flex items-center gap-1">
                                <sl-icon name="translate"></sl-icon> Idiomas:
                            </span>
                            {% for lang in researcher.languageProficiencies %}
                                <span class="rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 px-2 py-0.5 text-[11px] font-medium text-slate-700 dark:text-slate-300" title="Compreensão: {{ lang.comprehension ?: '-' }} | Fala: {{ lang.speaking ?: '-' }} | Leitura: {{ lang.reading ?: '-' }} | Escrita: {{ lang.writing ?: '-' }}">
                                    <strong class="font-semibold text-sky-600 dark:text-sky-400">{{ lang.language }}</strong>
                                    {% if lang.reading %}<span class="text-slate-400 text-[10px]"> (Lê: {{ lang.reading|lower }})</span>{% endif %}
                                </span>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- External Action Links & Academic Export -->
            <div class="flex flex-wrap lg:flex-col gap-2 w-full lg:w-auto shrink-0 pt-4 lg:pt-0 border-t lg:border-t-0 border-slate-200/60 dark:border-white/10 no-print">
                <a href="{{ researcher.lattesUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white hover:bg-slate-800 dark:bg-sky-600 dark:hover:bg-sky-500 shadow-sm transition-colors flex-1 lg:flex-none" title="Abrir Currículo Lattes oficial no CNPq">
                    <sl-icon name="box-arrow-up-right"></sl-icon> Currículo Lattes
                </a>

                {% if researcher.orcid %}
                    <a href="{{ researcher.orcidUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-500/40 bg-emerald-50/50 px-4 py-2.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-900/60 shadow-sm transition-colors flex-1 lg:flex-none" title="Abrir registro ORCID em nova aba">
                        <span class="h-3.5 w-3.5 rounded-full bg-emerald-500 text-[9px] text-white flex items-center justify-center font-bold">iD</span>
                        ORCID: {{ researcher.orcid }}
                    </a>
                {% endif %}

                {% if researcher.email %}
                    <a href="mailto:{{ researcher.email }}" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors">
                        <sl-icon name="envelope"></sl-icon> {{ researcher.email }}
                    </a>
                {% endif %}

                <!-- Export Action Dropdown -->
                <div class="flex items-center gap-1.5 pt-1 w-full justify-start lg:justify-end">
                    <a href="{{ path('app_pub_professor_export', {'slugOrId': researcher.slug ?: researcher.idLattes, 'format': 'bibtex'}) }}" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300" title="Baixar todas as produções no formato BibTeX">
                        <sl-icon name="download"></sl-icon> BibTeX
                    </a>
                    <a href="{{ path('app_pub_professor_export', {'slugOrId': researcher.slug ?: researcher.idLattes, 'format': 'json'}) }}" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300" title="Baixar currículo completo em JSON">
                        <sl-icon name="code-slash"></sl-icon> JSON
                    </a>
                    <a href="{{ path('app_pub_professor_export', {'slugOrId': researcher.slug ?: researcher.idLattes, 'format': 'csv'}) }}" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300" title="Exportar tabela de produções em CSV">
                        <sl-icon name="file-earmark-spreadsheet"></sl-icon> CSV
                    </a>
                    <button type="button" onclick="window.print()" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300" title="Imprimir / Salvar em PDF">
                        <sl-icon name="printer"></sl-icon>
                    </button>
                </div>
            </div>
        </div>

        <!-- Abstract Resume -->
        {% if researcher.abstractResume %}
            <div class="mt-6 pt-6 border-t border-slate-200/60 dark:border-white/10 space-y-2">
                <h2 class="font-heading text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                    <sl-icon name="file-text" class="text-sky-500"></sl-icon> Resumo do Currículo Lattes
                </h2>
                <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed text-justify">
                    {{ researcher.abstractResume }}
                </p>
            </div>
        {% endif %}
    </div>

    <!-- ── KPI Summary Cards (Métricas Rápidas de Resumo) ── -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 no-print">
        <!-- Card 1: Artigos -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-sky-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Artigos Periódicos</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-sky-600 dark:text-sky-400 font-heading">
                {{ kpiStats.articlesCount }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <span class="inline-block h-2 w-2 rounded-full {% if kpiStats.percentArticlesWithDoi > 50 %}bg-emerald-500{% else %}bg-amber-500{% endif %}"></span>
                {{ kpiStats.percentArticlesWithDoi }}% com DOI
            </div>
        </div>

        <!-- Card 2: Livros & Capítulos -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-amber-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Livros / Capítulos</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-amber-600 dark:text-amber-400 font-heading">
                {{ kpiStats.booksCount + kpiStats.chaptersCount }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                {{ kpiStats.booksCount }} livros, {{ kpiStats.chaptersCount }} cap.
            </div>
        </div>

        <!-- Card 3: Eventos -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-purple-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Em Congressos</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-purple-600 dark:text-purple-400 font-heading">
                {{ kpiStats.eventsCount }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                Trabalhos e Anais
            </div>
        </div>

        <!-- Card 4: Produções Técnicas / Inovação -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-emerald-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Produção Técnica</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 font-heading">
                {{ kpiStats.techCount }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                Técnicos, Softwares, Pat.
            </div>
        </div>

        <!-- Card 5: Orientações Concluídas -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-rose-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Orientações Concl.</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-rose-600 dark:text-rose-400 font-heading">
                {{ kpiStats.orientationsCompleted }}
            </div>
            <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight truncate">
                {{ kpiStats.orientationsOngoing }} em andamento
            </div>
        </div>

        <!-- Card 6: Total Acervo -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-indigo-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Acervo</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 font-heading">
                {{ kpiStats.totalProductions }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                Média: ~{{ kpiStats.averagePerYear }} / ano
            </div>
        </div>
    </div>

    <!-- ── 4 Modern Tab Navigation Pills (Touch-Friendly) ── -->
    <div class="border-b border-slate-200/80 dark:border-slate-800 pb-1 no-print">
        <nav class="flex items-center gap-2 overflow-x-auto py-2 -mb-px no-scrollbar" aria-label="Abas do Perfil">
            <!-- Aba 1: Produção -->
            <button type="button" onclick="switchProfessorTab('productions')" class="prof-tab-btn inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-xs sm:text-sm font-bold transition-all shadow-sm bg-sky-600 text-white" data-tab="productions" id="btn-tab-productions">
                <sl-icon name="file-earmark-text" class="text-base"></sl-icon>
                <span>Produção Científica & Técnica</span>
                <span id="tabCount-productions" class="pill-count rounded-full bg-white/20 text-white px-2 py-0.5 text-[11px] font-extrabold" data-initial="{{ kpiStats.totalProductions }}">
                    {{ kpiStats.totalProductions }}
                </span>
            </button>

            <!-- Aba 2: Orientações & Formação -->
            <button type="button" onclick="switchProfessorTab('orientations')" class="prof-tab-btn inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-xs sm:text-sm font-semibold transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800" data-tab="orientations" id="btn-tab-orientations">
                <sl-icon name="mortarboard" class="text-base"></sl-icon>
                <span>Orientações & Formação</span>
                <span id="tabCount-orientations" class="pill-count rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 px-2 py-0.5 text-[11px] font-bold" data-initial="{{ kpiStats.orientationsCompleted + kpiStats.orientationsOngoing + researcher.educations|length }}">
                    {{ kpiStats.orientationsCompleted + kpiStats.orientationsOngoing + researcher.educations|length }}
                </span>
            </button>

            <!-- Aba 3: Projetos, Bancas & Atuação -->
            <button type="button" onclick="switchProfessorTab('activities')" class="prof-tab-btn inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-xs sm:text-sm font-semibold transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800" data-tab="activities" id="btn-tab-activities">
                <sl-icon name="kanban" class="text-base"></sl-icon>
                <span>Projetos, Bancas & Atuação</span>
                <span id="tabCount-activities" class="pill-count rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 px-2 py-0.5 text-[11px] font-bold" data-initial="{{ kpiStats.projectsCount + kpiStats.boardsCount + researcher.professionalExperiences|length + researcher.eventParticipations|length + researcher.awards|length }}">
                    {{ kpiStats.projectsCount + kpiStats.boardsCount + researcher.professionalExperiences|length + researcher.eventParticipations|length + researcher.awards|length }}
                </span>
            </button>

            <!-- Aba 4: Métricas & Inteligência -->
            <button type="button" onclick="switchProfessorTab('analytics')" class="prof-tab-btn inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-xs sm:text-sm font-semibold transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800" data-tab="analytics" id="btn-tab-analytics">
                <sl-icon name="graph-up-arrow" class="text-base"></sl-icon>
                <span>Métricas, Redes & Inteligência</span>
                <span class="rounded-full bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wide">
                    Analytics
                </span>
            </button>
        </nav>
    </div>

    <!-- ── Global Filter & Real-Time Search Toolbar ── -->
    <div id="globalFilterBar" class="glass-card rounded-3xl p-5 sm:p-6 shadow-sm border border-slate-200/80 dark:border-slate-800 transition-all duration-300 no-print">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
            <div class="relative flex-1">
                <input type="text" id="prodSearchInput" value="{{ app.request.query.get('tema') ?: app.request.query.get('keyword') ?: app.request.query.get('q') }}" oninput="applyGlobalFilter()" placeholder="Buscar por termo, título, orientando, projeto, autor, evento, instituição ou ano..." class="w-full rounded-2xl border border-slate-300 bg-white/90 px-4 py-2.5 pl-10 pr-10 text-sm text-slate-900 placeholder-slate-400 dark:border-slate-700 dark:bg-slate-900/90 dark:text-white focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/15 transition-all shadow-inner" />
                <sl-icon name="search" class="absolute left-3.5 top-3.5 text-slate-400 text-sm"></sl-icon>
                <button type="button" id="btnClearInputQuick" onclick="clearGlobalFilters()" class="hidden absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs p-1" title="Limpar busca">
                    <sl-icon name="x-circle-fill" class="text-base"></sl-icon>
                </button>
            </div>

            <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
                <button type="button" id="btnOnlyDoi" onclick="toggleOnlyDoi()" class="inline-flex items-center gap-1.5 rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 transition-colors shadow-sm">
                    <sl-icon name="link-45deg" class="text-sky-500"></sl-icon> Apenas com DOI
                </button>
                <button type="button" id="btnClearFiltersMain" onclick="clearGlobalFilters()" class="hidden inline-flex items-center gap-1.5 rounded-2xl bg-rose-600 hover:bg-rose-700 active:scale-95 text-white px-4 py-2.5 text-xs font-bold shadow-lg shadow-rose-600/25 transition-all animate-bounce">
                    <sl-icon name="x-circle-fill" class="text-sm"></sl-icon> Limpar Filtro
                </button>
            </div>
        </div>

        <!-- Active Filter Status Banner -->
        <div id="filterStatusBanner" class="hidden mt-3.5 pt-3 border-t border-slate-200/70 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 rounded-xl bg-amber-500/15 dark:bg-amber-400/15 border border-amber-500/40 text-amber-900 dark:text-amber-300 px-3 py-1 font-semibold">
                    <sl-icon name="funnel-fill" class="text-amber-500"></sl-icon>
                    Filtrando por: <span id="filterActiveLabel" class="font-bold underline ml-1"></span>
                </span>
                <span id="filterMatchesSummary" class="text-slate-700 dark:text-slate-200 font-medium"></span>
            </div>
            <button type="button" onclick="clearGlobalFilters()" class="text-rose-600 dark:text-rose-400 font-bold hover:underline inline-flex items-center gap-1">
                <sl-icon name="arrow-counterclockwise"></sl-icon> Remover todos os filtros
            </button>
        </div>
    </div>

    <!-- ── Tab Content Panes (Modular & Instant Filtering) ── -->
    <div id="tabContentContainer" class="min-h-[400px]">
        <!-- Aba 1: Produção (Pré-carregada) -->
        <div id="pane-productions" class="prof-tab-pane active" data-tab-loaded="true">
            {% include 'pub/professor/_tab_productions.html.twig' %}
        </div>

        <!-- Aba 2: Orientações & Formação (Pré-carregada para busca instantânea unificada) -->
        <div id="pane-orientations" class="prof-tab-pane hidden" data-tab-loaded="true">
            {% include 'pub/professor/_tab_orientations.html.twig' %}
        </div>

        <!-- Aba 3: Projetos, Bancas & Atuação (Pré-carregada para busca instantânea unificada) -->
        <div id="pane-activities" class="prof-tab-pane hidden" data-tab-loaded="true">
            {% include 'pub/professor/_tab_activities.html.twig' %}
        </div>

        <!-- Aba 4: Métricas & Inteligência (Lazy Loaded sob demanda) -->
        <div id="pane-analytics" class="prof-tab-pane hidden" data-tab-loaded="false"></div>
    </div>
</div>

<!-- ── Toast Notification for Clipboard Copy Feedback ── -->
<div id="copyToast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 rounded-2xl bg-slate-900 text-white px-5 py-3 text-xs font-semibold shadow-2xl flex items-center gap-2">
    <sl-icon name="check2-circle" class="text-emerald-400 text-base"></sl-icon>
    <span id="copyToastMessage">Citação copiada para a área de transferência!</span>
</div>

<!-- ── Interactive JavaScript for Modular Tabs, Filter & Lazy Loading ── -->
<script>
const researcherSlug = "{{ researcher.slug ?: researcher.idLattes }}";
const fragmentBaseUrl = "{{ path('app_pub_professor_fragment', {'slugOrId': researcher.slug ?: researcher.idLattes, 'tab': '__TAB__'}) }}";

let currentCategory = 'all';
let onlyDoi = false;
let currentDatabase = null;
let lastFilterCounts = { productions: 0, orientations: 0, activities: 0 };

function switchProfessorTab(tabName) {
    // 1. Update navigation button styles and pill styling
    document.querySelectorAll('.prof-tab-btn').forEach(btn => {
        const isCurrent = btn.getAttribute('data-tab') === tabName;
        const pill = btn.querySelector('.pill-count');
        if (isCurrent) {
            btn.classList.add('bg-sky-600', 'text-white', 'shadow-sm');
            btn.classList.remove('text-slate-600', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
            if (pill) {
                pill.classList.add('bg-white/25', 'text-white');
                pill.classList.remove('bg-slate-200', 'dark:bg-slate-700', 'text-slate-700', 'dark:text-slate-300');
            }
        } else {
            btn.classList.remove('bg-sky-600', 'text-white', 'shadow-sm');
            btn.classList.add('text-slate-600', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
            if (pill) {
                pill.classList.remove('bg-white/25', 'text-white');
                pill.classList.add('bg-slate-200', 'dark:bg-slate-700', 'text-slate-700', 'dark:text-slate-300');
            }
        }
    });

    // 2. Toggle panes
    document.querySelectorAll('.prof-tab-pane').forEach(pane => {
        pane.classList.add('hidden');
    });

    const targetPane = document.getElementById('pane-' + tabName);
    if (!targetPane) return;
    targetPane.classList.remove('hidden');

    // 3. Update URL Hash
    if (window.location.hash !== '#' + tabName) {
        if (history.replaceState) {
            history.replaceState(null, null, '#' + tabName);
        } else {
            window.location.hash = tabName;
        }
    }

    // 4. Lazy load if not yet populated (e.g. Analytics tab)
    if (targetPane.getAttribute('data-tab-loaded') !== 'true') {
        targetPane.innerHTML = `
            <div class="py-24 flex flex-col items-center justify-center gap-3 text-slate-400">
                <div class="w-8 h-8 border-3 border-sky-500 border-t-transparent rounded-full animate-spin"></div>
                <span class="text-xs font-medium">Carregando informações da aba...</span>
            </div>
        `;

        const url = fragmentBaseUrl.replace('__TAB__', tabName);
        fetch(url)
            .then(res => {
                if (!res.ok) throw new Error('Erro ao carregar dados da aba.');
                return res.text();
            })
            .then(html => {
                targetPane.innerHTML = html;
                targetPane.setAttribute('data-tab-loaded', 'true');

                // Execute embedded scripts
                targetPane.querySelectorAll('script').forEach(oldScript => {
                    const newScript = document.createElement('script');
                    if (oldScript.src) {
                        newScript.src = oldScript.src;
                    } else {
                        newScript.textContent = oldScript.textContent;
                    }
                    document.body.appendChild(newScript);
                });

                applyGlobalFilter();
            })
            .catch(err => {
                targetPane.innerHTML = `
                    <div class="p-8 text-center text-rose-500 text-xs">
                        Não foi possível carregar os dados. Por favor, recarregue a página ou clique na aba novamente.
                    </div>
                `;
            });
    } else {
        applyGlobalFilter();
    }
}

function setCategoryFilter(category) {
    currentCategory = category;
    document.querySelectorAll('.category-pill').forEach(btn => {
        if (btn.getAttribute('data-category') === category) {
            btn.classList.add('bg-sky-600', 'text-white', 'shadow-sm');
            btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        } else {
            btn.classList.remove('bg-sky-600', 'text-white', 'shadow-sm');
            btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        }
    });
    applyGlobalFilter();
}

function toggleOnlyDoi() {
    onlyDoi = !onlyDoi;
    const btn = document.getElementById('btnOnlyDoi');
    if (onlyDoi) {
        btn.classList.add('bg-sky-100', 'border-sky-500', 'text-sky-800', 'dark:bg-sky-950', 'dark:text-sky-300', 'ring-2', 'ring-sky-500/30');
    } else {
        btn.classList.remove('bg-sky-100', 'border-sky-500', 'text-sky-800', 'dark:bg-sky-950', 'dark:text-sky-300', 'ring-2', 'ring-sky-500/30');
    }
    applyGlobalFilter();
}

function filterByKeyword(keyword) {
    const searchInput = document.getElementById('prodSearchInput');
    if (searchInput) searchInput.value = keyword;
    applyGlobalFilter();

    if (lastFilterCounts.productions > 0) {
        switchProfessorTab('productions');
    } else if (lastFilterCounts.orientations > 0) {
        switchProfessorTab('orientations');
    } else if (lastFilterCounts.activities > 0) {
        switchProfessorTab('activities');
    } else {
        switchProfessorTab('productions');
    }

    const filterBar = document.getElementById('globalFilterBar');
    if (filterBar) {
        filterBar.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
}

function filterByDatabase(dbAcronym) {
    dbAcronym = (dbAcronym || '').toLowerCase();
    if (currentDatabase === dbAcronym) {
        currentDatabase = null;
    } else {
        currentDatabase = dbAcronym;
        setCategoryFilter('artigo');
        switchProfessorTab('productions');
    }

    document.querySelectorAll('.db-filter-btn, .db-card-btn').forEach(btn => {
        const btnAcronym = (btn.getAttribute('data-db-acronym') || '').toLowerCase();
        if (currentDatabase && btnAcronym === currentDatabase) {
            btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-600', 'ring-2', 'ring-indigo-500/40');
            btn.classList.remove('bg-white/90', 'dark:bg-slate-900/80', 'bg-white/70', 'dark:bg-slate-900/60', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200/90', 'dark:border-slate-800');
        } else {
            btn.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600', 'ring-2', 'ring-indigo-500/40');
            btn.classList.add('bg-white/90', 'dark:bg-slate-900/80', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200/90', 'dark:border-slate-800');
        }
    });

    applyGlobalFilter();
}

function clearGlobalFilters() {
    const searchInput = document.getElementById('prodSearchInput');
    if (searchInput) searchInput.value = '';
    onlyDoi = false;
    currentDatabase = null;
    document.querySelectorAll('.db-filter-btn, .db-card-btn').forEach(btn => {
        btn.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600', 'ring-2', 'ring-indigo-500/40');
        btn.classList.add('bg-white/90', 'dark:bg-slate-900/80', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200/90', 'dark:border-slate-800');
    });
    const btnDoi = document.getElementById('btnOnlyDoi');
    if (btnDoi) {
        btnDoi.classList.remove('bg-sky-100', 'border-sky-500', 'text-sky-800', 'dark:bg-sky-950', 'dark:text-sky-300', 'ring-2', 'ring-sky-500/30');
    }
    setCategoryFilter('all');

    // Also clean URL query params if present
    if (window.history.replaceState) {
        const url = new URL(window.location);
        url.searchParams.delete('tema');
        url.searchParams.delete('keyword');
        url.searchParams.delete('q');
        window.history.replaceState({}, document.title, url.pathname + url.hash);
    }
}

function clearProdFilters() {
    clearGlobalFilters();
}

function updateTabCount(panelName, currentCount) {
    const el = document.getElementById('tabCount-' + panelName);
    if (!el) return;
    const initial = parseInt(el.getAttribute('data-initial') || '0', 10);
    const searchInput = document.getElementById('prodSearchInput');
    const rawTerm = (searchInput ? searchInput.value : '').trim();
    const isFiltered = rawTerm !== '' || onlyDoi || currentDatabase !== null;

    if (isFiltered) {
        if (currentCount > 0) {
            el.innerHTML = `<span class="font-bold text-sky-600 dark:text-sky-400">${currentCount}</span><span class="opacity-50 text-[10px]">/${initial}</span>`;
        } else {
            el.innerHTML = `<span class="text-rose-500/70 dark:text-rose-400/70 font-medium text-[11px]">0</span><span class="opacity-40 text-[10px]">/${initial}</span>`;
        }
    } else {
        el.textContent = initial;
    }
}

function checkPanelEmpty(panelName, count) {
    const emptyEl = document.getElementById('empty-' + panelName);
    if (!emptyEl) return;

    if (count === 0) {
        emptyEl.classList.remove('hidden');

        // Check if other tabs have matches to offer quick switch buttons!
        const suggestionEl = document.getElementById('empty-' + panelName + '-suggestion');
        if (suggestionEl) {
            let suggestions = [];
            if (panelName !== 'productions' && lastFilterCounts.productions > 0) {
                suggestions.push(`
                    <button type="button" onclick="switchProfessorTab('productions')" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-md transition-all active:scale-95 cursor-pointer">
                        <sl-icon name="file-earmark-text"></sl-icon>
                        <span>Ver ${lastFilterCounts.productions} em Produções</span>
                        <sl-icon name="arrow-right"></sl-icon>
                    </button>
                `);
            }
            if (panelName !== 'orientations' && lastFilterCounts.orientations > 0) {
                suggestions.push(`
                    <button type="button" onclick="switchProfessorTab('orientations')" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md transition-all active:scale-95 cursor-pointer">
                        <sl-icon name="mortarboard"></sl-icon>
                        <span>Ver ${lastFilterCounts.orientations} em Orientações & Formação</span>
                        <sl-icon name="arrow-right"></sl-icon>
                    </button>
                `);
            }
            if (panelName !== 'activities' && lastFilterCounts.activities > 0) {
                suggestions.push(`
                    <button type="button" onclick="switchProfessorTab('activities')" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md transition-all active:scale-95 cursor-pointer">
                        <sl-icon name="kanban"></sl-icon>
                        <span>Ver ${lastFilterCounts.activities} em Projetos & Atuação</span>
                        <sl-icon name="arrow-right"></sl-icon>
                    </button>
                `);
            }

            if (suggestions.length > 0) {
                suggestionEl.innerHTML = `
                    <div class="mt-3.5 pt-3 border-t border-slate-200/60 dark:border-slate-800 text-center">
                        <p class="text-xs text-slate-600 dark:text-slate-300 mb-2.5 font-medium">Foram encontrados resultados deste tema em outra seção:</p>
                        <div class="flex items-center justify-center gap-2.5 flex-wrap">${suggestions.join('')}</div>
                    </div>
                `;
                suggestionEl.classList.remove('hidden');
            } else {
                suggestionEl.innerHTML = '';
                suggestionEl.classList.add('hidden');
            }
        }
    } else {
        emptyEl.classList.add('hidden');
    }
}

function normalizeFilterStr(str) {
    return (str || '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}

function applyGlobalFilter() {
    const searchInput = document.getElementById('prodSearchInput');
    const rawTerm = (searchInput ? searchInput.value : '').trim();
    const term = rawTerm.toLowerCase();
    const normTerm = normalizeFilterStr(rawTerm);
    const isFiltered = term !== '' || onlyDoi || currentDatabase !== null;

    const filterBar = document.getElementById('globalFilterBar');
    const btnClearMain = document.getElementById('btnClearFiltersMain');
    const btnClearQuick = document.getElementById('btnClearInputQuick');
    const statusBanner = document.getElementById('filterStatusBanner');
    const activeLabel = document.getElementById('filterActiveLabel');
    const matchesSummary = document.getElementById('filterMatchesSummary');

    if (isFiltered) {
        if (filterBar) {
            filterBar.classList.add('ring-2', 'ring-sky-500/50', 'border-sky-400', 'dark:border-sky-500', 'bg-sky-50/40', 'dark:bg-sky-950/30');
        }
        if (btnClearMain) btnClearMain.classList.remove('hidden');
        if (btnClearQuick) btnClearQuick.classList.remove('hidden');
        if (statusBanner) statusBanner.classList.remove('hidden');
        
        let labelParts = [];
        if (term !== '') labelParts.push(`"${rawTerm}"`);
        if (onlyDoi) labelParts.push('Apenas com DOI');
        if (currentDatabase) labelParts.push(`Base: "${currentDatabase.toUpperCase()}"`);
        if (activeLabel) activeLabel.textContent = labelParts.join(' + ');
    } else {
        if (filterBar) {
            filterBar.classList.remove('ring-2', 'ring-sky-500/50', 'border-sky-400', 'dark:border-sky-500', 'bg-sky-50/40', 'dark:bg-sky-950/30');
        }
        if (btnClearMain) btnClearMain.classList.add('hidden');
        if (btnClearQuick) btnClearQuick.classList.add('hidden');
        if (statusBanner) statusBanner.classList.add('hidden');
    }

    let totalMatchesAllTabs = 0;

    // 1. Filter Productions Tab items
    let prodMatchesVisible = 0;
    const catCounts = { all: 0, artigo: 0, livro: 0, capitulo: 0, jornal: 0, evento: 0, tecnico: 0, inovacao: 0, artes: 0, outra: 0 };

    document.querySelectorAll('#pane-productions .prod-item').forEach(item => {
        const itemCat = item.getAttribute('data-category');
        const hasDoi = item.getAttribute('data-has-doi') === '1';
        let itemDbs = [];
        try {
            itemDbs = JSON.parse(item.getAttribute('data-databases') || '[]');
        } catch (e) {
            itemDbs = [];
        }
        const text = item.textContent.toLowerCase();

        const matchDoi = !onlyDoi || hasDoi;
        const matchTerm = term === '' || text.includes(term) || (normTerm !== '' && normalizeFilterStr(text).includes(normTerm));
        const matchDb = !currentDatabase || itemDbs.includes(currentDatabase);
        const matchesCriteria = matchDoi && matchTerm && matchDb;

        if (matchesCriteria) {
            catCounts.all++;
            if (catCounts[itemCat] !== undefined) {
                catCounts[itemCat]++;
            }
            if (itemCat === 'inovacao' || itemCat === 'software' || itemCat === 'patente') {
                if (itemCat !== 'inovacao') catCounts.inovacao = (catCounts.inovacao || 0) + 1;
            }
        }

        const matchCat = (currentCategory === 'all') || (currentCategory === itemCat) || (currentCategory === 'inovacao' && (itemCat === 'inovacao' || itemCat === 'software' || itemCat === 'patente'));

        if (matchesCriteria && matchCat) {
            item.style.display = '';
            prodMatchesVisible++;
        } else {
            item.style.display = 'none';
        }
    });

    document.querySelectorAll('#pane-productions .prod-section').forEach(sec => {
        const visibleItems = sec.querySelectorAll('.prod-item:not([style*="display: none"])');
        sec.style.display = visibleItems.length > 0 ? '' : 'none';
    });

    document.querySelectorAll('.category-pill').forEach(pill => {
        const cat = pill.getAttribute('data-category');
        const countSpan = pill.querySelector('.pill-count');
        if (countSpan && catCounts[cat] !== undefined) {
            const initial = parseInt(countSpan.getAttribute('data-initial') || '0', 10);
            const current = catCounts[cat];
            if (isFiltered) {
                if (current > 0) {
                    countSpan.innerHTML = `<span class="font-bold">${current}</span><span class="opacity-60 text-[10px]">/${initial}</span>`;
                } else {
                    countSpan.innerHTML = `<span class="opacity-40 text-[10px]">0/${initial}</span>`;
                }
            } else {
                countSpan.textContent = initial;
            }
        }
    });

    updateTabCount('productions', catCounts.all);
    totalMatchesAllTabs += catCounts.all;

    // 2. Filter Orientations Tab items
    let orientMatches = 0;
    document.querySelectorAll('#pane-orientations .orientation-item, #pane-orientations .education-item, #pane-orientations .complementary-item').forEach(item => {
        const text = item.textContent.toLowerCase();
        const kw = (item.getAttribute('data-keywords') || '').toLowerCase();
        const altTitle = (item.getAttribute('data-alt-title') || '').toLowerCase();
        const full = text + ' ' + kw + ' ' + altTitle;
        const matches = (term === '' || full.includes(term) || (normTerm !== '' && normalizeFilterStr(full).includes(normTerm))) && !onlyDoi;
        if (matches) {
            item.style.display = '';
            orientMatches++;
        } else {
            item.style.display = 'none';
        }
    });

    document.querySelectorAll('#pane-orientations .orient-subsection').forEach(sec => {
        const visibleItems = sec.querySelectorAll('.orientation-item:not([style*="display: none"]), .education-item:not([style*="display: none"]), .complementary-item:not([style*="display: none"])');
        sec.style.display = (visibleItems.length > 0 || !isFiltered) ? '' : 'none';
    });

    updateTabCount('orientations', orientMatches);
    totalMatchesAllTabs += orientMatches;

    // 3. Filter Activities Tab items
    let actMatches = 0;
    document.querySelectorAll('#pane-activities .project-item, #pane-activities .board-item, #pane-activities .experience-item, #pane-activities .event-item, #pane-activities .award-item, #pane-activities .area-item').forEach(item => {
        const text = item.textContent.toLowerCase();
        const matches = (term === '' || text.includes(term) || (normTerm !== '' && normalizeFilterStr(text).includes(normTerm))) && !onlyDoi;
        if (matches) {
            item.style.display = '';
            actMatches++;
        } else {
            item.style.display = 'none';
        }
    });

    document.querySelectorAll('#pane-activities .act-subsection').forEach(sec => {
        const visibleItems = sec.querySelectorAll('.project-item:not([style*="display: none"]), .board-item:not([style*="display: none"]), .experience-item:not([style*="display: none"]), .event-item:not([style*="display: none"]), .award-item:not([style*="display: none"]), .area-item:not([style*="display: none"])');
        sec.style.display = (visibleItems.length > 0 || !isFiltered) ? '' : 'none';
    });

    updateTabCount('activities', actMatches);
    totalMatchesAllTabs += actMatches;

    // Store latest counts
    lastFilterCounts = { productions: catCounts.all, orientations: orientMatches, activities: actMatches };

    // Update empty states with cross-tab suggestions
    checkPanelEmpty('productions', prodMatchesVisible);
    checkPanelEmpty('orientations', orientMatches);
    checkPanelEmpty('activities', actMatches);

    // Update status banner summary text
    if (matchesSummary) {
        if (!isFiltered) {
            matchesSummary.textContent = '';
        } else if (totalMatchesAllTabs > 0) {
            let summaryParts = [];
            if (catCounts.all > 0) summaryParts.push(`<strong class="text-sky-600 dark:text-sky-400">${catCounts.all}</strong> em Produções`);
            if (orientMatches > 0) summaryParts.push(`<strong class="text-emerald-600 dark:text-emerald-400">${orientMatches}</strong> em Orientações`);
            if (actMatches > 0) summaryParts.push(`<strong class="text-indigo-600 dark:text-indigo-400">${actMatches}</strong> em Projetos/Atuação`);
            matchesSummary.innerHTML = `• ${totalMatchesAllTabs} registro(s) encontrado(s) (${summaryParts.join(', ')})`;
        } else {
            matchesSummary.innerHTML = `• <span class="text-rose-600 dark:text-rose-400 font-bold">Nenhum registro encontrado</span>`;
        }
    }
}

function copyCitation(btn, title, venue, year, doi) {
    const authorName = "{{ researcher.citationNames ? researcher.citationNames|split(';')|first|trim : researcher.fullName }}";
    let citation = `${authorName}. ${title}. ${venue ? venue + ', ' : ''}${year}.`;
    if (doi) citation += ` DOI: https://doi.org/${doi}.`;

    navigator.clipboard.writeText(citation).then(() => {
        showToast('Citação ABNT copiada para a área de transferência!');
    });
}

function showToast(message) {
    const toast = document.getElementById('copyToast');
    const toastMsg = document.getElementById('copyToastMessage');
    if (!toast || !toastMsg) return;
    toastMsg.textContent = message;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
    }, 3000);
}

// ── Initial Tab Setup on Load ──
document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const filterTopic = urlParams.get('tema') || urlParams.get('keyword') || urlParams.get('q');
    const hash = window.location.hash ? window.location.hash.replace('#', '') : '';

    if (filterTopic && filterTopic.trim() !== '') {
        const searchInput = document.getElementById('prodSearchInput');
        if (searchInput) {
            searchInput.value = filterTopic.trim();
        }
        applyGlobalFilter();

        // Automatically determine the most relevant tab!
        // If hash was NOT explicitly set or was 'productions':
        if (!hash || hash === 'productions') {
            if (lastFilterCounts.productions > 0) {
                switchProfessorTab('productions');
            } else if (lastFilterCounts.orientations > 0) {
                switchProfessorTab('orientations');
            } else if (lastFilterCounts.activities > 0) {
                switchProfessorTab('activities');
            } else {
                switchProfessorTab('productions');
            }
        } else {
            switchProfessorTab(hash);
        }

        const filterBar = document.getElementById('globalFilterBar');
        if (filterBar) {
            setTimeout(() => {
                filterBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 250);
        }
    } else if (['productions', 'orientations', 'activities', 'analytics'].includes(hash)) {
        switchProfessorTab(hash);
    } else {
        switchProfessorTab('productions');
    }
});
</script>
{% endblock %}
