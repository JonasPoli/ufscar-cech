{#
    Template: templates/pub/professor/show.html.twig
    Finalidade: Exibição completa do perfil público do pesquisador, dados biográficos, produções científicas e orientações.
    
    Variáveis Recebidas do Controller:
    @var researcher \App\Entity\Researcher Entidade do pesquisador com relacionamentos carregados
    @var articles \App\Entity\ProductionItem[] Lista de artigos científicos ordenados por ano decrescente
    @var books \App\Entity\ProductionItem[] Lista de livros publicados
    @var chapters \App\Entity\ProductionItem[] Lista de capítulos de livros
    @var events \App\Entity\ProductionItem[] Trabalhos em eventos e anais de congressos
    @var newspaperTexts \App\Entity\ProductionItem[] Textos em jornais ou revistas
    @var techWorks \App\Entity\ProductionItem[] Trabalhos técnicos e relatórios
    @var software \App\Entity\ProductionItem[] Softwares e programas de computador
    @var patents \App\Entity\ProductionItem[] Patentes e registros de marcas
    @var artistic \App\Entity\ProductionItem[] Produções artísticas e culturais
    @var otherProds \App\Entity\ProductionItem[] Outras produções não categorizadas
    @var completedOrientations \App\Entity\Orientation[] Orientações concluídas
    @var ongoingOrientations \App\Entity\Orientation[] Orientações em andamento
    @var orientationsCount array<string, int> Contagem agregada de orientações por nível acadêmico
    @var totalWithDoi int Total de produções com identificador DOI cadastrado
    @var allYears array<int, bool> Mapa de anos com produção ativa
#}
{% extends 'pub/base.html.twig' %}

{% block title %}{{ researcher.fullName }} | Currículo Lattes & Produção Científica — CECH UFSCar{% endblock %}
{% block meta_description %}{{ researcher.abstractResume ? researcher.abstractResume|slice(0, 155) ~ '...' : 'Perfil acadêmico, produções científicas, orientações e trajetória de ' ~ researcher.fullName ~ ' no CECH - UFSCar.' }}{% endblock %}
{% block meta_keywords %}{{ researcher.fullName }}, {{ researcher.department }}, UFSCar, CECH, currículo lattes, produção científica, {{ researcher.citationNames }}{% endblock %}

{% block og_type %}profile{% endblock %}
{% block og_title %}{{ researcher.fullName }} — Docente e Pesquisador(a) do CECH UFSCar{% endblock %}
{% block og_description %}{{ researcher.abstractResume ? researcher.abstractResume|slice(0, 155) ~ '...' : 'Currículo e produção científica de ' ~ researcher.fullName ~ ' no CECH - UFSCar.' }}{% endblock %}

{# ── Academic Google Scholar Meta Tags ── #}
{% block academic_meta %}
    {% for a in articles|slice(0, 8) %}
        <meta name="citation_title" content="{{ a.title|e('html_attr') }}">
        <meta name="citation_author" content="{{ researcher.fullName|e('html_attr') }}">
        {% if a.year %}<meta name="citation_publication_date" content="{{ a.year }}">{% endif %}
        {% if a.journalName %}<meta name="citation_journal_title" content="{{ a.journalName|e('html_attr') }}">{% endif %}
        {% if a.doi %}<meta name="citation_doi" content="{{ a.doi|e('html_attr') }}">{% endif %}
        {% if a.issn %}<meta name="citation_issn" content="{{ a.issn|e('html_attr') }}">{% endif %}
    {% endfor %}
{% endblock %}

{# ── Schema.org Structured Data (JSON-LD) for Person ── #}
{% block schema_json_ld %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "{{ site_settings ? site_settings.baseUrl : 'https://cech.ufscar.br' }}{{ path('app_pub_professor_show', {'slugOrId': researcher.slug ?: researcher.idLattes}) }}#person",
    "name": "{{ researcher.fullName|e('js') }}",
    {% if researcher.citationNames %}"alternateName": {{ researcher.citationNames|split(';')|map(n => n|trim)|json_encode|raw }},{% endif %}
    "jobTitle": "Docente e Pesquisador(a)",
    "worksFor": {
        "@type": "CollegeOrUniversity",
        "name": "Centro de Educação e Ciências Humanas — UFSCar",
        "parentOrganization": {
            "@type": "CollegeOrUniversity",
            "name": "Universidade Federal de São Carlos",
            "url": "https://www.ufscar.br"
        }
    },
    {% if researcher.department %}"department": "{{ researcher.department|e('js') }}",{% endif %}
    {% if researcher.email %}"email": "mailto:{{ researcher.email }}",{% endif %}
    "sameAs": [
        "{{ researcher.lattesUrl }}"{% if researcher.orcid %},
        "{{ researcher.orcidUrl }}"{% endif %}
    ],
    {% if researcher.abstractResume %}"description": "{{ researcher.abstractResume|slice(0, 300)|e('js') }}",{% endif %}
    "alumniOf": [
        {% for e in researcher.educations %}
            {
                "@type": "EducationalOrganization",
                "name": "{{ e.institutionName|e('js') }}"
            }{% if not loop.last %},{% endif %}
        {% endfor %}
    ],
    "knowsAbout": [
        {% for ka in researcher.knowledgeAreas %}
            "{{ ka.area|e('js') }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: #fff !important; color: #000 !important; font-size: 11pt; }
            .glass-card { background: #fff !important; border: 1px solid #ccc !important; box-shadow: none !important; }
            sl-tab-group::part(nav) { display: none !important; }
            sl-tab-panel { display: block !important; opacity: 1 !important; visibility: visible !important; }
            a { text-decoration: none !important; color: #000 !important; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 no-print" aria-label="Breadcrumb">
        <a href="{{ path('app_pub_home') }}" class="hover:text-sky-600 dark:hover:text-sky-400">Início</a>
        <span>/</span>
        {% if researcher.departmentCode %}
            <a href="{{ path('app_pub_department_show', {'codeOrSlug': researcher.departmentCode}) }}" class="hover:text-sky-600 dark:hover:text-sky-400">
                {{ researcher.department }}
            </a>
            <span>/</span>
        {% endif %}
        <span class="text-slate-900 dark:text-white font-medium truncate" aria-current="page">{{ researcher.fullName }}</span>
    </nav>

    <!-- Researcher Profile Header Card -->
    <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-sm relative overflow-hidden">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 flex-1 min-w-0">
                <!-- Avatar / Photo -->
                <div class="flex h-28 w-28 sm:h-32 sm:w-32 shrink-0 items-center justify-center rounded-2xl overflow-hidden shadow-lg shadow-sky-500/20 {% if not researcher.photoUrl %}bg-gradient-to-tr from-sky-600 via-indigo-600 to-purple-600 text-white font-bold text-3xl sm:text-4xl{% endif %}">
                    {% if researcher.photoUrl %}
                        <img src="{{ researcher.photoUrl }}" alt="{{ researcher.fullName }}" class="h-full w-full object-cover" onerror="this.onerror=null;this.parentElement.innerHTML='{{ researcher.fullName|slice(0, 2)|upper }}';this.parentElement.className='flex h-28 w-28 sm:h-32 sm:w-32 shrink-0 items-center justify-center rounded-2xl overflow-hidden shadow-lg bg-gradient-to-tr from-sky-600 via-indigo-600 to-purple-600 text-white font-bold text-3xl sm:text-4xl';">
                    {% else %}
                        {{ researcher.fullName|slice(0, 2)|upper }}
                    {% endif %}
                </div>

                <!-- Profile Info -->
                <div class="flex-1 min-w-0 space-y-2">
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
                            {{ researcher.fullName }}
                        </h1>
                        {% if researcher.departmentCode %}
                            <span class="rounded-full bg-sky-100 px-3 py-0.5 text-xs font-bold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                                {{ researcher.departmentCode }}
                            </span>
                        {% endif %}
                    </div>

                    {% set citationVariants = author_thesaurus_variants(researcher) %}
                    {% if citationVariants|length > 0 %}
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                            <strong class="font-medium text-slate-700 dark:text-slate-300">Nomes em Citação:</strong> {{ citationVariants|join('; ') }}
                        </p>
                    {% elseif researcher.citationNames %}
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                            <strong class="font-medium text-slate-700 dark:text-slate-300">Nomes em Citação:</strong> {{ researcher.citationNames }}
                        </p>
                    {% endif %}

                    <p class="text-sm font-medium text-sky-700 dark:text-sky-400">
                        {{ researcher.department ?: 'Centro de Educação e Ciências Humanas — UFSCar' }}
                    </p>

                    <!-- Metadata pills -->
                    <div class="flex flex-wrap items-center gap-3 pt-1 text-xs text-slate-500 dark:text-slate-400">
                        {% if researcher.birthCountry or researcher.nationality %}
                            {{ country_badge(researcher.birthCountry ?: researcher.nationality) }}
                        {% endif %}
                        {% if researcher.admissionYear or researcher.leaveYear %}
                            {% if researcher.isActiveInCech %}
                                <span class="flex items-center gap-1">
                                    <sl-icon name="calendar-check" class="text-emerald-600 dark:text-emerald-400"></sl-icon> {{ researcher.cechPeriodLabel }}
                                </span>
                            {% else %}
                                <span class="flex items-center gap-1 font-semibold text-amber-700 dark:text-amber-400" title="Docente com vínculo encerrado no CECH">
                                    <sl-icon name="clock-history"></sl-icon> {{ researcher.cechPeriodLabel }} (Docente Aposentado/Histórico)
                                </span>
                            {% endif %}
                        {% endif %}
                        {% if researcher.workCity or researcher.workState or researcher.workAgency %}
                            <span class="flex items-center gap-1">
                                <sl-icon name="building"></sl-icon>
                                {{ [researcher.workAgency ?: researcher.unit, researcher.workCity ~ (researcher.workState ? '/' ~ researcher.workState : '')]|filter(v => v is not empty)|join(' • ') }}
                            </span>
                        {% endif %}
                        {% if researcher.lastLattesUpdate %}
                            <span class="flex items-center gap-1 font-medium text-slate-600 dark:text-slate-300">
                                <sl-icon name="clock-history"></sl-icon> Atualização Lattes: {{ researcher.lastLattesUpdate|date('d/m/Y') }}
                            </span>
                        {% endif %}
                    </div>

                    {% if researcher.languageProficiencies|length > 0 %}
                        <div class="flex flex-wrap items-center gap-1.5 pt-1 text-xs">
                            <span class="text-slate-400 font-medium mr-1 flex items-center gap-1">
                                <sl-icon name="translate"></sl-icon> Idiomas:
                            </span>
                            {% for lang in researcher.languageProficiencies %}
                                <span class="rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-white/10 px-2 py-0.5 text-[11px] font-medium text-slate-700 dark:text-slate-300" title="Compreensão: {{ lang.comprehension ?: '-' }} | Fala: {{ lang.speaking ?: '-' }} | Leitura: {{ lang.reading ?: '-' }} | Escrita: {{ lang.writing ?: '-' }}">
                                    <strong class="font-semibold text-sky-600 dark:text-sky-400">{{ lang.language }}</strong>
                                    {% if lang.reading %}<span class="text-slate-400 text-[10px]"> (Lê: {{ lang.reading|lower }})</span>{% endif %}
                                </span>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- External Action Links & Academic Export -->
            <div class="flex flex-wrap lg:flex-col gap-2 w-full lg:w-auto shrink-0 pt-4 lg:pt-0 border-t lg:border-t-0 border-slate-200/60 dark:border-white/10 no-print">
                <a href="{{ researcher.lattesUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white hover:bg-slate-800 dark:bg-sky-600 dark:hover:bg-sky-500 shadow-sm transition-colors flex-1 lg:flex-none" title="Abrir Currículo Lattes oficial no CNPq">
                    <sl-icon name="box-arrow-up-right"></sl-icon> Currículo Lattes
                </a>

                {% if researcher.orcid %}
                    <a href="{{ researcher.orcidUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-500/40 bg-emerald-50/50 px-4 py-2.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-900/60 shadow-sm transition-colors flex-1 lg:flex-none" title="Abrir registro ORCID em nova aba">
                        <span class="h-3.5 w-3.5 rounded-full bg-emerald-500 text-[9px] text-white flex items-center justify-center font-bold">iD</span>
                        ORCID: {{ researcher.orcid }}
                    </a>
                {% endif %}

                {% if researcher.email %}
                    <a href="mailto:{{ researcher.email }}" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors">
                        <sl-icon name="envelope"></sl-icon> {{ researcher.email }}
                    </a>
                {% endif %}

                <!-- Export Action Dropdown -->
                <div class="flex items-center gap-1.5 pt-1 w-full justify-start lg:justify-end">
                    <a href="{{ path('app_pub_professor_export', {'slugOrId': researcher.slug ?: researcher.idLattes, 'format': 'bibtex'}) }}" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300" title="Baixar todas as produções no formato BibTeX">
                        <sl-icon name="download"></sl-icon> BibTeX
                    </a>
                    <a href="{{ path('app_pub_professor_export', {'slugOrId': researcher.slug ?: researcher.idLattes, 'format': 'json'}) }}" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300" title="Baixar currículo completo em JSON">
                        <sl-icon name="code-slash"></sl-icon> JSON
                    </a>
                    <a href="{{ path('app_pub_professor_export', {'slugOrId': researcher.slug ?: researcher.idLattes, 'format': 'csv'}) }}" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300" title="Exportar tabela de produções em CSV">
                        <sl-icon name="file-earmark-spreadsheet"></sl-icon> CSV
                    </a>
                    <button type="button" onclick="window.print()" class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300" title="Imprimir / Salvar em PDF">
                        <sl-icon name="printer"></sl-icon>
                    </button>
                </div>
            </div>
        </div>

        <!-- Abstract Resume -->
        {% if researcher.abstractResume %}
            <div class="mt-6 pt-6 border-t border-slate-200/60 dark:border-white/10 space-y-2">
                <h2 class="font-heading text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                    <sl-icon name="file-text" class="text-sky-500"></sl-icon> Resumo do Currículo Lattes
                </h2>
                <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed text-justify">
                    {{ researcher.abstractResume }}
                </p>
            </div>
        {% endif %}
    </div>

    <!-- ── KPI Summary Cards (Métricas de Inteligência Acadêmica) ── -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 no-print">
        <!-- Card 1: Artigos -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-sky-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Artigos Periódicos</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-sky-600 dark:text-sky-400 font-heading">
                {{ kpiStats.articlesCount }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <span class="inline-block h-2 w-2 rounded-full {% if kpiStats.percentArticlesWithDoi > 50 %}bg-emerald-500{% else %}bg-amber-500{% endif %}"></span>
                {{ kpiStats.percentArticlesWithDoi }}% com DOI
            </div>
        </div>

        <!-- Card 2: Livros & Capítulos -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-amber-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Livros / Capítulos</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-amber-600 dark:text-amber-400 font-heading">
                {{ kpiStats.booksCount + kpiStats.chaptersCount }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                {{ kpiStats.booksCount }} livros, {{ kpiStats.chaptersCount }} cap.
            </div>
        </div>

        <!-- Card 3: Eventos -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-purple-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Em Congressos</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-purple-600 dark:text-purple-400 font-heading">
                {{ kpiStats.eventsCount }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                Trabalhos e Anais
            </div>
        </div>

        <!-- Card 4: Produções Técnicas / Inovação -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-emerald-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Produção Técnica</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 font-heading">
                {{ kpiStats.techCount }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                Técnicos, Softwares, Pat.
            </div>
        </div>

        <!-- Card 5: Orientações Concluídas -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-rose-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Orientações Concl.</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-rose-600 dark:text-rose-400 font-heading">
                {{ kpiStats.orientationsCompleted }}
            </div>
            <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight truncate" title="{% set allP = [] %}{% if kpiStats.orientationsBreakdown.doutorado_concluido > 0 %}{% set allP = allP|merge([kpiStats.orientationsBreakdown.doutorado_concluido ~ ' Doutorado']) %}{% endif %}{% if kpiStats.orientationsBreakdown.mestrado_concluido > 0 %}{% set allP = allP|merge([kpiStats.orientationsBreakdown.mestrado_concluido ~ ' Mestrado']) %}{% endif %}{% if kpiStats.orientationsBreakdown.pos_doc_concluido > 0 %}{% set allP = allP|merge([kpiStats.orientationsBreakdown.pos_doc_concluido ~ ' Pós-Doc']) %}{% endif %}{% if kpiStats.orientationsBreakdown.tcc_concluido > 0 %}{% set allP = allP|merge([kpiStats.orientationsBreakdown.tcc_concluido ~ ' TCC']) %}{% endif %}{% if kpiStats.orientationsBreakdown.iniciacao_concluido > 0 %}{% set allP = allP|merge([kpiStats.orientationsBreakdown.iniciacao_concluido ~ ' Inic. Científica']) %}{% endif %}{% if kpiStats.orientationsBreakdown.especializacao_concluido > 0 %}{% set allP = allP|merge([kpiStats.orientationsBreakdown.especializacao_concluido ~ ' Especialização']) %}{% endif %}{% if kpiStats.orientationsBreakdown.outras_concluido > 0 %}{% set allP = allP|merge([kpiStats.orientationsBreakdown.outras_concluido ~ ' Outras']) %}{% endif %}{{ allP|join(', ') }}">
                {% set parts = [] %}
                {% if kpiStats.orientationsBreakdown.doutorado_concluido > 0 %}
                    {% set parts = parts|merge([kpiStats.orientationsBreakdown.doutorado_concluido ~ ' Dout']) %}
                {% endif %}
                {% if kpiStats.orientationsBreakdown.mestrado_concluido > 0 %}
                    {% set parts = parts|merge([kpiStats.orientationsBreakdown.mestrado_concluido ~ ' Mest']) %}
                {% endif %}
                {% if kpiStats.orientationsBreakdown.pos_doc_concluido > 0 %}
                    {% set parts = parts|merge([kpiStats.orientationsBreakdown.pos_doc_concluido ~ ' Pós-Doc']) %}
                {% endif %}
                {% if kpiStats.orientationsBreakdown.tcc_concluido > 0 %}
                    {% set parts = parts|merge([kpiStats.orientationsBreakdown.tcc_concluido ~ ' TCC']) %}
                {% endif %}
                {% if kpiStats.orientationsBreakdown.iniciacao_concluido > 0 %}
                    {% set parts = parts|merge([kpiStats.orientationsBreakdown.iniciacao_concluido ~ ' PIBIC']) %}
                {% endif %}
                {% if kpiStats.orientationsBreakdown.especializacao_concluido > 0 %}
                    {% set parts = parts|merge([kpiStats.orientationsBreakdown.especializacao_concluido ~ ' Espec']) %}
                {% endif %}
                {% if kpiStats.orientationsBreakdown.outras_concluido > 0 %}
                    {% set parts = parts|merge([kpiStats.orientationsBreakdown.outras_concluido ~ ' Outras']) %}
                {% endif %}
                {{ parts|slice(0, 3)|join(', ') ?: 'Nenhuma concluída' }}
            </div>
        </div>

        <!-- Card 6: Total Produções & Média -->
        <div class="glass-card rounded-2xl p-4 space-y-1 relative overflow-hidden border-indigo-500/20">
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Acervo</div>
            <div class="text-2xl sm:text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 font-heading">
                {{ kpiStats.totalProductions }}
            </div>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                Média: ~{{ kpiStats.averagePerYear }} / ano
            </div>
        </div>
    </div>

    <!-- ── Visual Analytics & Interactive Charts Section (Somos UFMG Inspired) ── -->
    <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-sm space-y-6 no-print">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200/60 dark:border-white/10">
            <div>
                <h2 class="font-heading text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <sl-icon name="graph-up-arrow" class="text-sky-500"></sl-icon> Painel de Gráficos e Inteligência de Produção
                </h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Análise cronológica da produção científica, intelectual e formação de recursos humanos ao longo dos anos.
                </p>
            </div>

            <div class="flex items-center gap-2">
                <button type="button" id="toggleChartsBtn" onclick="toggleChartsPanel()" class="inline-flex items-center gap-2 rounded-xl bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800/60 px-3.5 py-2 text-xs font-semibold text-sky-700 dark:text-sky-300 hover:bg-sky-100 transition-colors">
                    <sl-icon name="arrows-expand" id="toggleIcon"></sl-icon> <span id="toggleText">Recolher Gráficos</span>
                </button>
            </div>
        </div>

        <div id="chartsContainer" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Main Chart: Stacked Production Timeline -->
            <div class="lg:col-span-8 space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Evolução da Produção por Categoria (Histórico Anual)
                    </h3>
                    <span class="text-[11px] text-slate-400 font-mono">{{ kpiStats.firstYear }} - {{ kpiStats.lastYear }}</span>
                </div>
                <div class="h-72 w-full">
                    <canvas id="productionTimelineChart"></canvas>
                </div>
            </div>

            <!-- Side Chart: Donut Category Distribution -->
            <div class="lg:col-span-4 space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Distribuição por Categoria
                    </h3>
                    <span class="text-[11px] text-slate-400 font-semibold">{{ kpiStats.totalProductions }} itens</span>
                </div>
                <div class="h-72 w-full flex items-center justify-center">
                    <canvas id="categoryDonutChart"></canvas>
                </div>
            </div>

            <!-- Orientations Timeline Chart -->
            {% if completedOrientations|length > 0 %}
                <div class="lg:col-span-12 pt-4 border-t border-slate-200/60 dark:border-white/10 space-y-3">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 flex items-center gap-2">
                            <sl-icon name="people" class="text-rose-500"></sl-icon> Histórico de Orientações Concluídas por Nível
                        </h3>
                        <span class="text-[11px] text-slate-400">{{ kpiStats.orientationsCompleted }} concluídas, {{ kpiStats.orientationsOngoing }} em andamento</span>
                    </div>
                    <div class="h-56 w-full">
                        <canvas id="orientationsTimelineChart"></canvas>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- ── Bases Científicas & Indexação Internacional (Scopus, WoS, Latindex, etc.) ── -->
    {% if academicDatabases.ranking|length > 0 or academicDatabases.totalIndexedArticles > 0 %}
        <div class="glass-card rounded-3xl p-6 sm:p-7 shadow-sm space-y-6 border-l-4 border-indigo-500 no-print">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/60 dark:border-white/10 pb-4">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">Bases Científicas & Indexação</span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">
                            Visibilidade Internacional
                        </span>
                    </div>
                    <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2.5">
                        <sl-icon name="journal-bookmark-fill" class="text-indigo-600 dark:text-indigo-400 text-xl"></sl-icon> Produção Científica Indexada em Bases Internacionais
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        Cruzamento entre os artigos publicados pelo docente, as revistas científicas e as bases internacionais de indexação.
                    </p>
                </div>
                <span class="rounded-full bg-indigo-100 dark:bg-indigo-950/80 text-indigo-800 dark:text-indigo-300 px-3.5 py-1.5 text-xs font-bold self-start sm:self-auto shrink-0 flex items-center gap-1.5 shadow-2xs">
                    <sl-icon name="check-circle-fill" class="text-xs text-indigo-600 dark:text-indigo-400"></sl-icon> {{ academicDatabases.totalIndexedArticles }} de {{ academicDatabases.totalArticles }} artigos indexados ({{ academicDatabases.indexedPercentage }}%)
                </span>
            </div>

            <!-- KPI Cards Ranking -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
                <!-- Total Indexados -->
                <div class="rounded-2xl border border-indigo-200/80 dark:border-indigo-900/60 p-4 bg-gradient-to-br from-indigo-50/80 to-sky-50/50 dark:from-indigo-950/40 dark:to-slate-900/40 space-y-1.5">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-300">Artigos Indexados</span>
                        <sl-icon name="award" class="text-indigo-500 text-sm"></sl-icon>
                    </div>
                    <div class="text-2xl font-black text-indigo-900 dark:text-indigo-200 font-heading">
                        {{ academicDatabases.totalIndexedArticles|number_format(0, ',', '.') }}
                    </div>
                    <div class="text-[11px] text-indigo-600/80 dark:text-indigo-400 font-medium">
                        {{ academicDatabases.indexedPercentage }}% de todos os artigos
                    </div>
                </div>

                <!-- Loop bases ranking -->
                {% for item in academicDatabases.ranking %}
                    <button type="button" onclick="filterByDatabase('{{ item.acronym|lower|e('js') }}')" class="db-card-btn rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4 bg-white/70 dark:bg-slate-900/60 text-left space-y-1.5 hover:border-indigo-500 dark:hover:border-indigo-400 hover:shadow-md transition-all group shadow-2xs" data-db-acronym="{{ item.acronym|lower|e('html_attr') }}" title="Filtrar produções indexadas em {{ item.name }}">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5 min-w-0">
                                {% if item.logo %}
                                    <img src="{{ item.logo }}" alt="{{ item.name }}" class="h-3.5 w-auto object-contain shrink-0 group-hover:scale-110 transition-transform" onerror="this.style.display='none'" />
                                {% endif %}
                                <span class="text-[11px] font-bold text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate">{{ item.name }}</span>
                            </div>
                            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">#{{ loop.index }}</span>
                        </div>
                        <div class="text-2xl font-black text-slate-900 dark:text-white font-heading">
                            {{ item.total|number_format(0, ',', '.') }}
                        </div>
                        <div class="text-[11px] text-slate-500 dark:text-slate-400">
                            {{ item.indexedPercentage }}% das produções indexadas
                        </div>
                    </button>
                {% endfor %}
            </div>

            <!-- Fig 15 & Fig 16 Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
                <!-- Fig 15: Produção por Base de Indexação -->
                <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 bg-slate-50/50 dark:bg-slate-900/50 flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">Figura 15</span>
                            <span class="text-[11px] text-slate-400">Bases Científicas Internacionais</span>
                        </div>
                        <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white font-heading">
                            Trabalhos por Base de Indexação
                        </h4>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                            Distribuição dos artigos publicados pelo docente nas bases de dados indexadoras.
                        </p>
                    </div>
                    <div class="h-64 w-full">
                        <canvas id="chartProfessorAcademicDatabases"></canvas>
                    </div>
                </div>

                <!-- Fig 16: Evolução Temporal por Base -->
                <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 bg-slate-50/50 dark:bg-slate-900/50 flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">Figura 16</span>
                            <span class="text-[11px] text-slate-400">Séries Históricas</span>
                        </div>
                        <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white font-heading">
                            Evolução Temporal da Indexação por Base ({{ academicDatabases.years|first }}–{{ academicDatabases.years|last }})
                        </h4>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                            Histórico comparativo do número anual de artigos publicados em periódicos indexados.
                        </p>
                    </div>
                    <div class="h-64 w-full">
                        <canvas id="chartProfessorAcademicDatabasesTimeline"></canvas>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- ── 1. Principais Colaboradores e Rede de Coautoria (Largura Total) ── -->
    {% if topCoauthors|length > 0 %}
        <div class="glass-card rounded-3xl p-6 sm:p-7 shadow-sm space-y-5 border-l-4 border-indigo-500 no-print">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/60 dark:border-white/10 pb-4">
                <div>
                    <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2.5">
                        <sl-icon name="people-fill" class="text-indigo-600 dark:text-indigo-400 text-xl"></sl-icon> Principais Colaboradores e Rede de Coautoria
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        Pesquisadores e docentes com maior volume de trabalhos e produções em parceria
                    </p>
                </div>
                <span class="rounded-full bg-indigo-100 dark:bg-indigo-950/80 text-indigo-800 dark:text-indigo-300 px-3 py-1 text-xs font-bold self-start sm:self-auto shrink-0 flex items-center gap-1.5 shadow-2xs">
                    <sl-icon name="diagram-2" class="text-xs"></sl-icon> {{ topCoauthors|length }} colaboradores em destaque
                </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                {% for coauthor in topCoauthors %}
                    <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4 flex flex-col justify-between bg-white/70 dark:bg-slate-900/60 hover:border-indigo-300 dark:hover:border-indigo-700 hover:shadow-md transition-all group">
                        <div class="space-y-2.5">
                            <!-- Top: Avatar + Name + Count -->
                            <div class="flex items-start justify-between gap-2">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <div class="w-10 h-10 rounded-xl overflow-hidden flex items-center justify-center font-bold text-xs uppercase shrink-0 ring-2 {% if coauthor.researcher and coauthor.researcher.photoUrl %}ring-sky-500/30 bg-slate-100 dark:bg-slate-800 shadow-xs{% elseif coauthor.researcher %}ring-indigo-500/30 bg-gradient-to-tr from-indigo-600 to-sky-600 text-white shadow-xs{% else %}ring-slate-200 dark:ring-slate-800 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300{% endif %}">
                                        {% if coauthor.researcher and coauthor.researcher.photoUrl %}
                                            <img src="{{ coauthor.researcher.photoUrl }}" alt="{{ coauthor.name }}" class="h-full w-full object-cover" onerror="this.onerror=null;this.parentElement.innerHTML='{{ coauthor.name|slice(0, 2)|upper }}';this.parentElement.className='w-10 h-10 rounded-xl overflow-hidden flex items-center justify-center font-bold text-xs uppercase shrink-0 ring-2 ring-indigo-500/30 bg-gradient-to-tr from-indigo-600 to-sky-600 text-white shadow-xs';" />
                                        {% else %}
                                            {{ coauthor.name|slice(0, 2)|upper }}
                                        {% endif %}
                                    </div>
                                    <div class="min-w-0">
                                        {% if coauthor.researcher %}
                                            <a href="{{ path('app_pub_professor_show', {'slugOrId': coauthor.researcher.slug ?: coauthor.researcher.idLattes}) }}" class="text-xs font-bold text-slate-900 dark:text-white hover:text-sky-600 dark:hover:text-sky-400 hover:underline truncate block" title="Ver perfil docente no CECH">
                                                {{ coauthor.name }}
                                            </a>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 px-1.5 py-0.2 rounded mt-0.5 truncate max-w-full">
                                                <sl-icon name="check-circle-fill" class="text-[9px]"></sl-icon> {{ coauthor.researcher.department ?: 'CECH UFSCar' }}
                                            </span>
                                        {% else %}
                                            <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 truncate block" title="{{ coauthor.name }}">
                                                {{ coauthor.name }}
                                            </span>
                                            <span class="text-[10px] text-slate-400 block mt-0.5">Colaborador externo</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <span class="rounded-lg bg-indigo-50 dark:bg-indigo-950 px-2.5 py-1 text-xs font-bold text-indigo-700 dark:text-indigo-300 shrink-0 shadow-2xs">
                                    {{ coauthor.count }} pub.
                                </span>
                            </div>

                            <!-- Middle: Period and Types breakdown -->
                            <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 space-y-1.5 text-[11px]">
                                {% if coauthor.period %}
                                    <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-[11px]">
                                        <span class="flex items-center gap-1"><sl-icon name="calendar3" class="text-slate-400 text-[10px]"></sl-icon> Período:</span>
                                        <span class="font-semibold text-slate-700 dark:text-slate-300">{{ coauthor.period }}</span>
                                    </div>
                                {% endif %}

                                {% if coauthor.types|length > 0 %}
                                    <div class="flex flex-wrap gap-1 pt-0.5">
                                        {% for t, c in coauthor.types %}
                                            <span class="text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 px-1.5 py-0.5 rounded font-medium">
                                                {{ t|capitalize }}: {{ c }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <!-- ── 2. Palavras-chave dos Trabalhos & Temas Frequentes (Duas Colunas Lado a Lado) ── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 no-print">
        <!-- Coluna 1: Palavras-chave dos Trabalhos (Lattes) -->
        {% if authorKeywords|length > 0 %}
            <div class="glass-card rounded-3xl p-6 sm:p-7 shadow-sm space-y-4 border-l-4 border-emerald-500 flex flex-col justify-between">
                <div class="space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200/60 dark:border-white/10 pb-3">
                        <div>
                            <h3 class="font-heading text-sm sm:text-base font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 flex items-center gap-2">
                                <sl-icon name="tags-fill" class="text-emerald-500"></sl-icon> Palavras-chave dos Trabalhos
                            </h3>
                            <p class="text-[11px] text-slate-400 mt-0.5">Cadastradas pelo autor nos artigos e produções no Lattes</p>
                        </div>
                        <span class="rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 px-2.5 py-0.5 text-[10px] font-bold shrink-0">Lattes Oficial</span>
                    </div>
                    <div class="flex flex-wrap gap-2 pt-1 max-h-64 overflow-y-auto pr-1">
                        {% set maxAuthCount = authorKeywords|first %}
                        {% for kw, count in authorKeywords %}
                            {% set weight = ((count / (maxAuthCount ?: 1)) * 100)|round %}
                            <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-xl border border-emerald-200/80 dark:border-emerald-900/60 px-3 py-1.5 text-xs transition-all hover:border-emerald-500 hover:scale-105 {% if weight > 70 %}bg-emerald-600 text-white font-bold shadow-sm{% elseif weight > 40 %}bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 font-semibold{% else %}bg-emerald-50/60 dark:bg-emerald-950/30 text-emerald-900 dark:text-emerald-200{% endif %}" title="Filtrar produções com palavra-chave '{{ kw }}' ({{ count }} ocorrências)">
                                {{ kw }} <span class="text-[10px] opacity-75">({{ count }})</span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
                    <span>Clique em qualquer termo para filtrar produções</span>
                    <span class="font-semibold text-emerald-600 dark:text-emerald-400">{{ authorKeywords|length }} termos</span>
                </div>
            </div>
        {% endif %}

        <!-- Coluna 2: Temas e Termos Frequentes (Mineração de Títulos) -->
        {% if topKeywords|length > 0 %}
            <div class="glass-card rounded-3xl p-6 sm:p-7 shadow-sm space-y-4 border-l-4 border-sky-500 flex flex-col justify-between">
                <div class="space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200/60 dark:border-white/10 pb-3">
                        <div>
                            <h3 class="font-heading text-sm sm:text-base font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 flex items-center gap-2">
                                <sl-icon name="diagram-3" class="text-sky-500"></sl-icon> Temas e Termos Frequentes
                            </h3>
                            <p class="text-[11px] text-slate-400 mt-0.5">Sintagmas e conceitos mais recorrentes nos títulos</p>
                        </div>
                        <span class="rounded-full bg-sky-100 dark:bg-sky-950/80 text-sky-800 dark:text-sky-300 px-2.5 py-0.5 text-[10px] font-bold shrink-0">Mineração</span>
                    </div>
                    <div class="flex flex-wrap gap-2 pt-1 max-h-64 overflow-y-auto pr-1">
                        {% set maxCount = topKeywords|first %}
                        {% for word, count in topKeywords %}
                            {% set weight = ((count / (maxCount ?: 1)) * 100)|round %}
                            <button type="button" onclick="filterByKeyword('{{ word|e('js') }}')" class="rounded-xl border border-slate-200/80 dark:border-slate-800 px-3 py-1.5 text-xs transition-all hover:border-sky-500 hover:scale-105 {% if weight > 70 %}bg-sky-500 text-white font-bold shadow-sm{% elseif weight > 40 %}bg-sky-100 dark:bg-sky-950/60 text-sky-800 dark:text-sky-300 font-semibold{% else %}bg-slate-50 dark:bg-slate-900/60 text-slate-700 dark:text-slate-300{% endif %}" title="Filtrar produções contendo '{{ word }}' ({{ count }} ocorrências)">
                                {{ word|capitalize }} <span class="text-[10px] opacity-75">({{ count }})</span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
                    <span>Clique em qualquer termo para filtrar produções</span>
                    <span class="font-semibold text-sky-600 dark:text-sky-400">{{ topKeywords|length }} temas</span>
                </div>
            </div>
        {% endif %}
    </div>

    <!-- ── Global Filter & Real-Time Search Toolbar (Filtragem Abrangente em Todas as Abas) ── -->
    <div id="globalFilterBar" class="glass-card rounded-3xl p-5 sm:p-6 shadow-sm border border-slate-200/80 dark:border-slate-800 transition-all duration-300 no-print">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
            <div class="relative flex-1">
                <input type="text" id="prodSearchInput" oninput="applyGlobalFilter()" placeholder="Buscar por termo, título, orientando, projeto, autor, evento, instituição ou ano..." class="w-full rounded-2xl border border-slate-300 bg-white/90 px-4 py-2.5 pl-10 pr-10 text-sm text-slate-900 placeholder-slate-400 dark:border-slate-700 dark:bg-slate-900/90 dark:text-white focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/15 transition-all shadow-inner" />
                <sl-icon name="search" class="absolute left-3.5 top-3.5 text-slate-400 text-sm"></sl-icon>
                <button type="button" id="btnClearInputQuick" onclick="clearGlobalFilters()" class="hidden absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs p-1" title="Limpar busca">
                    <sl-icon name="x-circle-fill" class="text-base"></sl-icon>
                </button>
            </div>

            <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
                <button type="button" id="btnOnlyDoi" onclick="toggleOnlyDoi()" class="inline-flex items-center gap-1.5 rounded-2xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 transition-colors shadow-sm">
                    <sl-icon name="link-45deg" class="text-sky-500"></sl-icon> Apenas com DOI
                </button>
                <button type="button" id="btnClearFiltersMain" onclick="clearGlobalFilters()" class="hidden inline-flex items-center gap-1.5 rounded-2xl bg-rose-600 hover:bg-rose-700 active:scale-95 text-white px-4 py-2.5 text-xs font-bold shadow-lg shadow-rose-600/25 transition-all animate-bounce">
                    <sl-icon name="x-circle-fill" class="text-sm"></sl-icon> Limpar Filtro
                </button>
            </div>
        </div>

        <!-- Active Filter Status Banner (Destaque do Estado Filtrado) -->
        <div id="filterStatusBanner" class="hidden mt-3.5 pt-3 border-t border-slate-200/70 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 rounded-xl bg-amber-500/15 dark:bg-amber-400/15 border border-amber-500/40 text-amber-900 dark:text-amber-300 px-3 py-1 font-semibold">
                    <sl-icon name="funnel-fill" class="text-amber-500"></sl-icon>
                    Filtrando por: <span id="filterActiveLabel" class="font-bold underline ml-1"></span>
                </span>
                <span id="filterMatchesSummary" class="text-slate-700 dark:text-slate-200 font-medium"></span>
            </div>
            <button type="button" onclick="clearGlobalFilters()" class="text-rose-600 dark:text-rose-400 font-bold hover:underline inline-flex items-center gap-1">
                <sl-icon name="arrow-counterclockwise"></sl-icon> Remover todos os filtros
            </button>
        </div>
    </div>

    <!-- ── Main Content Tabs (Completude de Todas as Seções do Lattes) ── -->
    <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-sm">
        <sl-tab-group id="mainTabGroup">
            <sl-tab slot="nav" panel="productions">
                <sl-icon name="journal-bookmark" class="mr-1"></sl-icon> Produção Científica & Técnica (<span id="tabCount-productions" data-initial="{{ researcher.productions|length }}">{{ researcher.productions|length }}</span>)
            </sl-tab>
            <sl-tab slot="nav" panel="orientations">
                <sl-icon name="people" class="mr-1"></sl-icon> Orientações (<span id="tabCount-orientations" data-initial="{{ researcher.orientations|length }}">{{ researcher.orientations|length }}</span>)
            </sl-tab>
            {% if researcher.researchProjects|length > 0 %}
                <sl-tab slot="nav" panel="projects">
                    <sl-icon name="kanban" class="mr-1"></sl-icon> Projetos (<span id="tabCount-projects" data-initial="{{ researcher.researchProjects|length }}">{{ researcher.researchProjects|length }}</span>)
                </sl-tab>
            {% endif %}
            {% if researcher.professionalExperiences|length > 0 %}
                <sl-tab slot="nav" panel="experience">
                    <sl-icon name="briefcase" class="mr-1"></sl-icon> Atuação Profissional (<span id="tabCount-experience" data-initial="{{ researcher.professionalExperiences|length }}">{{ researcher.professionalExperiences|length }}</span>)
                </sl-tab>
            {% endif %}
            <sl-tab slot="nav" panel="education">
                {% set mainEduCount = researcher.educations|filter(e => e.level not in ['CURTA_DURACAO', 'EXTENSAO', 'COMPLEMENTAR', 'APERFEICOAMENTO'])|length %}
                <sl-icon name="mortarboard" class="mr-1"></sl-icon> Formação Acadêmica (<span id="tabCount-education" data-initial="{{ mainEduCount }}">{{ mainEduCount }}</span>)
            </sl-tab>
            {% set compEduCount = researcher.educations|filter(e => e.level in ['CURTA_DURACAO', 'EXTENSAO', 'COMPLEMENTAR', 'APERFEICOAMENTO'])|length %}
            {% if compEduCount > 0 %}
                <sl-tab slot="nav" panel="complementary">
                    <sl-icon name="award" class="mr-1"></sl-icon> Formação Complementar (<span id="tabCount-complementary" data-initial="{{ compEduCount }}">{{ compEduCount }}</span>)
                </sl-tab>
            {% endif %}
            {% if researcher.examinationBoards|length > 0 %}
                <sl-tab slot="nav" panel="boards">
                    <sl-icon name="clipboard-check" class="mr-1"></sl-icon> Bancas (<span id="tabCount-boards" data-initial="{{ researcher.examinationBoards|length }}">{{ researcher.examinationBoards|length }}</span>)
                </sl-tab>
            {% endif %}
            {% if researcher.eventParticipations|length > 0 %}
                <sl-tab slot="nav" panel="events">
                    <sl-icon name="calendar-event" class="mr-1"></sl-icon> Eventos (<span id="tabCount-events" data-initial="{{ researcher.eventParticipations|length }}">{{ researcher.eventParticipations|length }}</span>)
                </sl-tab>
            {% endif %}
            {% if researcher.awards|length > 0 %}
                <sl-tab slot="nav" panel="awards">
                    <sl-icon name="trophy" class="mr-1"></sl-icon> Prêmios e Títulos (<span id="tabCount-awards" data-initial="{{ researcher.awards|length }}">{{ researcher.awards|length }}</span>)
                </sl-tab>
            {% endif %}
            {% if researcher.knowledgeAreas|length > 0 %}
                <sl-tab slot="nav" panel="areas">
                    <sl-icon name="diagram-2" class="mr-1"></sl-icon> Áreas de Atuação (<span id="tabCount-areas" data-initial="{{ researcher.knowledgeAreas|length }}">{{ researcher.knowledgeAreas|length }}</span>)
                </sl-tab>
            {% endif %}

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 1: PRODUÇÕES CIENTÍFICAS, TÉCNICAS E ARTÍSTICAS
            ══════════════════════════════════════════════════════════════ -->
            <sl-tab-panel name="productions" class="pt-6 space-y-6">

                <!-- Production Category Pills Toolbar -->
                <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 p-3.5 bg-slate-50/70 dark:bg-slate-900/60 no-print">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <button type="button" onclick="setCategoryFilter('all')" class="category-pill active rounded-lg px-2.5 py-1 text-xs font-semibold bg-sky-600 text-white shadow-sm transition-all" data-category="all">
                            Todas (<span class="pill-count" data-initial="{{ researcher.productions|length }}">{{ researcher.productions|length }}</span>)
                        </button>
                        {% if articles|length > 0 %}
                            <button type="button" onclick="setCategoryFilter('artigo')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="artigo">
                                Artigos (<span class="pill-count" data-initial="{{ articles|length }}">{{ articles|length }}</span>)
                            </button>
                        {% endif %}
                        {% if books|length > 0 %}
                            <button type="button" onclick="setCategoryFilter('livro')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="livro">
                                Livros (<span class="pill-count" data-initial="{{ books|length }}">{{ books|length }}</span>)
                            </button>
                        {% endif %}
                        {% if chapters|length > 0 %}
                            <button type="button" onclick="setCategoryFilter('capitulo')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="capitulo">
                                Capítulos (<span class="pill-count" data-initial="{{ chapters|length }}">{{ chapters|length }}</span>)
                            </button>
                        {% endif %}
                        {% if newspaperTexts|length > 0 %}
                            <button type="button" onclick="setCategoryFilter('jornal')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="jornal">
                                Jornais/Revistas (<span class="pill-count" data-initial="{{ newspaperTexts|length }}">{{ newspaperTexts|length }}</span>)
                            </button>
                        {% endif %}
                        {% if events|length > 0 %}
                            <button type="button" onclick="setCategoryFilter('evento')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="evento">
                                Congressos (<span class="pill-count" data-initial="{{ events|length }}">{{ events|length }}</span>)
                            </button>
                        {% endif %}
                        {% if techWorks|length > 0 %}
                            <button type="button" onclick="setCategoryFilter('tecnico')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="tecnico">
                                Trabalhos Técnicos (<span class="pill-count" data-initial="{{ techWorks|length }}">{{ techWorks|length }}</span>)
                            </button>
                        {% endif %}
                        {% if software|length > 0 or patents|length > 0 %}
                            {% set innovCount = software|length + patents|length %}
                            <button type="button" onclick="setCategoryFilter('inovacao')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="inovacao">
                                Inovação (<span class="pill-count" data-initial="{{ innovCount }}">{{ innovCount }}</span>)
                            </button>
                        {% endif %}
                        {% if artistic|length > 0 %}
                            <button type="button" onclick="setCategoryFilter('artes')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="artes">
                                Artes (<span class="pill-count" data-initial="{{ artistic|length }}">{{ artistic|length }}</span>)
                            </button>
                        {% endif %}
                        {% if otherProds|length > 0 %}
                            <button type="button" onclick="setCategoryFilter('outra')" class="category-pill rounded-lg px-2.5 py-1 text-xs font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 transition-all" data-category="outra">
                                Outras (<span class="pill-count" data-initial="{{ otherProds|length }}">{{ otherProds|length }}</span>)
                            </button>
                        {% endif %}
                    </div>

                    {% if academicDatabases.ranking|length > 0 %}
                        <!-- Bases de Indexação Científica / Academic Databases Filter Subsection -->
                        <div class="mt-3.5 pt-3 border-t border-slate-200/80 dark:border-slate-800/80 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
                                    <sl-icon name="database-check" class="text-indigo-500"></sl-icon> Bases de Indexação Científica ({{ academicDatabases.ranking|length }}):
                                </span>
                                <span class="text-[10px] text-slate-400">Clique no ícone/logo da base para filtrar os artigos indexados</span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 max-h-48 overflow-y-auto pr-1">
                                {% for db in academicDatabases.ranking %}
                                    <button type="button" onclick="filterByDatabase('{{ db.acronym|lower|e('js') }}')" class="db-filter-btn rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white/90 dark:bg-slate-900/80 px-2.5 py-1 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-indigo-500 dark:hover:border-indigo-400 hover:bg-indigo-50/50 dark:hover:bg-indigo-950/40 transition-all flex items-center gap-2 shadow-2xs group" data-db-acronym="{{ db.acronym|lower|e('html_attr') }}" title="Filtrar artigos indexados na base '{{ db.name }}' ({{ db.total }} itens)">
                                        {% if db.logo %}
                                            <img src="{{ db.logo }}" alt="{{ db.name }}" class="h-3.5 w-auto object-contain shrink-0 group-hover:scale-110 transition-transform" onerror="this.style.display='none'" />
                                        {% else %}
                                            <sl-icon name="journal-check" class="text-indigo-500 text-xs shrink-0"></sl-icon>
                                        {% endif %}
                                        <span class="font-bold">{{ db.name }}</span>
                                        <span class="rounded-md bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 px-1.5 py-0.2 text-[10px] font-bold group-hover:bg-indigo-100 dark:group-hover:bg-indigo-900 font-mono">
                                            {{ db.total }}
                                        </span>
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>

                <!-- Empty State Message for Productions -->
                <div id="empty-productions" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                    <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhuma produção encontrada para o filtro selecionado.</p>
                </div>

                <!-- 1. Articles in Journals -->
                {% if articles|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="artigo">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="file-earmark-text" class="text-sky-600 dark:text-sky-400"></sl-icon>
                            Artigos em Periódicos ({{ articles|length }})
                        </h3>
                        <div class="space-y-3">
                            {% for p in articles %}
                                {% set indexedDbs = resolve_databases(p, p.issn) %}
                                {% set dbAcronyms = [] %}
                                {% for db in indexedDbs %}
                                    {% set dbAcronyms = dbAcronyms|merge([db.acronym|lower]) %}
                                {% endfor %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 hover:border-sky-300 dark:hover:border-sky-700 transition-colors space-y-2 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="artigo" data-year="{{ p.year }}" data-databases="{{ dbAcronyms|json_encode|e('html_attr') }}">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="flex flex-wrap items-center gap-2">
                                            {% if p.year %}
                                                <span class="rounded-md bg-sky-100 px-2 py-0.5 text-[11px] font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                                                    {{ p.year }}
                                                </span>
                                            {% endif %}
                                            {% set jBadges = p.journalName ? journal_badges(p, p.issn, p.qualis) : '' %}
                                            {% if jBadges %}
                                                {{ jBadges|raw }}
                                            {% elseif p.qualis %}
                                                <span class="rounded-md px-2 py-0.5 text-[11px] font-bold badge-qualis-{{ p.qualis|lower }}">
                                                    Qualis {{ p.qualis }}
                                                </span>
                                            {% endif %}
                                            {% if p.nature %}
                                                <span class="text-[11px] text-slate-400 font-medium">{{ p.nature }}</span>
                                            {% endif %}
                                        </div>
                                        <button type="button" onclick="copyCitation(this, '{{ p.title|e('js') }}', '{{ (p.journalName ?: '')|e('js') }}', '{{ p.year }}', '{{ p.doi ?: '' }}')" class="text-[11px] font-medium text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 flex items-center gap-1 no-print" title="Copiar citação ABNT">
                                            <sl-icon name="clipboard"></sl-icon> Citar
                                        </button>
                                    </div>

                                    <h4 class="font-heading text-sm sm:text-base font-semibold text-slate-900 dark:text-white leading-snug prod-title">
                                        {{ p.title }}
                                    </h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    <div class="text-xs text-slate-600 dark:text-slate-400 prod-details">
                                        {% if p.journalName %}
                                            <span class="font-medium italic text-slate-800 dark:text-slate-200">{{ p.journalName }}</span>
                                        {% endif %}
                                        {% if p.volume %} v. {{ p.volume }},{% endif %}
                                        {% if p.issue %} n. {{ p.issue }},{% endif %}
                                        {% if p.pages %} p. {{ p.pages }},{% endif %}
                                        {% if p.issn %} ISSN: {{ p.issn }}{% endif %}
                                    </div>

                                    <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-200/60 dark:border-white/10 text-xs">
                                        <div class="text-slate-500 dark:text-slate-400 prod-authors">
                                            {% if p.authors|length > 0 %}
                                                Autores: {{ render_production_authors(p, researcher.id) }}
                                            {% endif %}
                                        </div>

                                        {% if p.doi %}
                                            <a href="{{ p.doiUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold text-sky-600 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300 hover:underline shrink-0" title="Abrir artigo pelo DOI em nova aba">
                                                <sl-icon name="box-arrow-up-right" class="text-[11px]"></sl-icon> DOI: {{ p.doi }}
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- 2. Books -->
                {% if books|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="livro">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="book" class="text-amber-600 dark:text-amber-400"></sl-icon>
                            Livros Publicados ou Organizados ({{ books|length }})
                        </h3>
                        <div class="space-y-3">
                            {% for p in books %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-2 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="livro" data-year="{{ p.year }}">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            {% if p.year %}
                                                <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                                                    {{ p.year }}
                                                </span>
                                            {% endif %}
                                            <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 uppercase">Livro</span>
                                        </div>
                                        <button type="button" onclick="copyCitation(this, '{{ p.title|e('js') }}', '{{ (p.publisher ?: '')|e('js') }}', '{{ p.year }}', '{{ p.doi ?: '' }}')" class="text-[11px] font-medium text-slate-400 hover:text-amber-600 flex items-center gap-1 no-print">
                                            <sl-icon name="clipboard"></sl-icon> Citar
                                        </button>
                                    </div>
                                    <h4 class="font-heading text-sm sm:text-base font-semibold text-slate-900 dark:text-white prod-title">{{ p.title }}</h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    <div class="text-xs text-slate-600 dark:text-slate-400 prod-details">
                                        {% if p.publisher %}Editora: {{ p.publisher }}.{% endif %}
                                        {% if p.volume %} v. {{ p.volume }}.{% endif %}
                                        {% if p.pages %} {{ p.pages }}.{% endif %}
                                        {% if p.isbn %} ISBN: {{ p.isbn }}.{% endif %}
                                    </div>

                                    <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 dark:border-white/10 text-xs">
                                        <div class="text-slate-500 dark:text-slate-400 prod-authors">
                                            {% if p.authors|length > 0 %}Autores: {{ render_production_authors(p, researcher.id) }}{% endif %}
                                        </div>
                                        {% if p.doi %}
                                            <a href="{{ p.doiUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold text-sky-600 hover:underline shrink-0">
                                                <sl-icon name="box-arrow-up-right"></sl-icon> DOI
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- 3. Book Chapters -->
                {% if chapters|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="capitulo">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="bookmark" class="text-purple-600 dark:text-purple-400"></sl-icon>
                            Capítulos de Livros Publicados ({{ chapters|length }})
                        </h3>
                        <div class="space-y-3">
                            {% for p in chapters %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-2 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="capitulo" data-year="{{ p.year }}">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            {% if p.year %}
                                                 <span class="rounded-md bg-purple-100 px-2 py-0.5 text-[11px] font-semibold text-purple-800 dark:bg-purple-950 dark:text-purple-300">
                                                    {{ p.year }}
                                                </span>
                                            {% endif %}
                                            <span class="text-[11px] font-bold text-purple-600 dark:text-purple-400 uppercase">Capítulo</span>
                                        </div>
                                        <button type="button" onclick="copyCitation(this, '{{ p.title|e('js') }}', 'In: {{ (p.journalName ?: '')|e('js') }}', '{{ p.year }}', '{{ p.doi ?: '' }}')" class="text-[11px] font-medium text-slate-400 hover:text-purple-600 flex items-center gap-1 no-print">
                                            <sl-icon name="clipboard"></sl-icon> Citar
                                        </button>
                                    </div>
                                    <h4 class="font-heading text-sm sm:text-base font-semibold text-slate-900 dark:text-white prod-title">{{ p.title }}</h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    <div class="text-xs text-slate-600 dark:text-slate-400 prod-details">
                                        {% if p.journalName %}In: <span class="italic font-medium">{{ p.journalName }}</span>.{% endif %}
                                        {% if p.publisher %} Editora: {{ p.publisher }}.{% endif %}
                                        {% if p.volume %} v. {{ p.volume }}.{% endif %}
                                        {% if p.pages %} p. {{ p.pages }}.{% endif %}
                                    </div>

                                    <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 dark:border-white/10 text-xs">
                                        <div class="text-slate-500 dark:text-slate-400 prod-authors">
                                            {% if p.authors|length > 0 %}Autores: {{ render_production_authors(p, researcher.id) }}{% endif %}
                                        </div>
                                        {% if p.doi %}
                                            <a href="{{ p.doiUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold text-sky-600 hover:underline shrink-0">
                                                <sl-icon name="box-arrow-up-right"></sl-icon> DOI
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- 4. Textos em Jornais e Revistas -->
                {% if newspaperTexts|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="jornal">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="newspaper" class="text-blue-600 dark:text-blue-400"></sl-icon>
                            Textos em Jornais de Notícias / Revistas ({{ newspaperTexts|length }})
                        </h3>
                        <div class="space-y-3">
                            {% for p in newspaperTexts %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-2 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="jornal" data-year="{{ p.year }}">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            {% if p.year %}
                                                <span class="rounded-md bg-blue-100 px-2 py-0.5 text-[11px] font-semibold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
                                                    {{ p.year }}
                                                </span>
                                            {% endif %}
                                            <span class="text-[11px] font-bold text-blue-600 dark:text-blue-400 uppercase">Jornal / Revista</span>
                                        </div>
                                    </div>
                                    <h4 class="font-heading text-sm sm:text-base font-semibold text-slate-900 dark:text-white prod-title">{{ p.title }}</h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    <div class="text-xs text-slate-600 dark:text-slate-400 prod-details">
                                        {% if p.journalName %}Veículo: <span class="font-medium">{{ p.journalName }}</span>.{% endif %}
                                        {% if p.pages %} p. {{ p.pages }}.{% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- 5. Event Papers -->
                {% if events|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="evento">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="calendar-event" class="text-rose-600 dark:text-rose-400"></sl-icon>
