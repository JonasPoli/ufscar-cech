                        </h3>
                        <div class="space-y-3">
                            {% for p in events %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-2 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="evento" data-year="{{ p.year }}">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            {% if p.year %}
                                                <span class="rounded-md bg-rose-100 px-2 py-0.5 text-[11px] font-semibold text-rose-800 dark:bg-rose-950 dark:text-rose-300">
                                                    {{ p.year }}
                                                </span>
                                            {% endif %}
                                            <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:text-slate-300 uppercase">
                                                {{ p.nature ?: 'Congresso' }}
                                            </span>
                                        </div>
                                        <button type="button" onclick="copyCitation(this, '{{ p.title|e('js') }}', 'In: {{ (p.eventName ?: p.journalName ?: '')|e('js') }}', '{{ p.year }}', '{{ p.doi ?: '' }}')" class="text-[11px] font-medium text-slate-400 hover:text-rose-600 flex items-center gap-1 no-print">
                                            <sl-icon name="clipboard"></sl-icon> Citar
                                        </button>
                                    </div>
                                    <h4 class="font-heading text-sm sm:text-base font-semibold text-slate-900 dark:text-white prod-title">{{ p.title }}</h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    <div class="text-xs text-slate-600 dark:text-slate-400 prod-details">
                                        {% if p.eventName or p.journalName %}In: <span class="italic">{{ p.eventName ?: p.journalName }}</span>.{% endif %}
                                        {% if p.eventCity %} Local: {{ p.eventCity }}.{% endif %}
                                        {% if p.volume %} v. {{ p.volume }}.{% endif %}
                                        {% if p.pages %} p. {{ p.pages }}.{% endif %}
                                    </div>

                                    <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 dark:border-white/10 text-xs">
                                        <div class="text-slate-500 dark:text-slate-400 prod-authors">
                                            {% if p.authors|length > 0 %}Autores: {{ render_production_authors(p, researcher.id) }}{% endif %}
                                        </div>
                                        {% if p.doi %}
                                            <a href="{{ p.doiUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold text-sky-600 hover:underline shrink-0">
                                                <sl-icon name="box-arrow-up-right"></sl-icon> DOI
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- 6. Technical Works & Consultancy -->
                {% if techWorks|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="tecnico">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="gear" class="text-teal-600 dark:text-teal-400"></sl-icon>
                            Trabalhos Técnicos, Pareceres e Consultorias ({{ techWorks|length }})
                        </h3>
                        <div class="space-y-3">
                            {% for p in techWorks %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1.5 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="tecnico" data-year="{{ p.year }}">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            {% if p.year %}
                                                <span class="rounded-md bg-teal-100 px-2 py-0.5 text-[11px] font-semibold text-teal-800 dark:bg-teal-950 dark:text-teal-300">
                                                    {{ p.year }}
                                                </span>
                                            {% endif %}
                                            <span class="text-[11px] font-bold text-teal-600 dark:text-teal-400 uppercase">{{ p.nature ?: 'Trabalho Técnico' }}</span>
                                        </div>
                                    </div>
                                    <h4 class="font-heading text-sm font-semibold text-slate-900 dark:text-white prod-title">{{ p.title }}</h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    {% if p.journalName %}<p class="text-xs text-slate-500 dark:text-slate-400 prod-details">{{ p.journalName }}</p>{% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- 7. Innovation: Software & Patents -->
                {% if software|length > 0 or patents|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="inovacao">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="cpu" class="text-indigo-600 dark:text-indigo-400"></sl-icon>
                            Inovação Tecnológica: Softwares e Patentes ({{ software|length + patents|length }})
                        </h3>
                        <div class="space-y-3">
                            {% for p in software|merge(patents) %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1.5 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="inovacao" data-year="{{ p.year }}">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            {% if p.year %}<span class="rounded-md bg-indigo-100 px-2 py-0.5 text-[11px] font-semibold text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">{{ p.year }}</span>{% endif %}
                                            <span class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase">{{ p.itemType }}</span>
                                        </div>
                                    </div>
                                    <h4 class="font-heading text-sm font-semibold text-slate-900 dark:text-white prod-title">{{ p.title }}</h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    {% if p.journalName %}<p class="text-xs text-slate-500 dark:text-slate-400 prod-details">{{ p.journalName }}</p>{% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- 8. Artistic & Cultural -->
                {% if artistic|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="artes">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="palette" class="text-purple-600 dark:text-purple-400"></sl-icon>
                            Produção Artística e Cultural ({{ artistic|length }})
                        </h3>
                        <div class="space-y-3">
                            {% for p in artistic %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1.5 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="artes" data-year="{{ p.year }}">
                                    <div class="flex items-center gap-2">
                                        {% if p.year %}<span class="rounded-md bg-purple-100 px-2 py-0.5 text-[11px] font-semibold text-purple-800 dark:bg-purple-950 dark:text-purple-300">{{ p.year }}</span>{% endif %}
                                        <span class="text-[11px] font-bold text-purple-600 dark:text-purple-400 uppercase">{{ p.nature ?: 'Artes' }}</span>
                                    </div>
                                    <h4 class="font-heading text-sm font-semibold text-slate-900 dark:text-white prod-title">{{ p.title }}</h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- 9. Outras Produções -->
                {% if otherProds|length > 0 %}
                    <div class="space-y-4 prod-section" data-section-category="outra">
                        <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <sl-icon name="collection" class="text-slate-600 dark:text-slate-400"></sl-icon>
                            Demais Tipos de Produção ({{ otherProds|length }})
                        </h3>
                        <div class="space-y-3">
                            {% for p in otherProds %}
                                <div class="prod-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1.5 bg-white/50 dark:bg-slate-900/50" data-has-doi="{{ p.doi ? '1' : '0' }}" data-category="outra" data-year="{{ p.year }}">
                                    <div class="flex items-center gap-2">
                                        {% if p.year %}<span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-800 dark:bg-slate-800 dark:text-slate-300">{{ p.year }}</span>{% endif %}
                                    </div>
                                    <h4 class="font-heading text-sm font-semibold text-slate-900 dark:text-white prod-title">{{ p.title }}</h4>

                                    {% if p.keywords|length > 0 %}
                                        <div class="flex flex-wrap items-center gap-1.5 pt-0.5 pb-0.5">
                                            <span class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1">
                                                <sl-icon name="tags-fill" class="text-emerald-500 text-[11px]"></sl-icon> Palavras-chave:
                                            </span>
                                            {% for kw in p.keywords %}
                                                <button type="button" onclick="filterByKeyword('{{ kw|e('js') }}')" class="rounded-md bg-emerald-50 hover:bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:hover:bg-emerald-900/80 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 px-2 py-0.5 text-[10px] font-medium transition-colors hover:scale-105" title="Filtrar produções por '{{ kw }}'">
                                                    #{{ kw }}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </sl-tab-panel>

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 2: ORIENTAÇÕES E SUPERVISÕES (CONCLUÍDAS E EM ANDAMENTO)
            ══════════════════════════════════════════════════════════════ -->
            <sl-tab-panel name="orientations" class="pt-6 space-y-8">
                <!-- Empty State Message for Orientations -->
                <div id="empty-orientations" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                    <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhuma orientação encontrada para o filtro aplicado.</p>
                </div>

                <!-- Completed Orientations -->
                {% if completedOrientations|length > 0 %}
                    <div class="space-y-4">
                        <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <span class="flex items-center gap-2">
                                <sl-icon name="check-circle-fill" class="text-emerald-600 dark:text-emerald-400"></sl-icon>
                                Orientações Concluídas ({{ completedOrientations|length }})
                            </span>
                            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                                {% set pCount = [] %}
                                {% if kpiStats.orientationsBreakdown.doutorado_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.doutorado_concluido ~ ' Doutorado']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.mestrado_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.mestrado_concluido ~ ' Mestrado']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.pos_doc_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.pos_doc_concluido ~ ' Pós-Doc']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.tcc_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.tcc_concluido ~ ' TCC/Graduação']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.iniciacao_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.iniciacao_concluido ~ ' PIBIC']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.especializacao_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.especializacao_concluido ~ ' Especialização']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.outras_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.outras_concluido ~ ' Outras']) %}{% endif %}
                                {{ pCount|join(' • ') }}
                            </span>
                        </h3>
                        <div class="space-y-3">
                            {% for o in completedOrientations %}
                                <div class="orientation-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-2.5 bg-white/50 dark:bg-slate-900/50 hover:border-emerald-300 dark:hover:border-emerald-700/50 transition-colors flex flex-col justify-between">
                                    <div class="space-y-1">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                {% if o.orientationType == 'DOUTORADO' %}
                                                    <span class="rounded-md bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 px-2 py-0.5 text-[11px] font-bold">Doutorado</span>
                                                {% elseif o.orientationType == 'MESTRADO' %}
                                                    <span class="rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-2 py-0.5 text-[11px] font-bold">Mestrado</span>
                                                {% elseif o.orientationType == 'POS_DOUTORADO' %}
                                                    <span class="rounded-md bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 px-2 py-0.5 text-[11px] font-bold">Pós-Doutorado</span>
                                                {% elseif o.orientationType == 'TCC_GRADUACAO' %}
                                                    <span class="rounded-md bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 text-[11px] font-bold">TCC / Graduação</span>
                                                {% elseif o.orientationType == 'INICIACAO_CIENTIFICA' %}
                                                    <span class="rounded-md bg-yellow-100 text-yellow-800 dark:bg-yellow-950 dark:text-yellow-300 px-2 py-0.5 text-[11px] font-bold">Iniciação Científica (PIBIC)</span>
                                                {% elseif o.orientationType == 'ESPECIALIZACAO' %}
                                                    <span class="rounded-md bg-pink-100 text-pink-800 dark:bg-pink-950 dark:text-pink-300 px-2 py-0.5 text-[11px] font-bold">Especialização</span>
                                                {% else %}
                                                    <span class="rounded-md bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2 py-0.5 text-[11px] font-bold">Outra Natureza</span>
                                                {% endif %}
                                                {% if o.isCoadvising %}
                                                    <span class="rounded-md bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/50 px-1.5 py-0.5 text-[10px] font-medium">Coorientação</span>
                                                {% endif %}
                                            </div>
                                            {% if o.year %}<span class="text-xs text-slate-400 font-semibold font-mono">{{ o.year }}</span>{% endif %}
                                        </div>
                                        <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ o.studentName }}</p>
                                        {% if o.title %}
                                            <p class="text-xs text-slate-600 dark:text-slate-300 italic">"{{ o.title }}"</p>
                                        {% endif %}
                                        <div class="text-[11px] text-slate-400">
                                            {% if o.courseName %}{{ o.courseName }} • {% endif %}
                                            {{ o.institutionName }}
                                            {% if o.campus %} ({{ o.campus }}){% endif %}
                                        </div>
                                    </div>

                                    {# Botão de Busca e Link Direto para o Repositório #}
                                    <div class="pt-2 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between gap-2">
                                        {% set queryParts = [] %}
                                        {% if o.title %}{% set queryParts = queryParts|merge(['"' ~ o.title ~ '"']) %}{% endif %}
                                        {% if o.studentName %}{% set queryParts = queryParts|merge([o.studentName]) %}{% endif %}
                                        {% if researcher.fullName %}{% set queryParts = queryParts|merge([researcher.fullName]) %}{% endif %}
                                        {% if o.institutionName %}{% set queryParts = queryParts|merge([o.institutionName]) %}{% endif %}
                                        {% set gSearchUrl = 'https://www.google.com/search?q=' ~ (queryParts|join(' ')|url_encode) %}
                                        {% set gScholarUrl = 'https://scholar.google.com/scholar?q=' ~ ((o.title ? ('"' ~ o.title ~ '"') : (o.studentName ~ ' ' ~ researcher.fullName))|url_encode) %}

                                        <div class="flex items-center gap-2 flex-wrap">
                                            {% if o.handleUrl %}
                                                <a href="{{ o.handleUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-[11px] font-semibold text-emerald-700 dark:text-emerald-300 hover:text-emerald-900 dark:hover:text-emerald-100 bg-emerald-50 dark:bg-emerald-950/60 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-200/80 dark:border-emerald-800/60 transition group shrink-0" title="Ver trabalho completo no Repositório Institucional UFSCar">
                                                    <sl-icon name="book" class="text-emerald-600 dark:text-emerald-400 text-xs"></sl-icon>
                                                    <span>Repositório UFSCar</span>
                                                    <sl-icon name="box-arrow-up-right" class="text-[10px] text-emerald-500"></sl-icon>
                                                </a>
                                            {% endif %}

                                            <a href="{{ gSearchUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100/80 hover:bg-slate-200/80 dark:bg-slate-800/80 dark:hover:bg-slate-700/80 border border-slate-200/60 dark:border-slate-700/60 transition group shrink-0" title="Pesquisar trabalho/arquivo da orientação no Google">
                                                <svg class="w-3.5 h-3.5 grayscale group-hover:grayscale-0 opacity-70 group-hover:opacity-100 transition" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                                                </svg>
                                                <span>Google</span>
                                                <sl-icon name="box-arrow-up-right" class="text-[10px] text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-200"></sl-icon>
                                            </a>

                                            <a href="{{ gScholarUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-2 py-1 rounded-md text-[11px] font-medium text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition" title="Pesquisar no Google Acadêmico (Scholar)">
                                                <sl-icon name="mortarboard" class="text-slate-400 text-[11px]"></sl-icon>
                                                <span>Scholar</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- Ongoing Orientations -->
                {% if ongoingOrientations|length > 0 %}
                    <div class="space-y-4">
                        <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <span class="flex items-center gap-2">
                                <sl-icon name="arrow-repeat" class="text-sky-600 dark:text-sky-400"></sl-icon>
                                Orientações em Andamento ({{ ongoingOrientations|length }})
                            </span>
                            <span class="text-xs font-semibold text-sky-600 dark:text-sky-400">
                                {% set pCountA = [] %}
                                {% if kpiStats.orientationsBreakdown.doutorado_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.doutorado_andamento ~ ' Doutorado']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.mestrado_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.mestrado_andamento ~ ' Mestrado']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.pos_doc_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.pos_doc_andamento ~ ' Pós-Doc']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.tcc_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.tcc_andamento ~ ' TCC/Graduação']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.iniciacao_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.iniciacao_andamento ~ ' PIBIC']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.especializacao_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.especializacao_andamento ~ ' Especialização']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.outras_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.outras_andamento ~ ' Outras']) %}{% endif %}
                                {{ pCountA|join(' • ') }}
                            </span>
                        </h3>
                        <div class="space-y-3">
                            {% for o in ongoingOrientations %}
                                <div class="orientation-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-2.5 bg-white/50 dark:bg-slate-900/50 hover:border-sky-300 dark:hover:border-sky-700/50 transition-colors flex flex-col justify-between">
                                    <div class="space-y-1">
                                        <div class="flex items-center justify-between">
                                            {% if o.orientationType == 'DOUTORADO' %}
                                                <span class="rounded-md bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 px-2 py-0.5 text-[11px] font-bold">Doutorado</span>
                                            {% elseif o.orientationType == 'MESTRADO' %}
                                                <span class="rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-2 py-0.5 text-[11px] font-bold">Mestrado</span>
                                            {% elseif o.orientationType == 'POS_DOUTORADO' %}
                                                <span class="rounded-md bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 px-2 py-0.5 text-[11px] font-bold">Pós-Doutorado</span>
                                            {% elseif o.orientationType == 'TCC_GRADUACAO' %}
                                                <span class="rounded-md bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 text-[11px] font-bold">TCC / Graduação</span>
                                            {% elseif o.orientationType == 'INICIACAO_CIENTIFICA' %}
                                                <span class="rounded-md bg-yellow-100 text-yellow-800 dark:bg-yellow-950 dark:text-yellow-300 px-2 py-0.5 text-[11px] font-bold">Iniciação Científica (PIBIC)</span>
                                            {% elseif o.orientationType == 'ESPECIALIZACAO' %}
                                                <span class="rounded-md bg-pink-100 text-pink-800 dark:bg-pink-950 dark:text-pink-300 px-2 py-0.5 text-[11px] font-bold">Especialização</span>
                                            {% else %}
                                                <span class="rounded-md bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2 py-0.5 text-[11px] font-bold">Outra Natureza</span>
                                            {% endif %}
                                            {% if o.year %}<span class="text-xs text-slate-400 font-medium font-mono">Início: {{ o.year }}</span>{% endif %}
                                        </div>
                                        <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ o.studentName }}</p>
                                        {% if o.title %}
                                            <p class="text-xs text-slate-600 dark:text-slate-300 italic">"{{ o.title }}"</p>
                                        {% endif %}
                                        <div class="text-[11px] text-slate-400">
                                            {% if o.courseName %}{{ o.courseName }} • {% endif %}
                                            {{ o.institutionName }}
                                        </div>
                                    </div>

                                    {# Botão de Busca do Trabalho no Google #}
                                    <div class="pt-2 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between gap-2">
                                        {% set queryParts = [] %}
                                        {% if o.title %}{% set queryParts = queryParts|merge(['"' ~ o.title ~ '"']) %}{% endif %}
                                        {% if o.studentName %}{% set queryParts = queryParts|merge([o.studentName]) %}{% endif %}
                                        {% if researcher.fullName %}{% set queryParts = queryParts|merge([researcher.fullName]) %}{% endif %}
                                        {% if o.institutionName %}{% set queryParts = queryParts|merge([o.institutionName]) %}{% endif %}
                                        {% set gSearchUrl = 'https://www.google.com/search?q=' ~ (queryParts|join(' ')|url_encode) %}

                                        <a href="{{ gSearchUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100/80 hover:bg-slate-200/80 dark:bg-slate-800/80 dark:hover:bg-slate-700/80 border border-slate-200/60 dark:border-slate-700/60 transition group shrink-0" title="Pesquisar projeto/orientação no Google">
                                            <svg class="w-3.5 h-3.5 grayscale group-hover:grayscale-0 opacity-70 group-hover:opacity-100 transition" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                                            </svg>
                                            <span>Buscar no Google</span>
                                            <sl-icon name="box-arrow-up-right" class="text-[10px] text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-200"></sl-icon>
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                        </div>
                    </div>
                {% endif %}
            </sl-tab-panel>

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 3: PROJETOS DE PESQUISA, EXTENSÃO E DESENVOLVIMENTO
            ══════════════════════════════════════════════════════════════ -->
            {% if researcher.researchProjects|length > 0 %}
                <sl-tab-panel name="projects" class="pt-6 space-y-4">
                    <!-- Empty State Message for Projects -->
                    <div id="empty-projects" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                        <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhum projeto encontrado para o filtro aplicado.</p>
                    </div>

                    <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                        <sl-icon name="kanban" class="text-sky-600 dark:text-sky-400"></sl-icon>
                        Projetos de Pesquisa, Extensão & Desenvolvimento ({{ researcher.researchProjects|length }})
                    </h3>
                    <div class="space-y-4">
                        {% for proj in researcher.researchProjects %}
                            <div class="project-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-5 space-y-2.5 bg-white/50 dark:bg-slate-900/50 hover:border-slate-300 transition-colors">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        <span class="rounded-md {% if proj.nature == 'EXTENSAO' %}bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300{% elseif proj.nature == 'DESENVOLVIMENTO' %}bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300{% else %}bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300{% endif %} px-2.5 py-0.5 text-[11px] font-bold">
                                            {{ proj.nature }}
                                        </span>
                                        <span class="rounded-md {% if proj.status == 'EM_ANDAMENTO' %}bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300{% else %}bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300{% endif %} px-2 py-0.5 text-[11px] font-semibold">
                                            {{ proj.status|replace({'_': ' '}) }}
                                        </span>
                                        {% if proj.isCoordinator %}
                                            <span class="rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 px-2 py-0.5 text-[10px] font-bold">
                                                Coordenador
                                            </span>
                                        {% endif %}
                                    </div>
                                    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 font-mono">
                                        {{ proj.startYear ?: '?' }} — {{ proj.endYear ?: 'Atual' }}
                                    </span>
                                </div>

                                <h4 class="font-heading text-base font-bold text-slate-900 dark:text-white leading-snug">
                                    {{ proj.name }}
                                </h4>

                                {% if proj.description %}
                                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed pt-1">{{ proj.description }}</p>
                                {% endif %}

                                {% if proj.agencyFinancier %}
                                    <div class="flex items-center gap-1.5 pt-1 text-xs text-emerald-700 dark:text-emerald-400 font-semibold">
                                        <sl-icon name="cash-coin"></sl-icon> Financiador(es): {{ proj.agencyFinancier }}
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </sl-tab-panel>
            {% endif %}

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 4: ATUAÇÃO PROFISSIONAL E VÍNCULOS
            ══════════════════════════════════════════════════════════════ -->
            {% if researcher.professionalExperiences|length > 0 %}
                <sl-tab-panel name="experience" class="pt-6 space-y-4">
                    <!-- Empty State Message for Experience -->
                    <div id="empty-experience" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                        <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhuma atuação profissional encontrada para o filtro aplicado.</p>
                    </div>

                    <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                        <sl-icon name="briefcase" class="text-sky-600 dark:text-sky-400"></sl-icon>
                        Atuação Profissional e Vínculos Institucionais
                    </h3>
                    <div class="space-y-4">
                        {% for exp in researcher.professionalExperiences %}
                            <div class="experience-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-5 space-y-2 bg-white/50 dark:bg-slate-900/50">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        {{ institution_badge(exp.institutionName) }}
                                    </div>
                                    <div class="flex items-center gap-2">
                                        {% if exp.isCurrent %}
                                            <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                                                Atual
                                            </span>
                                        {% endif %}
                                        <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 font-mono">
                                            {{ exp.startYear ?: '?' }} — {{ exp.endYear ?: 'Atual' }}
                                        </span>
                                    </div>
                                </div>

                                <div class="text-xs text-slate-600 dark:text-slate-300 space-y-1">
                                    {% if exp.roleName %}
                                        <p><strong class="font-semibold text-slate-700 dark:text-slate-200">Cargo / Enquadramento:</strong> {{ exp.roleName }}</p>
                                    {% endif %}
                                    {% if exp.contractType %}
                                        <p><strong class="font-semibold text-slate-700 dark:text-slate-200">Vínculo:</strong> {{ exp.contractType }} {% if exp.workloadHours %}({{ exp.workloadHours }}h semanais){% endif %}</p>
                                    {% endif %}
                                    {% if exp.otherInfo %}
                                        <p class="italic text-slate-500 dark:text-slate-400 pt-1">{{ exp.otherInfo }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </sl-tab-panel>
            {% endif %}

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 5: FORMAÇÃO ACADÊMICA E TITULAÇÕES
            ══════════════════════════════════════════════════════════════ -->
            <sl-tab-panel name="education" class="pt-6 space-y-4">
                <!-- Empty State Message for Education -->
                <div id="empty-education" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                    <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhuma formação acadêmica encontrada para o filtro aplicado.</p>
                </div>

                <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                    <sl-icon name="mortarboard" class="text-indigo-600 dark:text-indigo-400"></sl-icon>
                    Formação Acadêmica / Titulação & Pós-Doutorado
                </h3>

                <div class="space-y-6 relative border-l-2 border-slate-200 dark:border-slate-800 ml-4 pl-6 pt-2">
                    {% for e in researcher.educations|filter(e => e.level not in ['CURTA_DURACAO', 'EXTENSAO', 'COMPLEMENTAR', 'APERFEICOAMENTO']) %}
                        <div class="education-item relative space-y-1.5">
                            <div class="absolute -left-[31px] top-1.5 h-3.5 w-3.5 rounded-full bg-sky-600 border-2 border-white dark:border-slate-950"></div>
                            <div class="flex items-center gap-2">
                                <span class="rounded-md bg-indigo-100 px-2 py-0.5 text-[11px] font-bold text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">
                                    {{ e.level|replace({'_': ' '}) }}
                                </span>
                                <span class="text-xs text-slate-400 font-semibold font-mono">
                                    {{ e.startYear ?: '?' }} — {{ e.endYear ?: 'Atual' }}
                                </span>
                            </div>
                            <h4 class="font-heading text-base font-bold text-slate-900 dark:text-white">
                                {{ e.courseName ?: e.institutionName }}
                            </h4>
                            <div class="text-xs font-medium text-slate-600 dark:text-slate-400">
                                {{ institution_badge(e.institutionName) }}
                            </div>
                            {% if e.monographTitle %}
                                <p class="text-xs text-slate-600 dark:text-slate-300 italic pt-0.5">
                                    <strong>Título:</strong> "{{ e.monographTitle }}"
                                </p>
                            {% endif %}
                            {% if e.advisorName %}
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    <strong>Orientador(a):</strong> {{ e.advisorName }}
                                </p>
                            {% endif %}
                            {% if e.grantingAgency %}
                                <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">
                                    Bolsa / Fomento: {{ e.grantingAgency }}
                                </p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </sl-tab-panel>

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 6: FORMAÇÃO COMPLEMENTAR & EXTENSÃO
            ══════════════════════════════════════════════════════════════ -->
            {% if researcher.educations|filter(e => e.level in ['CURTA_DURACAO', 'EXTENSAO', 'COMPLEMENTAR', 'APERFEICOAMENTO'])|length > 0 %}
                <sl-tab-panel name="complementary" class="pt-6 space-y-4">
                    <!-- Empty State Message for Complementary Education -->
                    <div id="empty-complementary" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                        <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhum curso de formação complementar encontrado para o filtro aplicado.</p>
                    </div>

                    <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                        <sl-icon name="award" class="text-amber-500"></sl-icon>
                        Formação Complementar & Cursos de Extensão
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {% for ce in researcher.educations|filter(e => e.level in ['CURTA_DURACAO', 'EXTENSAO', 'COMPLEMENTAR', 'APERFEICOAMENTO']) %}
                            <div class="complementary-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1 bg-white/50 dark:bg-slate-900/50">
                                <div class="flex items-center justify-between">
                                    <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                                        {{ ce.level|replace({'_': ' '}) }}
                                    </span>
                                    <span class="text-xs text-slate-400 font-medium font-mono">{{ ce.startYear ?: ce.endYear ?: '-' }}</span>
                                </div>
                                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">{{ ce.courseName }}</h4>
                                <div>{{ institution_badge(ce.institutionName) }}</div>
                                {% if ce.workloadHours %}
                                    <p class="text-[11px] text-slate-400">Carga horária: {{ ce.workloadHours }}h</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </sl-tab-panel>
            {% endif %}

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 7: BANCAS EXAMINADORAS
            ══════════════════════════════════════════════════════════════ -->
            {% if researcher.examinationBoards|length > 0 %}
                <sl-tab-panel name="boards" class="pt-6 space-y-4">
                    <!-- Empty State Message for Boards -->
                    <div id="empty-boards" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                        <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhuma participação em banca encontrada para o filtro aplicado.</p>
                    </div>

                    <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                        <sl-icon name="clipboard-check" class="text-indigo-600 dark:text-indigo-400"></sl-icon>
                        Participação em Bancas Julgadoras e Comissões ({{ researcher.examinationBoards|length }})
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {% for b in researcher.examinationBoards %}
                            <div class="board-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1.5 bg-white/50 dark:bg-slate-900/50">
                                <div class="flex items-center justify-between">
                                    <span class="rounded-md bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300 px-2 py-0.5 text-[11px] font-bold">
                                        {{ b.boardType }}
                                    </span>
                                    {% if b.year %}<span class="text-xs text-slate-400 font-semibold font-mono">{{ b.year }}</span>{% endif %}
                                </div>
                                {% if b.candidateName %}
                                    <p class="text-sm font-semibold text-slate-900 dark:text-white">Candidato(a): {{ b.candidateName }}</p>
                                {% endif %}
                                {% if b.title %}
                                    <p class="text-xs text-slate-600 dark:text-slate-300 italic">"{{ b.title }}"</p>
                                {% endif %}
                                {% if b.institutionName %}
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400">{{ b.institutionName }}</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </sl-tab-panel>
            {% endif %}

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 8: PARTICIPAÇÃO E ORGANIZAÇÃO DE EVENTOS
            ══════════════════════════════════════════════════════════════ -->
            {% if researcher.eventParticipations|length > 0 %}
                <sl-tab-panel name="events" class="pt-6 space-y-4">
                    <!-- Empty State Message for Events -->
                    <div id="empty-events" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                        <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhum evento encontrado para o filtro aplicado.</p>
                    </div>

                    <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                        <sl-icon name="calendar-event" class="text-teal-600 dark:text-teal-400"></sl-icon>
                        Participação em Eventos, Congressos e Exposições ({{ researcher.eventParticipations|length }})
                    </h3>
                    <div class="space-y-3">
                        {% for ev in researcher.eventParticipations %}
                            <div class="event-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1.5 bg-white/50 dark:bg-slate-900/50">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <span class="rounded-md bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300 px-2 py-0.5 text-[11px] font-bold">
                                            {{ ev.eventType ?: 'Evento' }}
                                        </span>
                                        {% if ev.participationType %}
                                            <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
                                                ({{ ev.participationType }})
                                            </span>
                                        {% endif %}
                                    </div>
                                    {% if ev.year %}<span class="text-xs text-slate-400 font-semibold font-mono">{{ ev.year }}</span>{% endif %}
                                </div>
                                <h4 class="text-sm font-bold text-slate-900 dark:text-white">{{ ev.eventName }}</h4>
                                {% if ev.presentationTitle %}
                                    <p class="text-xs text-slate-600 dark:text-slate-300 italic">Apresentação: "{{ ev.presentationTitle }}"</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </sl-tab-panel>
            {% endif %}

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 9: PRÊMIOS E TÍTULOS
            ══════════════════════════════════════════════════════════════ -->
            {% if researcher.awards|length > 0 %}
                <sl-tab-panel name="awards" class="pt-6 space-y-4">
                    <!-- Empty State Message for Awards -->
                    <div id="empty-awards" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                        <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhum prêmio ou título encontrado para o filtro aplicado.</p>
                    </div>

                    <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                        <sl-icon name="trophy" class="text-amber-500"></sl-icon> Prêmios e Distinções
                    </h3>
                    <div class="space-y-3">
                        {% for a in researcher.awards %}
                            <div class="award-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1 bg-white/50 dark:bg-slate-900/50">
                                <div class="flex items-center justify-between">
                                    <h4 class="font-heading text-sm sm:text-base font-bold text-slate-900 dark:text-white">{{ a.name }}</h4>
                                    {% if a.year %}<span class="text-xs font-semibold text-amber-600 dark:text-amber-400 font-mono">{{ a.year }}</span>{% endif %}
                                </div>
                                {% if a.promoterEntity %}
                                    <p class="text-xs text-slate-500 dark:text-slate-400">{{ a.promoterEntity }}</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </sl-tab-panel>
            {% endif %}

            <!-- ══════════════════════════════════════════════════════════════
                 TAB 10: ÁREAS DE ATUAÇÃO E CONHECIMENTO
            ══════════════════════════════════════════════════════════════ -->
            {% if researcher.knowledgeAreas|length > 0 %}
                <sl-tab-panel name="areas" class="pt-6 space-y-4">
                    <!-- Empty State Message for Knowledge Areas -->
                    <div id="empty-areas" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                        <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhuma área de atuação encontrada para o filtro aplicado.</p>
                    </div>

                    <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                        <sl-icon name="diagram-2" class="text-sky-600 dark:text-sky-400"></sl-icon> Áreas de Atuação do CNPq
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {% for ka in researcher.knowledgeAreas %}
                            <div class="area-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1.5 bg-white/50 dark:bg-slate-900/50">
                                <span class="text-[11px] font-bold uppercase text-sky-600 dark:text-sky-400">{{ ka.majorArea }}</span>
                                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">{{ ka.area }}</h4>
                                {% if ka.subArea %}<p class="text-xs text-slate-500 dark:text-slate-400">Subárea: {{ ka.subArea }}</p>{% endif %}
                                {% if ka.specialty %}<p class="text-xs text-slate-500 dark:text-slate-400">Especialidade: {{ ka.specialty }}</p>{% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </sl-tab-panel>
            {% endif %}
        </sl-tab-group>
    </div>
</div>

<!-- ── Toast Notification for Clipboard Copy Feedback ── -->
<div id="copyToast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 rounded-2xl bg-slate-900 text-white px-5 py-3 text-xs font-semibold shadow-2xl flex items-center gap-2">
    <sl-icon name="check2-circle" class="text-emerald-400 text-base"></sl-icon>
    <span id="copyToastMessage">Citação copiada para a área de transferência!</span>
</div>

<!-- ── Interactive JavaScript for Visual Analytics, Filtering & Citations ── -->
<script>
let currentCategory = 'all';
let onlyDoi = false;
let chartsExpanded = true;

function toggleChartsPanel() {
    const container = document.getElementById('chartsContainer');
    const toggleIcon = document.getElementById('toggleIcon');
    const toggleText = document.getElementById('toggleText');
    if (chartsExpanded) {
        container.style.display = 'none';
        toggleIcon.name = 'arrows-collapse';
        toggleText.textContent = 'Exibir Gráficos';
        chartsExpanded = false;
    } else {
        container.style.display = '';
        toggleIcon.name = 'arrows-expand';
        toggleText.textContent = 'Recolher Gráficos';
        chartsExpanded = true;
    }
}

function setCategoryFilter(category) {
    currentCategory = category;
    document.querySelectorAll('.category-pill').forEach(btn => {
        if (btn.getAttribute('data-category') === category) {
            btn.classList.add('bg-sky-600', 'text-white', 'shadow-sm');
            btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        } else {
            btn.classList.remove('bg-sky-600', 'text-white', 'shadow-sm');
            btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        }
    });
    applyGlobalFilter();
}

function toggleOnlyDoi() {
    onlyDoi = !onlyDoi;
    const btn = document.getElementById('btnOnlyDoi');
    if (onlyDoi) {
        btn.classList.add('bg-sky-100', 'border-sky-500', 'text-sky-800', 'dark:bg-sky-950', 'dark:text-sky-300', 'ring-2', 'ring-sky-500/30');
    } else {
        btn.classList.remove('bg-sky-100', 'border-sky-500', 'text-sky-800', 'dark:bg-sky-950', 'dark:text-sky-300', 'ring-2', 'ring-sky-500/30');
    }
    applyGlobalFilter();
}

function filterByKeyword(keyword) {
    const searchInput = document.getElementById('prodSearchInput');
    if (searchInput) searchInput.value = keyword;
    applyGlobalFilter();

    const filterBar = document.getElementById('globalFilterBar');
    if (filterBar) {
        filterBar.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
}

let currentDatabase = null;

function filterByDatabase(dbAcronym) {
    dbAcronym = (dbAcronym || '').toLowerCase();
    if (currentDatabase === dbAcronym) {
        currentDatabase = null;
    } else {
        currentDatabase = dbAcronym;
        // Garantir que a aba de artigos está selecionada/visível
        setCategoryFilter('artigo');
    }

    document.querySelectorAll('.db-filter-btn, .db-card-btn').forEach(btn => {
        const btnAcronym = (btn.getAttribute('data-db-acronym') || '').toLowerCase();
        if (currentDatabase && btnAcronym === currentDatabase) {
            btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-600', 'ring-2', 'ring-indigo-500/40');
            btn.classList.remove('bg-white/90', 'dark:bg-slate-900/80', 'bg-white/70', 'dark:bg-slate-900/60', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200/90', 'dark:border-slate-800');
        } else {
            btn.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600', 'ring-2', 'ring-indigo-500/40');
            btn.classList.add('bg-white/90', 'dark:bg-slate-900/80', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200/90', 'dark:border-slate-800');
        }
    });

    applyGlobalFilter();
}

function clearGlobalFilters() {
    const searchInput = document.getElementById('prodSearchInput');
    if (searchInput) searchInput.value = '';
    onlyDoi = false;
    currentDatabase = null;
    document.querySelectorAll('.db-filter-btn, .db-card-btn').forEach(btn => {
        btn.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-600', 'ring-2', 'ring-indigo-500/40');
        btn.classList.add('bg-white/90', 'dark:bg-slate-900/80', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200/90', 'dark:border-slate-800');
    });
    const btnDoi = document.getElementById('btnOnlyDoi');
    if (btnDoi) {
        btnDoi.classList.remove('bg-sky-100', 'border-sky-500', 'text-sky-800', 'dark:bg-sky-950', 'dark:text-sky-300', 'ring-2', 'ring-sky-500/30');
    }
    setCategoryFilter('all');
}

// Backward compatibility alias
function clearProdFilters() {
    clearGlobalFilters();
}

function updateTabCount(panelName, currentCount) {
    const el = document.getElementById('tabCount-' + panelName);
    if (!el) return;
    const initial = parseInt(el.getAttribute('data-initial') || '0', 10);
    const searchInput = document.getElementById('prodSearchInput');
    const rawTerm = (searchInput ? searchInput.value : '').trim();
    const isFiltered = rawTerm !== '' || onlyDoi || currentDatabase !== null;

    if (isFiltered) {
        if (currentCount > 0) {
            el.innerHTML = `<span class="font-bold text-sky-600 dark:text-sky-400">${currentCount}</span><span class="opacity-50 text-[10px]">/${initial}</span>`;
        } else {
            el.innerHTML = `<span class="text-rose-500/70 dark:text-rose-400/70 font-medium text-[11px]">0</span><span class="opacity-40 text-[10px]">/${initial}</span>`;
        }
    } else {
        el.textContent = initial;
    }
}

function checkPanelEmpty(panelName, count) {
    const emptyEl = document.getElementById('empty-' + panelName);
    if (emptyEl) {
        if (count === 0) {
            emptyEl.classList.remove('hidden');
        } else {
            emptyEl.classList.add('hidden');
        }
    }
}

function applyGlobalFilter() {
    const searchInput = document.getElementById('prodSearchInput');
    const rawTerm = (searchInput ? searchInput.value : '').trim();
    const term = rawTerm.toLowerCase();
    const isFiltered = term !== '' || onlyDoi || currentDatabase !== null;

    // Filter control UI elements
    const filterBar = document.getElementById('globalFilterBar');
    const btnClearMain = document.getElementById('btnClearFiltersMain');
    const btnClearQuick = document.getElementById('btnClearInputQuick');
    const statusBanner = document.getElementById('filterStatusBanner');
    const activeLabel = document.getElementById('filterActiveLabel');
    const matchesSummary = document.getElementById('filterMatchesSummary');

    if (isFiltered) {
        if (filterBar) {
            filterBar.classList.add('ring-2', 'ring-sky-500/50', 'border-sky-400', 'dark:border-sky-500', 'bg-sky-50/40', 'dark:bg-sky-950/30');
        }
        if (btnClearMain) btnClearMain.classList.remove('hidden');
        if (btnClearQuick) btnClearQuick.classList.remove('hidden');
        if (statusBanner) statusBanner.classList.remove('hidden');
        
        let labelParts = [];
        if (term !== '') labelParts.push(`"${rawTerm}"`);
        if (onlyDoi) labelParts.push('Apenas com DOI');
        if (currentDatabase) labelParts.push(`Base: "${currentDatabase.toUpperCase()}"`);
        if (activeLabel) activeLabel.textContent = labelParts.join(' + ');
    } else {
        if (filterBar) {
            filterBar.classList.remove('ring-2', 'ring-sky-500/50', 'border-sky-400', 'dark:border-sky-500', 'bg-sky-50/40', 'dark:bg-sky-950/30');
        }
        if (btnClearMain) btnClearMain.classList.add('hidden');
        if (btnClearQuick) btnClearQuick.classList.add('hidden');
        if (statusBanner) statusBanner.classList.add('hidden');
    }

    let totalMatchesAllTabs = 0;

    // 1. Filter Productions Tab
    let prodMatchesVisible = 0;
    const catCounts = { all: 0, artigo: 0, livro: 0, capitulo: 0, jornal: 0, evento: 0, tecnico: 0, inovacao: 0, artes: 0, outra: 0 };

    document.querySelectorAll('.prod-item').forEach(item => {
        const itemCat = item.getAttribute('data-category');
        const hasDoi = item.getAttribute('data-has-doi') === '1';
        let itemDbs = [];
        try {
            itemDbs = JSON.parse(item.getAttribute('data-databases') || '[]');
        } catch (e) {
            itemDbs = [];
        }
        const text = item.textContent.toLowerCase();

        const matchDoi = !onlyDoi || hasDoi;
        const matchTerm = term === '' || text.includes(term);
        const matchDb = !currentDatabase || itemDbs.includes(currentDatabase);
        const matchesCriteria = matchDoi && matchTerm && matchDb;

        if (matchesCriteria) {
            catCounts.all++;
            if (catCounts[itemCat] !== undefined) {
                catCounts[itemCat]++;
            }
            if (itemCat === 'inovacao' || itemCat === 'software' || itemCat === 'patente') {
                if (itemCat !== 'inovacao') catCounts.inovacao = (catCounts.inovacao || 0) + 1;
            }
        }

        const matchCat = (currentCategory === 'all') || (currentCategory === itemCat) || (currentCategory === 'inovacao' && (itemCat === 'inovacao' || itemCat === 'software' || itemCat === 'patente'));

        if (matchesCriteria && matchCat) {
            item.style.display = '';
            prodMatchesVisible++;
        } else {
            item.style.display = 'none';
        }
    });

    // Update visibility of production sub-sections
    document.querySelectorAll('.prod-section').forEach(sec => {
        const visibleItems = sec.querySelectorAll('.prod-item:not([style*="display: none"])');
        sec.style.display = visibleItems.length > 0 ? '' : 'none';
    });

    // Update category pill counts
    document.querySelectorAll('.category-pill').forEach(pill => {
        const cat = pill.getAttribute('data-category');
        const countSpan = pill.querySelector('.pill-count');
        if (countSpan && catCounts[cat] !== undefined) {
            const initial = parseInt(countSpan.getAttribute('data-initial') || '0', 10);
            const current = catCounts[cat];
            if (isFiltered) {
                if (current > 0) {
                    countSpan.innerHTML = `<span class="font-bold">${current}</span><span class="opacity-60 text-[10px]">/${initial}</span>`;
                } else {
                    countSpan.innerHTML = `<span class="opacity-40 text-[10px]">0/${initial}</span>`;
                }
            } else {
                countSpan.textContent = initial;
            }
        }
    });

    updateTabCount('productions', catCounts.all);
    totalMatchesAllTabs += catCounts.all;
    checkPanelEmpty('productions', prodMatchesVisible);

    // 2. Filter Helper for all other tabs
    function filterSimpleTab(panelName, itemSelector) {
        let count = 0;
        document.querySelectorAll(itemSelector).forEach(item => {
            const text = item.textContent.toLowerCase();
            const matches = (term === '' || text.includes(term)) && !onlyDoi;
            if (matches) {
                item.style.display = '';
                count++;
            } else {
                item.style.display = 'none';
            }
        });
        updateTabCount(panelName, count);
        totalMatchesAllTabs += count;
        checkPanelEmpty(panelName, count);
        return count;
    }

    filterSimpleTab('orientations', '.orientation-item');
    filterSimpleTab('projects', '.project-item');
    filterSimpleTab('experience', '.experience-item');
    filterSimpleTab('education', '.education-item');
    filterSimpleTab('complementary', '.complementary-item');
    filterSimpleTab('boards', '.board-item');
    filterSimpleTab('events', '.event-item');
    filterSimpleTab('awards', '.award-item');
    filterSimpleTab('areas', '.area-item');

    if (matchesSummary) {
        matchesSummary.textContent = `• ${totalMatchesAllTabs} registro(s) encontrado(s) no currículo`;
    }
}

// Backward compatibility alias
function filterProductions() {
    applyGlobalFilter();
}

function copyCitation(btn, title, venue, year, doi) {
    const authorName = "{{ researcher.citationNames ? researcher.citationNames|split(';')|first|trim : researcher.fullName }}";
    let citation = `${authorName}. ${title}. ${venue ? venue + ', ' : ''}${year}.`;
    if (doi) citation += ` DOI: https://doi.org/${doi}.`;

    navigator.clipboard.writeText(citation).then(() => {
        showToast('Citação ABNT copiada para a área de transferência!');
    });
}

function showToast(message) {
    const toast = document.getElementById('copyToast');
    const toastMsg = document.getElementById('copyToastMessage');
    toastMsg.textContent = message;
    toast.classList.remove('translate-y-20', 'opacity-0');
    setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
    }, 3000);
}

// ── Chart.js Initialization ──
document.addEventListener('DOMContentLoaded', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const textColor = isDark ? '#94a3b8' : '#475569';
    const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.05)';

    const timelineYears = {{ timelineYears|json_encode|raw }};
    const prodTimeline = {{ productionTimeline|json_encode|raw }};
    const orientTimeline = {{ orientationsTimeline|json_encode|raw }};
    const catDistribution = {{ categoryDistribution|json_encode|raw }};

    // 1. Stacked Production Timeline Chart
    const prodCanvas = document.getElementById('productionTimelineChart');
    if (prodCanvas) {
        new Chart(prodCanvas, {
            type: 'bar',
            data: {
                labels: timelineYears,
                datasets: [
                    {
                        label: 'Artigos Periódicos',
                        data: Object.values(prodTimeline.artigos),
                        backgroundColor: '#0284c7',
                        stack: 'prod',
                        borderRadius: 3
                    },
                    {
                        label: 'Livros & Capítulos',
                        data: Object.values(prodTimeline.livros_capitulos),
                        backgroundColor: '#f59e0b',
                        stack: 'prod',
                        borderRadius: 3
                    },
                    {
                        label: 'Jornais / Revistas',
                        data: Object.values(prodTimeline.jornais_revistas),
                        backgroundColor: '#3b82f6',
                        stack: 'prod',
                        borderRadius: 3
                    },
                    {
                        label: 'Trabalhos em Congressos',
                        data: Object.values(prodTimeline.eventos),
                        backgroundColor: '#ec4899',
                        stack: 'prod',
                        borderRadius: 3
                    },
                    {
                        label: 'Produção Técnica & Inovação',
                        data: Object.values(prodTimeline.tecnicos_inovacao),
                        backgroundColor: '#10b981',
                        stack: 'prod',
                        borderRadius: 3
                    },
                    {
                        label: 'Outras',
                        data: Object.values(prodTimeline.outras),
                        backgroundColor: '#94a3b8',
                        stack: 'prod',
                        borderRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { boxWidth: 12, font: { size: 10 }, color: textColor }
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        grid: { display: false },
                        ticks: { color: textColor, font: { size: 10 } }
                    },
                    y: {
                        stacked: true,
                        grid: { color: gridColor },
                        ticks: { color: textColor, precision: 0 }
                    }
                }
            }
        });
    }

    // 2. Donut Category Distribution Chart
    const catCanvas = document.getElementById('categoryDonutChart');
    if (catCanvas) {
        new Chart(catCanvas, {
            type: 'doughnut',
            data: {
                labels: Object.keys(catDistribution),
                datasets: [{
                    data: Object.values(catDistribution),
                    backgroundColor: [
                        '#0284c7', '#f59e0b', '#3b82f6', '#ec4899',
                        '#10b981', '#6366f1', '#a855f7', '#64748b'
                    ],
                    borderWidth: isDark ? 2 : 1,
                    borderColor: isDark ? '#0f172a' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 10, font: { size: 9 }, color: textColor }
                    }
                },
                cutout: '62%'
            }
        });
    }

    // 3. Orientations Timeline Chart
    const orientCanvas = document.getElementById('orientationsTimelineChart');
    if (orientCanvas) {
        new Chart(orientCanvas, {
            type: 'bar',
            data: {
                labels: timelineYears,
                datasets: [
                    {
                        label: 'Doutorado',
                        data: Object.values(orientTimeline.doutorado || {}),
                        backgroundColor: '#7c3aed',
                        stack: 'orient',
                        borderRadius: 3
                    },
                    {
                        label: 'Mestrado',
                        data: Object.values(orientTimeline.mestrado || {}),
                        backgroundColor: '#059669',
                        stack: 'orient',
                        borderRadius: 3
                    },
                    {
                        label: 'Pós-Doutorado',
                        data: Object.values(orientTimeline.pos_doutorado || {}),
                        backgroundColor: '#ea580c',
                        stack: 'orient',
                        borderRadius: 3
                    },
                    {
                        label: 'TCC / Graduação',
                        data: Object.values(orientTimeline.tcc_graduacao || {}),
                        backgroundColor: '#0284c7',
                        stack: 'orient',
                        borderRadius: 3
                    },
                    {
                        label: 'Iniciação Científica (PIBIC)',
                        data: Object.values(orientTimeline.iniciacao_cientifica || {}),
                        backgroundColor: '#eab308',
                        stack: 'orient',
                        borderRadius: 3
                    },
                    {
                        label: 'Especialização',
                        data: Object.values(orientTimeline.especializacao || {}),
                        backgroundColor: '#ec4899',
                        stack: 'orient',
                        borderRadius: 3
                    },
                    {
                        label: 'Outras Orientações',
                        data: Object.values(orientTimeline.outras || {}),
                        backgroundColor: '#64748b',
                        stack: 'orient',
                        borderRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { boxWidth: 12, font: { size: 10 }, color: textColor }
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        grid: { display: false },
                        ticks: { color: textColor, font: { size: 10 } }
                    },
                    y: {
                        stacked: true,
                        grid: { color: gridColor },
                        ticks: { color: textColor, precision: 0 }
                    }
                }
            }
        });
    }

    // 4. Professor Academic Databases Chart (Fig 15 Horizontal Bar)
    const profAcademicDbData = {{ academicDatabases|json_encode|raw }};
    const profDbCanvas = document.getElementById('chartProfessorAcademicDatabases');
    if (profDbCanvas && profAcademicDbData && profAcademicDbData.ranking && profAcademicDbData.ranking.length > 0) {
        new Chart(profDbCanvas, {
            type: 'bar',
            data: {
                labels: profAcademicDbData.ranking.map(d => d.name),
                datasets: [{
                    label: 'Artigos Indexados',
                    data: profAcademicDbData.ranking.map(d => d.total),
                    backgroundColor: profAcademicDbData.ranking.map(d => d.color),
                    borderRadius: 6,
                    borderWidth: 1,
                    borderColor: profAcademicDbData.ranking.map(d => d.color)
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const item = profAcademicDbData.ranking[context.dataIndex];
                                return ` ${item.total.toLocaleString('pt-BR')} artigos (${item.indexedPercentage}% dos indexados / ${item.percentage}% do total)`;
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { color: gridColor }, ticks: { color: textColor, precision: 0 } },
                    y: { grid: { display: false }, ticks: { color: textColor, font: { size: 11, weight: 'bold' } } }
                }
            }
        });
    }

    // 5. Professor Academic Databases Timeline (Fig 16 Multi-Line Chart)
    const profDbTimelineCanvas = document.getElementById('chartProfessorAcademicDatabasesTimeline');
    if (profDbTimelineCanvas && profAcademicDbData && profAcademicDbData.timelineSeries && profAcademicDbData.timelineSeries.length > 0) {
        const profTimelineDatasets = profAcademicDbData.timelineSeries.map(s => ({
            label: s.name,
            data: s.data,
            borderColor: s.color,
            backgroundColor: s.color + '20',
            tension: 0.35,
            borderWidth: 2.5,
            fill: false,
            pointRadius: 3,
            pointHoverRadius: 6
        }));

        new Chart(profDbTimelineCanvas, {
            type: 'line',
            data: {
                labels: profAcademicDbData.years,
                datasets: profTimelineDatasets
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { color: textColor, font: { size: 10, weight: 'bold' }, boxWidth: 12 }
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false
                    }
                },
                scales: {
                    x: { grid: { color: gridColor }, ticks: { color: textColor, font: { size: 10 } } },
                    y: { grid: { color: gridColor }, ticks: { color: textColor, precision: 0 } }
                }
            }
        });
    }
});
</script>
{% endblock %}
