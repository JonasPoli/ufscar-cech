<div class="space-y-8">
    <!-- 1. ORIENTAÇÕES (CONCLUÍDAS E EM ANDAMENTO) -->
    <div class="space-y-6">
                <!-- Empty State Message for Orientations -->
                <div id="empty-orientations" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                    <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhuma orientação encontrada para o filtro aplicado.</p>
                </div>

                <!-- Completed Orientations -->
                {% if completedOrientations|length > 0 %}
                    <div class="space-y-4">
                        <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <span class="flex items-center gap-2">
                                <sl-icon name="check-circle-fill" class="text-emerald-600 dark:text-emerald-400"></sl-icon>
                                Orientações Concluídas ({{ completedOrientations|length }})
                            </span>
                            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                                {% set pCount = [] %}
                                {% if kpiStats.orientationsBreakdown.doutorado_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.doutorado_concluido ~ ' Doutorado']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.mestrado_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.mestrado_concluido ~ ' Mestrado']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.pos_doc_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.pos_doc_concluido ~ ' Pós-Doc']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.tcc_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.tcc_concluido ~ ' TCC/Graduação']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.iniciacao_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.iniciacao_concluido ~ ' PIBIC']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.especializacao_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.especializacao_concluido ~ ' Especialização']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.outras_concluido > 0 %}{% set pCount = pCount|merge([kpiStats.orientationsBreakdown.outras_concluido ~ ' Outras']) %}{% endif %}
                                {{ pCount|join(' • ') }}
                            </span>
                        </h3>
                        <div class="space-y-3">
                            {% for o in completedOrientations %}
                                <div class="orientation-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-2.5 bg-white/50 dark:bg-slate-900/50 hover:border-emerald-300 dark:hover:border-emerald-700/50 transition-colors flex flex-col justify-between">
                                    <div class="space-y-1">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-1.5 flex-wrap">
                                                {% if o.orientationType == 'DOUTORADO' %}
                                                    <span class="rounded-md bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 px-2 py-0.5 text-[11px] font-bold">Doutorado</span>
                                                {% elseif o.orientationType == 'MESTRADO' %}
                                                    <span class="rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-2 py-0.5 text-[11px] font-bold">Mestrado</span>
                                                {% elseif o.orientationType == 'POS_DOUTORADO' %}
                                                    <span class="rounded-md bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 px-2 py-0.5 text-[11px] font-bold">Pós-Doutorado</span>
                                                {% elseif o.orientationType == 'TCC_GRADUACAO' %}
                                                    <span class="rounded-md bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 text-[11px] font-bold">TCC / Graduação</span>
                                                {% elseif o.orientationType == 'INICIACAO_CIENTIFICA' %}
                                                    <span class="rounded-md bg-yellow-100 text-yellow-800 dark:bg-yellow-950 dark:text-yellow-300 px-2 py-0.5 text-[11px] font-bold">Iniciação Científica (PIBIC)</span>
                                                {% elseif o.orientationType == 'ESPECIALIZACAO' %}
                                                    <span class="rounded-md bg-pink-100 text-pink-800 dark:bg-pink-950 dark:text-pink-300 px-2 py-0.5 text-[11px] font-bold">Especialização</span>
                                                {% else %}
                                                    <span class="rounded-md bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2 py-0.5 text-[11px] font-bold">Outra Natureza</span>
                                                {% endif %}
                                                {% if o.isCoadvising %}
                                                    <span class="rounded-md bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/50 px-1.5 py-0.5 text-[10px] font-medium">Coorientação</span>
                                                {% endif %}
                                            </div>
                                            {% if o.year %}<span class="text-xs text-slate-400 font-semibold font-mono">{{ o.year }}</span>{% endif %}
                                        </div>
                                        <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ o.studentName }}</p>
                                        {% if o.title %}
                                            <p class="text-xs text-slate-600 dark:text-slate-300 italic">"{{ o.title }}"</p>
                                        {% endif %}
                                        <div class="text-[11px] text-slate-400">
                                            {% if o.courseName %}{{ o.courseName }} • {% endif %}
                                            {{ o.institutionName }}
                                            {% if o.campus %} ({{ o.campus }}){% endif %}
                                        </div>
                                    </div>

                                    {# Botão de Busca e Link Direto para o Repositório #}
                                    <div class="pt-2 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between gap-2">
                                        {% set queryParts = [] %}
                                        {% if o.title %}{% set queryParts = queryParts|merge(['"' ~ o.title ~ '"']) %}{% endif %}
                                        {% if o.studentName %}{% set queryParts = queryParts|merge([o.studentName]) %}{% endif %}
                                        {% if researcher.fullName %}{% set queryParts = queryParts|merge([researcher.fullName]) %}{% endif %}
                                        {% if o.institutionName %}{% set queryParts = queryParts|merge([o.institutionName]) %}{% endif %}
                                        {% set gSearchUrl = 'https://www.google.com/search?q=' ~ (queryParts|join(' ')|url_encode) %}
                                        {% set gScholarUrl = 'https://scholar.google.com/scholar?q=' ~ ((o.title ? ('"' ~ o.title ~ '"') : (o.studentName ~ ' ' ~ researcher.fullName))|url_encode) %}

                                        <div class="flex items-center gap-2 flex-wrap">
                                            {% if o.handleUrl %}
                                                <a href="{{ o.handleUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-[11px] font-semibold text-emerald-700 dark:text-emerald-300 hover:text-emerald-900 dark:hover:text-emerald-100 bg-emerald-50 dark:bg-emerald-950/60 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-200/80 dark:border-emerald-800/60 transition group shrink-0" title="Ver trabalho completo no Repositório Institucional UFSCar">
                                                    <sl-icon name="book" class="text-emerald-600 dark:text-emerald-400 text-xs"></sl-icon>
                                                    <span>Repositório UFSCar</span>
                                                    <sl-icon name="box-arrow-up-right" class="text-[10px] text-emerald-500"></sl-icon>
                                                </a>
                                            {% endif %}

                                            <a href="{{ gSearchUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100/80 hover:bg-slate-200/80 dark:bg-slate-800/80 dark:hover:bg-slate-700/80 border border-slate-200/60 dark:border-slate-700/60 transition group shrink-0" title="Pesquisar trabalho/arquivo da orientação no Google">
                                                <svg class="w-3.5 h-3.5 grayscale group-hover:grayscale-0 opacity-70 group-hover:opacity-100 transition" viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                                                </svg>
                                                <span>Google</span>
                                                <sl-icon name="box-arrow-up-right" class="text-[10px] text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-200"></sl-icon>
                                            </a>

                                            <a href="{{ gScholarUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-2 py-1 rounded-md text-[11px] font-medium text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition" title="Pesquisar no Google Acadêmico (Scholar)">
                                                <sl-icon name="mortarboard" class="text-slate-400 text-[11px]"></sl-icon>
                                                <span>Scholar</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <!-- Ongoing Orientations -->
                {% if ongoingOrientations|length > 0 %}
                    <div class="space-y-4">
                        <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between border-b border-slate-200/60 dark:border-white/10 pb-2">
                            <span class="flex items-center gap-2">
                                <sl-icon name="arrow-repeat" class="text-sky-600 dark:text-sky-400"></sl-icon>
                                Orientações em Andamento ({{ ongoingOrientations|length }})
                            </span>
                            <span class="text-xs font-semibold text-sky-600 dark:text-sky-400">
                                {% set pCountA = [] %}
                                {% if kpiStats.orientationsBreakdown.doutorado_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.doutorado_andamento ~ ' Doutorado']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.mestrado_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.mestrado_andamento ~ ' Mestrado']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.pos_doc_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.pos_doc_andamento ~ ' Pós-Doc']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.tcc_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.tcc_andamento ~ ' TCC/Graduação']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.iniciacao_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.iniciacao_andamento ~ ' PIBIC']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.especializacao_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.especializacao_andamento ~ ' Especialização']) %}{% endif %}
                                {% if kpiStats.orientationsBreakdown.outras_andamento > 0 %}{% set pCountA = pCountA|merge([kpiStats.orientationsBreakdown.outras_andamento ~ ' Outras']) %}{% endif %}
                                {{ pCountA|join(' • ') }}
                            </span>
                        </h3>
                        <div class="space-y-3">
                            {% for o in ongoingOrientations %}
                                <div class="orientation-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-2.5 bg-white/50 dark:bg-slate-900/50 hover:border-sky-300 dark:hover:border-sky-700/50 transition-colors flex flex-col justify-between">
                                    <div class="space-y-1">
                                        <div class="flex items-center justify-between">
                                            {% if o.orientationType == 'DOUTORADO' %}
                                                <span class="rounded-md bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 px-2 py-0.5 text-[11px] font-bold">Doutorado</span>
                                            {% elseif o.orientationType == 'MESTRADO' %}
                                                <span class="rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 px-2 py-0.5 text-[11px] font-bold">Mestrado</span>
                                            {% elseif o.orientationType == 'POS_DOUTORADO' %}
                                                <span class="rounded-md bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 px-2 py-0.5 text-[11px] font-bold">Pós-Doutorado</span>
                                            {% elseif o.orientationType == 'TCC_GRADUACAO' %}
                                                <span class="rounded-md bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300 px-2 py-0.5 text-[11px] font-bold">TCC / Graduação</span>
                                            {% elseif o.orientationType == 'INICIACAO_CIENTIFICA' %}
                                                <span class="rounded-md bg-yellow-100 text-yellow-800 dark:bg-yellow-950 dark:text-yellow-300 px-2 py-0.5 text-[11px] font-bold">Iniciação Científica (PIBIC)</span>
                                            {% elseif o.orientationType == 'ESPECIALIZACAO' %}
                                                <span class="rounded-md bg-pink-100 text-pink-800 dark:bg-pink-950 dark:text-pink-300 px-2 py-0.5 text-[11px] font-bold">Especialização</span>
                                            {% else %}
                                                <span class="rounded-md bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 px-2 py-0.5 text-[11px] font-bold">Outra Natureza</span>
                                            {% endif %}
                                            {% if o.year %}<span class="text-xs text-slate-400 font-medium font-mono">Início: {{ o.year }}</span>{% endif %}
                                        </div>
                                        <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ o.studentName }}</p>
                                        {% if o.title %}
                                            <p class="text-xs text-slate-600 dark:text-slate-300 italic">"{{ o.title }}"</p>
                                        {% endif %}
                                        <div class="text-[11px] text-slate-400">
                                            {% if o.courseName %}{{ o.courseName }} • {% endif %}
                                            {{ o.institutionName }}
                                        </div>
                                    </div>

                                    {# Botão de Busca do Trabalho no Google #}
                                    <div class="pt-2 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between gap-2">
                                        {% set queryParts = [] %}
                                        {% if o.title %}{% set queryParts = queryParts|merge(['"' ~ o.title ~ '"']) %}{% endif %}
                                        {% if o.studentName %}{% set queryParts = queryParts|merge([o.studentName]) %}{% endif %}
                                        {% if researcher.fullName %}{% set queryParts = queryParts|merge([researcher.fullName]) %}{% endif %}
                                        {% if o.institutionName %}{% set queryParts = queryParts|merge([o.institutionName]) %}{% endif %}
                                        {% set gSearchUrl = 'https://www.google.com/search?q=' ~ (queryParts|join(' ')|url_encode) %}

                                        <a href="{{ gSearchUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white bg-slate-100/80 hover:bg-slate-200/80 dark:bg-slate-800/80 dark:hover:bg-slate-700/80 border border-slate-200/60 dark:border-slate-700/60 transition group shrink-0" title="Pesquisar projeto/orientação no Google">
                                            <svg class="w-3.5 h-3.5 grayscale group-hover:grayscale-0 opacity-70 group-hover:opacity-100 transition" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                                            </svg>
                                            <span>Buscar no Google</span>
                                            <sl-icon name="box-arrow-up-right" class="text-[10px] text-slate-400 group-hover:text-slate-600 dark:group-hover:text-slate-200"></sl-icon>
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                        </div>
                    </div>
                {% endif %}
    </div>

    <!-- 2. FORMAÇÃO ACADÊMICA / TITULAÇÃO -->
    <div class="space-y-4 pt-6 border-t border-slate-200/80 dark:border-slate-800">
                <!-- Empty State Message for Education -->
                <div id="empty-education" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                    <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhuma formação acadêmica encontrada para o filtro aplicado.</p>
                </div>

                <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                    <sl-icon name="mortarboard" class="text-indigo-600 dark:text-indigo-400"></sl-icon>
                    Formação Acadêmica / Titulação & Pós-Doutorado
                </h3>

                <div class="space-y-6 relative border-l-2 border-slate-200 dark:border-slate-800 ml-4 pl-6 pt-2">
                    {% for e in researcher.educations|filter(e => e.level not in ['CURTA_DURACAO', 'EXTENSAO', 'COMPLEMENTAR', 'APERFEICOAMENTO']) %}
                        <div class="education-item relative space-y-1.5">
                            <div class="absolute -left-[31px] top-1.5 h-3.5 w-3.5 rounded-full bg-sky-600 border-2 border-white dark:border-slate-950"></div>
                            <div class="flex items-center gap-2">
                                <span class="rounded-md bg-indigo-100 px-2 py-0.5 text-[11px] font-bold text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">
                                    {{ e.level|replace({'_': ' '}) }}
                                </span>
                                <span class="text-xs text-slate-400 font-semibold font-mono">
                                    {{ e.startYear ?: '?' }} — {{ e.endYear ?: 'Atual' }}
                                </span>
                            </div>
                            <h4 class="font-heading text-base font-bold text-slate-900 dark:text-white">
                                {{ e.courseName ?: e.institutionName }}
                            </h4>
                            <div class="text-xs font-medium text-slate-600 dark:text-slate-400">
                                {{ institution_badge(e.institutionName) }}
                            </div>
                            {% if e.monographTitle %}
                                <p class="text-xs text-slate-600 dark:text-slate-300 italic pt-0.5">
                                    <strong>Título:</strong> "{{ e.monographTitle }}"
                                </p>
                            {% endif %}
                            {% if e.advisorName %}
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    <strong>Orientador(a):</strong> {{ e.advisorName }}
                                </p>
                            {% endif %}
                            {% if e.grantingAgency %}
                                <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">
                                    Bolsa / Fomento: {{ e.grantingAgency }}
                                </p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
    </div>

    {% if researcher.educations|filter(e => e.level in ["CURTA_DURACAO", "EXTENSAO", "COMPLEMENTAR", "APERFEICOAMENTO"])|length > 0 %}
    <!-- 3. FORMAÇÃO COMPLEMENTAR -->
    <div class="space-y-4 pt-6 border-t border-slate-200/80 dark:border-slate-800">
                    <!-- Empty State Message for Complementary Education -->
                    <div id="empty-complementary" class="empty-filter-state hidden p-8 text-center rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/50">
                        <sl-icon name="search" class="text-3xl text-slate-400 mb-2"></sl-icon>
                        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Nenhum curso de formação complementar encontrado para o filtro aplicado.</p>
                    </div>

                    <h3 class="font-heading text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-200/60 dark:border-white/10 pb-2">
                        <sl-icon name="award" class="text-amber-500"></sl-icon>
                        Formação Complementar & Cursos de Extensão
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {% for ce in researcher.educations|filter(e => e.level in ['CURTA_DURACAO', 'EXTENSAO', 'COMPLEMENTAR', 'APERFEICOAMENTO']) %}
                            <div class="complementary-item rounded-2xl border border-slate-200/80 dark:border-white/10 p-4 space-y-1 bg-white/50 dark:bg-slate-900/50">
                                <div class="flex items-center justify-between">
                                    <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                                        {{ ce.level|replace({'_': ' '}) }}
                                    </span>
                                    <span class="text-xs text-slate-400 font-medium font-mono">{{ ce.startYear ?: ce.endYear ?: '-' }}</span>
                                </div>
                                <h4 class="text-sm font-semibold text-slate-900 dark:text-white">{{ ce.courseName }}</h4>
                                <div>{{ institution_badge(ce.institutionName) }}</div>
                                {% if ce.workloadHours %}
                                    <p class="text-[11px] text-slate-400">Carga horária: {{ ce.workloadHours }}h</p>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
    </div>
    {% endif %}
</div>