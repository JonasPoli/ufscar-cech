{% extends 'pub/base.html.twig' %}

{% set titles = {
    'assuntos': ['Assuntos de pesquisa', 'Explore os assuntos mais presentes nas publicações dos docentes do CECH.', 'Encontre um assunto'],
    'areas': ['Áreas de atuação', 'Explore a produção dos docentes pelas áreas de atuação declaradas no Lattes.', 'Encontre uma área'],
    'grandes-areas': ['Grandes áreas', 'Explore a produção dos docentes pelas grandes áreas do conhecimento.', 'Encontre uma grande área'],
} %}
{% set current = titles[tab] %}

{% block title %}{{ current[0] }} | Explorar pesquisa | Portal CECH UFSCar{% endblock %}
{% block meta_description %}{{ current[1] }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <header class="space-y-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 px-3 py-0.5 text-xs font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
            <sl-icon name="stars"></sl-icon> Explorar pesquisa
        </span>
        <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">{{ current[0] }}</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300">{{ current[1] }}</p>
    </header>

    <div class="glass-card rounded-2xl overflow-hidden">
        <nav class="flex flex-wrap gap-1 border-b border-slate-200/70 dark:border-white/10 px-4 pt-3" aria-label="Catálogos">
            {% for key, route in {'assuntos': 'app_pub_explore', 'areas': 'app_pub_explore_areas', 'grandes-areas': 'app_pub_explore_major_areas'} %}
                <a href="{{ path(route) }}" {% if tab == key %}aria-current="page"{% endif %} class="rounded-t-xl px-4 py-2.5 text-sm font-semibold border-b-2 {{ tab == key ? 'border-sky-600 text-sky-700 dark:text-sky-400' : 'border-transparent text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white' }}">{{ titles[key][0] }}</a>
            {% endfor %}
        </nav>
        <div class="p-4">
            <label for="catalog-filter" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">{{ current[2] }}</label>
            <input id="catalog-filter" type="search" placeholder="Filtrar por nome" autocomplete="off" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400" id="catalog-count" aria-live="polite">
                {{ items|length|number_format(0, ',', '.') }} {{ tab == 'assuntos' ? 'assuntos' : (tab == 'areas' ? 'áreas' : 'grandes áreas') }}
                {% if tab == 'assuntos' and total > items|length %}(os {{ items|length }} mais frequentes de {{ total|number_format(0, ',', '.') }}; para outros, use a <a href="{{ path('app_pub_search') }}" class="font-semibold text-sky-700 hover:underline dark:text-sky-400">busca</a>){% endif %}
            </p>
        </div>
    </div>

    <ul id="catalog-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {% for item in items %}
            <li data-name="{{ item.name|lower }}">
                <a href="{{ item.url }}" class="glass-card rounded-2xl p-4 flex flex-col gap-1 h-full hover:border-sky-500/60 hover:shadow-md transition-all">
                    <span class="font-heading text-base font-bold text-slate-900 dark:text-white">{{ item.name }}</span>
                    <span class="text-xs text-slate-600 dark:text-slate-300">{{ item.count|number_format(0, ',', '.') }} {{ item.countLabel }} · {{ item.detail }}</span>
                </a>
            </li>
        {% else %}
            <li class="text-sm text-slate-500">Nada para mostrar ainda.</li>
        {% endfor %}
    </ul>
    <p id="catalog-empty" hidden class="text-sm text-slate-600 dark:text-slate-300">Nenhum item com esse nome. Experimente a <a href="{{ path('app_pub_search') }}" class="font-semibold text-sky-700 hover:underline dark:text-sky-400">busca de especialistas</a>.</p>
</div>

<script>
    (function () {
        var input = document.getElementById('catalog-filter');
        var items = Array.prototype.slice.call(document.querySelectorAll('#catalog-list > li[data-name]'));
        var count = document.getElementById('catalog-count');
        var empty = document.getElementById('catalog-empty');
        var initial = count ? count.innerHTML : '';
        function norm(s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
        input.addEventListener('input', function () {
            var q = norm(input.value.trim());
            var shown = 0;
            items.forEach(function (li) {
                var match = !q || norm(li.dataset.name).indexOf(q) >= 0;
                li.hidden = !match;
                if (match) shown++;
            });
            empty.hidden = shown > 0;
            count.innerHTML = q ? shown + (shown === 1 ? ' item encontrado' : ' itens encontrados') : initial;
        });
    })();
</script>
{% endblock %}
