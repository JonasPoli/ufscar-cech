{% extends 'pub/base.html.twig' %}
{% import 'pub/research/_macros.html.twig' as rs %}

{% block title %}{{ scope.name }} | Explorar pesquisa | Portal CECH UFSCar{% endblock %}
{% block meta_description %}Produção, docentes e coautorias do CECH UFSCar em {{ scope.name }}: {{ metrics.publications|number_format(0, ',', '.') }} publicações de {{ metrics.researchers }} docentes.{% endblock %}
{% block meta_robots %}{% if pageParams|length == 0 %}index, follow{% else %}noindex, follow{% endif %}{% endblock %}
{% block canonical_url %}{{ url(scope.route, {slug: scope.slug}) }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400" aria-label="Trilha">
        <a href="{{ path('app_pub_explore') }}" class="hover:text-sky-700 dark:hover:text-sky-400">Explorar pesquisa</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-800 dark:text-slate-200 font-medium" aria-current="page">{{ scope.name }}</span>
    </nav>

    <header class="space-y-2">
        <p class="text-xs font-bold uppercase tracking-wider text-sky-700 dark:text-sky-400">{{ scope.kind }}</p>
        <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">{{ scope.name }}</h1>
        <p class="text-sm text-slate-600 dark:text-slate-300">Acompanhe a produção, encontre quem pesquisa e veja as colaborações neste campo.</p>
        <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
            <a href="{{ searchUrl }}" class="font-semibold text-sky-700 hover:underline dark:text-sky-400">Buscar especialistas neste campo <sl-icon name="arrow-right"></sl-icon></a>
            {% if scope.thematicUrl is defined %}
                <a href="{{ scope.thematicUrl }}" class="font-semibold text-sky-700 hover:underline dark:text-sky-400">Qualis e periódicos do tema <sl-icon name="arrow-right"></sl-icon></a>
            {% endif %}
        </p>
    </header>

    {% include 'pub/research/_filters.html.twig' with {
        action: path(scope.route, {slug: scope.slug}),
        filter: filter,
        departments: departments,
        heading: 'Filtrar este campo',
    } only %}

    {% include 'pub/research/_panorama.html.twig' with {metrics: metrics, panoramaId: 'panorama-campo'} only %}

    {% if scope.related is defined and scope.related|length > 0 %}
        <section class="glass-card rounded-2xl p-4 sm:p-5" aria-labelledby="relacionados">
            <h2 id="relacionados" class="font-heading text-base font-bold text-slate-900 dark:text-white">Assuntos relacionados</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
                {% for c in scope.related %}
                    {% set slug = c.slug ?? null %}
                    <li>
                        {% if slug %}
                            <a href="{{ path('app_pub_explore_topic', {slug: slug}) }}" class="inline-flex rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-800 hover:border-sky-500 hover:text-sky-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">{{ c.term ?? c.name }}</a>
                        {% else %}
                            <span class="inline-flex rounded-xl border border-slate-200 px-3 py-1.5 text-sm text-slate-700 dark:border-slate-700 dark:text-slate-300">{{ c.term ?? c.name }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="space-y-3" aria-labelledby="docentes-campo">
        <div class="flex items-end justify-between gap-3">
            <h2 id="docentes-campo" class="font-heading text-xl font-bold text-slate-900 dark:text-white">Docentes que mais publicam neste campo</h2>
            {% if experts.count > experts.results|length %}
                <a href="{{ searchUrl }}" class="text-sm font-semibold text-sky-700 hover:underline dark:text-sky-400">Ver os {{ experts.count }} docentes</a>
            {% endif %}
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {% for item in experts.results %}
                {% set p = item.researcher %}
                <li>
                    <a href="{{ path('app_pub_professor_show', {slugOrId: p.slug}) }}" class="glass-card rounded-2xl p-4 flex items-center gap-3 h-full hover:border-sky-500/60 hover:shadow-md transition-all">
                        {{ rs.avatar(p) }}
                        <span class="min-w-0">
                            <span class="block text-sm font-bold text-slate-900 dark:text-white truncate">{{ p.name }}</span>
                            {{ rs.person_meta(p) }}
                            <span class="block text-xs font-semibold text-sky-700 dark:text-sky-400">{{ item.count }} {{ item.count == 1 ? 'publicação' : 'publicações' }}</span>
                        </span>
                    </a>
                </li>
            {% else %}
                <li class="text-sm text-slate-500 dark:text-slate-400">Nenhum docente com produção neste recorte.</li>
            {% endfor %}
        </ul>
    </section>

    {% include 'pub/research/_graph.html.twig' with {
        graphId: 'rede-campo',
        src: graphSrc,
        pairSrc: pairSrc,
        pairs: pairs,
        totalPairs: metrics.pairs,
        heading: 'Coautorias neste campo',
    } only %}

    <section class="space-y-3" aria-labelledby="publicacoes-campo">
        <h2 id="publicacoes-campo" class="font-heading text-xl font-bold text-slate-900 dark:text-white">Publicações relacionadas <span class="text-sm font-normal text-slate-500 dark:text-slate-400">({{ publications.count|number_format(0, ',', '.') }})</span></h2>
        {% if publications.results|length > 0 %}
            <ol class="glass-card rounded-2xl px-4 sm:px-6 divide-y divide-slate-200/70 dark:divide-white/10">
                {% for w in publications.results %}<li>{{ rs.work(w) }}</li>{% endfor %}
            </ol>
            {{ rs.pagination(scope.route, pageParams|merge({slug: scope.slug}), publications.page, publications.pages) }}
        {% else %}
            <p class="text-sm text-slate-500 dark:text-slate-400">Nenhuma publicação neste recorte.</p>
        {% endif %}
    </section>
</div>
{% endblock %}
