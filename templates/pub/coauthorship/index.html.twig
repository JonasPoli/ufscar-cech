{% extends 'pub/base.html.twig' %}

{% block graph_script %}<script src="{{ asset('js/graph.js') }}" defer></script>{% endblock %}

{% block title %}Coautorias entre docentes | Portal CECH UFSCar{% endblock %}
{% block meta_description %}Rede interativa de coautoria entre os docentes do Centro de Educação e Ciências Humanas da UFSCar: quem publica junto e o que publica.{% endblock %}
{% block meta_robots %}{% if filter.isEmpty %}index, follow{% else %}noindex, follow{% endif %}{% endblock %}
{% block canonical_url %}{{ url('app_pub_coauthorship') }}{% endblock %}

{% block body %}
{% embed 'pub/research/_hero.html.twig' with {
    eyebrow: 'Pesquisa compartilhada',
    icon: 'diagram-3',
    title: 'Conexões que produzem',
    highlight: 'conhecimento',
    subtitle: 'Veja quais docentes do CECH publicam juntos e o que publicam. A mesma publicação declarada no currículo de cada coautor conta uma vez.',
    stats: [
        {value: totalPeople, label: 'Docentes', icon: 'people'},
        {value: totalPairs, label: 'Pares', icon: 'link-45deg'},
        {value: sharedWorks, label: 'Publicações', icon: 'journal-text'},
    ],
    filter: filter, departments: departments, topics: topics,
} only %}
    {% block hero_after %}
        <div class="mt-8">
            {% include 'pub/research/_filters.html.twig' with {
                action: path('app_pub_coauthorship'),
                filter: filter,
                departments: departments,
                topics: topics,
                heading: 'Filtrar coautorias',
            } only %}
        </div>
    {% endblock %}
{% endembed %}

<div class="mx-auto max-w-7xl space-y-6 px-4 py-10 sm:px-6 lg:px-8">
    <div id="rede" class="scroll-mt-32">
        {% include 'pub/research/_graph.html.twig' with {
            graphId: 'rede-coautoria',
            src: graphSrc,
            pairSrc: pairSrc,
            pairs: pairs,
            totalPairs: totalPairs,
            morePairs: morePairs,
            limits: limits,
            currentLimit: currentLimit,
            heading: 'Rede de coautoria',
        } only %}
    </div>

    <aside class="flex flex-col gap-3 rounded-2xl border border-cech-blue/15 bg-gradient-to-r from-cech-blue-light to-cech-teal-light p-5 sm:flex-row sm:items-center sm:justify-between dark:border-white/10 dark:from-slate-900 dark:to-slate-900">
        <p class="flex items-center gap-3 text-sm text-slate-700 dark:text-slate-200">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-cech-blue shadow-sm dark:bg-slate-800 dark:text-cech-teal" aria-hidden="true"><sl-icon name="grid-3x3-gap"></sl-icon></span>
            A matriz completa de coautoria e a exportação para o VOSviewer ficam em Indicadores.
        </p>
        <a href="{{ path('app_pub_indicators', {tab: 'network'}) }}" class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-cech-blue px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-cech-blue-dark">Redes de colaboração <sl-icon name="arrow-right" aria-hidden="true"></sl-icon></a>
    </aside>
</div>
{% endblock %}
