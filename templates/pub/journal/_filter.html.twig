{#
    Filtro por área de conhecimento (taxonomia CAPES). Funciona sem JavaScript: o botão "Filtrar" envia o formulário,
    e o onchange do select só poupa o clique. Com JavaScript, o envio mostra o carregamento e impede um segundo envio.
    O select fica só bloqueado para o ponteiro: desabilitado, ele sairia do formulário e o filtro se perderia.
    Parâmetros: action (URL do formulário), areaOptions (grandes áreas com as áreas de avaliação) e selectedArea
    (slug escolhido ou vazio).
#}
<form method="GET" action="{{ action }}" class="glass-card rounded-2xl p-4 shadow-sm">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
        <div class="min-w-0 flex-1">
            <label for="journal-area-filter" class="mb-1 block text-xs font-semibold text-slate-600 dark:text-slate-300">Área de conhecimento (CAPES)</label>
            <select id="journal-area-filter" name="area" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" class="w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
                <option value="">Todas as áreas</option>
                {% for group in areaOptions %}
                    <optgroup label="{{ group.area.name }}">
                        <option value="{{ group.area.slug }}"{% if selectedArea == group.area.slug %} selected{% endif %}>{{ group.area.name }} — todas</option>
                        {% for child in group.children %}
                            <option value="{{ child.slug }}"{% if selectedArea == child.slug %} selected{% endif %}>{{ child.name }}</option>
                        {% endfor %}
                    </optgroup>
                {% endfor %}
            </select>
        </div>
        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-sky-500 cursor-pointer disabled:opacity-60 disabled:cursor-wait"><span data-filter-spinner class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent" aria-hidden="true"></span><span data-filter-label>Filtrar</span></button>
    </div>
</form>
<script>
    (() => {
        const form = document.currentScript.previousElementSibling;
        const select = form.querySelector('select');
        const button = form.querySelector('button[type="submit"]');
        const spinner = form.querySelector('[data-filter-spinner]');
        const label = form.querySelector('[data-filter-label]');
        let busy = false;

        const setBusy = (value) => {
            busy = value;
            form.setAttribute('aria-busy', value ? 'true' : 'false');
            button.disabled = value;
            spinner.classList.toggle('hidden', !value);
            label.textContent = value ? 'Filtrando...' : 'Filtrar';
            select.classList.toggle('pointer-events-none', value);
            select.classList.toggle('opacity-60', value);
        };

        form.addEventListener('submit', (event) => {
            if (busy) {
                event.preventDefault();
                return;
            }
            setBusy(true);
        });

        // Ao voltar pelo navegador, a página pode vir do cache com o botão bloqueado e outra área escolhida na lista
        window.addEventListener('pageshow', () => {
            setBusy(false);
            select.value = [...select.options].find((option) => option.defaultSelected)?.value ?? '';
        });
    })();
</script>
