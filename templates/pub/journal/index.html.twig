{% extends 'pub/base.html.twig' %}

{% block title %}Periódicos por base de indexação | Portal CECH UFSCar{% endblock %}
{% block meta_description %}Periódicos científicos em que os docentes do Centro de Educação e Ciências Humanas da UFSCar publicam artigos, agrupados pela base em que estão indexados (Scopus, PubMed, SciELO, Web of Science e Latindex) e pela área de conhecimento.{% endblock %}
{% block og_title %}Periódicos em que o CECH UFSCar publica{% endblock %}
{% block og_description %}Periódicos com artigos de docentes do CECH registrados no Currículo Lattes, agrupados pela base em que estão indexados e pela área de avaliação da CAPES.{% endblock %}

{% block body %}
{% set totals = overview.totals %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="border-b border-slate-200/60 pb-6 dark:border-white/10">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 px-3 py-0.5 text-xs font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300 mb-2">
            <sl-icon name="journal-text"></sl-icon> Produção científica
        </span>
        <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">Periódicos em que o CECH publica</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Periódicos com artigos de docentes do CECH registrados no Currículo Lattes, agrupados pela base em que estão indexados e pela área de avaliação da CAPES.
        </p>
        <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0">
            <li class="rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs text-slate-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300"><strong class="font-heading text-sm text-slate-900 dark:text-white">{{ totals.journals|number_format(0, ',', '.') }}</strong> {{ totals.journals == 1 ? 'periódico' : 'periódicos' }} com artigos</li>
            <li class="rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs text-slate-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300"><strong class="font-heading text-sm text-slate-900 dark:text-white">{{ totals.articles|number_format(0, ',', '.') }}</strong> {{ totals.articles == 1 ? 'artigo distinto' : 'artigos distintos' }}</li>
            <li class="rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs text-slate-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300"><strong class="font-heading text-sm text-slate-900 dark:text-white">{{ totals.researchers|number_format(0, ',', '.') }}</strong> {{ totals.researchers == 1 ? 'docente' : 'docentes' }}</li>
        </ul>
    </div>

    {% include 'pub/journal/_methodology.html.twig' with {'part': 'box'} only %}

    {% include 'pub/journal/_filter.html.twig' with {'action': path('app_pub_journals_index'), 'areaOptions': areaOptions, 'selectedArea': selectedArea} only %}

    <div class="grid grid-cols-1 items-start gap-6 xl:grid-cols-2">
        {% for acronym, base in overview.bases %}
            {% include 'pub/journal/_list.html.twig' with {'acronym': acronym, 'base': base, 'selectedArea': selectedArea, 'fullList': false} only %}
        {% endfor %}
    </div>

    {% include 'pub/journal/_methodology.html.twig' with {'part': 'sources', 'updatedAt': overview.updatedAt} only %}
</div>
{% endblock %}
