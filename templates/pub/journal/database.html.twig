{% extends 'pub/base.html.twig' %}

{% block title %}Periódicos indexados em {{ section.db.name }} | Portal CECH UFSCar{% endblock %}
{% block meta_description %}Periódicos indexados em {{ section.db.name }} em que os docentes do Centro de Educação e Ciências Humanas da UFSCar publicam artigos, com a quantidade de artigos distintos e de docentes em cada um.{% endblock %}
{% block og_title %}Periódicos indexados em {{ section.db.name }} com artigos do CECH UFSCar{% endblock %}
{% block og_description %}Periódicos com artigos de docentes do CECH registrados no Currículo Lattes, agrupados pela base em que estão indexados e pela área de avaliação da CAPES.{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="border-b border-slate-200/60 pb-6 dark:border-white/10">
        <a href="{{ path('app_pub_journals_index', {'area': selectedArea ?: null}) }}" class="mb-3 inline-flex items-center gap-1 text-sm font-semibold text-sky-600 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"><sl-icon name="arrow-left"></sl-icon> Todas as bases</a>
        <div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 px-3 py-0.5 text-xs font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300 mb-2">
                <sl-icon name="journal-text"></sl-icon> Produção científica
            </span>
        </div>
        <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white">Periódicos indexados em {{ section.db.name }} com artigos do CECH</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Periódicos com artigos de docentes do CECH registrados no Currículo Lattes, agrupados pela base em que estão indexados e pela área de avaliação da CAPES.
        </p>
        <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0">
            <li class="rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs text-slate-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300"><strong class="font-heading text-sm text-slate-900 dark:text-white">{{ section.total_journals|number_format(0, ',', '.') }}</strong> {{ section.total_journals == 1 ? 'periódico' : 'periódicos' }} com artigos</li>
            <li class="rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs text-slate-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300"><strong class="font-heading text-sm text-slate-900 dark:text-white">{{ section.total_articles|number_format(0, ',', '.') }}</strong> {{ section.total_articles == 1 ? 'artigo distinto' : 'artigos distintos' }}</li>
            <li class="rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs text-slate-600 dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-300"><strong class="font-heading text-sm text-slate-900 dark:text-white">{{ section.total_researchers|number_format(0, ',', '.') }}</strong> {{ section.total_researchers == 1 ? 'docente' : 'docentes' }}</li>
        </ul>
    </div>

    {% include 'pub/journal/_methodology.html.twig' with {'part': 'box'} only %}

    {% include 'pub/journal/_filter.html.twig' with {'action': path('app_pub_journals_database', {'base': acronym}), 'areaOptions': areaOptions, 'selectedArea': selectedArea} only %}

    {% include 'pub/journal/_list.html.twig' with {'acronym': acronym, 'base': section, 'selectedArea': selectedArea, 'fullList': true} only %}

    {% include 'pub/journal/_methodology.html.twig' with {'part': 'sources', 'updatedAt': section.updatedAt} only %}
</div>
{% endblock %}
