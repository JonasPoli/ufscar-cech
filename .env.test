# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
# Configure o DATABASE_URL real em .env.test.local (ignorado pelo git); o banco usado é <dbname>_test.
DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/cech?serverVersion=8.0.40&charset=utf8mb4"

# Os testes nunca leem nem gravam o cache de páginas públicas (var/cache/public_pages é compartilhado com o dev)
PAGE_CACHE_ENABLED=false

TRUSTED_HOSTS='^(localhost|127\.0\.0\.1|cech\.wab\.com\.br|www\.cech\.wab\.com\.br)$'
